# Node dependencies (پوشه کتابخانه‌های سنگین)
node_modules/

# Build & Temporary Files (پوشه‌های خروجی موقت)
dist/
.astro/

# System Files (فایل‌های زباله سیستم‌عامل)
.DS_Store
Thumbs.db

# Environment variables (فایل‌های امنیتی و پسوردها)
.env
.env.*
# نکته: الگوی بالا .env.example را هم مخفی می‌کند؛ چون آن فایل هیچ مقدار
# محرمانه‌ای ندارد (فقط نمونه‌ی اسم متغیر) و باید در ریپازیتوری کامیت شود
# تا توسعه‌دهنده‌ی بعدی بداند چه env varهایی لازم است، صراحتاً استثنا می‌کنیم.
!.env.example

# Log files (فایل‌های لاگ و گزارش خطا)
*.log

# آرشیوهای موقت خروجی پروژه (بسته‌ی تحویل/بکاپ دستی) — نباید در تاریخچه‌ی
# گیت انباشته شوند. استثنا: زیپ نصب پلاگین وردپرس که یک آرتیفکت تحویلی
# واقعی و کوچک است و عمداً نگه داشته می‌شود.
craneyadak-final.zip
/*.zip
!wordpress-plugin/*.zip
// src/lib/seo-meta.test.mts
// ---------------------------------------------------------------------------
// آزمون ساختِ عنوان و توضیح متا، با **رشته‌های واقعی همین سایت**.
//
// ═══════════════════════════════════════════════════════════════════════════
// چرا
// ═══════════════════════════════════════════════════════════════════════════
// build هشدار می‌داد «۲۴ توضیح و ۸ عنوان بریده شد» و این هشدار کم‌اهمیت به
// نظر می‌رسید — «کمی بلند، کوتاه شد». ولی وقتی خروجی واقعی را نگاه کردیم:
//
//   • عنوان SAGA1-L12 در ۵۷ کاراکتر تمام می‌شد با «…» و **بدون نام برند**.
//   • ۱۸ دسته از ۳۱ دسته دمِ «فاکتور رسمی» را از دست می‌دادند.
//
// یعنی بریدنِ کاراکتری همیشه ارزشمندترین بخش را می‌خورد، چون آن بخش آخر است.
//
// این آزمون همان رشته‌های واقعی را می‌سنجد، نه نمونه‌ی ساختگی.
//
// اجرا:  npm run test:seo
// ---------------------------------------------------------------------------

import { buildTitle, buildDescription, TITLE_MAX, DESC_MAX } from './seo-meta.ts';

let failed = 0;
const ok = (cond: unknown, msg: string) => {
  console.log(`  ${cond ? '✓' : '✗'} ${msg}`);
  if (!cond) failed++;
};

const SITE = 'کرین یدک';

console.log('\n── عنوان: قطعه حذف می‌شود، نه نصفه می‌شود ──');

// بدترین عنوان واقعی سایت: ۹۱ کاراکتر.
const saga = buildTitle([
  'ریموت کنترل ساگا SAGA1-L12 | ریموت جرثقیل سقفی ۱۲ کاناله',
  'کد SAGA1-L12',
  SITE,
]);
ok(saga.length <= TITLE_MAX, `عنوان محصول در حد مجاز است (${saga.length})`);
ok(!saga.endsWith('…'), 'عنوان با «…» تمام نمی‌شود');
console.log(`       → ${saga}`);

// برند با نام بلند — قبلاً «| کرین یدک» را از دست می‌داد.
const balkan = buildTitle(['قطعات بالکانسکو اکو (BALKANSKO ECHO)', 'تامین و استعلام قیمت', SITE]);
ok(balkan.length <= TITLE_MAX, `عنوان برند در حد مجاز است (${balkan.length})`);
ok(!balkan.endsWith('…'), 'عنوان برند بریده نشده');
ok(!/\|\s*$/.test(balkan), 'جداکننده‌ی آویزان در انتها نمانده');
console.log(`       → ${balkan}`);

// برند کوتاه باید هر سه قطعه را نگه دارد.
const kito = buildTitle(['قطعات کیتو (KITO)', 'تامین و استعلام قیمت', SITE]);
ok(kito.includes(SITE), 'وقتی جا هست، نام سایت حفظ می‌شود');
console.log(`       → ${kito}`);

// قطعه‌ی اول اگر خودش بلند باشد، تور ایمنی باید وارد شود.
// برچسب دارد تا در خروجی build با هشدار واقعی اشتباه گرفته نشود.
const huge = buildTitle(['ا'.repeat(80), SITE], '[تست] عمداً بلند');
ok(huge.length <= TITLE_MAX, `قطعه‌ی اولِ بیش‌ازحد بلند هم مهار می‌شود (${huge.length})`);

console.log('\n── توضیح: بلندترین دمی که جا می‌شود ──');

// blurb واقعی rope-guide — ۱۱۳ کاراکتر، بلندترین blurb سایت.
const ropeGuide =
  'کمربند، سیم‌بکسل را در شیار درام هدایت می‌کند و از هم‌پوشانی رشته‌ها، سایش نامتقارن و پارگی زودرس جلوگیری می‌کند.';
const d1 = buildDescription(ropeGuide, [
  'تامین کمربند جرثقیل سقفی با تضمین اصالت کالا، بررسی سازگاری فنی و صدور فاکتور رسمی.',
  'تامین کمربند جرثقیل سقفی با تضمین اصالت کالا و فاکتور رسمی.',
  'تامین با تضمین اصالت کالا و فاکتور رسمی.',
  'استعلام قیمت و فاکتور رسمی.',
]);
ok(d1.length <= DESC_MAX, `توضیح در حد مجاز است (${d1.length})`);
ok(!d1.endsWith('…'), 'توضیح وسط جمله بریده نشده');
ok(d1.startsWith(ropeGuide), 'متن اختصاصی کامل حفظ شد');
ok(/فاکتور رسمی\.$/.test(d1), 'یک دمِ کامل چسبید — سیگنال اعتماد از دست نرفت');
console.log(`       → ${d1}`);

// blurb کوتاه باید بلندترین دم را بگیرد.
const short = 'قلاب جرثقیل، بار را به سیم‌بکسل متصل می‌کند.';
const d2 = buildDescription(short, [
  'تامین قلاب جرثقیل سقفی با تضمین اصالت کالا، بررسی سازگاری فنی و صدور فاکتور رسمی.',
  'تامین با فاکتور رسمی.',
]);
ok(d2.includes('بررسی سازگاری فنی'), 'وقتی جا هست، کامل‌ترین دم می‌آید');
ok(d2.length <= DESC_MAX, `و همچنان در حد مجاز (${d2.length})`);

// هیچ دمی جا نشود → فقط متن اختصاصی، بدون «…»
const d3 = buildDescription('ب'.repeat(150), ['یک دم خیلی طولانی که قطعاً جا نمی‌شود و باید کنار برود.']);
ok(d3.length === 150 && !d3.endsWith('…'), 'وقتی هیچ دمی جا نشود، متن اصلی دست‌نخورده می‌ماند');

// متن اختصاصیِ بیش‌ازحد بلند → تور ایمنی
const d4 = buildDescription('پ'.repeat(200), [], '[تست] عمداً بلند');
ok(d4.length <= DESC_MAX, `متن اختصاصیِ بیش‌ازحد بلند مهار می‌شود (${d4.length})`);

console.log(failed ? `\n❌ ${failed} آزمون شکست خورد.\n` : '\n✅ همه‌ی آزمون‌های متا گذشت.\n');
process.exit(failed ? 1 : 0);

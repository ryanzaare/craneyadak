---
// src/pages/compare.astro — مقایسه‌ی کنار هم محصولات (O8؛ کارفرما: ایده‌ی دیجی‌کالا)
// ---------------------------------------------------------------------------
// انتخاب از دکمه‌ی «افزودن به مقایسه» صفحه‌ی محصول (localStorage، حداکثر ۴) یا نشانی ?p=a,b (قابل اشتراک).
// داده از /compare-index.json (فقط این صفحه می‌خواند). هر ردیف یک مشخصه با همان برچسب وردپرس؛ مقدارِ نبوده «—»، نه حدس.
// ⚠️ noindex: محتوای این صفحه به انتخاب کاربر بسته است و برای گوگل صفحه‌ی خالی است؛ مقایسه‌ی ایندکس‌پذیر همان جدول‌های
// مقایسه‌ی داخل صفحه‌ی محصول است (L10/L12).
// ⚠️ پیشنهاد «افزودن» فقط از دسته‌های مشترک کالاهای انتخاب‌شده — مقایسه‌ی ریموت با سیم‌بکسل بی‌معناست.
// ---------------------------------------------------------------------------
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
---

<Layout title="مقایسه‌ی قطعات جرثقیل سقفی | کرین یدک" description="مقایسه‌ی مشخصات فنی قطعات جرثقیل سقفی کنار هم." noindex={true} explore={{ skipGuides: true }}>
  <section class="bg-white border-b border-steel-300 px-4 py-6 md:py-8">
    <div class="max-w-7xl mx-auto">
      <Breadcrumb surface items={[{ label: 'صفحه اصلی', href: '/' }, { label: 'مقایسه' }]} />
      <h1 class="text-2xl md:text-3xl font-black text-steel-900 mb-2">مقایسه‌ی قطعات</h1>
      <p class="text-base text-steel-600 leading-8">تا ۴ قطعه‌ی هم‌دسته را کنار هم ببینید. از صفحه‌ی هر محصول «افزودن به مقایسه» را بزنید.</p>
    </div>
  </section>

  <section class="px-4 py-8 bg-steel-50 min-h-[40vh]">
    <div class="max-w-7xl mx-auto">
      <p data-cmp-empty class="rounded-md border border-steel-300 bg-white p-6 text-steel-700">هنوز قطعه‌ای برای مقایسه انتخاب نشده است. <a href="/products/" class="font-bold text-accent-ink hover:underline">فروشگاه ←</a></p>
      <div data-cmp-wrap hidden class="table-scroll bg-white rounded-md border border-steel-300">
        <table class="w-full text-sm" data-cmp-table></table>
      </div>
      <div data-cmp-suggest hidden class="mt-6">
        <h2 class="text-xl font-bold text-steel-900 mb-3">افزودن از همین دسته</h2>
        <ul class="flex flex-wrap gap-2" role="list" data-cmp-suggest-list></ul>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { readCompare, writeCompare, COMPARE_MAX } from '../scripts/compare';
  type P = { slug: string; name: string; href: string; sku: string | null; brand: string | null; categories: string[]; image: string | null; specs: [string, string][] };
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  const fromUrl = (new URLSearchParams(location.search).get('p') ?? '').split(',').map((s) => s.trim()).filter((s) => /^[a-z0-9-]+$/.test(s));
  if (fromUrl.length) writeCompare(fromUrl.slice(0, COMPARE_MAX));

  const all: P[] = await fetch('/compare-index.json').then((r) => (r.ok ? r.json() : [])).catch(() => []);
  const bySlug = new Map(all.map((p) => [p.slug, p]));

  function render() {
    const picked = readCompare().map((s) => bySlug.get(s)).filter((p): p is P => !!p);
    const empty = document.querySelector<HTMLElement>('[data-cmp-empty]')!;
    const wrap = document.querySelector<HTMLElement>('[data-cmp-wrap]')!;
    const table = document.querySelector<HTMLTableElement>('[data-cmp-table]')!;
    empty.hidden = picked.length > 0;
    wrap.hidden = picked.length === 0;
    history.replaceState(null, '', picked.length ? `?p=${picked.map((p) => p.slug).join(',')}` : location.pathname);
    if (picked.length) {
      const labels: string[] = [];
      for (const p of picked) for (const [l] of p.specs) if (!labels.includes(l)) labels.push(l);
      const head = '<thead><tr class="bg-steel-50 border-b border-steel-200"><th scope="col" class="p-3 text-right text-steel-600 font-bold">مشخصه</th>' +
        picked.map((p) => `<th scope="col" class="p-3 align-top min-w-48"><a href="${esc(p.href)}" class="block font-bold text-steel-900 hover:text-accent-ink leading-6">${p.image ? `<img src="${esc(p.image)}" alt="" width="96" height="96" class="w-24 h-24 object-contain mx-auto mb-2">` : ''}${esc(p.name)}</a>` +
          `<button type="button" data-cmp-remove="${esc(p.slug)}" class="mt-2 text-xs font-bold text-accent-ink hover:underline min-h-11">حذف از مقایسه</button></th>`).join('') + '</tr></thead>';
      const rows = [['کد فنی', (p: P) => p.sku ?? '—'], ['برند', (p: P) => p.brand ?? '—'], ...labels.map((l) => [l, (p: P) => p.specs.find(([x]) => x === l)?.[1] ?? '—'] as const)] as [string, (p: P) => string][];
      table.innerHTML = head + '<tbody>' + rows.map(([l, f], i) => `<tr class="border-b border-steel-100 ${i % 2 ? 'bg-steel-50/50' : ''}"><th scope="row" class="p-3 text-right font-bold text-steel-900 whitespace-nowrap">${esc(l)}</th>` +
        picked.map((p) => `<td class="p-3 text-steel-700 leading-7 align-top" dir="auto">${esc(f(p))}</td>`).join('') + '</tr>').join('') + '</tbody>';
    }
    const cats = new Set(picked.flatMap((p) => p.categories));
    const sugg = picked.length < COMPARE_MAX ? all.filter((p) => !picked.some((x) => x.slug === p.slug) && (cats.size === 0 || p.categories.some((c) => cats.has(c)))) : [];
    const box = document.querySelector<HTMLElement>('[data-cmp-suggest]')!;
    box.hidden = sugg.length === 0;
    box.querySelector('[data-cmp-suggest-list]')!.innerHTML = sugg.map((p) => `<li><button type="button" data-cmp-add="${esc(p.slug)}" class="inline-flex items-center min-h-11 px-4 rounded-md border border-steel-300 bg-white text-sm font-bold text-steel-800 hover:border-action">+ ${esc(p.name)}</button></li>`).join('');
  }

  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const rm = t.closest<HTMLElement>('[data-cmp-remove]')?.dataset.cmpRemove;
    const add = t.closest<HTMLElement>('[data-cmp-add]')?.dataset.cmpAdd;
    if (rm) { writeCompare(readCompare().filter((s) => s !== rm)); render(); }
    if (add) { writeCompare([...readCompare(), add].slice(-COMPARE_MAX)); render(); }
  });
  render();
</script>

---
// src/pages/brands/[slug].astro
// ---------------------------------------------------------------------------
// صفحه‌ی برند — نیت جستجوی «قطعات <برند>» را هدف می‌گیرد.
//
// تفکیک از صفحه‌ی دسته (ضد هم‌نوع‌خواری):
//   • /categories/.../remote-control → «ریموت کنترل جرثقیل سقفی» (نوع قطعه)
//   • /brands/telecrane             → «قطعات تله‌کرین» (موجودیت برند)
// این دو نباید یک عبارت را هدف بگیرند. متن و عنوان این صفحه حول «برند» است،
// نه حول یک نوع قطعه.
//
// آرایه‌ی mockProducts قبلی (نام و کد فنی جعلی + Offer بدون price +
// availability ساختگی) کاملاً حذف شده؛ محصولات واقعی از وردپرس می‌آیند.
// ---------------------------------------------------------------------------
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ProductCard from '../../components/ProductCard.astro';
import { SITE } from '../../data/site';
import { BRAND_CLASSES, categoryPath, findCategory } from '../../data/taxonomy';
import { getBrands, type EnrichedBrand } from '../../lib/brands';
import { getProductsByBrand, computePrice, productJsonLd, type CraneProduct } from '../../lib/wp';
import BrandGuide from '../../components/BrandGuide.astro';
import { getBrandSectionOrder } from '../../lib/section-order';
import { getBrandCustomSections } from '../../lib/brand-custom-sections';
import { getBrandProfile, type BrandProfile } from '../../lib/brand-profile';
import { isReviewMode } from '../../lib/category-content';

export async function getStaticPaths() {
  // برندها از وردپرس غنی می‌شوند: رنگ، متن لوگو، انکرتکست و توضیح سئو
  // همگی از ACF می‌آیند. ساختار (اسلاگ و کلاس) از تاکسونومی است تا یک
  // قطعی وردپرس مسیرها را از بین نبرد.
  const brands = await getBrands();
  return Promise.all(
    brands.map(async (brand) => ({
      params: { slug: brand.slug },
      props: {
        brand,
        products: await getProductsByBrand(brand.slug),
        profile: await getBrandProfile(brand.slug),
      },
    }))
  );
}

interface Props {
  brand: EnrichedBrand;
  products: CraneProduct[];
  profile: BrandProfile;
}

const { brand, products, profile } = Astro.props as Props;
const reviewMode = isReviewMode();

const classMeta = BRAND_CLASSES[brand.brandClass];
const title = `قطعات ${brand.nameFa} (${brand.nameEn}) | تامین و استعلام قیمت | ${SITE.name}`;
// جمله‌ی معرفِ نوشته‌شده در وردپرس بر توضیح تولیدی اولویت دارد — متنی که
// انسان نوشته، همیشه از متن قالبی بهتر در SERP دیده می‌شود.
const description = profile.heroClaim
  ? `${profile.heroClaim} استعلام قیمت با کد فنی و بررسی سازگاری.`.slice(0, 158)
  : `تامین ${brand.seoDesc}، ساخت ${brand.country}. استعلام قیمت با کد فنی، بررسی سازگاری و صدور فاکتور رسمی.`;
const canonical = `${SITE.url}/brands/${brand.slug}`;

// همه‌ی برندها برای لینک‌سازی داخلی هم‌کلاس.
const allBrands = await getBrands();
const brandsByClass = (c: EnrichedBrand['brandClass']) => allBrands.filter((b) => b.brandClass === c);

// برندهای هم‌کلاس — لینک‌سازی داخلی بین موجودیت‌های هم‌نوع، نه همه‌ی ۱۸ برند.
const siblings = brandsByClass(brand.brandClass).filter((b) => b.slug !== brand.slug);

// دسته‌هایی که واقعاً برای این برند محصول دارند — لینک به تقاطع واقعی
// «برند × دسته». اگر محصولی نباشد، لینکی ساخته نمی‌شود (بدون صفحه‌ی توخالی).
const categoriesWithProducts = [
  ...new Set(products.flatMap((p) => p.categorySlugs)),
]
  .map((slug) => findCategory(slug))
  .filter((c): c is NonNullable<typeof c> => Boolean(c));

const breadcrumbItems = [
  { label: 'صفحه اصلی', href: '/' },
  { label: 'برندهای جهانی', href: '/brands' },
  { label: brand.nameFa },
];

const brandNodeId = `${canonical}#brand`;

const itemList =
  products.length > 0
    ? {
        '@type': 'ItemList',
        '@id': `${canonical}#products`,
        numberOfItems: products.length,
        itemListElement: products.map((product, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          item: productJsonLd(product, SITE.url, computePrice(product)),
        })),
      }
    : null;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: breadcrumbItems.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: item.label,
        ...(item.href ? { item: `${SITE.url}${item.href}` } : {}),
      })),
    },
    {
      '@type': 'Brand',
      '@id': brandNodeId,
      name: brand.nameEn,
      alternateName: brand.nameFa,
      // فقط فیلدهایی که واقعاً مقدار دارند وارد اسکیما می‌شوند.
      // فیلد خالی یا حدسی در structured data ریسک جریمه است، نه امتیاز.
      ...(profile.headquarters ? { location: profile.headquarters } : {}),
      ...(profile.foundedYear ? { foundingDate: profile.foundedYear } : {}),
      ...(profile.sources.length ? { sameAs: profile.sources.map((x) => x.url) } : {}),
    },
    {
      '@type': 'CollectionPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      about: { '@id': brandNodeId },
      isPartOf: { '@id': `${SITE.url}/#website` },
      inLanguage: SITE.locale,
      ...(itemList ? { mainEntity: itemList } : {}),
    },
  ],
};
import { getContact } from '../../lib/site-options';

/* ⚠️ اعلان‌های داده‌ی وردپرس بلافاصله بعد از import ها.
   قبلاً انتهای فرontmatter بودند و کدِ بالاتر که از آن‌ها استفاده
   می‌کرد با «Cannot access before initialization» می‌شکست:
   `const` هویست می‌شود اما تا نقطه‌ی اعلان در ناحیه‌ی مرده‌ی
   زمانی (TDZ) است و دسترسی به آن خطا می‌دهد. */
const contact = await getContact();

// ترتیب بخش‌ها از پنل وردپرس؛ اگر تنظیم نشده باشد null و ترتیب پیش‌فرض
// کامپوننت استفاده می‌شود. این کوئری هرگز throw نمی‌کند.
const sectionOrder = await getBrandSectionOrder();
const customSections = await getBrandCustomSections(brand.slug);

---

<Layout title={title} description={description} jsonLd={jsonLd}>
  {/* نوار پایین هدر با رنگ اختصاصی برند. اگر برند رنگی ثبت نکرده باشد،
      `var(--brand, …)` به رنگ پیش‌فرض سایت برمی‌گردد. */}
  <section
    class="bg-steel-900 text-white pt-10 pb-16 px-4 relative overflow-hidden"
    style={brand.color ? `--brand:${brand.color}` : undefined}
  >
    <span class="cy-brand-bar absolute bottom-0 inset-x-0 h-2" aria-hidden="true"></span>
    <div class="absolute -left-16 -top-16 opacity-[0.06] pointer-events-none select-none" aria-hidden="true">
      <svg class="w-[28rem] h-[28rem] text-white" viewBox="0 0 200 60" fill="currentColor">
        <text x="50%" y="50%" dominant-baseline="middle" text-anchor="middle" font-family="Arial Black, Impact, sans-serif" font-size="46" font-weight="900">{brand.logoText}</text>
      </svg>
    </div>

    <div class="max-w-7xl mx-auto relative z-10">
      <Breadcrumb items={breadcrumbItems} />
      <div class="flex flex-col md:flex-row items-start gap-8">
        <div class="w-28 h-28 bg-white rounded-3xl flex items-center justify-center shrink-0 border-4 border-white/20 shadow-2xl p-3">
          <svg class="w-full h-full text-crane-navy" viewBox="0 0 200 60" fill="currentColor" role="img" aria-label={`لوگوی ${brand.nameFa}`}>
            <text x="50%" y="50%" dominant-baseline="middle" text-anchor="middle" font-family="Arial Black, Impact, sans-serif" font-size="34" font-weight="900">{brand.logoText}</text>
          </svg>
        </div>
        <div>
          <div class="flex flex-wrap items-center gap-2 mb-3">
            <span class="inline-block px-3 py-1 rounded bg-white/10 text-steel-100 text-xs font-bold border border-white/20">{classMeta.name}</span>
            <span class="inline-block px-3 py-1 rounded bg-white/10 text-steel-100 text-xs font-bold border border-white/20">ساخت {brand.country}</span>
          </div>
          <h1 class="text-3xl md:text-5xl font-black mb-4 tracking-tight drop-shadow-md leading-relaxed">
            قطعات {brand.nameFa}
            <span class="text-gray-400 font-bold text-2xl md:text-3xl" dir="ltr">({brand.nameEn})</span>
          </h1>
          {/* فقط و فقط متن وردپرس. جمله‌ی ثابت «تامین با بررسی سازگاری…»
              که اینجا بود حذف شد: متن سئوی نوشته‌شده باید تنها چیزی باشد
              که خوانده می‌شود، نه یک شعار تکراری کنارش. */}
          <p class="text-lg text-steel-300 max-w-3xl leading-9 whitespace-pre-line">{brand.seoDesc}</p>
        </div>
      </div>
    </div>
  </section>

  {/* ------------------------------ محصولات ------------------------------ */}
  <section class="bg-gray-50 px-4 py-14" aria-labelledby="brand-products-heading">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-wrap gap-4 justify-between items-end mb-8 border-b border-gray-200 pb-4">
        <h2 id="brand-products-heading" class="text-2xl font-black text-crane-navy">قطعات {brand.nameFa}</h2>
        {products.length > 0 && (
          <span class="text-sm text-gray-600 font-bold bg-white border border-gray-200 px-3 py-1 rounded-full tabular-nums">{products.length} قطعه</span>
        )}
      </div>

      {products.length > 0 ? (
        <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6" role="list">
          {products.map((product, index) => (
            <li><ProductCard product={product} eager={index < 4} showBrand={false} /></li>
          ))}
        </ul>
      ) : (
        <div class="bg-white rounded-3xl border border-gray-100 shadow-sm p-8 md:p-12 max-w-3xl">
          <h3 class="text-xl md:text-2xl font-black text-crane-navy mb-4 leading-9">
            استعلام قطعات {brand.nameFa} با کد فنی سازنده
          </h3>
          <p class="text-gray-700 leading-8 mb-8">
            فهرست آنلاین قطعات {brand.nameFa} در حال تکمیل است و تنها اقلامی منتشر می‌شود که تامین آن‌ها قطعی باشد. اگر Part Number اصلی سازنده یا عکس پلاک دستگاه را دارید، همان را بفرستید؛ کارشناسان ما قطعه‌ی اورجینال یا معادل استاندارد را شناسایی می‌کنند.
          </p>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href={`/contact?brand=${encodeURIComponent(brand.nameEn)}`} class="bg-crane-orange text-white px-8 py-4 rounded-xl font-black text-center hover:bg-orange-800 transition-colors focus:outline-none focus:ring-4 focus:ring-crane-orange/40 min-h-[52px] flex items-center justify-center">ثبت استعلام</a>
            <a href={contact.whatsappHref} target="_blank" rel="noopener noreferrer" class="bg-emerald-50 text-emerald-800 border border-emerald-200 px-8 py-4 rounded-xl font-black text-center hover:bg-emerald-600 hover:text-white transition-colors focus:outline-none focus:ring-4 focus:ring-emerald-500/30 min-h-[52px] flex items-center justify-center">ارسال عکس در واتساپ</a>
          </div>
        </div>
      )}
    </div>
  </section>

  {/* -------- تقاطع واقعی برند × دسته (فقط جایی که محصول وجود دارد) -------- */}
  {categoriesWithProducts.length > 0 && (
    <section class="bg-white px-4 py-14 border-t border-gray-100" aria-labelledby="brand-categories-heading">
      <div class="max-w-7xl mx-auto">
        <h2 id="brand-categories-heading" class="text-xl md:text-2xl font-black text-crane-navy mb-8">
          دسته‌بندی قطعات موجود {brand.nameFa}
        </h2>
        <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4" role="list">
          {categoriesWithProducts.map((category) => (
            <li>
              <a href={categoryPath(category)} class="group h-full bg-gray-50 hover:bg-white p-5 rounded-2xl border border-gray-100 hover:border-orange-100 hover:shadow-md transition-all flex items-center gap-3 focus:outline-none focus:ring-4 focus:ring-crane-orange/30">
                <span class="w-10 h-10 shrink-0 bg-white text-crane-navy group-hover:text-crane-orange group-hover:bg-orange-50 rounded-xl flex items-center justify-center transition-colors" aria-hidden="true">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.4" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d={category.icon} /></svg>
                </span>
                <span class="text-sm font-bold text-crane-navy group-hover:text-crane-orange transition-colors leading-6">{category.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {/* ------------------- هاب برند (محتوای عمیق) ------------------- */}
  <BrandGuide profile={profile} brandName={brand.nameFa} reviewMode={reviewMode} sectionOrder={sectionOrder} customSections={customSections} />

  {/* ---------------------- برندهای هم‌گروه ---------------------- */}
  {siblings.length > 0 && (
    <section class="bg-gray-50 px-4 py-14 border-t border-gray-100" aria-labelledby="sibling-brands-heading">
      <div class="max-w-7xl mx-auto">
        <h2 id="sibling-brands-heading" class="text-xl md:text-2xl font-black text-crane-navy mb-3">سایر {classMeta.name}</h2>
        <p class="text-gray-600 leading-8 mb-8 max-w-3xl">{classMeta.intro}</p>
        <ul class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4" role="list">
          {siblings.map((sibling) => (
            <li>
              <a href={`/brands/${sibling.slug}`} class="group h-full bg-white hover:shadow-md p-5 rounded-2xl border border-gray-100 hover:border-orange-100 transition-all flex flex-col items-center text-center focus:outline-none focus:ring-4 focus:ring-crane-orange/30">
                <span class="text-sm font-black tracking-wider text-crane-navy group-hover:text-crane-orange transition-colors uppercase" dir="ltr">{sibling.nameEn}</span>
                <span class="text-sm font-bold text-gray-700 mt-0.5">{sibling.nameFa}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</Layout>

---
// src/pages/brands/index.astro
import Layout from '../../layouts/Layout.astro';
import { ENRICHED_BRANDS, SITE } from '../../data/site';

const title = `برندهای تحت پوشش | تامین قطعات اصلی | ${SITE.name}`;
const description = 'تامین بی‌واسطه و فروش قطعات اورجینال معتبرترین برندهای تجهیزات بالابر صنعتی نظیر دماگ، اشتال، کونه‌کرین و تله‌کرین با تضمین اصالت و گارانتی معتبر.';

// Entity SEO: Breadcrumb + CollectionPage
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      '@id': `${SITE.url}/brands#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'صفحه اصلی', item: SITE.url },
        { '@type': 'ListItem', position: 2, name: 'برندهای جهانی', item: `${SITE.url}/brands` },
      ],
    },
    {
      '@type': 'CollectionPage',
      '@id': `${SITE.url}/brands#webpage`,
      url: `${SITE.url}/brands`,
      name: title,
      description: description,
      isPartOf: { '@id': `${SITE.url}/#website` }
    }
  ]
};
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  {/* HERO Section */}
  <section class="bg-crane-navy text-white pt-12 pb-20 px-4 border-b-[8px] border-crane-orange">
    <div class="max-w-7xl mx-auto">
      <nav class="text-sm text-gray-400 mb-8 flex items-center gap-2" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-crane-orange rounded py-1 px-2 -ml-2">صفحه اصلی</a>
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
        <span class="text-white font-bold" aria-current="page">برندهای جهانی</span>
      </nav>
      <h1 class="text-3xl md:text-5xl font-black mb-4 tracking-tight drop-shadow-md">برندهای تحت پوشش و تامین</h1>
      <p class="text-lg text-gray-300 max-w-2xl leading-8 font-light">
        ما در کرین یدک به عنوان تامین‌کننده‌ی معتمد صنایع، قطعات اورجینال برترین غول‌های مهندسی بالابر جهان را به صورت مستقیم و با مدارک تایید اصالت (Certificate) در اختیار شما قرار می‌دهیم.
      </p>
    </div>
  </section>

  {/* Brands Grid */}
  <section class="py-20 px-4 md:px-8 lg:px-12 bg-gray-50 min-h-[50vh]">
    <div class="max-w-7xl mx-auto">
      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
        {ENRICHED_BRANDS.map((brand) => (
          <li>
            <a href={brand.slug} class="group block bg-white rounded-3xl border border-transparent shadow-sm hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 overflow-hidden focus:outline-none focus:ring-4 focus:ring-crane-orange/30 hover:border-orange-100">
              <span class="sr-only">{brand.seoAnchor}</span>
              <div class="p-8 flex flex-col items-center justify-center h-[180px] bg-crane-light/30 relative">
                <div class="transform transition-transform duration-500 group-hover:-translate-y-3">
                  <svg class={`w-full h-12 md:h-14 text-gray-400 transition-colors duration-500 ${brand.brandColor.replace('group-hover:', '')}`} viewBox="0 0 200 60" fill="currentColor" aria-hidden="true">
                    <text x="50%" y="50%" dominant-baseline="middle" text-anchor="middle" font-family="Arial Black, Impact, system-ui, sans-serif" font-size="34" font-weight="900" letter-spacing="2">{brand.logoText}</text>
                  </svg>
                </div>
                <div class="absolute bottom-6 flex flex-col items-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 translate-y-2 group-hover:translate-y-0">
                  <span class="text-sm font-bold text-crane-navy mt-1">قطعات {brand.nameFa}</span>
                </div>
              </div>
              <div class="p-5 border-t border-gray-100 flex justify-between items-center bg-white relative z-10">
                <span class="text-xs font-bold text-gray-500 tracking-widest">{brand.nameEn}</span>
                <span class="w-8 h-8 rounded-full bg-orange-50 text-crane-orange flex items-center justify-center group-hover:bg-crane-orange group-hover:text-white transition-colors" aria-hidden="true">
                  <svg class="w-4 h-4 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                </span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>
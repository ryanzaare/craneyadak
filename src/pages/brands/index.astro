---
// src/pages/brands/index.astro
// ---------------------------------------------------------------------------
// هاب برندها.
//
// ⚠️ واقع‌بینی سئویی: تقاضای جستجو برای «برندهای جرثقیل» تقریباً صفر است.
// این صفحه یک صفحه‌ی فرود (Landing Page) نیست و نباید طوری بهینه شود که با
// صفحات تک‌برند رقابت کند. نقشش «ناوبری و توزیع اعتبار به صفحات برند» است —
// آن‌جاست که نیت خرید واقعی وجود دارد («قطعات دماگ»، «ریموت تله‌کرین»).
//
// گروه‌بندی سه‌گانه عمدی است: سازنده‌ی جرثقیل، سازنده‌ی سیستم کنترل و
// سازنده‌ی قطعه‌ی برقی سه نیت جستجوی متفاوت‌اند و یک فهرست تخت آن‌ها را
// در هم می‌ریزد.
// ---------------------------------------------------------------------------
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { SITE } from '../../data/site';
import { BRAND_CLASSES, type BrandClass } from '../../data/taxonomy';
import { getBrands } from '../../lib/brands';
import { getAllProducts } from '../../lib/wp';
import { productReadiness } from '../../lib/indexability';

// ⚠️ فهرست بدون هیچ محصولِ کامل = صفحه‌ی خالی → noindex (تصمیم کارفرما ۱۹ مهر ۱۴۰۵)؛ با اولین محصول کامل خودکار ایندکس‌پذیر می‌شود.
const noindexHub = !(await getAllProducts()).some((p) => productReadiness(p).ready);

// برندها از وردپرس — رنگ، متن لوگو، انکرتکست و توضیح سئو از پنل می‌آیند.
const BRANDS = await getBrands();
const brandsByClass = (c: BrandClass) => BRANDS.filter((b) => b.brandClass === c);

const title = `برندهای تحت پوشش | تامین قطعات اصلی | ${SITE.name}`;
const description = `تامین قطعات ${fa(BRANDS.length)} برند تجهیزات بالابر صنعتی — از سازندگان جرثقیل مانند دماگ و اشتال تا سیستم‌های کنترل تله‌کرین و HBC.`;
const canonical = `${SITE.url}/brands`;

const classOrder: BrandClass[] = ['oem', 'control', 'electrical'];
const breadcrumbItems = [{ label: 'صفحه اصلی', href: '/' }, { label: 'برندهای جهانی' }];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: breadcrumbItems.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: item.label,
        ...(item.href ? { item: `${SITE.url}${item.href}` } : {}),
      })),
    },
    {
      '@type': 'CollectionPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      isPartOf: { '@id': `${SITE.url}/#website` },
      inLanguage: SITE.locale,
      mainEntity: {
        '@type': 'ItemList',
        '@id': `${canonical}#brands`,
        numberOfItems: BRANDS.length,
        itemListElement: BRANDS.map((brand, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: brand.nameEn,
          url: `${SITE.url}/brands/${brand.slug}`,
        })),
      },
    },
  ],
};
import { hairlineFillers } from '../../components/hairline';
import { fa } from '../../components/catalog-presence';
---

<Layout title={title} description={description} jsonLd={jsonLd} noindex={noindexHub}>
  {/* Frontend v2 فاز ۵: نوار عنوان روشن زیر هدر گرافیت (هم‌خانواده‌ی دسته/محصول)، نه نوار تیره‌ی دوم با خط ۸px. */}
  <section class="bg-white text-steel-900 border-b border-steel-300 px-4 py-6 md:py-8 relative">
    <div class="max-w-7xl mx-auto">
      <Breadcrumb surface items={breadcrumbItems} />
      <h1 class="text-2xl md:text-3xl font-black mb-2 tracking-tight">برندهای تحت پوشش</h1>
      <p class="text-base md:text-xl text-steel-600 max-w-3xl leading-8">
        قطعات {fa(BRANDS.length)} برند تجهیزات بالابر تامین می‌شود. برندها بر اساس نقششان دسته‌بندی شده‌اند: سازنده‌ی جرثقیل، سازنده‌ی سیستم کنترل، و سازنده‌ی تجهیزات برقی — چون معمولاً روی یک دستگاه، هر سه از شرکت‌های متفاوتی هستند.
      </p>
    </div>
  </section>

  <section class="bg-steel-50 px-4 py-8 md:py-10">
    <div class="max-w-7xl mx-auto space-y-8">
      {classOrder.map((brandClass) => {
        const meta = BRAND_CLASSES[brandClass];
        const items = brandsByClass(brandClass);
        return (
          <section aria-labelledby={`class-${meta.slug}`}>
            <div class="mb-3">
              <h2 id={`class-${meta.slug}`} class="text-xl md:text-2xl font-bold text-steel-900 mb-2">
                {meta.name}
                <span class="text-sm font-bold text-steel-600 bg-white border border-steel-200 px-2 py-0.5 rounded ms-2 tabular-nums align-middle">
                  {fa(items.length)} برند
                </span>
              </h2>
              <p class="text-steel-700 leading-8 max-w-3xl">{meta.intro}</p>
            </div>

            {/* Frontend v2 فاز ۵: همان پلاک دوطبقه‌ی صفحه‌ی اصلی (.cy-brand-tile در global.css) در شبکه‌ی خط مو + یک خط
                توضیح وردپرس. رنگ اختصاصی برند (ACF) دیگر روی کاشی نیست — فقط نوار پایین صفحه‌ی خود برند. */}
            <ul class="cy-brand-tile grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-px bg-steel-200 border border-steel-200 rounded-md overflow-hidden" role="list">
              {items.map((brand) => (
                <li class="bg-white">
                  <a href={`/brands/${brand.slug}/`} title={brand.seoAnchor ?? undefined}>
                    <span><b dir="ltr">{brand.logoText}</b><i>{brand.country}</i></span>
                    <span>{brand.nameFa}</span>
                  </a>
                </li>
              ))}
              {hairlineFillers(items.length).map((c) => <li class={c} aria-hidden="true"></li>)}
            </ul>
          </section>
        );
      })}
    </div>
  </section>

  <section class="bg-white px-4 py-8 md:py-10 border-t border-steel-100">
    <div class="max-w-4xl mx-auto text-steel-700 leading-8 text-right">
      <h2 class="text-2xl font-bold text-steel-900 mb-6">برند مورد نظر شما در فهرست نیست؟</h2>
      <p class="mb-4">
        فهرست بالا برندهایی است که به‌طور منظم تامین می‌شوند. اگر قطعه‌ی شما از سازنده‌ی دیگری است، کد فنی (Part Number) یا عکس پلاک دستگاه را بفرستید؛ در بسیاری از موارد قطعه‌ی معادل با همان مشخصات فنی از سازنده‌ی دیگری قابل تامین است.
      </p>
      <p>
        در نظر داشته باشید که روی یک جرثقیل، معمولاً بدنه از یک برند، ریموت کنترل از برند دوم و تجهیزات تابلو برق از برند سوم است — بنابراین برای هر قطعه، برند همان قطعه اهمیت دارد، نه برند کل دستگاه.
        <a href="/contact" class="text-accent-ink font-bold hover:underline mr-1">ثبت استعلام</a>
      </p>
    </div>
  </section>
</Layout>

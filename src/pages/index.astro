---
// src/pages/index.astro
// ---------------------------------------------------------------------------
// صفحه‌ی اصلی — ویترین فروشگاه.
//
// سه تغییر بنیادی نسبت به نسخه‌ی قبل:
//
// ۱) داده‌ی ساختگی حذف شد. برچسب «بیشترین جستجوها» بالای سه لینک دست‌نویس
//    یک ادعای آماری بی‌پشتوانه بود — همان دسته از تخلفی که کد فنی جعلی و
//    حجم فایل دستی بودند. جایگزین: برچسب صادقانه + مقصدهای واقعی
//    (src/data/popular-searches.ts).
//
// ۲) نوار «آمار» حذف شد. «+۸ دسته‌بندی» و «۸ پرسش پاسخ‌داده‌شده» شمارش
//    محتوای خودِ سایت بود، نه دستاورد؛ برای مدیر خرید صنعتی بی‌معناست و
//    عملاً کوچک‌بودن را تبلیغ می‌کرد. مزیت‌های واقعی همان پایین در بخش
//    ADVANTAGES هستند.
//
// ۳) محصولات واقعی روی صفحه آمدند. قبلاً صفحه‌ی اصلی هیچ کالایی نشان
//    نمی‌داد و حس «انبار خالی» می‌داد. اگر محصول واقعی نباشد، بخش‌ها اصلاً
//    رندر نمی‌شوند — نه این‌که با کارت ساختگی پر شوند.
//
// تفکیک نیت (ضد هم‌نوع‌خواری): این صفحه مالک عبارت اصلی
// «قطعات جرثقیل سقفی» است. صفحه‌ی /categories عمداً همین عبارت را هدف
// نمی‌گیرد و نیت «مرور کاتالوگ» را می‌گیرد.
// ---------------------------------------------------------------------------
import Layout from '../layouts/Layout.astro';
import PartFinder from '../components/PartFinder.astro';
import AuthorityStrip from '../components/AuthorityStrip.astro';
import ProductCard from '../components/ProductCard.astro';
import { SITE } from '../data/site';
import { ADVANTAGES as advantages, FAQS as faqs } from '../data/content';
import { SILOS, BRANDS, BRAND_CLASSES, brandsByClass, siloPath, categoryPath, ALL_CATEGORIES } from '../data/taxonomy';
import { getQuickSuggestions, QUICK_LINKS_LABEL } from '../data/popular-searches';
import { getStorefront } from '../lib/storefront';
import { getAvailableDatasheets } from '../lib/datasheets';

const storefront = await getStorefront();
const quickSuggestions = getQuickSuggestions();
const datasheets = getAvailableDatasheets();
const featuredDatasheets = datasheets.slice(0, 2);

const title = 'قطعات جرثقیل سقفی | تامین تخصصی با تضمین اصالت — کرین یدک';
const description = `تامین تخصصی قطعات جرثقیل سقفی در ${ALL_CATEGORIES.length} دسته و ${BRANDS.length} برند: ریموت کنترل، شین برق‌رسان، موتور گیربکس، چرخ، ترمز و جاروبک. جستجو با کد فنی، بررسی سازگاری و صدور فاکتور رسمی.`;

// sameAs محلی فقط با لینک واقعی — لینک خالی بی‌ارزش است.
const localSameAs = [SITE.social.googleBusinessProfile, SITE.social.neshan, SITE.social.balad].filter(
  (url): url is string => Boolean(url)
);

// GeoCoordinates فقط با مختصات واقعی — پین اشتباه روی نقشه بدتر از نبود پین است.
const geoCoordinates =
  SITE.geo.lat !== null && SITE.geo.lng !== null
    ? { '@type': 'GeoCoordinates', latitude: SITE.geo.lat, longitude: SITE.geo.lng }
    : undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['LocalBusiness', 'HardwareStore'],
      '@id': `${SITE.url}/#organization`,
      name: SITE.name,
      legalName: SITE.legalName,
      url: SITE.url,
      areaServed: 'IR',
      knowsAbout: ALL_CATEGORIES.map((c) => c.keyword),
      logo: { '@type': 'ImageObject', '@id': `${SITE.url}/#logo`, url: `${SITE.url}/logo.png`, width: 512, height: 512, caption: SITE.name },
      image: { '@id': `${SITE.url}/#logo` },
      description: SITE.description,
      inLanguage: SITE.locale,
      address: {
        '@type': 'PostalAddress',
        streetAddress: SITE.address.street,
        addressLocality: SITE.address.city,
        addressRegion: SITE.address.region,
        postalCode: SITE.address.postalCode,
        addressCountry: SITE.address.country,
      },
      ...(geoCoordinates ? { geo: geoCoordinates } : {}),
      openingHoursSpecification: SITE.hours.map((h) => ({
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: h.dayOfWeek,
        opens: h.opens,
        closes: h.closes,
      })),
      contactPoint: { '@type': 'ContactPoint', telephone: SITE.phone, contactType: 'sales', areaServed: 'IR', availableLanguage: ['fa', 'en'] },
      sameAs: [SITE.social.instagram, ...localSameAs],
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      url: SITE.url,
      name: SITE.name,
      publisher: { '@id': `${SITE.url}/#organization` },
      inLanguage: SITE.locale,
      potentialAction: {
        '@type': 'SearchAction',
        target: { '@type': 'EntryPoint', urlTemplate: `${SITE.url}/search?q={search_term_string}` },
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'WebPage',
      '@id': `${SITE.url}/#webpage`,
      url: `${SITE.url}/`,
      name: title,
      description,
      isPartOf: { '@id': `${SITE.url}/#website` },
      about: [
        { '@id': `${SITE.url}/#organization` },
        { '@type': 'Thing', name: 'Overhead Crane Parts', sameAs: 'https://en.wikipedia.org/wiki/Overhead_crane' },
      ],
      inLanguage: SITE.locale,
    },
    {
      '@type': 'FAQPage',
      '@id': `${SITE.url}/#faq`,
      isPartOf: { '@id': `${SITE.url}/#webpage` },
      mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
  ],
};
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  {/* ================================ HERO ================================ */}
  {/* بازطراحی: نسخه‌ی قبلی یک نوار جستجو روی پس‌زمینه‌ی تزئینی بود — که
      نمی‌گفت این سایت چیست، برای کیست، و چرا باید به آن اعتماد کرد.
      نسخه‌ی جدید در سه ثانیه‌ی اول سه چیز را روشن می‌کند: چه می‌فروشیم،
      برای چه کسی، و چرا قابل اتکاست. جستجو همچنان اولین اقدام است، اما
      حالا در یک زمینه‌ی معنادار قرار دارد نه در خلأ. */}
  {/* ============================== HERO ==============================
      بازطراحی کامل. چرا نسخه‌ی قبل شکست خورده بود:

      ۱) یک «لندینگ‌پیج استارتاپی» بود، نه پیشخوان فروش قطعه. هدر تیره‌ی
         بلند با pb-36، یک SVG تزئینی ۵۶۰ پیکسلی از قلاب جرثقیل با شفافیت
         ۷٪، و یک نوار جستجوی کاملاً گرد با سایه‌ی درشت. کل صفحه‌ی اول یک
         تیتر بود و یک کادر جستجو — خریدار صنعتی بعد از دیدن آن هنوز
         نمی‌دانست ما چه چیزی موجود داریم.
      ۲) SVG تزئینی صرفاً نویز بود. مدیر نگهداری نیازی ندارد به او نشان
         دهیم جرثقیل چه شکلی است؛ او آمده کد فنی‌اش را پیدا کند.
      ۳) تیتر H1 قوی‌ترین سیگنال سئوی صفحه است و صرف یک شعار شده بود
         («…نه با حدس»). حالا عبارت هدف اول می‌آید و شعار زیرمجموعه‌ی آن
         است — بدون از دست دادن لحن.

      اصل حاکم بر نسخه‌ی جدید (مک‌مستر-کار، گرینجر، فروشگاه کونه‌کرینز):
      صفحه‌ی اصلیِ یک تأمین‌کننده‌ی قطعه، یک «سطح ناوبری» است نه یک «پیام
      تبلیغاتی». هر پیکسل بالای خط تا باید مسیری به یک قطعه باشد. به همین
      دلیل ستون راست، خودِ هفت گروه فنی است — نه تصویر.
  =================================================================== */}
  <section class="relative bg-steel-900 border-b-4 border-accent" aria-labelledby="hero-heading">
    {/* بافت فلز ماشین‌کاری‌شده: یک گرادیان تکرارشونده. جایگزین SVG و
        الگوی نقطه‌ای قبلی — عملاً بدون هزینه‌ی رندر و بدون جلب توجه. */}
    <div
      class="absolute inset-0 opacity-[0.35] pointer-events-none"
      aria-hidden="true"
      style="background-image: repeating-linear-gradient(115deg, rgba(255,255,255,.035) 0 1px, transparent 1px 7px);"
    ></div>

    <div class="relative max-w-7xl mx-auto px-4 py-10 md:py-14 grid lg:grid-cols-[minmax(0,1fr)_20rem] gap-10 lg:gap-12 items-start">
      <div class="min-w-0">
        <h1 id="hero-heading" class="text-3xl md:text-4xl lg:text-[2.75rem] font-black text-white tracking-tight leading-[1.3] mb-4">
          قطعات جرثقیل سقفی
          <span class="block text-xl md:text-2xl font-bold text-steel-300 mt-2 leading-9">
            تأمین تخصصی بر اساس <span class="text-white">کد فنی</span> — نه حدس و نمونه‌برداری
          </span>
        </h1>

        <p class="text-steel-300 leading-8 mb-7 max-w-2xl">
          کد فنی، عکس پلاک دستگاه یا حتی عکس قطعه‌ی فرسوده کافی است. سازگاری را
          پیش از صدور پیش‌فاکتور بررسی می‌کنیم تا قطعه‌ی اشتباه سفارش داده نشود.
        </p>

        {/* جستجو: مستطیل با گوشه‌ی کم — «ابزار» است نه «بنر». گوشه‌ی کاملاً
            گرد و سایه‌ی ۶۰ پیکسلی قبلی، زبان بصری نرم‌افزار مصرفی بود. */}
        <form class="w-full mb-4" action="/search" method="GET" role="search">
          <label for="site-search" class="sr-only">جستجوی نام یا کد فنی قطعه</label>
          <div class="flex flex-col md:flex-row items-stretch bg-white rounded-lg p-1.5 ring-1 ring-black/20 focus-within:ring-4 focus-within:ring-accent/60 transition-shadow">
            <span class="hidden md:flex items-center px-4 text-steel-600" aria-hidden="true">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
            </span>
            <input
              id="site-search"
              type="search"
              name="q"
              placeholder="کد فنی، نام قطعه یا برند — مثال: MT318"
              class="grow bg-transparent text-steel-900 px-4 md:px-0 py-3.5 focus:outline-none text-right placeholder-steel-600 text-base font-medium w-full"
              dir="rtl"
              autocomplete="off"
              required
            />
            <button type="submit" class="w-full md:w-auto bg-accent text-white px-8 py-3.5 rounded-md font-black hover:bg-accent-ink transition-colors shrink-0 mt-1.5 md:mt-0">
              جستجو
            </button>
          </div>
        </form>

        <div class="flex flex-wrap items-center gap-2 text-sm">
          <span class="text-steel-300 shrink-0">{QUICK_LINKS_LABEL}</span>
          {quickSuggestions.map((item) => (
            <a
              href={item.href}
              class="text-steel-100 hover:text-white hover:bg-white/15 transition-colors bg-white/[0.07] px-3 py-1 rounded border border-white/15 focus:outline-none focus:ring-2 focus:ring-white/60"
            >
              {item.label}
            </a>
          ))}
        </div>
      </div>

      {/* ستون راست: ناوبری واقعی بالای خط تا.
          این همان شبکه‌ی گروه‌های فنی است که قبلاً فقط پایین صفحه و بعد از
          چند اسکرول دیده می‌شد. آوردن آن به بالا، صفحه‌ی اول را از «یک
          شعار» به «یک فهرست انبار» تبدیل می‌کند. */}
      <nav class="hidden lg:block bg-steel-800/80 rounded-lg border border-white/10 overflow-hidden" aria-labelledby="hero-silos">
        <p id="hero-silos" class="px-4 py-3 text-xs font-black text-steel-300 tracking-wide border-b border-white/10 bg-white/[0.04]">
          گروه‌های فنی
        </p>
        <ul role="list" class="divide-y divide-white/[0.07]">
          {SILOS.map((silo) => (
            <li>
              <a
                href={siloPath(silo)}
                class="flex items-center justify-between gap-3 px-4 py-2.5 text-sm text-steel-100 hover:bg-accent hover:text-white transition-colors focus:outline-none focus:bg-accent focus:text-white"
              >
                <span class="font-bold truncate">{silo.name}</span>
                <span class="text-xs tabular-nums opacity-70 shrink-0">{silo.categories.length}</span>
              </a>
            </li>
          ))}
        </ul>
        <a
          href="/categories"
          class="block px-4 py-3 text-xs font-black text-white bg-white/[0.06] hover:bg-white/15 transition-colors border-t border-white/10 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-white/60"
        >
          هر {ALL_CATEGORIES.length} دسته ←
        </a>
      </nav>
    </div>
  </section>

  {/* ============================ PART FINDER ============================ */}
  <PartFinder />

  <AuthorityStrip />

  {/* ====================== ویترین: محصولات واقعی ====================== */}
  {storefront.onSale.length > 0 && (
    <section class="bg-white px-4 py-14 border-y border-gray-100" aria-labelledby="onsale-heading">
      <div class="max-w-7xl mx-auto">
        <div class="flex flex-wrap items-end justify-between gap-4 mb-8 border-b border-gray-200 pb-4">
          <h2 id="onsale-heading" class="text-2xl md:text-3xl font-black text-crane-navy">
            قطعات دارای تخفیف
          </h2>
          <a href="/categories" class="text-sm font-bold text-crane-orange hover:underline focus:outline-none focus:ring-2 focus:ring-crane-orange rounded">مشاهده همه دسته‌ها ←</a>
        </div>
        <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6" role="list">
          {storefront.onSale.map((product, index) => (
            <li><ProductCard product={product} eager={index < 4} /></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {storefront.inStock.length > 0 && (
    <section class="bg-gray-50 px-4 py-14 border-b border-gray-100" aria-labelledby="instock-heading">
      <div class="max-w-7xl mx-auto">
        <div class="flex flex-wrap items-end justify-between gap-4 mb-8 border-b border-gray-200 pb-4">
          <h2 id="instock-heading" class="text-2xl md:text-3xl font-black text-crane-navy">موجود در انبار — ارسال سریع</h2>
          <a href="/categories" class="text-sm font-bold text-crane-orange hover:underline focus:outline-none focus:ring-2 focus:ring-crane-orange rounded">مشاهده همه ←</a>
        </div>
        <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6" role="list">
          {storefront.inStock.map((product) => (
            <li><ProductCard product={product} /></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {storefront.latest.length > 0 && (
    <section class="bg-white px-4 py-14 border-b border-gray-100" aria-labelledby="latest-heading">
      <div class="max-w-7xl mx-auto">
        <h2 id="latest-heading" class="text-2xl md:text-3xl font-black text-crane-navy mb-8 border-b border-gray-200 pb-4">تازه‌ترین قطعات افزوده‌شده</h2>
        <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6" role="list">
          {storefront.latest.map((product) => (
            <li><ProductCard product={product} /></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {/* ========================= گروه‌های قطعات (سیلو) ========================= */}
  {/* ====================== فهرست کامل دسته‌ها ======================
      قبلاً این بخش همان هفت گروه فنی را تکرار می‌کرد که حالا بالای صفحه
      هستند. تکرار هفت لینک یکسان در یک صفحه، هم برای کاربر بی‌فایده است و
      هم ارزش لینک داخلی را رقیق می‌کند.

      جایگزین: هر ۳۱ دسته، گروه‌بندی‌شده زیر سیلوی خودش. سه دستاورد هم‌زمان:
      ۱) صفحه‌ی اصلی حالا به تمام صفحات دسته لینک مستقیم دارد، نه فقط به
         هفت صفحه‌ی میانی — عمق خزش از ۳ به ۲ کاهش می‌یابد.
      ۲) چگالی واقعی: بازدیدکننده در یک نگاه می‌بیند دامنه‌ی کالا چقدر است.
      ۳) هر نام دسته خودش یک عبارت جستجوی واقعی است؛ این فهرست عملاً یک
         نقشه‌ی موضوعی از کل سایت روی قوی‌ترین صفحه‌ی دامنه است.
  =============================================================== */}
  <section class="bg-steel-50 px-4 py-16 border-b border-steel-100" aria-labelledby="silos-heading">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-wrap items-end justify-between gap-4 mb-8 border-b border-steel-300 pb-4">
        <div>
          <h2 id="silos-heading" class="text-2xl md:text-3xl font-black text-steel-900 mb-2">دسته‌بندی قطعات جرثقیل سقفی</h2>
          <p class="text-steel-600 leading-8">
            {ALL_CATEGORIES.length} دسته قطعه در {SILOS.length} گروه فنی — از روی گروه پیش بروید یا مستقیم کد فنی را جستجو کنید.
          </p>
        </div>
        <a href="/categories" class="text-sm font-bold text-accent-ink hover:underline focus:outline-none focus:ring-2 focus:ring-accent rounded">
          فهرست کامل ←
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-8">
        {SILOS.map((silo) => (
          <div class="min-w-0">
            <h3 class="flex items-center gap-2 pb-2 mb-3 border-b-2 border-steel-900">
              <span class="w-7 h-7 shrink-0 text-accent-ink" aria-hidden="true">
                <svg class="w-full h-full" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d={silo.icon} />
                </svg>
              </span>
              <a href={siloPath(silo)} class="font-black text-steel-900 text-sm leading-6 hover:text-accent-ink focus:outline-none focus:ring-2 focus:ring-accent rounded">
                {silo.name}
              </a>
            </h3>
            <ul role="list" class="space-y-1.5">
              {silo.categories.map((category) => (
                <li>
                  <a
                    href={categoryPath({ ...category, silo })}
                    class="block text-sm text-steel-700 leading-6 hover:text-accent-ink hover:underline focus:outline-none focus:ring-2 focus:ring-accent rounded"
                  >
                    {category.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white px-4 py-16 border-b border-gray-100" aria-labelledby="advantages-heading">
    <div class="max-w-7xl mx-auto">
      <h2 id="advantages-heading" class="text-2xl md:text-3xl font-black text-crane-navy mb-10 text-center">چرا کرین یدک</h2>
      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6" role="list">
        {advantages.map((item) => (
          <li class="bg-gray-50 rounded-2xl border border-gray-100 p-7 text-center flex flex-col items-center">
            <span class="w-14 h-14 bg-orange-50 text-crane-orange rounded-2xl flex items-center justify-center mb-5" aria-hidden="true">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d={item.icon} /></svg>
            </span>
            <h3 class="font-black text-crane-navy mb-2 leading-7">{item.title}</h3>
            <p class="text-sm text-gray-700 leading-7">{item.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* =============================== برندها =============================== */}
  <section class="bg-gray-50 px-4 py-16 border-b border-gray-100" aria-labelledby="brands-heading">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-wrap items-end justify-between gap-4 mb-8 border-b border-gray-200 pb-4">
        <div>
          <h2 id="brands-heading" class="text-2xl md:text-3xl font-black text-crane-navy mb-2">برندهای تحت پوشش</h2>
          <p class="text-gray-600 leading-8">روی یک جرثقیل معمولاً بدنه، سیستم کنترل و تجهیزات برقی از سه سازنده‌ی متفاوت‌اند.</p>
        </div>
        <a href="/brands" class="text-sm font-bold text-crane-orange hover:underline focus:outline-none focus:ring-2 focus:ring-crane-orange rounded">همه برندها ←</a>
      </div>

      <div class="space-y-8">
        {(['oem', 'control'] as const).map((brandClass) => (
          <div>
            <h3 class="text-sm font-black text-gray-700 mb-4">{BRAND_CLASSES[brandClass].name}</h3>
            <ul class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4" role="list">
              {brandsByClass(brandClass).map((brand) => (
                <li>
                  <a href={`/brands/${brand.slug}`} class="group h-full bg-white p-5 rounded-2xl border border-gray-100 hover:border-orange-100 hover:shadow-md transition-all flex flex-col items-center text-center focus:outline-none focus:ring-4 focus:ring-crane-orange/30">
                    <span class="text-xs font-black tracking-wider text-crane-navy group-hover:text-crane-orange transition-colors uppercase" dir="ltr">{brand.nameEn}</span>
                    <span class="text-sm font-bold text-gray-700 mt-1">{brand.nameFa}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ============================ اسناد فنی ============================ */}
  <section class="bg-crane-light px-4 py-16 border-b border-gray-100" aria-labelledby="datasheet-heading">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-start justify-between gap-12">
      <div class="md:w-1/2">
        <h2 id="datasheet-heading" class="text-2xl md:text-3xl font-black text-crane-navy mb-4">
          {featuredDatasheets.length > 0 ? 'مرجع دانلود اسناد فنی و کاتالوگ‌ها' : 'نقشه‌ها و اسناد فنی قطعات'}
        </h2>
        <p class="text-gray-700 leading-8 text-right">
          {featuredDatasheets.length > 0
            ? 'دسترسی مستقیم به نقشه‌های انفجاری (Exploded Views)، هندبوک‌های نگهداری و فایل‌های PDF ابعاد قطعات برندهای معتبر.'
            : 'برای شناسایی دقیق قطعه، نقشه‌ی انفجاری، دیاگرام وایرینگ یا هندبوک نگهداری مدل دستگاه خود را از کارشناسان فنی ما درخواست کنید.'}
        </p>
      </div>

      <div class="md:w-1/2 w-full flex flex-col gap-6">
        {featuredDatasheets.length > 0 ? (
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {featuredDatasheets.map((doc) => (
              <a href={doc.file} target="_blank" rel="noopener noreferrer" aria-label={`دانلود ${doc.title} با حجم ${doc.size}`} class="flex items-center gap-4 bg-white p-4 rounded-2xl border border-gray-200 hover:border-crane-orange hover:shadow-md transition-all group focus:outline-none focus:ring-4 focus:ring-crane-orange/30">
                <span class="bg-red-50 text-red-500 p-3 rounded-xl shrink-0 group-hover:bg-red-500 group-hover:text-white transition-colors" aria-hidden="true"><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v11m0 5l4.879-4.879m0 0a3 3 0 104.243-4.242 3 3 0 00-4.243 4.242z"></path></svg></span>
                <div><h3 class="font-bold text-gray-800 text-sm line-clamp-1">{doc.title}</h3><span class="text-xs text-gray-600" dir="ltr">{doc.ext} — {doc.size}</span></div>
              </a>
            ))}
          </div>
        ) : (
          <div class="bg-white p-6 rounded-2xl border border-gray-200">
            <p class="text-sm text-gray-700 leading-7">
              اسنادی که اجازه‌ی بازنشر عمومی داشته باشند به‌تدریج منتشر می‌شوند. تا آن زمان، درخواست سند برای یک مدل مشخص از طریق کارشناسان فنی انجام می‌شود.
            </p>
          </div>
        )}
        <div class="flex flex-wrap gap-6 border-t border-gray-200 pt-4">
          <a href="/datasheets" class="inline-flex items-center gap-2 text-crane-orange font-bold hover:text-orange-800 transition-colors group focus:outline-none focus:ring-2 focus:ring-crane-orange focus:ring-offset-2 rounded">
            <svg aria-hidden="true" class="w-5 h-5 rtl:rotate-180 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
            ورود به آرشیو اسناد فنی
          </a>
          <a href="/contact" class="inline-flex items-center gap-2 text-crane-navy font-bold hover:text-crane-orange transition-colors focus:outline-none focus:ring-2 focus:ring-crane-navy focus:ring-offset-2 rounded">
            درخواست سند فنی مدل خاص
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* ================================ FAQ ================================ */}
  <section class="bg-white px-4 py-16" aria-labelledby="faq-heading">
    <div class="max-w-4xl mx-auto">
      <h2 id="faq-heading" class="text-2xl md:text-3xl font-black text-crane-navy mb-10 text-center">پرسش‌های متداول فنی</h2>
      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="group bg-gray-50 rounded-2xl border border-gray-100 overflow-hidden">
            <summary class="cursor-pointer list-none px-6 py-5 font-bold text-crane-navy flex items-center justify-between gap-4 hover:bg-gray-100 transition-colors focus:outline-none focus-visible:ring-4 focus-visible:ring-crane-orange/30">
              <span class="leading-8">{faq.q}</span>
              <svg class="w-5 h-5 shrink-0 text-crane-orange transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <div class="px-6 pb-6 text-gray-700 leading-8 text-right prose-crane" set:html={faq.a} />
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>

                <svg class="w-5 h-5 text-crane-orange transition-transform duration-300 group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
              </span>
            </summary>
            <p class="px-6 pb-6 text-gray-600 leading-8 text-sm md:text-base text-right border-t border-gray-100 pt-4 mt-2 mx-2" set:html={faq.a}></p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-crane-navy py-20 px-4" aria-labelledby="cta-heading">
    <div class="max-w-3xl mx-auto text-center">
      <h2 id="cta-heading" class="text-3xl md:text-4xl font-black text-white mb-5">قطعه‌ی مورد نظرتان را پیدا نکردید؟</h2>
      <p class="text-gray-300 text-lg leading-8 mb-10 text-center">مشخصات، کد فنی یا حتی عکس قطعه را برای ما بفرستید. کارشناس فنی ما امکان تامین و زمان تحویل را بررسی و اعلام می‌کند.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact" class="bg-crane-orange text-white px-10 py-4 rounded-full font-bold text-lg hover:bg-orange-800 transition-all transform hover:-translate-y-1 focus:outline-none focus:ring-4 focus:ring-crane-orange/50">ثبت درخواست استعلام</a>
        <a href={`tel:${SITE.phone}`} class="bg-white/10 backdrop-blur-lg border border-white/20 text-white px-10 py-4 rounded-full font-bold text-lg hover:bg-white/20 transition-all transform hover:-translate-y-1 focus:outline-none focus:ring-4 focus:ring-white/50">تماس مستقیم: {SITE.phoneDisplay}</a>
      </div>
    </div>
  </section>
</Layout>
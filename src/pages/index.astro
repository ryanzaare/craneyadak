---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import { CATEGORIES, ENRICHED_BRANDS, SITE } from '../data/site';
import { ADVANTAGES as advantages, FAQS as faqs, INDUSTRIES as industries } from '../data/content';
import { getAvailableDatasheets } from '../lib/datasheets';

// نکته صداقت داده: فقط اسنادی که فایل PDF واقعی‌شان در public/ موجود است.
// پیش‌تر این‌جا طول آرایه‌ی خام DATASHEETS شمرده می‌شد و صفحه‌ی اصلی «+۶ سند
// قابل دانلود» را تبلیغ می‌کرد در حالی که هیچ‌کدام از آن شش فایل وجود
// نداشت — یعنی هم آمار نادرست بود و هم هر دو کارت دانلود ۴۰۴ می‌دادند.
const datasheets = getAvailableDatasheets();
const featuredDatasheets = datasheets.slice(0, 2);

// نکته صداقت داده (E-E-A-T): این آمار به‌عمد به‌جای اعداد ادعایی و غیرقابل
// اثبات (مثل «+۱۰۰۰۰ مشتری راضی» یا نشان اعتماد ساختگی) مستقیماً از طول
// آرایه‌های واقعی محتوا (تک منبع حقیقت در src/data) محاسبه می‌شود. اگر فردا
// دسته یا برند جدیدی اضافه شود، این عدد بدون نیاز به ویرایش دستی به‌روز
// می‌ماند و هرگز با واقعیت سایت واگرا نمی‌شود. آمار اسناد فنی هم فقط وقتی
// نمایش داده می‌شود که واقعاً فایلی برای دانلود وجود داشته باشد.
const trustStats = [
  { value: `+${CATEGORIES.length}`, label: 'دسته‌بندی تخصصی قطعات' },
  { value: `+${ENRICHED_BRANDS.length}`, label: 'برند جهانی تحت پوشش' },
  { value: `${industries.length}`, label: 'صنعت هدف (فولاد، پتروشیمی، معادن)' },
  ...(datasheets.length > 0
    ? [{ value: `+${datasheets.length}`, label: 'سند و کاتالوگ فنی قابل دانلود' }]
    : [{ value: `${faqs.length}`, label: 'پرسش فنی پاسخ‌داده‌شده توسط کارشناسان' }]),
];

const title = 'قطعات جرثقیل سقفی | تامین تخصصی با تضمین اصالت — کرین یدک';
const description = 'تامین تخصصی قطعات جرثقیل سقفی: ریموت کنترل، شین، چرخ، جاروبک، قلاب و دیسک ترمز. جستجو بر اساس نام قطعه، برند یا کد فنی با تضمین اصالت و ارسال به سراسر ایران.';

// نکته سئوی محلی (Local SEO): sameAs محلی (نشان/بلد/گوگل بیزینس پروفایل) فقط
// وقتی به اسکیما اضافه می‌شود که SITE.social مقدار واقعی (غیرخالی) داشته
// باشد — لینک خالی در sameAs بی‌ارزش/نامعتبر است و بهتر از نبودنش نیست.
const localSameAs = [SITE.social.googleBusinessProfile, SITE.social.neshan, SITE.social.balad].filter(
  (url): url is string => Boolean(url)
);

// GeoCoordinates فقط وقتی ساخته می‌شود که مختصات واقعی (نه null) در
// SITE.geo موجود باشد — نگاه کنید به کامنت TODO در src/data/site.ts.
const geoCoordinates =
  SITE.geo.lat !== null && SITE.geo.lng !== null
    ? { '@type': 'GeoCoordinates', latitude: SITE.geo.lat, longitude: SITE.geo.lng }
    : undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      // نکته سئو: «B2BBusiness» یک نوع رسمی schema.org نیست (بررسی شد:
      // schema.org/B2BBusiness نتیجه‌ی 404 برمی‌گرداند) و باعث خطای
      // "Unrecognized type" در Rich Results Test می‌شد. LocalBusiness +
      // HardwareStore هر دو نوع معتبر و رسمی هستند؛ ماهیت B2B از طریق
      // priceRange، knowsAbout و محتوای صفحه (نه یک تایپ جعلی) بیان می‌شود.
      '@type': ['LocalBusiness', 'HardwareStore'],
      '@id': `${SITE.url}/#organization`,
      name: SITE.name,
      legalName: SITE.legalName,
      url: SITE.url,
      // نکته صداقت داده: کلید `priceRange` حذف شد. مقدار قبلی `'$$$'` یک
      // ادعای غیرقابل‌اثبات درباره‌ی سطح قیمت بود، در حالی که سایت اصلاً
      // قیمتی منتشر نمی‌کند (همه‌ی اقلام استعلامی‌اند). این فیلد اختیاری
      // است و حذف آن هیچ خطای اسکیما ایجاد نمی‌کند؛ درج یک مقدار حدسی
      // اما هم گمراه‌کننده است و هم می‌تواند خریدار B2B را پیشاپیش دلسرد کند.
      areaServed: 'IR',
      knowsAbout: CATEGORIES.map((c) => c.keyword),
      logo: { '@type': 'ImageObject', '@id': `${SITE.url}/#logo`, url: `${SITE.url}/logo.png`, width: 512, height: 512, caption: SITE.name },
      image: { '@id': `${SITE.url}/#logo` },
      description: SITE.description,
      inLanguage: SITE.locale,
      address: {
        '@type': 'PostalAddress',
        streetAddress: SITE.address.street,
        addressLocality: SITE.address.city,
        addressRegion: SITE.address.region,
        postalCode: SITE.address.postalCode,
        addressCountry: SITE.address.country,
      },
      // نکته سئوی محلی: تا وقتی SITE.geo مقدار واقعی نداشته باشد، این کلید
      // اصلاً به آبجکت اضافه نمی‌شود (به‌جای فرستادن یک مختصات جعلی که
      // پین اشتباه روی نقشه‌ی گوگل/نتایج محلی می‌سازد).
      ...(geoCoordinates ? { geo: geoCoordinates } : {}),
      // نکته سئوی محلی: openingHoursSpecification دقیقاً همان ساعات کاری‌ای
      // است که در contact.astro به‌صورت متن نمایش داده می‌شود (تک منبع
      // حقیقت: SITE.hours) — بدون این کلید، ساعات کاری فقط برای انسان
      // قابل‌خواندن است، نه برای الگوریتم رتبه‌بندی محلی گوگل.
      openingHoursSpecification: SITE.hours.map((h) => ({
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: h.dayOfWeek,
        opens: h.opens,
        closes: h.closes,
      })),
      contactPoint: { '@type': 'ContactPoint', telephone: SITE.phone, contactType: 'sales', areaServed: 'IR', availableLanguage: ['fa', 'en'] },
      // نکته سئو: sameAs فقط باید به پروفایل‌های خودِ این کسب‌وکار اشاره کند
      // (شبکه‌های اجتماعی، ویکی‌پدیای مربوط به برند و...)، نه به یک مقاله‌ی
      // عمومی درباره‌ی "جرثقیل سقفی". آن ارجاع در پایین‌تر، در WebPage.about
      // به‌درستی استفاده شده چون آنجا درباره‌ی موضوع صفحه است، نه هویت شرکت.
      // نشان و بلد (localSameAs) فقط با لینک واقعی اضافه می‌شوند — نگاه
      // کنید به کامنت TODO سئوی محلی در src/data/site.ts.
      sameAs: [SITE.social.instagram, ...localSameAs],
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      url: SITE.url,
      name: SITE.name,
      publisher: { '@id': `${SITE.url}/#organization` },
      inLanguage: SITE.locale,
      potentialAction: { '@type': 'SearchAction', target: { '@type': 'EntryPoint', urlTemplate: `${SITE.url}/search?q={search_term_string}` }, 'query-input': 'required name=search_term_string' },
    },
    {
      '@type': 'WebPage',
      '@id': `${SITE.url}/#webpage`,
      url: `${SITE.url}/`,
      name: title,
      description,
      isPartOf: { '@id': `${SITE.url}/#website` },
      about: [
        { '@id': `${SITE.url}/#organization` },
        { '@type': 'Thing', name: 'Overhead Crane Parts', sameAs: 'https://en.wikipedia.org/wiki/Overhead_crane' }
      ],
      inLanguage: SITE.locale,
    },
    {
      '@type': 'FAQPage',
      '@id': `${SITE.url}/#faq`,
      isPartOf: { '@id': `${SITE.url}/#webpage` },
      mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
  ],
};
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <!-- HERO Section -->
  <section class="relative flex flex-col items-center overflow-hidden bg-crane-navy border-b-[8px] border-crane-orange px-4 pt-28 md:pt-36 pb-32 md:pb-48" aria-labelledby="hero-heading">
    <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
      <div class="absolute inset-0 opacity-[0.12]" style="background-image: radial-gradient(#fff 1.5px, transparent 1.5px); background-size: 32px 32px;" aria-hidden="true"></div>
      <svg class="absolute -left-32 md:left-4 top-12 w-[400px] md:w-[650px] h-[400px] md:h-[650px] text-white opacity-[0.15] transform -rotate-6" viewBox="0 0 500 600" fill="none" stroke="currentColor" aria-hidden="true">
        <circle cx="250" cy="150" r="85" stroke-width="4" stroke-dasharray="8 4"/><circle cx="250" cy="150" r="70" stroke-width="2"/><circle cx="250" cy="150" r="20" stroke-width="6"/>
        <path d="M 140 150 L 140 270 C 140 330, 360 330, 360 270 L 360 150" stroke-width="5"/>
        <path d="M 250 350 V 380 C 250 420, 160 440, 160 510 C 160 580, 280 600, 340 550 C 380 510, 350 450, 310 460 C 270 470, 240 490, 230 460 C 220 430, 270 410, 280 380" stroke-width="18" stroke-linecap="round"/>
      </svg>
      <svg class="absolute -right-32 md:right-4 top-24 w-[350px] md:w-[550px] h-[350px] md:h-[550px] text-white opacity-[0.15] transform rotate-12" viewBox="0 0 500 600" fill="none" stroke="currentColor" aria-hidden="true">
        <rect x="150" y="150" width="200" height="380" rx="25" stroke-width="5"/><rect x="165" y="165" width="170" height="350" rx="15" stroke-width="2" opacity="0.5"/>
        <circle cx="300" cy="230" r="25" stroke-width="4"/><circle cx="200" cy="310" r="18" stroke-width="3"/><circle cx="300" cy="310" r="18" stroke-width="3"/>
      </svg>
      <div class="absolute inset-0 bg-gradient-to-r from-crane-navy/40 via-crane-navy/80 to-crane-navy/40" aria-hidden="true"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-crane-navy via-transparent to-transparent" aria-hidden="true"></div>
    </div>

    <div class="relative z-10 text-center w-full max-w-[1200px] mx-auto px-2">
      <h1 id="hero-heading" class="text-4xl md:text-5xl lg:text-6xl font-black text-white mb-6 tracking-tight leading-tight drop-shadow-lg">
        تامین تخصصی <span class="text-crane-orange">قطعات جرثقیل سقفی</span>
      </h1>
      <p class="text-gray-200 text-lg md:text-xl lg:text-2xl mb-12 font-light drop-shadow-md">
        جستجو بر اساس نام قطعه، برند سازنده یا کد فنی (SKU)
      </p>

      <form class="w-full max-w-5xl mx-auto mb-8 relative group" action="/search" method="GET" role="search">
        <label for="site-search" class="sr-only">جستجوی نام یا کد فنی قطعه</label>
        <div class="flex flex-col md:flex-row items-center bg-white rounded-2xl md:rounded-full p-2 shadow-[0_20px_50px_rgba(0,0,0,0.4)] focus-within:ring-4 focus-within:ring-crane-orange/30 transition-all duration-300">
          <span class="hidden md:flex pl-4 pr-6 text-gray-400" aria-hidden="true">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
          </span>
          <input id="site-search" type="search" name="q" placeholder="مثال: موتور گیربکس حرکت طولی دماگ مدل KBA-71" class="flex-grow bg-transparent text-gray-800 px-6 md:px-2 py-4 md:py-5 focus:outline-none text-right placeholder-gray-400 text-lg font-medium w-full" dir="rtl" autocomplete="off" required />
          <button type="submit" aria-label="شروع جستجو در قطعات" class="w-full md:w-auto bg-crane-orange text-white px-12 py-4 md:py-5 rounded-xl md:rounded-full font-bold text-lg hover:bg-orange-800 transition-colors shadow-md mt-2 md:mt-0">جستجو در فروشگاه</button>
        </div>
      </form>

      <div class="flex flex-wrap justify-center items-center gap-3 text-sm font-medium">
        <span class="text-gray-400 drop-shadow-sm">بیشترین جستجوها:</span>
        <a href="/categories/remote-control" class="text-gray-300 hover:text-white hover:bg-white/20 transition-colors bg-white/10 px-4 py-1.5 rounded-full border border-white/10 backdrop-blur-sm">ریموت تله‌کرین</a>
        <a href="/categories/conductor-bar" class="text-gray-300 hover:text-white hover:bg-white/20 transition-colors bg-white/10 px-4 py-1.5 rounded-full border border-white/10 backdrop-blur-sm">شین برق‌رسان دماگ</a>
        <a href="/categories/crane-wheels" class="text-gray-300 hover:text-white hover:bg-white/20 transition-colors bg-white/10 px-4 py-1.5 rounded-full border border-white/10 backdrop-blur-sm">چرخ راهبر فولادی</a>
      </div>
    </div>
  </section>

  <!-- Rapid Part-Finder -->
  <section class="bg-gray-50 px-4 relative z-20" aria-label="ابزار جستجوی سریع قطعات">
    <div class="max-w-5xl mx-auto bg-white rounded-3xl shadow-xl p-6 md:p-8 border border-gray-100 -mt-20 md:-mt-24 mb-12">
      <div class="flex flex-col md:flex-row items-center gap-4 mb-6 border-b border-gray-100 pb-4">
        <span class="bg-crane-navy text-white p-3 rounded-xl shadow-md" aria-hidden="true">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 21h7a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v11m0 5l4.879-4.879m0 0a3 3 0 104.243-4.242 3 3 0 00-4.243 4.242z"></path></svg>
        </span>
        <h2 class="text-xl md:text-2xl font-black text-crane-navy">ابزار جستجوی سریع قطعات (Part-Finder)</h2>
        <p class="text-sm text-gray-500 md:mr-auto">ویژه استعلام کدهای فنی دقیق</p>
      </div>
      <form action="/search" method="GET" class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div class="md:col-span-1">
          <label class="sr-only" for="brand-select">برند سازنده</label>
          <select id="brand-select" name="brand" class="w-full bg-gray-50 border border-gray-200 text-gray-700 rounded-xl px-4 py-3.5 focus:outline-none focus:ring-2 focus:ring-crane-orange focus:border-transparent font-medium cursor-pointer">
            <option value="">انتخاب برند...</option>
            <option value="demag">دماگ (Demag)</option>
            <option value="stahl">اشتال (Stahl)</option>
            <option value="konecranes">کونه کرین (Konecranes)</option>
            <option value="telecrane">تله کرین (Telecrane)</option>
          </select>
        </div>
        <div class="md:col-span-1">
          <label class="sr-only" for="category-select">نوع قطعه</label>
          <select id="category-select" name="cat" class="w-full bg-gray-50 border border-gray-200 text-gray-700 rounded-xl px-4 py-3.5 focus:outline-none focus:ring-2 focus:ring-crane-orange focus:border-transparent font-medium cursor-pointer">
            <option value="">نوع قطعه...</option>
            <option value="hoist">موتور گیربکس / وینچ</option>
            <option value="electrical">تجهیزات برق‌رسان (شین)</option>
            <option value="mechanical">مکانیکال (چرخ و قلاب)</option>
            <option value="control">ریموت و کنترلر</option>
          </select>
        </div>
        <div class="md:col-span-1">
          <label class="sr-only" for="part-number">کد فنی قطعه</label>
          <input id="part-number" type="text" name="pn" placeholder="کد فنی (PN) را وارد کنید..." class="w-full bg-gray-50 border border-gray-200 text-gray-700 rounded-xl px-4 py-3.5 focus:outline-none focus:ring-2 focus:ring-crane-orange focus:border-transparent font-medium text-left dir-ltr" />
        </div>
        <div class="md:col-span-1">
          <button type="submit" class="w-full bg-crane-navy text-white rounded-xl px-4 py-3.5 font-bold hover:bg-gray-800 transition-colors flex items-center justify-center gap-2">
            <span>یافتن قطعه</span>
            <svg aria-hidden="true" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
          </button>
        </div>
      </form>
    </div>
  </section>

  <!-- Trust / Stats Strip -->
  <section class="bg-gray-50 pb-14 px-4 md:px-12 lg:px-20" aria-label="آمار پوشش تخصصی کرین یدک">
    <ul class="max-w-7xl mx-auto grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
      {trustStats.map((stat) => (
        <li class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5 md:p-7 text-center">
          <span class="block text-3xl md:text-4xl font-black text-crane-orange mb-1.5">{stat.value}</span>
          <span class="block text-xs md:text-sm font-bold text-gray-500 leading-6">{stat.label}</span>
        </li>
      ))}
    </ul>
  </section>

  <!-- Advantages -->
  <section class="bg-gray-50 pb-14 px-4 md:px-12 lg:px-20 border-b border-gray-200" aria-labelledby="advantages-heading">
    <h2 id="advantages-heading" class="sr-only">مزیت‌های خرید از کرین یدک</h2>
    <ul class="max-w-7xl mx-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      {advantages.map((item) => (
        <li class="flex items-start gap-4">
          <span class="shrink-0 w-12 h-12 rounded-xl bg-orange-50 text-crane-orange flex items-center justify-center" aria-hidden="true">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d={item.icon}/></svg>
          </span>
          <div>
            <h3 class="font-bold text-crane-navy mb-1">{item.title}</h3>
            <p class="text-sm text-gray-600 leading-6 text-right">{item.body}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <!-- Branding -->
  <article class="bg-crane-light py-20 px-4 md:px-12 lg:px-20" aria-labelledby="branding-heading">
    <div class="max-w-7xl mx-auto flex flex-col lg:flex-row items-start gap-12 lg:gap-16">
      <div class="lg:w-3/5 space-y-8 text-gray-700 leading-[2.2] text-base md:text-lg text-right">
        <h2 id="branding-heading" class="text-3xl md:text-4xl font-black text-crane-navy mb-6">
          مرجع خرید قطعات جرثقیل سقفی؛<br/><span class="text-crane-orange mt-2 block">پیشگیری از توقف خطوط تولید</span>
        </h2>
        <p>توقف یک جرثقیل سقفی یعنی فلج شدن کل خط تولید. در صنایع سنگین، هزینه‌ی واقعی خرابی دستگاه، قیمت خود قطعه نیست؛ بلکه خسارت سنگینِ ساعت‌هایی است که سالن تولید بی‌کار می‌ماند. ما در <strong class="text-crane-navy font-black">کرین یدک</strong>، تخصصی‌ترین مرجع تامین و <strong class="text-crane-navy font-black">خرید لوازم یدکی جرثقیل سقفی</strong> در ایران هستیم و تنها یک رسالت داریم: رساندن زمان توقف (Down-time) تجهیزاتِ شما به صفر.</p>
        <p>موجودی انبار و شبکه‌ی تامین بی‌واسطه‌ی ما، مجموعه‌ای کامل از <strong>تجهیزات بالابر صنعتی</strong> را پوشش می‌دهد؛ از قطعات مکانیکی مانند انواع <a href="/categories/crane-wheels" class="text-crane-orange font-black hover:underline transition-all">چرخ راهبر و کلگی</a>، وینچ و <a href="/categories/wire-rope-hoist" class="text-crane-orange font-black hover:underline transition-all">موتور گیربکس</a> گرفته تا اقلام الکتریکی شامل <a href="/categories/conductor-bar" class="text-crane-orange font-black hover:underline transition-all">شین‌های برق‌رسان</a> و <a href="/categories/remote-control" class="text-crane-orange font-black hover:underline transition-all">ریموت کنترل جرثقیل</a>.</p>
        <p>اگر کد فنی (Part Number) قطعه را در اختیار ندارید، جای نگرانی نیست. از مشاوره‌ی تخصصی تا تضمین ۱۰۰ درصدی اصالت کالا و حتی تامین <strong class="text-crane-navy font-black">اقلام توقف‌تولید (Obsolete)</strong>، ما در تمام مراحل کنار واحد نت کارخانه‌ی شما ایستاده‌ایم.</p>

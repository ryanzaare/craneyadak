---
// src/pages/index.astro
// ---------------------------------------------------------------------------
// صفحه‌ی اصلی — ویترین فروشگاه.
//
// سه تغییر بنیادی نسبت به نسخه‌ی قبل:
//
// ۱) داده‌ی ساختگی حذف شد. برچسب «بیشترین جستجوها» بالای سه لینک دست‌نویس
//    یک ادعای آماری بی‌پشتوانه بود — همان دسته از تخلفی که کد فنی جعلی و
//    حجم فایل دستی بودند. جایگزین: برچسب صادقانه + مقصدهای واقعی
//    (src/data/popular-searches.ts).
//
// ۲) نوار «آمار» حذف شد. «+۸ دسته‌بندی» و «۸ پرسش پاسخ‌داده‌شده» شمارش
//    محتوای خودِ سایت بود، نه دستاورد؛ برای مدیر خرید صنعتی بی‌معناست و
//    عملاً کوچک‌بودن را تبلیغ می‌کرد. مزیت‌های واقعی همان پایین در بخش
//    «چرا کرین یدک» هستند (از وردپرس؛ src/lib/site-options.ts).
//
// ۳) محصولات واقعی روی صفحه آمدند. قبلاً صفحه‌ی اصلی هیچ کالایی نشان
//    نمی‌داد و حس «انبار خالی» می‌داد. اگر محصول واقعی نباشد، بخش‌ها اصلاً
//    رندر نمی‌شوند — نه این‌که با کارت ساختگی پر شوند.
//
// ۴) Frontend v2 فاز ۳ صفحه را به پنج بلوک کوتاه کرد (تصمیم D: فقط دسته‌های دارای کالا). کارفرما ۳ آبان ۱۴۰۵ این را
//    لغو کرد — «صفحه خیلی کوتاه و خالی شد»: هر ۷ گروه و ۳۱ دسته، قطعات پرتعویض، مزیت‌ها و ۱۸ برند برگشتند، این بار
//    در زبان بصری v2 (شبکه‌ی خط مو `gap-px bg-steel-200`، ریل ۴px). ترتیب: هیرو بنتو → ۷ گروه/۳۱ دسته → کالاهای واقعی →
//    پرتعویض → مزیت‌ها → برندها → فرایند خرید سازمانی → نوار اعتماد → AuthorityBlock → FAQ.
//    ⚠️ FAQ و AuthorityBlock همیشه می‌مانند: FAQPage در JSON-LD بدون پرسش‌های *دیدنی* خلاف سیاست گوگل است.
//    ⚠️ ارقام شمارش (۳۱، ۱۸، ۷) همه از داده و با fa() — هرگز عدد دستی؛ اگر برندی در وردپرس افزوده شود، عدد خودش عوض می‌شود.
//
// تفکیک نیت (ضد هم‌نوع‌خواری): این صفحه مالک عبارت اصلی
// «قطعات جرثقیل سقفی» است. صفحه‌ی /categories عمداً همین عبارت را هدف
// نمی‌گیرد و نیت «مرور کاتالوگ» را می‌گیرد.
// ---------------------------------------------------------------------------
import Layout from '../layouts/Layout.astro';
import SearchBox from '../components/SearchBox.astro';
import AuthorityBlock from '../components/AuthorityBlock.astro';
import ProductCard from '../components/ProductCard.astro';
import { mobileLine } from '../components/contact-mobile';
import { SITE } from '../data/site';
import { TRUST_BADGES, ENAMAD } from '../data/trust';
import { getFaqs, getSiteOptions, getContact, getAdvantages } from '../lib/site-options';
import { categoryPath, siloPath, ALL_CATEGORIES, SILOS, BRAND_CLASSES } from '../data/taxonomy';
import HighWearParts from '../components/HighWearParts.astro';
import { getQuickSuggestions, QUICK_LINKS_LABEL } from '../data/popular-searches';
import { getBrands } from '../lib/brands';
import { getStorefront } from '../lib/storefront';
import { computePrice, productPath } from '../lib/wp';
import { getCatalogPresence, fa } from '../components/catalog-presence';
import { hairlineGrid, hairlineCell, hairlineFillers } from '../components/hairline';

/* ⚠️ اعلان‌های داده‌ی وردپرس بلافاصله بعد از import ها.
   قبلاً انتهای فرontmatter بودند و کدِ بالاتر که از آن‌ها استفاده
   می‌کرد با «Cannot access before initialization» می‌شکست:
   `const` هویست می‌شود اما تا نقطه‌ی اعلان در ناحیه‌ی مرده‌ی
   زمانی (TDZ) است و دسترسی به آن خطا می‌دهد. */
const contact = await getContact();
const siteOptions = await getSiteOptions();
const faqs = await getFaqs();
const storefront = await getStorefront();
// یک ویترین، بی‌تکرار: تخفیف‌دار → موجود → تازه، تا ۴ قلم (با یک کالا، سه ویترین قبلی سه بار همان کارت بودند).
const featured = [...new Map([...storefront.onSale, ...storefront.inStock, ...storefront.latest].map((p) => [p.slug, p])).values()].slice(0, 4);
const presence = await getCatalogPresence();
const advantages = await getAdvantages();
const mobile = mobileLine(contact);
/* آیکن هر مزیت طراحی است، نه محتوا — با ترتیب ردیف‌های پنل جفت می‌شود؛ پنجم به بعد آیکن عمومی. */
const ADVANTAGE_ICONS = [
  'M9 12l2 2 4-4 M12 2l7 4v6c0 5-3 8-7 10-4-2-7-5-7-10V6l7-4z',
  'M8 10h8 M8 14h5 M21 12a9 9 0 11-3.5-7.1L21 3v6h-6',
  'M3 8h11v9H3z M14 11h4l3 3v3h-7z M7 20a2 2 0 100-4 2 2 0 000 4z M17 20a2 2 0 100-4 2 2 0 000 4z',
  'M11 19a8 8 0 100-16 8 8 0 000 16z M21 21l-4.3-4.3 M11 8v6 M8 11h6',
];
const GENERIC_ADVANTAGE_ICON = 'M5 13l4 4L19 7';
/* چهار مرحله‌ی خرید سازمانی + آیکن خطی هر مرحله (استعلام، پیش‌فاکتور، فاکتور مالیاتی، ارسال). */
const STEPS = [
  ['استعلام فنی', 'کد فنی، عکس پلاک یا فهرست اقلام را بفرستید؛ سازگاری پیش از قیمت‌دهی بررسی می‌شود.', 'M11 19a8 8 0 100-16 8 8 0 000 16z M21 21l-4.3-4.3'],
  ['پیش‌فاکتور رسمی', 'قیمت روز و وضعیت تأمین هر قلم در یک پیش‌فاکتور.', 'M7 3h7l5 5v13H7z M14 3v5h5 M10 13h6 M10 17h6'],
  ['تایید و فاکتور مالیاتی', 'پس از تایید و پرداخت، فاکتور رسمی و مالیاتی در صورت درخواست صادر می‌شود.', 'M6 3h12v18l-3-2-3 2-3-2-3 2z M9 8h6 M9 12h6 M9 16h3'],
  ['ارسال سریع', 'ارسال در سریع‌ترین زمان ممکن.', 'M3 8h11v9H3z M14 11h4l3 3v3h-7z M7 20a2 2 0 100-4 2 2 0 000 4z M17 20a2 2 0 100-4 2 2 0 000 4z'],
];
const quickSuggestions = getQuickSuggestions();
// اعتماد: فقط ادعای verified (trust.ts — همان قاعده‌ی JSON-LD)؛ نشان وابسته به اصالت روی صفحه‌ی اصلی معنا ندارد.
const trust = TRUST_BADGES.filter((b) => b.verified && !b.onlyIfAuthenticity);
const waPlate = contact.whatsappHref ? `${contact.whatsappHref}?text=${encodeURIComponent('سلام، عکس پلاک قطعه را برای شناسایی می‌فرستم.')}` : null;

/* پرسش‌های متداول و مختصات/لینک‌ها از وردپرس. تا پیش از این، گروه فیلد
   `siteOptionsFields` وجود داشت اما فرانت‌اند هرگز آن را نمی‌خواند.
   (توضیح کامل در src/lib/site-options.ts) */


// برندها از وردپرس — ویترین برندها، H1 و توضیح متا.
const BRANDS = await getBrands();
const brandsByClass = (c: 'oem' | 'control' | 'electrical') => BRANDS.filter((b) => b.brandClass === c);

const title = 'قطعات جرثقیل سقفی | تامین تخصصی با تضمین اصالت — کرین یدک';
// ارقام فارسی در متا (کارفرما، ۳ آبان ۱۴۰۵) — همان شمارش، فقط نمایش.
const description = `تامین تخصصی قطعات جرثقیل سقفی در ${fa(ALL_CATEGORIES.length)} دسته و ${fa(BRANDS.length)} برند: ریموت کنترل، شین برق‌رسان، موتور گیربکس، ترمز و جاروبک. جستجو با کد فنی و فاکتور رسمی.`;

// sameAs محلی فقط با لینک واقعی — لینک خالی بی‌ارزش است.
const localSameAs = [
  siteOptions.social.instagram,
  siteOptions.social.telegram,
  siteOptions.social.googleBusinessProfile,
  siteOptions.social.neshan,
  siteOptions.social.balad,
].filter((url): url is string => Boolean(url));

// GeoCoordinates فقط با مختصات واقعی — پین اشتباه روی نقشه بدتر از نبود پین است.
const geoCoordinates =
  siteOptions.geo.lat !== null && siteOptions.geo.lng !== null
    ? { '@type': 'GeoCoordinates', latitude: siteOptions.geo.lat, longitude: siteOptions.geo.lng }
    : undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['LocalBusiness', 'HardwareStore'],
      '@id': `${SITE.url}/#organization`,
      name: SITE.name,
      legalName: SITE.legalName,
      url: SITE.url,
      areaServed: 'IR',
      knowsAbout: ALL_CATEGORIES.map((c) => c.keyword),
      logo: { '@type': 'ImageObject', '@id': `${SITE.url}/#logo`, url: `${SITE.url}/logo.png`, width: 512, height: 512, caption: SITE.name },
      image: { '@id': `${SITE.url}/#logo` },
      description: SITE.description,
      inLanguage: SITE.locale,
      // ⚠️ آدرس و تلفن فقط وقتی وارد اسکیما می‌شوند که واقعی باشند.
      //
      // انتشار NAP ساختگی در LocalBusiness، گوگل را وادار می‌کند آن را
      // با منابع دیگر تطبیق دهد و تناقض پیدا کند. این به سئوی محلی
      // آسیب واقعی می‌زند. تا ورود اطلاعات واقعی، شهر و کشور می‌مانند
      // (که درست‌اند) و خیابان، کدپستی و تلفن حذف می‌شوند.
      /* ⚠️ NAP فقط از وردپرس و فقط وقتی واقعی باشد.
         مقادیر ساختگی قبلی (۰۲۱-۱۲۳۴۵۶۷۸ و کدپستی ۱۲۳۴۵۶۷۸۹۰) کاملاً
         حذف شدند. اگر مدیر سایت تلفن واقعی وارد نکرده باشد،
         `hasRealContact` غلط است و هیچ آدرس یا تلفنی وارد اسکیما
         نمی‌شود — نه جعلی، نه هیچ. */
      ...(contact.hasRealContact
        ? {
            address: {
              '@type': 'PostalAddress',
              ...(contact.street ? { streetAddress: contact.street } : {}),
              ...(contact.postalCode ? { postalCode: contact.postalCode } : {}),
              ...(contact.city ? { addressLocality: contact.city } : {}),
              ...(contact.region ? { addressRegion: contact.region } : {}),
              addressCountry: 'IR',
            },
          }
        : {}),
      ...(geoCoordinates ? { geo: geoCoordinates } : {}),
      ...(siteOptions.hours.length > 0
        ? {
            openingHoursSpecification: siteOptions.hours.map((h) => ({
              '@type': 'OpeningHoursSpecification',
              dayOfWeek: h.dayOfWeek,
              opens: h.opens,
              closes: h.closes,
            })),
          }
        : {}),
      ...(contact.phonePrimary
        ? {
            contactPoint: {
              '@type': 'ContactPoint',
              telephone: contact.phonePrimary,
              contactType: 'sales',
              areaServed: 'IR',
              availableLanguage: ['fa', 'en'],
            },
          }
        : {}),
      ...(localSameAs.length > 0 ? { sameAs: localSameAs } : {}),
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      url: SITE.url,
      name: SITE.name,
      publisher: { '@id': `${SITE.url}/#organization` },
      inLanguage: SITE.locale,
      potentialAction: {
        '@type': 'SearchAction',
        target: { '@type': 'EntryPoint', urlTemplate: `${SITE.url}/search?q={search_term_string}` },
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'WebPage',
      '@id': `${SITE.url}/#webpage`,
      url: `${SITE.url}/`,
      name: title,
      description,
      isPartOf: { '@id': `${SITE.url}/#website` },
      about: [
        { '@id': `${SITE.url}/#organization` },
        { '@type': 'Thing', name: 'Overhead Crane Parts', sameAs: 'https://en.wikipedia.org/wiki/Overhead_crane' },
      ],
      inLanguage: SITE.locale,
    },
    // FAQPage فقط وقتی پرسش واقعی در وردپرس ثبت شده باشد.
    ...(faqs.length > 0
      ? [
          {
            '@type': 'FAQPage',
            '@id': `${SITE.url}/#faq`,
            isPartOf: { '@id': `${SITE.url}/#webpage` },
            mainEntity: faqs.map((f) => ({
              '@type': 'Question',
              name: f.q,
              acceptedAnswer: { '@type': 'Answer', text: f.a },
            })),
          },
        ]
      : []),
  ],
};

---

<Layout title={title} description={description} jsonLd={jsonLd}>
  {/* ════════════════════ ۱) هیرو بنتو ════════════════════
      سه سلول در یک شبکه‌ی «خط مو» (gap-px روی steel-300): جستجو (عمل اصلی — بیشتر بازدیدکننده‌ها کد فنی دارند)،
      عکس پلاک در واتساپ (کسی که کد را نمی‌داند)، فهرست چندقلمی (مدیر خرید با فهرست توقف برنامه‌ریزی‌شده).
      ⚠️ سلول اصلی (بازبینی کارفرما، ۳ آبان ۱۴۰۵): سفیدِ روی سفید بود و کوتاه‌تر از دو سلول کنار — زیر دکمه‌ی جستجو فضای
      مرده می‌ماند. حالا سطح steel-50 + شبکه‌ی نقطه‌ای + ریل ۴px، و flex-col justify-between با نوار سه‌تایی پایین تا
      دو ستون هم‌قد بسته شوند. ریل با border-s (منطقی = راست در RTL)، نه border-r. هیچ تصویر یا انیمیشنی — قفل سرعت. */}
  <section class="bg-white border-b border-steel-300" aria-labelledby="hero-heading">
    <div class="max-w-7xl mx-auto px-4 md:px-6 py-5 md:py-8">
      <div class="grid lg:grid-cols-12 gap-px bg-steel-300 border border-steel-300 rounded-md overflow-hidden">
        <div class="lg:col-span-8 lg:row-span-2 bg-steel-50 bg-blueprint border-s-4 border-s-action p-4 md:p-8 min-w-0 flex flex-col justify-between gap-5">
          <div>
            <h1 id="hero-heading" class="text-2xl md:text-3xl lg:text-4xl font-black text-steel-900 leading-[1.5] text-right">
              مرجع تخصصی تأمین قطعات یدکی <span class="text-accent-ink">جرثقیل سقفی</span>
              {/* اعداد از خودِ تاکسونومی و وردپرس، با ارقام فارسی — نه از حدس. */}
              <span class="block text-base md:text-xl font-bold text-steel-600 mt-2 leading-8">
                {fa(ALL_CATEGORIES.length)} دسته قطعه از {fa(BRANDS.length)} برند — اصل، قابل ردیابی با کد فنی، با ضمانت اصالت و فاکتور رسمی
              </span>
            </h1>
            <p class="mt-3 mb-5 text-sm md:text-base text-steel-700 leading-7 md:leading-8 max-w-2xl text-right">
              کد فنی، عکس پلاک دستگاه یا عکس قطعه‌ی فرسوده کافی است — سازگاری را <strong class="font-bold text-steel-900">پیش از صدور پیش‌فاکتور</strong> بررسی می‌کنیم.
            </p>
            <SearchBox id="hero-search" tone="light" slash />
            <div class="mt-3 flex flex-wrap items-center gap-2 text-sm">
              <span class="text-steel-600 shrink-0">{QUICK_LINKS_LABEL}</span>
              {quickSuggestions.map((item) => (
                <a href={item.href} class="inline-flex items-center min-h-9 px-3 rounded border border-steel-300 bg-white text-steel-800 hover:border-steel-500">{item.label}</a>
              ))}
            </div>
          </div>
          {/* سه تعهد کارفرما (متن خود کارفرما، ۳ آبان ۱۴۰۵؛ «کتبی» به خواست کارفرما حذف شد — همان ادعای تأییدشده‌ی «تعویض در صورت عدم تطابق با کد سفارش») — جای خالی زیر جستجو را می‌گیرد و دو ستون را هم‌قد می‌کند. */}
          <ul class="border-t border-steel-200 pt-4 grid grid-cols-3 gap-2 text-xs text-steel-700 leading-5" role="list">
            {['ضمانت تطابق با کد سفارش', 'صدور پیش‌فاکتور رسمی مالیاتی', 'تامین مستقیم و ارسال سریع'].map((t) => (
              <li class="flex items-start gap-1.5">
                <svg class="w-4 h-4 shrink-0 text-accent-ink" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                <span class="font-bold">{t}</span>
              </li>
            ))}
          </ul>
        </div>

        {waPlate && (
          <div class="lg:col-span-4 bg-white p-4 md:p-6 flex flex-col">
            <h2 class="text-base font-black text-steel-900 leading-7">کد فنی را نمی‌دانید؟</h2>
            <p class="mt-1 mb-4 text-sm text-steel-700 leading-7">از پلاک مشخصات دستگاه یا خودِ قطعه عکس بگیرید و در واتساپ بفرستید تا قطعه‌ی سازگار شناسایی شود.</p>
            <a href={waPlate} target="_blank" rel="noopener noreferrer" class="mt-auto inline-flex items-center justify-center gap-2 min-h-11 px-4 rounded-md border border-steel-300 bg-white text-sm font-bold text-steel-900 hover:border-steel-500">
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 015.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 00-1.134-.175 2.31 2.31 0 01-1.64-1.055l-.822-1.316a2.192 2.192 0 00-1.736-1.039 48.774 48.774 0 00-5.232 0 2.192 2.192 0 00-1.736 1.039l-.821 1.316zM16.5 12.75a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0z" /></svg>
              ارسال عکس پلاک در واتساپ
            </a>
          </div>
        )}

        {/* فهرست چندقلمی — جانشین QuickOrder. GET به /contact با name="parts" (فرم تماس از فاز ۳ آن را می‌خواند).
            بدون جاوااسکریپت کار می‌کند. */}
        <form action="/contact/" method="get" class:list={['bg-white p-4 md:p-6 flex flex-col', waPlate ? 'lg:col-span-4' : 'lg:col-span-4 lg:row-span-2']}>
          <h2 class="text-base font-black text-steel-900 leading-7"><label for="bulk-parts">فهرست چندقلمی، یک پیش‌فاکتور</label></h2>
          <p id="bulk-parts-hint" class="mt-1 mb-2 text-sm text-steel-700 leading-7">هر کد فنی در یک خط — سازگاری هر قلم بررسی و یک پیش‌فاکتور واحد صادر می‌شود.</p>
          <textarea id="bulk-parts" name="parts" rows="2" dir="ltr" aria-describedby="bulk-parts-hint" placeholder={'SAGA1-L12\n...'}
            class="w-full rounded-md border border-steel-300 bg-steel-50 p-2.5 text-sm font-mono leading-6 text-steel-900 placeholder:text-steel-500 focus:border-steel-600 focus:bg-white resize-y max-h-40"></textarea>
          <button type="submit" class="mt-auto pt-0 inline-flex items-center justify-center min-h-11 px-4 rounded-md bg-action text-white text-sm font-black hover:bg-accent-strong">درخواست پیش‌فاکتور</button>
        </form>
      </div>
    </div>
  </section>

  {/* ════════════════════ ۲) ۷ گروه فنی و ۳۱ دسته ════════════════════
      هر ۳۱ دسته، زیر گروه خودش، در شبکه‌ی خط مو. صفحه‌ی اصلی به تمام صفحات دسته لینک مستقیم دارد (عمق خزش ۲) و هر نام
      دسته یک عبارت جستجوی واقعی است. شمار کالا فقط کنار دسته‌ی دارای کالا — «۰ قطعه» بیست‌وچند بار نویز است. */}
  <section class="bg-steel-50 px-4 py-8 md:py-10 border-b border-steel-300" aria-labelledby="silos-heading">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-wrap items-end justify-between gap-x-4 gap-y-1 mb-4">
        <div>
          <h2 id="silos-heading" class="text-xl md:text-2xl font-black text-steel-900">دسته‌بندی قطعات جرثقیل سقفی</h2>
          <p class="mt-1 text-sm text-steel-600 leading-7">{fa(ALL_CATEGORIES.length)} دسته قطعه در {fa(SILOS.length)} گروه فنی — از روی گروه پیش بروید یا مستقیم کد فنی را جستجو کنید.</p>
        </div>
        <a href="/categories/" class="inline-flex items-center min-h-11 text-sm font-bold text-accent-ink hover:underline underline-offset-4">فهرست کامل ←</a>
      </div>
      <ul class={hairlineGrid(presence.all.length)} role="list">
        {presence.all.map(({ silo, categories }, i) => (
          <li class={`${hairlineCell(i, presence.all.length)} flex flex-col relative transition-all duration-150 hover:ring-2 hover:ring-inset hover:ring-action hover:z-10`}>
            <a href={siloPath(silo)} class="flex items-center gap-3 px-4 py-3 border-b border-steel-200 hover:bg-steel-50">
              <span class="w-9 h-9 shrink-0 grid place-items-center rounded bg-steel-100 text-steel-700" aria-hidden="true">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d={silo.icon} /></svg>
              </span>
              <h3 class="flex-1 min-w-0 font-black text-sm leading-6 text-steel-900">{silo.name}</h3>
              <span class="shrink-0 text-xs text-steel-600">{fa(categories.length)} دسته</span>
            </a>
            <ul class="px-4 py-2 [&_a]:flex [&_a]:items-center [&_a]:justify-between [&_a]:gap-2 [&_a]:min-h-9 [&_a]:text-sm [&_a]:text-steel-700 [&_a:hover]:text-accent-ink" role="list">
              {categories.map(({ category, count }) => (
                <li>
                  <a href={categoryPath({ ...category, silo })}>
                    <span>{category.name}</span>
                    {count > 0 && <span class="text-xs font-bold text-steel-900 tabular-nums">{fa(count)} قطعه</span>}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ════════════════════ ۳) کالاهای واقعی ════════════════════
      شبکه‌ی ProductCard (کارفرما، ۳ آبان ۱۴۰۵ — جای ردیف باریک). با کمتر از ۳ کالا، کارت همراه «هنوز در فهرست آنلاین
      نیست؟» ردیف را کامل می‌کند — مسیر واقعی (واتساپ پلاک / فهرست چندقلمی)، نه کارت کالای ساختگی. بی‌کالا = بی‌بخش. */}
  {featured.length > 0 && (
    <section class="bg-white px-4 py-8 md:py-10 border-b border-steel-300" aria-labelledby="featured-heading">
      <div class="max-w-7xl mx-auto">
        <div class="flex flex-wrap items-end justify-between gap-x-4 gap-y-1 mb-4">
          <h2 id="featured-heading" class="text-xl md:text-2xl font-black text-steel-900">قطعات موجود در کاتالوگ</h2>
          <a href="/products/" class="inline-flex items-center min-h-11 text-sm font-bold text-accent-ink hover:underline underline-offset-4">همه‌ی قطعات ←</a>
        </div>
        <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5" role="list">
          {featured.slice(0, 3).map((product, i) => <li><ProductCard product={product} eager={i === 0} /></li>)}
          {featured.length < 3 && (
            <li class:list={["bg-steel-50 border border-steel-300 border-s-4 border-s-action rounded-md p-6 flex flex-col justify-between gap-5", featured.length === 1 && "lg:col-span-2"]}>
              <div>
                <h3 class="text-xl font-black text-steel-900 leading-8">قطعه مورد نظر شما هنوز در فهرست آنلاین نیست؟</h3>
                <p class="mt-2 text-sm text-steel-700 leading-7">
                  فهرست آنلاین در حال تکمیل است؛ تامین ما هر {fa(SILOS.length)} گروه فنی جرثقیل سقفی را پوشش می‌دهد. کد فنی یا عکس
                  پلاک را بفرستید تا قطعه‌ی سازگار شناسایی و پیش‌فاکتور صادر شود.
                </p>
                {/* محتوای میانی (کارفرما، ۴ آبان ۱۴۰۵): justify-between یک حفره‌ی ~۳۰۰px سفید وسط کارت می‌ساخت. چهار مرحله‌ی
                    واقعی استعلام سفارشی — همان ادعاهای تأییدشده‌ی صفحه (سازگاری پیش از پیش‌فاکتور، پیش‌فاکتور رسمی). */}
                <ul class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-2.5 bg-white border border-steel-200 rounded p-3.5 text-sm text-steel-800" role="list">
                  {['شناسایی از روی عکس پلاک', 'بررسی سازگاری فنی', 'صدور پیش‌فاکتور رسمی', 'تامین قطعات توقف تولید'].map((t, i) => (
                    <li class="flex items-center gap-2">
                      <span class="font-mono text-xs font-black text-white bg-steel-900 rounded px-1.5 py-0.5 tabular-nums" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                      <span class="font-bold">{t}</span>
                    </li>
                  ))}
                </ul>
                {/* ⚠️ چک‌لیست به‌تنهایی کافی نبود: کارت همراه هم‌قد کارت محصول کشیده می‌شود و در ۱۲۸۰px هنوز ~۲۳۰px خالی می‌ماند
                    (اسکرین‌شات a326586). ۷ گروه فنی به‌صورت پیوند فشرده — همان ادعای «پوشش هر ۷ گروه» قابل‌کلیک. */}
                <p class="mt-4 mb-2 text-xs font-black text-steel-600">گروه‌های فنی تحت پوشش</p>
                <ul class="flex flex-wrap gap-1.5" role="list">
                  {SILOS.map((silo) => (
                    <li><a href={siloPath(silo)} class="inline-flex items-center min-h-8 px-2.5 rounded border border-steel-300 bg-white text-xs font-bold text-steel-800 hover:border-action hover:text-accent-ink">{silo.name}</a></li>
                  ))}
                </ul>
              </div>
              <div class="grid gap-2">
                {waPlate && <a href={waPlate} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center min-h-11 px-4 rounded-md bg-action text-white text-sm font-black hover:bg-accent-strong">ارسال عکس پلاک در واتساپ</a>}
                <a href="#bulk-parts" class="inline-flex items-center justify-center min-h-11 px-4 rounded-md border border-steel-300 bg-white text-sm font-bold text-steel-900 hover:border-steel-500">ثبت فهرست چندقلمی</a>
              </div>
            </li>
          )}
        </ul>
      </div>
    </section>
  )}

  {/* ════════════════════ ۴) قطعات مصرفی و پرتعویض (وردپرس) ════════════════════ */}
  <HighWearParts />

  {/* ════════════════════ ۵) مزیت‌های تامین (وردپرس) ════════════════════
      «ماتریس مشخصات»: هر مزیت یک خانه با ریل ۴px و شماره‌ی مونو — متن از پنل، شکل از طراحی. */}
  {advantages.length > 0 && (
    <section class="bg-steel-50 px-4 py-8 md:py-10 border-b border-steel-300" aria-labelledby="advantages-heading">
      <div class="max-w-7xl mx-auto">
        <h2 id="advantages-heading" class="text-xl md:text-2xl font-black text-steel-900 mb-4">چرا کرین یدک — مزیت‌های تامین</h2>
        <ul class={hairlineGrid(advantages.length)} role="list">
          {advantages.map((item, i) => (
            <li class={`${hairlineCell(i, advantages.length)} border-s-4 border-s-action p-4 md:p-5`}>
              <span class="flex items-center justify-between mb-2" aria-hidden="true">
                <span class="w-10 h-10 rounded bg-steel-100 border border-steel-200 grid place-items-center">
                  <svg class="w-6 h-6 text-action" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d={ADVANTAGE_ICONS[i] ?? GENERIC_ADVANTAGE_ICON} /></svg>
                </span>
                <span class="font-mono text-xs text-steel-600 tabular-nums">{String(i + 1).padStart(2, '0')}</span>
              </span>
              <h3 class="font-black text-steel-900 leading-7">{item.title}</h3>
              <p class="mt-1 text-sm text-steel-700 leading-7">{item.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {/* ════════════════════ ۶) برندها ════════════════════
      سه کلاس (سازنده‌ی بدنه / سیستم کنترل / تجهیزات برقی)، هر کدام یک شبکه‌ی خط مو.
      ⚠️ لوگوی جعلی کشیده نمی‌شود (علامت تجاری — توضیح کامل در تاریخچه‌ی همین فایل): پلاک تایپوگرافیک نام لاتین. */}
  <section class="bg-white px-4 py-8 md:py-10 border-b border-steel-300" aria-labelledby="brands-heading">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-wrap items-end justify-between gap-x-4 gap-y-1 mb-4">
        <div>
          <h2 id="brands-heading" class="text-xl md:text-2xl font-black text-steel-900">برندهای تحت پوشش</h2>
          <p class="mt-1 text-sm text-steel-600 leading-7">روی یک جرثقیل معمولاً بدنه، سیستم کنترل و تجهیزات برقی از سه سازنده‌ی متفاوت‌اند.</p>
        </div>
        <a href="/brands/" class="inline-flex items-center min-h-11 text-sm font-bold text-accent-ink hover:underline underline-offset-4">همه برندها ←</a>
      </div>
      <div class="space-y-5">
        {(['oem', 'control', 'electrical'] as const).map((brandClass) => {
          const list = brandsByClass(brandClass);
          return list.length > 0 && (
            <div>
              <h3 class="text-xs font-black text-steel-600 mb-2">{BRAND_CLASSES[brandClass].name} <span class="font-normal">({fa(list.length)})</span></h3>
              {/* ظاهر کاشی در global.css (.cy-brand-tile) — کلاس روی هر ۱۹ کاشی ~۵KB بود. */}
              <ul class="cy-brand-tile grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-px bg-steel-200 border border-steel-200 rounded-md overflow-hidden" role="list">
                {list.map((brand) => (
                  <li class="bg-white">
                    <a href={`/brands/${brand.slug}/`} title={brand.seoAnchor ?? undefined}>
                      <span><b dir="ltr">{brand.logoText}</b><i>{brand.country}</i></span>
                      <span>{brand.nameFa}</span>
                    </a>
                  </li>
                ))}
                {/* خانه‌های خالی ردیف آخر سفید پر می‌شوند تا لکه‌ی خاکستری نماند (همان دام hairline.ts). */}
                {hairlineFillers(list.length).map((c) => <li class={c} aria-hidden="true"></li>)}
              </ul>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  {/* ════════════════════ ۷) فرآیند تامین و خرید سازمانی — لنگر تیره ════════════════════
      (کارفرما، ۳ آبان ۱۴۰۵) تنها بخش گرافیت صفحه: یکنواختی سفید-روی-سفید را می‌شکند. مسیر واقعی B2B (پیش‌فاکتور → فاکتور).
      ⚠️ بدون زمان یا عدد: «ارسال سریع» همان ادعای verified است؛ هیچ «۲۴ ساعته»ای ساخته نشد (قاعده‌ی ۲).
      ⚠️ کنتراست: نشان مرحله bg-action + سفید (۵٫۲:۱)، نه متن نارنجی روی steel-800 (۴٫۱:۱ — زیر AA)؛ زیرعنوان accent روی
      steel-900 (۴٫۸:۱). ریل با border-s (منطقی = راست در RTL). */}
  <section class="bg-steel-900 text-white px-4 py-10 md:py-12 border-y border-steel-800" aria-labelledby="process-heading">
    <div class="max-w-7xl mx-auto">
      <p class="text-sm font-bold text-accent mb-1">از استعلام تا تحویل</p>
      <h2 id="process-heading" class="text-xl md:text-2xl font-black mb-5">فرآیند تامین و خرید سازمانی</h2>
      <ol class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {STEPS.map(([step, text, icon], i) => (
          <li class="bg-steel-800/90 border border-steel-700 border-s-4 border-s-action p-5 rounded-md">
            <span class="flex items-center justify-between mb-3" aria-hidden="true">
              <span class="font-mono text-sm font-black bg-action text-white px-2 py-0.5 rounded tabular-nums">{String(i + 1).padStart(2, '0')}</span>
              <svg class="w-7 h-7 text-steel-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d={icon} /></svg>
            </span>
            <h3 class="font-black text-white leading-7">{step}</h3>
            <p class="mt-1 text-sm text-steel-300 leading-7">{text}</p>
          </li>
        ))}
      </ol>
      {mobile && (
        <div class="mt-5 flex flex-wrap items-center justify-between gap-3 border border-steel-700 rounded-md px-4 py-3">
          <p class="text-sm text-steel-200 leading-7"><strong class="text-white">جرثقیل خط تولید از کار افتاده؟</strong> مستقیم با خط ویژه‌ی تامین تماس بگیرید.</p>
          <a href={mobile.href} class="inline-flex items-center gap-2 min-h-11 px-4 rounded-md bg-action text-white text-sm font-black hover:bg-accent-strong">
            <span class="w-2 h-2 rounded-full bg-emerald-400" aria-hidden="true"></span>
            <span class="tabular-nums" dir="ltr">{mobile.display}</span>
          </a>
        </div>
      )}
    </div>
  </section>

  {/* ════════════════════ ۸) یک نوار اعتماد ════════════════════
      فقط نشان‌های verified در trust.ts؛ اینماد با نماد واقعی (نسخه‌ی محلی، lazy). ⚠️ قطعه‌کد رسمی کامل اینماد
      (referrerpolicy/code) در فوتر است؛ این‌جا فقط پیوند به صفحه‌ی تأیید. */}
  <section class="bg-white px-4 py-8 border-b border-steel-300" aria-labelledby="trust-heading">
    <div class="max-w-7xl mx-auto">
      <h2 id="trust-heading" class="sr-only">تضمین‌ها</h2>
      <ul class={hairlineGrid(trust.length)} role="list">
        {trust.map((b, i) => (
          <li class={`${hairlineCell(i, trust.length)} p-4 flex items-start gap-3`}>
            {b.id === 'enamad' ? (
              <a href={ENAMAD.href} target="_blank" referrerpolicy="origin" class="w-12 h-12 shrink-0 grid place-items-center rounded border border-steel-200 bg-white" aria-label="صفحه‌ی تأیید نماد اعتماد الکترونیکی (اینماد)">
                <img src={ENAMAD.localImg} alt="" width="44" height="44" loading="lazy" decoding="async" class="w-11 h-11 object-contain" />
              </a>
            ) : (
              <span class="w-12 h-12 shrink-0 grid place-items-center rounded bg-steel-100 text-steel-700" aria-hidden="true">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d={b.icon} /></svg>
              </span>
            )}
            <span class="min-w-0">
              <span class="block font-black text-steel-900 text-sm leading-6">{b.title}</span>
              <span class="block text-xs text-steel-600 leading-5">{b.description}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ================================ FAQ ================================ */}
  <AuthorityBlock />

  {faqs.length > 0 && (
  <section class="bg-steel-50 px-4 py-8 md:py-10" aria-labelledby="faq-heading">
    <div class="max-w-4xl mx-auto">
      <h2 id="faq-heading" class="text-xl md:text-2xl font-black text-steel-900 mb-4">پرسش‌های متداول فنی</h2>
      {/* فهرست خط مو (فاز ۴)؛ ظاهر در global.css (.cy-faq). فوکوس = :focus-visible سراسری. */}
      <div class="cy-faq">
        {faqs.map((faq) => (
          <details>
            <summary>
              <span>{faq.q}</span>
              <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <div class="prose-crane" set:html={faq.a} />
          </details>
        ))}
      </div>
    </div>
  </section>
  )}
</Layout>

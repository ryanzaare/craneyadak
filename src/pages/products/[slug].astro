---
// src/pages/products/[slug].astro
// ---------------------------------------------------------------------------
// صفحه‌ی محصول — مهم‌ترین صفحه‌ی سایت.
//
// این صفحه حول رفتار واقعی کاربرش طراحی شده، نه حول الگوی عمومی فروشگاهی:
//
//   • او معمولاً قطعه‌ی خراب را در دست دارد و اولین سوالش «قیمت» نیست،
//     «آیا این همان قطعه است؟». به همین دلیل کد فنی، کدهای معادل و
//     مدل‌های سازگار بالاتر از هر چیز دیگری و در دسترس فوری‌اند.
//   • خرید صنعتی چندنفره است: مهندس نت پیدا می‌کند، مدیر خرید تایید
//     می‌کند. پس «ارسال برای همکار» و «چاپ مشخصات» ابزار واقعی کارند،
//     نه تزئین.
//   • او زیر فشار توقف خط تولید است. نوار اقدام چسبان موبایل و کپی
//     یک‌کلیکی کد فنی، اصطکاک را در همان لحظه کم می‌کنند.
//
// قاعده‌ی داده: هیچ فیلدی که مقدار واقعی ندارد ساخته یا حدس زده نمی‌شود.
// ---------------------------------------------------------------------------
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PriceTag from '../../components/PriceTag.astro';
import ProductCard from '../../components/ProductCard.astro';
import ProductGallery from '../../components/ProductGallery.astro';
import PartNumber from '../../components/PartNumber.astro';
import { SITE } from '../../data/site';
import { findCategory, categoryPath, siloPath, findBrand } from '../../data/taxonomy';
import {
  getAllProducts,
  getRelatedProducts,
  computePrice,
  productJsonLd,
  productPath,
  inquiryHref,
  type CraneProduct,
} from '../../lib/wp';

export async function getStaticPaths() {
  const products = await getAllProducts();
  return Promise.all(
    products.map(async (product) => ({
      params: { slug: product.slug },
      props: { product, related: await getRelatedProducts(product) },
    }))
  );
}

interface Props {
  product: CraneProduct;
  related: CraneProduct[];
}

const { product, related } = Astro.props as Props;
const price = computePrice(product);

const primaryCategory = product.categorySlugs.map((s) => findCategory(s)).find(Boolean) ?? null;
const brand = product.brandSlug ? findBrand(product.brandSlug) : undefined;

const title = product.sku
  ? `${product.name} | کد ${product.sku} | ${SITE.name}`
  : `${product.name} | ${SITE.name}`;

// متا دیسکریپشن از داده‌ی واقعی ساخته می‌شود، نه از یک قالب عمومی.
const description = [
  product.summary,
  product.brandNameFa ? `برند ${product.brandNameFa}` : null,
  product.sku ? `کد فنی ${product.sku}` : null,
  'بررسی سازگاری فنی، استعلام قیمت و صدور فاکتور رسمی.',
]
  .filter(Boolean)
  .join(' — ')
  .slice(0, 300);

const breadcrumbItems = [
  { label: 'صفحه اصلی', href: '/' },
  { label: 'دسته‌بندی‌ها', href: '/categories' },
  ...(primaryCategory
    ? [
        { label: primaryCategory.silo.name, href: siloPath(primaryCategory.silo) },
        { label: primaryCategory.name, href: categoryPath(primaryCategory) },
      ]
    : []),
  { label: product.name },
];

const canonical = `${SITE.url}${productPath(product)}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: breadcrumbItems.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: item.label,
        ...(item.href ? { item: `${SITE.url}${item.href}` } : {}),
      })),
    },
    productJsonLd(product, SITE.url, price),
  ],
};

const hasFitment = product.oemCrossReference.length > 0 || product.compatibleModels.length > 0;
const canBuyOnline = product.buyMode === 'cart' && price.hasPrice;
const heroImage = product.images[0] ?? null;

const stockLabel: Record<CraneProduct['stockStatus'], string | null> = {
  in_stock: 'موجود در انبار',
  on_order: 'تامین به‌سفارش',
  unknown: null,
};

// تاریخ به‌روزرسانی واقعی از وردپرس — سیگنال تازگی برای کاربر و موتور
// جستجو. اگر وردپرس تاریخی نداده باشد، چیزی ساخته نمی‌شود.
const modifiedDate = product.modified
  ? new Date(product.modified).toLocaleDateString('fa-IR', { year: 'numeric', month: 'long', day: 'numeric' })
  : null;
---

<Layout title={title} description={description} jsonLd={jsonLd} ogImage={heroImage?.url} noindex={product.isDemo}>
  {product.isDemo && (
    /* رکورد نمایشی — عمداً پررنگ و غیرقابل‌چشم‌پوشی. اگر روزی سهواً روی
       سایت زنده بماند، هم بازدیدکننده و هم تیم بلافاصله متوجه می‌شوند. */
    <div class="bg-amber-100 border-y-2 border-amber-400 px-4 py-3 print:hidden">
      <p class="max-w-7xl mx-auto text-sm font-bold text-amber-900">
        ⚠️ نمونه‌ی نمایشی — این رکورد فقط برای کار طراحی ساخته شده است. کد فنی و کدهای معادل آن واقعی نیستند و این صفحه در موتورهای جستجو ایندکس نمی‌شود.
      </p>
    </div>
  )}
  <section class="bg-crane-navy text-white pt-10 pb-6 px-4 print:hidden">
    <div class="max-w-7xl mx-auto">
      <Breadcrumb items={breadcrumbItems} />
    </div>
  </section>

  {/* ============================ بخش اصلی ============================ */}
  <section class="bg-white px-4 py-10 md:py-14 border-b-[8px] border-crane-orange print:border-0 print:py-0">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10">
      <div class="lg:col-span-5">
        <ProductGallery images={product.images} productName={product.name} />
      </div>

      <div class="lg:col-span-7 lg:sticky lg:top-24 lg:self-start">
        <div class="flex flex-wrap items-center gap-3 mb-4">
          {brand && (
            <a
              href={`/brands/${brand.slug}`}
              class="bg-gray-50 border border-gray-200 text-crane-navy text-sm font-bold px-3 py-1.5 rounded-lg hover:border-crane-orange hover:text-crane-orange transition-colors"
            >
              {brand.nameFa}
              <span class="text-gray-500 font-normal" dir="ltr"> ({brand.nameEn})</span>
              <span class="text-gray-500 font-normal"> — ساخت {brand.country}</span>
            </a>
          )}
          {stockLabel[product.stockStatus] && (
            <span
              class:list={[
                'text-sm font-bold px-3 py-1.5 rounded-lg border',
                product.stockStatus === 'in_stock'
                  ? 'bg-emerald-50 text-emerald-800 border-emerald-200'
                  : 'bg-amber-50 text-amber-800 border-amber-200',
              ]}
            >
              {stockLabel[product.stockStatus]}
            </span>
          )}
        </div>

        <h1 class="text-2xl md:text-4xl font-black text-crane-navy leading-[1.45] mb-5">{product.name}</h1>

        {product.sku && (
          <div class="mb-6">
            <PartNumber sku={product.sku} id="main" />
          </div>
        )}

        {product.summary && <p class="text-gray-700 leading-8 mb-8">{product.summary}</p>}

        {/* ------------------------- جعبه‌ی خرید ------------------------- */}
        <div id="buy-box" class="bg-gradient-to-b from-gray-50 to-white border border-gray-200 rounded-3xl p-6 md:p-8 mb-6 print:hidden shadow-sm">
          {/* برچسب مسیر خرید — کاربر باید پیش از دیدن دکمه بداند با چه
              فرایندی روبه‌روست. ابهام بین «خرید» و «استعلام» مکث ایجاد
              می‌کند، و مکث در خرید صنعتی یعنی رفتن سراغ تامین‌کننده‌ی بعدی. */}
          <p class="text-xs font-black tracking-wider text-gray-500 mb-3">
            {canBuyOnline ? 'خرید آنلاین' : 'استعلام قیمت و پیش‌فاکتور رسمی'}
          </p>
          <PriceTag price={price} size="page" />

          <div class="flex flex-col sm:flex-row gap-3 mt-6">
            {canBuyOnline ? (
              <>
                <div class="flex items-stretch gap-2 shrink-0">
                  <label for="qty" class="sr-only">تعداد</label>
                  <input
                    id="qty"
                    type="number"
                    min="1"
                    value="1"
                    inputmode="numeric"
                    class="w-20 text-center bg-white border border-gray-200 rounded-xl font-bold text-crane-navy min-h-[52px] focus:outline-none focus:ring-4 focus:ring-crane-orange/30"
                  />
                </div>
                <button
                  type="button"
                  data-add-to-cart
                  data-slug={product.slug}
                  class="flex-1 bg-crane-orange text-white px-8 py-4 rounded-xl font-black hover:bg-orange-800 transition-colors focus:outline-none focus:ring-4 focus:ring-crane-orange/40 min-h-[52px]"
                >
                  افزودن به سبد خرید
                </button>
                <a
                  href={inquiryHref(product)}
                  class="flex-1 bg-white border-2 border-crane-navy text-crane-navy text-center px-6 py-4 rounded-xl font-black hover:bg-crane-navy hover:text-white transition-colors focus:outline-none focus:ring-4 focus:ring-crane-navy/30 min-h-[52px] flex items-center justify-center"
                >
                  پیش‌فاکتور رسمی
                </a>
              </>
            ) : (
              <>
                <a
                  href={inquiryHref(product)}
                  class="flex-1 bg-crane-orange text-white text-center px-8 py-4 rounded-xl font-black hover:bg-orange-800 transition-colors focus:outline-none focus:ring-4 focus:ring-crane-orange/40 min-h-[52px] flex items-center justify-center"
                >
                  استعلام قیمت و پیش‌فاکتور
                </a>
                <a
                  href={`https://wa.me/${SITE.whatsapp.replace('+', '')}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex-1 bg-emerald-50 text-emerald-800 border border-emerald-200 text-center px-6 py-4 rounded-xl font-black hover:bg-emerald-600 hover:text-white transition-colors focus:outline-none focus:ring-4 focus:ring-emerald-500/30 min-h-[52px] flex items-center justify-center"
                >
                  ارسال عکس قطعه در واتساپ
                </a>
              </>
            )}
          </div>

          {/* بلوک اطمینان — دقیقاً کنار دکمه، جایی که تردید خرید رخ می‌دهد. */}
          <ul class="grid grid-cols-1 sm:grid-cols-3 gap-3 mt-6 pt-6 border-t border-gray-200" role="list">
            {[
              { t: 'بررسی سازگاری', d: 'پیش از صدور پیش‌فاکتور تایید می‌شود', p: 'M9 12l2 2 4-4' },
              { t: 'فاکتور رسمی', d: 'قابل ارائه به واحد مالی', p: 'M9 12h6m-6 4h6M7 3h10a2 2 0 012 2v14a2 2 0 01-2 2H7a2 2 0 01-2-2V5a2 2 0 012-2z' },
              { t: 'ضمانت اصالت', d: 'کتبی، همراه کالا', p: 'M12 2l8 4v6c0 5-3 8-8 10-5-2-8-5-8-10V6l8-4z' },
            ].map((item) => (
              <li class="flex items-start gap-2.5">
                <span class="w-8 h-8 shrink-0 rounded-lg bg-white border border-gray-200 text-crane-orange flex items-center justify-center" aria-hidden="true">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d={item.p} /></svg>
                </span>
                <span class="min-w-0">
                  <span class="block text-sm font-bold text-crane-navy leading-6">{item.t}</span>
                  <span class="block text-xs text-gray-600 leading-5">{item.d}</span>
                </span>
              </li>
            ))}
          </ul>

          {/* دسترسی مستقیم — خریدارِ تحت فشار توقف خط اغلب فرم پر نمی‌کند و
              ترجیح می‌دهد همان لحظه تماس بگیرد. پنهان‌کردن شماره پشت یک
              صفحه‌ی دیگر، همان‌جا لید را از دست می‌دهد. */}
          <div class="flex flex-wrap items-center gap-x-5 gap-y-2 mt-6 pt-5 border-t border-gray-200 text-sm">
            <a href={`tel:${SITE.phone}`} class="inline-flex items-center gap-2 font-bold text-crane-navy hover:text-crane-orange transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
              <span dir="ltr">{SITE.phoneDisplay}</span>
            </a>
            <span class="text-gray-300" aria-hidden="true">|</span>
            <span class="text-gray-600">پاسخ‌گویی در ساعات کاری</span>
          </div>
        </div>

        {/* --------- ابزار کار واقعی: ارسال به همکار و چاپ مشخصات --------- */}
        <div class="flex flex-wrap gap-2 print:hidden">
          <button
            type="button"
            id="share-product"
            data-title={product.name}
            data-url={canonical}
            class="inline-flex items-center gap-2 text-sm font-bold text-crane-navy bg-white border border-gray-200 rounded-xl px-4 py-2.5 hover:border-crane-orange hover:text-crane-orange transition-colors focus:outline-none focus:ring-4 focus:ring-crane-orange/30"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342a3 3 0 100-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684zm0-12.632a3 3 0 105.368-2.684 3 3 0 00-5.368 2.684z" /></svg>
            <span id="share-label">ارسال برای همکار</span>
          </button>
          <button
            type="button"
            id="print-product"
            class="inline-flex items-center gap-2 text-sm font-bold text-crane-navy bg-white border border-gray-200 rounded-xl px-4 py-2.5 hover:border-crane-orange hover:text-crane-orange transition-colors focus:outline-none focus:ring-4 focus:ring-crane-orange/30"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" /></svg>
            چاپ مشخصات فنی
          </button>
        </div>

        {modifiedDate && (
          <p class="text-xs text-gray-600 mt-5">
            آخرین به‌روزرسانی اطلاعات این قطعه: <time datetime={product.modified!}>{modifiedDate}</time>
          </p>
        )}
      </div>
    </div>
  </section>

  {/* =================== کدهای معادل و سازگاری (Fitment) =================== */}
  {hasFitment && (
    <section class="bg-gray-50 px-4 py-14 border-b border-gray-100 print:bg-white print:py-4" aria-labelledby="fitment-heading">
      <div class="max-w-7xl mx-auto">
        <h2 id="fitment-heading" class="text-2xl font-black text-crane-navy mb-3">کدهای معادل و سازگاری</h2>
        <p class="text-gray-700 leading-8 mb-8 max-w-3xl print:hidden">
          اگر کد روی قطعه‌ی فرسوده‌ی شما با کد بالا یکی نیست، جدول زیر را بررسی کنید؛ یک قطعه اغلب با چند کد مختلف سازنده عرضه می‌شود.
        </p>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          {product.oemCrossReference.length > 0 && (
            <div class="bg-white rounded-3xl border border-gray-100 overflow-hidden">
              <h3 class="font-black text-crane-navy px-6 py-4 border-b border-gray-100 bg-gray-50">کدهای معادل سازنده (OEM)</h3>
              <table class="w-full text-sm">
                <caption class="sr-only">فهرست کدهای فنی معادل این قطعه نزد سازندگان مختلف</caption>
                <thead>
                  <tr class="text-gray-600 text-xs">
                    <th scope="col" class="text-right font-bold px-6 py-3">سازنده</th>
                    <th scope="col" class="text-right font-bold px-6 py-3">کد فنی</th>
                  </tr>
                </thead>
                <tbody>
                  {product.oemCrossReference.map((ref) => (
                    <tr class="border-t border-gray-50">
                      <td class="px-6 py-3 text-gray-700">{ref.oemBrand}</td>
                      <td class="px-6 py-3 font-mono text-crane-navy font-bold select-all" dir="ltr">{ref.oemPartNumber}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          {product.compatibleModels.length > 0 && (
            <div class="bg-white rounded-3xl border border-gray-100 overflow-hidden">
              <h3 class="font-black text-crane-navy px-6 py-4 border-b border-gray-100 bg-gray-50">مدل‌های سازگار</h3>
              <table class="w-full text-sm">
                <caption class="sr-only">مدل‌های جرثقیل که این قطعه با آن‌ها سازگار است</caption>
                <thead>
                  <tr class="text-gray-600 text-xs">
                    <th scope="col" class="text-right font-bold px-6 py-3">برند</th>
                    <th scope="col" class="text-right font-bold px-6 py-3">مدل</th>
                  </tr>
                </thead>
                <tbody>
                  {product.compatibleModels.map((model) => (
                    <tr class="border-t border-gray-50">
                      <td class="px-6 py-3 text-gray-700">{model.craneBrand}</td>
                      <td class="px-6 py-3 font-mono text-crane-navy font-bold select-all" dir="ltr">{model.modelName}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </div>

        <p class="text-sm text-gray-700 leading-7 mt-6 max-w-3xl print:hidden">
          مدل دستگاه شما در فهرست نیست؟ عکس پلاک دستگاه را بفرستید تا سازگاری بررسی شود —
          <a href={inquiryHref(product)} class="text-crane-orange font-bold hover:underline mr-1">بررسی سازگاری</a>.
        </p>
      </div>
    </section>
  )}

  {/* ============================ مشخصات فنی ============================ */}
  {product.technicalSpecs.length > 0 && (
    <section class="bg-white px-4 py-14 border-b border-gray-100 print:py-4" aria-labelledby="specs-heading">
      <div class="max-w-4xl mx-auto">
        <h2 id="specs-heading" class="text-2xl font-black text-crane-navy mb-8">مشخصات فنی</h2>
        <table class="w-full text-sm border border-gray-100 rounded-2xl overflow-hidden">
          <caption class="sr-only">جدول مشخصات فنی {product.name}</caption>
          <tbody>
            {product.technicalSpecs.map((spec, index) => (
              <tr class:list={[index % 2 === 0 ? 'bg-gray-50' : 'bg-white']}>
                <th scope="row" class="text-right font-bold text-crane-navy px-6 py-3.5 w-1/3 align-top">{spec.label}</th>
                <td class="px-6 py-3.5 text-gray-700 leading-7">{spec.value}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  {/* ============================ توضیحات ============================ */}
  {product.bodyHtml && (
    <section class="bg-gray-50 px-4 py-14 border-b border-gray-100 print:hidden" aria-labelledby="description-heading">
      <div class="max-w-4xl mx-auto">
        <h2 id="description-heading" class="text-2xl font-black text-crane-navy mb-6">توضیحات فنی محصول</h2>
        <div class="prose-crane text-gray-700 leading-8" set:html={product.bodyHtml} />
      </div>
    </section>
  )}

  {/* ========================= محصولات مرتبط ========================= */}
  {related.length > 0 && (
    <section class="bg-white px-4 py-14 print:hidden" aria-labelledby="related-heading">
      <div class="max-w-7xl mx-auto">
        <h2 id="related-heading" class="text-xl md:text-2xl font-black text-crane-navy mb-8">قطعات مرتبط</h2>
        <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6" role="list">
          {related.map((item) => (
            <li><ProductCard product={item} /></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {/* ------- نوار اقدام چسبان موبایل: وقتی جعبه‌ی خرید از دید خارج شد ------- */}
  <div
    id="sticky-bar"
    class="fixed bottom-0 inset-x-0 z-40 bg-white border-t border-gray-200 shadow-[0_-4px_16px_rgba(0,0,0,0.10)] px-4 py-3 translate-y-full transition-transform duration-200 md:hidden print:hidden"
    style="padding-bottom: calc(0.75rem + env(safe-area-inset-bottom, 0px));"
    aria-hidden="true"
  >
    <div class="flex items-center gap-3">
      <div class="min-w-0 flex-1">
        <PriceTag price={price} />
      </div>
      <a
        href={inquiryHref(product)}
        class="bg-crane-orange text-white px-6 py-3 rounded-xl font-black text-sm shrink-0 min-h-[48px] flex items-center focus:outline-none focus:ring-4 focus:ring-crane-orange/40"
      >
        {canBuyOnline ? 'پیش‌فاکتور' : 'استعلام قیمت'}
      </a>
    </div>
  </div>
</Layout>

<script>
  // ---------------- ارسال برای همکار ----------------
  // خرید صنعتی چندنفره است: مهندس نت قطعه را پیدا می‌کند، مدیر خرید تایید
  // می‌کند. Web Share API روی موبایل مستقیماً واتساپ/تلگرام را باز می‌کند —
  // همان کانالی که این انتقال واقعاً در آن اتفاق می‌افتد. روی دسکتاپ به
  // کپی لینک برمی‌گردد.
  const shareBtn = document.getElementById('share-product');
  const shareLabel = document.getElementById('share-label');

  shareBtn?.addEventListener('click', async () => {
    const title = shareBtn.dataset.title ?? document.title;
    const url = shareBtn.dataset.url ?? window.location.href;

    if (navigator.share) {
      try {
        await navigator.share({ title, url });
        return;
      } catch {
        // کاربر اشتراک‌گذاری را لغو کرد — این خطا نیست، کاری لازم نیست.
        return;
      }
    }

    try {
      await navigator.clipboard.writeText(url);
      if (shareLabel) shareLabel.textContent = 'لینک کپی شد ✓';
      setTimeout(() => { if (shareLabel) shareLabel.textContent = 'ارسال برای همکار'; }, 2000);
    } catch {
      if (shareLabel) shareLabel.textContent = 'کپی نشد';
    }
  });

  // ---------------- چاپ مشخصات ----------------
  document.getElementById('print-product')?.addEventListener('click', () => window.print());

  // ---------------- نوار چسبان موبایل ----------------
  // با IntersectionObserver به‌جای رویداد scroll: بدون هزینه‌ی محاسباتی روی
  // هر پیکسل اسکرول، که روی موبایل‌های ضعیف‌تر تفاوت محسوسی دارد.
  const buyBox = document.getElementById('buy-box');
  const stickyBar = document.getElementById('sticky-bar');

  if (buyBox && stickyBar && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        const hidden = entry.isIntersecting;
        stickyBar.classList.toggle('translate-y-full', hidden);
        // aria-hidden همگام نگه داشته می‌شود تا صفحه‌خوان محتوای تکراریِ
        // نامرئی را اعلام نکند.
        stickyBar.setAttribute('aria-hidden', String(hidden));
      },
      { rootMargin: '0px 0px -80px 0px' }
    );
    observer.observe(buyBox);
  }
</script>

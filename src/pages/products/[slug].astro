---
// src/pages/products/[slug].astro
// ---------------------------------------------------------------------------
// صفحه‌ی محصول — مهم‌ترین صفحه‌ی سایت.
//
// این صفحه حول رفتار واقعی کاربرش طراحی شده، نه حول الگوی عمومی فروشگاهی:
//
//   • او معمولاً قطعه‌ی خراب را در دست دارد و اولین سوالش «قیمت» نیست،
//     «آیا این همان قطعه است؟». به همین دلیل کد فنی، کدهای معادل و
//     مدل‌های سازگار بالاتر از هر چیز دیگری و در دسترس فوری‌اند.
//   • خرید صنعتی چندنفره است: مهندس نت پیدا می‌کند، مدیر خرید تایید
//     می‌کند. پس «اشتراک گذاری» و «چاپ مشخصات» ابزار واقعی کارند،
//     نه تزئین.
//   • او زیر فشار توقف خط تولید است. نوار اقدام چسبان موبایل و کپی
//     یک‌کلیکی کد فنی، اصطکاک را در همان لحظه کم می‌کنند.
//
// قاعده‌ی داده: هیچ فیلدی که مقدار واقعی ندارد ساخته یا حدس زده نمی‌شود.
// ---------------------------------------------------------------------------
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ProductGallery from '../../components/ProductGallery.astro';
import PartNumber from '../../components/PartNumber.astro';
import AuthenticityBadge from '../../components/AuthenticityBadge.astro';
import TrustBadges from '../../components/TrustBadges.astro';
import WarrantyNotice from '../../components/WarrantyNotice.astro';
import StockPill from '../../components/StockPill.astro';
import BuyBox from '../../components/BuyBox.astro';
import ActionBar from '../../components/ActionBar.astro';
import TwoTabs from '../../components/TwoTabs.astro';
import SpecTable from '../../components/SpecTable.astro';
import ProductRow from '../../components/ProductRow.astro';
import { whatsappInquiryHref } from '../../components/inquiry-message';
import { compactTrustBadges } from '../../data/trust';
import { warrantyFor } from '../../data/warranty';
import Community from '../../components/Community.astro';
import ContentBlocks from '../../components/ContentBlocks.astro';
import { getBlocks } from '../../lib/content-blocks';
import { aggregateRatingJsonLd, reviewsJsonLd } from '../../lib/community';
import Questions from '../../components/Questions.astro';
import { getQuestions, questionsJsonLd } from '../../lib/questions';
import { autolinkHtml } from '../../lib/autolink';
import { productReadiness } from '../../lib/indexability';
import { buildTitle, buildDescription } from '../../lib/seo-meta';
import { SITE } from '../../data/site';
import { findCategory, categoryPath, siloPath, findBrand } from '../../data/taxonomy';
import {
  getAllProducts,
  getRelatedProducts,
  computePrice,
  productJsonLd,
  productPath,
  inquiryHref,
  formatPrice,
  type CraneProduct,
} from '../../lib/wp';

export async function getStaticPaths() {
  const products = await getAllProducts();
  return Promise.all(
    products.map(async (product) => ({
      params: { slug: product.slug },
      props: { product, related: await getRelatedProducts(product) },
    }))
  );
}

interface Props {
  product: CraneProduct;
  related: CraneProduct[];
}

const { product, related } = Astro.props as Props;
const price = computePrice(product);

/* بلوک‌های محتوای اختیاری این محصول. برند و دسته از همان ابتدا این را
   داشتند؛ محصول فقط هرگز صدا زده نشده بود. */
const blocks = await getBlocks('product', product.slug);

const primaryCategory = product.categorySlugs.map((s) => findCategory(s)).find(Boolean) ?? null;
const brand = product.brandSlug ? findBrand(product.brandSlug) : undefined;

/* ⚠️ نام محصول تنها قطعه‌ی غیرقابل‌حذف است. عنوان SAGA1-L12 در ۹۱
   کاراکتر ساخته می‌شد و بریده می‌شد به ۵۷ — و چیزی که می‌افتاد «| کرین یدک»
   بود، یعنی نام برند از SERP حذف می‌شد و «…» جایش می‌نشست. */
const title = buildTitle(
  [product.name, product.sku ? `کد ${product.sku}` : null, SITE.name],
  `/products/${product.slug}/`,
);

/* متا دیسکریپشن از داده‌ی واقعی ساخته می‌شود، نه از یک قالب عمومی.
   ⚠️ این یکی `join(' — ').slice(0, 300)` بود — یعنی دقیقاً همان «قطعه‌ها را
   بچسبان بعد با کاراکتر ببر» که در عنوان‌ها اصلاحش کردیم و اینجا از قلم
   افتاد. خروجی‌اش ۲۴۲ کاراکتر بود و در Layout به ۱۵۸ بریده می‌شد، پس
   «فاکتور رسمی» همیشه می‌افتاد. */
const metaBrand = product.brandNameFa ? `برند ${product.brandNameFa}` : null;
const metaSku = product.sku ? `کد فنی ${product.sku}` : null;

const description = buildDescription(
  product.summary,
  [
    [metaBrand, metaSku, 'بررسی سازگاری فنی، استعلام قیمت و صدور فاکتور رسمی.']
      .filter(Boolean)
      .join(' — '),
    [metaBrand, metaSku, 'استعلام قیمت و فاکتور رسمی.'].filter(Boolean).join(' — '),
    [metaSku, 'استعلام قیمت و فاکتور رسمی.'].filter(Boolean).join(' — '),
    metaSku ?? '',
  ],
  `/products/${product.slug}/`,
);

const breadcrumbItems = [
  { label: 'صفحه اصلی', href: '/' },
  { label: 'دسته‌بندی‌ها', href: '/categories' },
  ...(primaryCategory
    ? [
        { label: primaryCategory.silo.name, href: siloPath(primaryCategory.silo) },
        { label: primaryCategory.name, href: categoryPath(primaryCategory) },
      ]
    : []),
  { label: product.name },
];

const canonical = `${SITE.url}${productPath(product)}`;

// محتوای کاربر → اسکیما. هر سه تابع اگر داده‌ی واقعی نباشد `undefined`
// برمی‌گردانند؛ هیچ امتیاز یا پرسشی اختراع نمی‌شود.
const wpBase = (import.meta.env.WP_GRAPHQL_URL as string | undefined)?.replace(/\/+$/, '') ?? null;
const pageUrl = `${SITE.url}/products/${product.slug}`;
/* پرسش‌های این محصول — از همان CPT که صفحه‌ی دسته می‌خواند. */
const questions = await getQuestions('product', product.slug);
const qaSchema = questionsJsonLd(questions, pageUrl);
const ratingSchema = aggregateRatingJsonLd(product.community);
const reviewSchema = reviewsJsonLd(product.community);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: breadcrumbItems.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: item.label,
        ...(item.href ? { item: `${SITE.url}${item.href}` } : {}),
      })),
    },
    // اسکیمای محصول با امتیاز و نظر *واقعی* غنی می‌شود. اگر نظری نباشد،
    // هیچ کلیدی اضافه نمی‌شود — نه یک شیء خالی، نه صفر.
    {
      ...productJsonLd(product, SITE.url, price),
      ...(ratingSchema ? { aggregateRating: ratingSchema } : {}),
      ...(reviewSchema ? { review: reviewSchema } : {}),
    },
    // QAPage فقط با پرسش پاسخ‌داده‌شده.
    ...(qaSchema ? [qaSchema] : []),
  ],
};

const hasFitment = product.oemCrossReference.length > 0 || product.compatibleModels.length > 0;
const heroImage = product.images[0] ?? null;

/* Frontend v2 (فاز ۱) — داده‌های نمایشی سرصفحه، اعتماد و نوار پایین. */
const keySpecs = product.technicalSpecs.slice(0, 4);
const hasTrust = compactTrustBadges(product.authenticity).length > 0;
const hasWarranty = !!warrantyFor(product.categorySlugs);

// تاریخ به‌روزرسانی واقعی از وردپرس — سیگنال تازگی برای کاربر و موتور
// جستجو. اگر وردپرس تاریخی نداده باشد، چیزی ساخته نمی‌شود.
const modifiedDate = product.modified
  ? new Date(product.modified).toLocaleDateString('fa-IR', { year: 'numeric', month: 'long', day: 'numeric' })
  : null;
import { getContact } from '../../lib/site-options';

/* ⚠️ اعلان‌های داده‌ی وردپرس بلافاصله بعد از import ها.
   قبلاً انتهای فرontmatter بودند و کدِ بالاتر که از آن‌ها استفاده
   می‌کرد با «Cannot access before initialization» می‌شکست:
   `const` هویست می‌شود اما تا نقطه‌ی اعلان در ناحیه‌ی مرده‌ی
   زمانی (TDZ) است و دسترسی به آن خطا می‌دهد. */
const contact = await getContact();

// نوار پایین: برچسب کوتاه قیمت + همان عمل اصلی جعبه‌ی خرید (تصمیم ۴: قلم استعلامی → واتساپ با نام و کد فنی).
const barPriceLabel = price.payable && price.effective !== null ? formatPrice(price.effective) : 'فروش استعلامی';
const barInquiryHref = price.payable ? null : whatsappInquiryHref(contact.whatsappHref, { name: product.name, sku: product.sku, url: canonical });
const BAR_PRIMARY = 'inline-flex items-center justify-center min-h-11 px-4 rounded-md bg-action text-white text-sm font-black whitespace-nowrap hover:bg-accent-ink';

---

<Layout title={title} description={description} jsonLd={jsonLd} ogImage={heroImage?.url} noindex={!productReadiness(product).ready} mobileBar={false}>
  {product.isDemo && (
    /* رکورد نمایشی — عمداً پررنگ و غیرقابل‌چشم‌پوشی. اگر روزی سهواً روی
       سایت زنده بماند، هم بازدیدکننده و هم تیم بلافاصله متوجه می‌شوند. */
    <div class="bg-amber-100 border-y-2 border-amber-400 px-4 py-3 print:hidden">
      <p class="max-w-7xl mx-auto text-sm font-bold text-amber-900">
        ⚠️ نمونه‌ی نمایشی — این رکورد فقط برای کار طراحی ساخته شده است. کد فنی و کدهای معادل آن واقعی نیستند و این صفحه در موتورهای جستجو ایندکس نمی‌شود.
      </p>
    </div>
  )}

  {/* ════════════════════ Frontend v2، فاز ۱ — ترتیب §4 ════════════════════
      موبایل، از بالا به پایین: مسیر یک‌خطی → هویت فشرده (نام، کد، برند، اصالت، موجودی) → گالری ۴:۳ → قیمت + یک
      عمل اصلی → چیپ‌های مشخصه → سازگاری → اعتماد و ضمانت (یک‌بار) → دو زبانه → توضیحات و پرسش‌ها.
      چرا هویت *پیش از* گالری (تحلیل کامل در §4): خریدارِ آمده از گوگل کد فنی جستجو کرده؛ اولین پرسشش «این صفحه‌ی
      همان کد است؟» است و فقط متن به آن پاسخ می‌دهد — ده ریموت شبیه هم‌اند. معیار پذیرش: کد، تصویر، قیمت و عمل
      اصلی همه در اولین صفحه‌ی ۳۹۰×۸۱۲.
      دسکتاپ (lg+): دو ستون — هویت و خرید در ستون راست (شروع RTL)، گالری چسبان در ستون چپ. همان DOM، فقط
      جای ستون‌ها با grid عوض می‌شود؛ ترتیب خواندن صفحه‌خوان همان ترتیب موبایل می‌ماند. */}
  <div class="bg-white border-b border-steel-300 print:border-0">
    <div class="max-w-7xl mx-auto px-4 md:px-6">
      <div class="print:hidden"><Breadcrumb items={breadcrumbItems} surface /></div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-x-10 gap-y-4 pb-6 lg:pb-10">
        {/* ── ۲) هویت فشرده ── */}
        <header class="lg:col-start-1 lg:col-span-7 lg:row-start-1 pt-1">
          <h1 class="text-xl md:text-2xl lg:text-3xl font-black text-steel-900 leading-[1.6] line-clamp-2 lg:line-clamp-none">{product.name}</h1>
          <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1">
            {product.sku && <PartNumber sku={product.sku} id="main" compact />}
            {brand && (
              <a href={`/brands/${brand.slug}`} class="inline-flex items-center min-h-11 text-sm font-bold text-steel-700 hover:text-accent-ink hover:underline underline-offset-4">
                {brand.nameFa}{' '}<span class="font-normal text-steel-500" dir="ltr">({brand.nameEn})</span>
              </a>
            )}
          </div>
          <div class="mt-1 flex flex-wrap items-center gap-2">
            {product.authenticity && <AuthenticityBadge authenticity={product.authenticity} full />}
            <StockPill status={product.stockStatus} />
          </div>
        </header>

        {/* ── ۳) گالری ── */}
        <div class="lg:col-start-8 lg:col-span-5 lg:row-start-1 lg:row-span-4 lg:sticky lg:top-40 xl:top-28 lg:self-start">
          <ProductGallery images={product.images} productName={product.name} />
        </div>

        {/* ── ۴) قیمت + یک عمل اصلی ──
            ⚠️ id="buy-box" قرارداد §7 است (لنگر و اسکریپت‌ها). سه نسخه‌ی تکراری اعتماد که این‌جا بود (قرص‌های بالای
            قیمت، TrustBadges، فهرست سه‌تایی) حذف شد — اعتماد یک‌بار، پایین‌تر (§4b). */}
        <section id="buy-box" class="lg:col-start-1 lg:col-span-7 lg:row-start-2 print:hidden" aria-label="قیمت و خرید">
          <BuyBox slug={product.slug} name={product.name} sku={product.sku} url={canonical} price={price} whatsappHref={contact.whatsappHref}>
            <Fragment slot="links">
              {/* علاقه‌مندی — وارد نشده: به ورود می‌رود و بعد به همین صفحه برمی‌گردد. ⚠️ idهای wish-* را اسکریپت پایین می‌خواند. */}
              <button type="button" id="wish-toggle" data-wish-slug={product.slug} aria-pressed="false"
                class="inline-flex items-center gap-1.5 min-h-11 text-sm font-bold text-steel-700 hover:text-steel-900">
                <svg id="wish-icon" class="w-4 h-4" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 20.5s-7.5-4.6-7.5-10.2A4.3 4.3 0 0112 7.6a4.3 4.3 0 017.5 2.7c0 5.6-7.5 10.2-7.5 10.2z" /></svg>
                <span id="wish-label">افزودن به علاقه‌مندی‌ها</span>
              </button>
              {/* ابزار کار واقعی: خرید صنعتی چندنفره است — ارسال به همکار و چاپ مشخصات برای تأیید داخلی. */}
              <button type="button" id="share-product" data-title={product.name} data-url={canonical}
                class="inline-flex items-center gap-1.5 min-h-11 text-sm font-bold text-steel-700 hover:text-steel-900">
                <span id="share-label">ارسال به همکار</span>
              </button>
              <button type="button" id="print-product" class="hidden lg:inline-flex items-center gap-1.5 min-h-11 text-sm font-bold text-steel-700 hover:text-steel-900">
                چاپ مشخصات
              </button>
            </Fragment>
          </BuyBox>
          {contact.telHref && (
            <p class="mt-1 text-sm text-steel-600">
              تماس: <a href={contact.telHref} class="font-bold text-steel-900 hover:text-accent-ink tabular-nums" dir="ltr">{contact.phoneDisplay}</a>
              <span class="text-steel-500"> — در ساعات کاری</span>
            </p>
          )}
        </section>

        {/* ── ۵) چیپ‌های مشخصه‌ی کلیدی (حداکثر ۴) → جدول کامل ──
            جدول فشرده‌ی شش‌ردیفی کنار خرید حذف شد: همان مشخصات سه بار تکرار می‌شد (§3). */}
        {keySpecs.length > 0 && (
          <div class="lg:col-start-1 lg:col-span-7 lg:row-start-3">
            <ul class="flex flex-wrap gap-2" role="list" aria-label="مشخصات کلیدی">
              {keySpecs.map((spec) => (
                <li class="rounded border border-steel-300 bg-steel-50 px-2 py-1 text-xs">
                  <span class="text-steel-600">{spec.label}:</span> <span class="font-bold text-steel-900" dir="auto">{spec.value}</span>
                </li>
              ))}
            </ul>
            {product.technicalSpecs.length > keySpecs.length && (
              <a href="#product-tabs-panel-1" class="mt-1 inline-flex items-center min-h-11 text-sm font-bold text-accent-ink hover:text-accent-strong hover:underline underline-offset-4">
                همه‌ی {product.technicalSpecs.length} مشخصه ↓
              </a>
            )}
          </div>
        )}

        {modifiedDate && (
          <p class="lg:col-start-1 lg:col-span-7 lg:row-start-4 text-xs text-steel-600">
            آخرین به‌روزرسانی اطلاعات این قطعه: <time datetime={product.modified!}>{modifiedDate}</time>
          </p>
        )}
      </div>
    </div>
  </div>

  {/* ── ۶) کدهای معادل و سازگاری (Fitment) ── */}
  {hasFitment && (
    <section class="bg-steel-50 px-4 md:px-6 py-8 border-b border-steel-300 print:bg-white print:py-4" aria-labelledby="fitment-heading">
      <div class="max-w-7xl mx-auto">
        <h2 id="fitment-heading" class="text-xl font-black text-steel-900 mb-2">کدهای معادل و سازگاری</h2>
        <p class="text-sm text-steel-700 leading-7 mb-5 max-w-3xl print:hidden">
          اگر کد روی قطعه‌ی فرسوده‌ی شما با کد بالا یکی نیست، جدول زیر را بررسی کنید؛ یک قطعه اغلب با چند کد مختلف سازنده عرضه می‌شود.
        </p>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
          {product.oemCrossReference.length > 0 && (
            <div class="bg-white rounded border border-steel-300 overflow-hidden">
              <table class="w-full text-sm text-right">
                <caption class="text-right font-black text-steel-900 px-3 py-2 bg-steel-100 border-b border-steel-300">کدهای معادل سازنده (OEM)</caption>
                <thead>
                  <tr class="text-steel-600 text-xs">
                    <th scope="col" class="font-bold px-3 py-2">سازنده</th>
                    <th scope="col" class="font-bold px-3 py-2">کد فنی</th>
                  </tr>
                </thead>
                <tbody>
                  {product.oemCrossReference.map((ref) => (
                    <tr class="border-t border-steel-200 even:bg-steel-50">
                      <td class="px-3 py-2 text-steel-700">{ref.oemBrand}</td>
                      <td class="px-3 py-2"><span class="inline-block font-mono font-bold text-steel-900 select-all" dir="ltr">{ref.oemPartNumber}</span></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
          {product.compatibleModels.length > 0 && (
            <div class="bg-white rounded border border-steel-300 overflow-hidden">
              <table class="w-full text-sm text-right">
                <caption class="text-right font-black text-steel-900 px-3 py-2 bg-steel-100 border-b border-steel-300">مدل‌های سازگار</caption>
                <thead>
                  <tr class="text-steel-600 text-xs">
                    <th scope="col" class="font-bold px-3 py-2">برند</th>
                    <th scope="col" class="font-bold px-3 py-2">مدل</th>
                  </tr>
                </thead>
                <tbody>
                  {product.compatibleModels.map((model) => (
                    <tr class="border-t border-steel-200 even:bg-steel-50">
                      <td class="px-3 py-2 text-steel-700">{model.craneBrand}</td>
                      <td class="px-3 py-2"><span class="inline-block font-mono font-bold text-steel-900 select-all" dir="ltr">{model.modelName}</span></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </div>
        <p class="text-sm text-steel-700 leading-7 mt-4 max-w-3xl print:hidden">
          مدل دستگاه شما در فهرست نیست؟ عکس پلاک دستگاه را بفرستید تا سازگاری بررسی شود —
          <a href={inquiryHref(product)} class="text-accent-ink font-bold hover:underline">بررسی سازگاری</a>.
        </p>
      </div>
    </section>
  )}

  {/* ── ۷) اعتماد و ضمانت — یک‌بار در کل صفحه (§4b) ── */}
  {(hasTrust || hasWarranty) && (
    <section class="bg-white px-4 md:px-6 py-6 border-b border-steel-300 print:hidden" aria-label="تضمین‌ها">
      <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-x-10">
        <TrustBadges variant="compact" authenticity={product.authenticity} />
        <WarrantyNotice categorySlugs={product.categorySlugs} bare />
      </div>
    </section>
  )}

  {/* ── ۸) دقیقاً دو زبانه (تصمیم ۳ کارفرما): «مشخصات فنی» و «محصولات مرتبط/سازگار». زبانه‌ی خالی رندر نمی‌شود. ── */}
  {product.technicalSpecs.length > 0 ? (
    <section class="bg-white px-4 md:px-6 py-8 border-b border-steel-300 print:py-4" aria-label="مشخصات و قطعات مرتبط">
      <div class="max-w-4xl mx-auto" id="specs-heading">
        <TwoTabs id="product-tabs" first="مشخصات فنی" second="محصولات مرتبط/سازگار">
          <SpecTable slot="first" caption={`جدول مشخصات فنی ${product.name}`} sticky rows={product.technicalSpecs.map((s) => ({ label: s.label, value: s.value }))} />
          {related.length > 0 && (
            <ul slot="second" class="bg-white border border-steel-300 rounded" role="list">
              {related.map((item) => (
                <ProductRow slug={item.slug} name={item.name} sku={item.sku} url={`${SITE.url}${productPath(item)}`} brand={item.brandNameFa}
                  keySpec={item.technicalSpecs[0]?.value ?? null} stock={item.stockStatus} price={computePrice(item)} whatsappHref={contact.whatsappHref} />
              ))}
            </ul>
          )}
        </TwoTabs>
      </div>
    </section>
  ) : related.length > 0 && (
    <section class="bg-white px-4 md:px-6 py-8 border-b border-steel-300 print:hidden" aria-labelledby="related-heading">
      <div class="max-w-4xl mx-auto">
        <h2 id="related-heading" class="text-xl font-black text-steel-900 mb-3">محصولات مرتبط/سازگار</h2>
        <ul class="bg-white border border-steel-300 rounded" role="list">
          {related.map((item) => (
            <ProductRow slug={item.slug} name={item.name} sku={item.sku} url={`${SITE.url}${productPath(item)}`} brand={item.brandNameFa}
              keySpec={item.technicalSpecs[0]?.value ?? null} stock={item.stockStatus} price={computePrice(item)} whatsappHref={contact.whatsappHref} />
          ))}
        </ul>
      </div>
    </section>
  )}

  {/* ── ۹) توضیحات ── */}
  {(product.summary || product.bodyHtml) && (
    <section class="bg-steel-50 px-4 md:px-6 py-8 border-b border-steel-300 print:hidden" aria-labelledby="description-heading">
      <div class="max-w-4xl mx-auto">
        <h2 id="description-heading" class="text-xl font-black text-steel-900 mb-4">توضیحات فنی محصول</h2>
        {/* خلاصه از سرصفحه این‌جا آمد: در سرصفحه، اولین صفحه‌ی موبایل را می‌گرفت و همان چیزی را می‌گفت که توضیحات
            کامل می‌گوید (اصل ۵). متن همان است؛ فقط جایش. */}
        {product.summary && <p class="text-base text-steel-800 leading-8 mb-4 font-bold">{product.summary}</p>}
        {/* لینک‌دهی داخلی خودکار روی متن محصول — بلندترین محتوای سایت که بدون این هیچ لینک داخلی نداشت. */}
        {product.bodyHtml && (
          <div
            class="prose-crane text-steel-700 leading-8"
            set:html={autolinkHtml(product.bodyHtml, { currentPath: Astro.url.pathname, max: 6 })}
          />
        )}
      </div>
    </section>
  )}

  {/* بلوک‌های محتوای اختیاری محصول — پس از توضیحات ویرایشگر و پیش از پرسش‌ها (محتوای تخصصی پیش از محتوای کاربر). */}
  <ContentBlocks blocks={blocks} title={product.name} eyebrow="در این صفحه" />

  <Questions
    questions={questions}
    entity="product"
    entitySlug={product.slug}
    productId={product.wpId}
    entityName={product.name}
    wpBase={wpBase}
  />

  {/* مستقل از related — پرسش کاربر درباره‌ی این قطعه به وجود قطعه‌ی مشابه وابسته نیست (باگ قبلی). */}
  <Community
    entries={product.community}
    productId={product.wpId}
    productName={product.name}
    wpBase={wpBase}
    class="print:hidden"
  />

  {/* ── ۱۰) نوار عمل پایین موبایل — جایگزین #sticky-bar و MobileCTA روی این صفحه (mobileBar={false}) ──
      از لحظه‌ی بارگذاری دیده می‌شود هر وقت دکمه‌ی اصلی جعبه‌ی خرید بیرون از دید است (ActionBar). ⚠️ برای قلم
      پرداخت‌پذیر همان دکمه‌ی سبد با data-*های قرارداد §7، و نسخه‌ی data-expired-only برای پس از انقضا. */}
  <ActionBar
    priceLabel={barPriceLabel}
    primaryLabel="استعلام در واتساپ"
    primaryHref={barInquiryHref ?? '#buy-box'}
    primaryExternal={!!barInquiryHref}
    whatsappHref={contact.whatsappHref}
    telHref={contact.telHref}
  >
    {price.payable && (
      <Fragment slot="primary">
        <button type="button" class={BAR_PRIMARY} data-cart-add={product.slug} data-basket-name={product.name} data-basket-sku={product.sku ?? ''}
          data-guard-until={price.validUntil} data-payable-only>
          <span data-basket-label>افزودن به سبد</span>
        </button>
        <button type="button" class={BAR_PRIMARY} hidden data-quote-add={product.slug} data-quote-mode="rfq" data-basket-name={product.name}
          data-basket-sku={product.sku ?? ''} data-guard-until={price.validUntil} data-expired-only>
          <span data-basket-label>افزودن به سبد استعلام</span>
        </button>
      </Fragment>
    )}
  </ActionBar>
</Layout>

<script>
  // ---------------- اشتراک گذاری ----------------
  // خرید صنعتی چندنفره است: مهندس نت قطعه را پیدا می‌کند، مدیر خرید تایید
  // می‌کند. Web Share API روی موبایل مستقیماً واتساپ/تلگرام را باز می‌کند —
  // همان کانالی که این انتقال واقعاً در آن اتفاق می‌افتد. روی دسکتاپ به
  // کپی لینک برمی‌گردد.
  const shareBtn = document.getElementById('share-product');
  const shareLabel = document.getElementById('share-label');

  shareBtn?.addEventListener('click', async () => {
    const title = shareBtn.dataset.title ?? document.title;
    const url = shareBtn.dataset.url ?? window.location.href;

    if (navigator.share) {
      try {
        await navigator.share({ title, url });
        return;
      } catch {
        // کاربر اشتراک‌گذاری را لغو کرد — این خطا نیست، کاری لازم نیست.
        return;
      }
    }

    try {
      await navigator.clipboard.writeText(url);
      if (shareLabel) shareLabel.textContent = 'لینک کپی شد ✓';
      setTimeout(() => { if (shareLabel) shareLabel.textContent = 'اشتراک گذاری'; }, 2000);
    } catch {
      if (shareLabel) shareLabel.textContent = 'کپی نشد';
    }
  });

  // ---------------- چاپ مشخصات ----------------
  document.getElementById('print-product')?.addEventListener('click', () => window.print());
</script>

<script>
  /* ------------------------- علاقه‌مندی‌ها -------------------------
     وضعیت اولیه با یک GET از فهرست کاربر خوانده می‌شود — فقط وقتی توکن
     هست. کاربرِ واردنشده هیچ درخواستی به سرور نمی‌فرستد. */
  import { api, getToken } from '../../scripts/account';

  const btn = document.getElementById('wish-toggle') as HTMLButtonElement | null;
  const icon = document.getElementById('wish-icon');
  const label = document.getElementById('wish-label');
  const slug = btn?.dataset.wishSlug ?? '';

  const paint = (on: boolean) => {
    if (!btn || !label || !icon) return;
    btn.setAttribute('aria-pressed', String(on));
    label.textContent = on ? 'در فهرست علاقه‌مندی‌ها' : 'افزودن به علاقه‌مندی‌ها';
    icon.setAttribute('fill', on ? 'currentColor' : 'none');
    btn.classList.toggle('text-red-700', on);
  };

  const toLogin = () => {
    location.href = `/account/login/?next=${encodeURIComponent(location.pathname)}`;
  };

  if (btn && slug) {
    if (getToken()) {
      void api<{ items?: { slug: string }[] }>('/account/wishlist', { auth: true }).then((res) => {
        if (res.ok) paint((res.data.items ?? []).some((i) => i.slug === slug));
      });
    }

    btn.addEventListener('click', async () => {
      if (!getToken()) return toLogin();
      const on = btn.getAttribute('aria-pressed') === 'true';
      btn.disabled = true;
      const res = await api('/account/wishlist', {
        method: 'POST',
        auth: true,
        body: { slug, action: on ? 'remove' : 'add' },
      });
      btn.disabled = false;
      if (res.status === 401) return toLogin();
      if (res.ok) paint(!on);
      else if (label) label.textContent = 'خطا — دوباره تلاش کنید';
    });
  }
</script>

---
// src/pages/products/index.astro
// ---------------------------------------------------------------------------
// آرشیو محصولات با فیلتر وجهی (faceted) — جایگزین PartFinder.
//
// چرا PartFinder حذف شد: یک فرم سه‌مرحله‌ای بود که کاربر باید *پیش از*
// دیدن هر محصولی پر می‌کرد. الگوی «اول فرم، بعد نتیجه» متعلق به دوران
// پیش از فیلتر زنده است. رفتار امروزی — دیجی‌کالا، آمازون، گرینجر —
// برعکس است: همه‌ی محصولات را نشان بده، بگذار کاربر با فیلتر باریکشان کند
// و تعداد نتایج را لحظه‌ای ببیند. کاربر هرگز به بن‌بست «هیچ نتیجه‌ای
// یافت نشد» بعد از پرکردن فرم نمی‌خورد، چون همیشه می‌بیند چه چیزی هست.
//
// معماری: سایت استاتیک است، پس همه‌ی محصولات یک‌بار در زمان build رندر
// می‌شوند و فیلتر کاملاً سمت کلاینت روی همان DOM اجرا می‌شود — بدون
// درخواست شبکه و بدون بارگذاری مجدد صفحه.
//
// وضعیت فیلترها در URL نوشته می‌شود (history.replaceState). سه دلیل:
//   ۱) کاربر می‌تواند نتیجه‌ی فیلترشده را برای همکارش بفرستد.
//   ۲) دکمه‌ی بازگشت مرورگر رفتار منطقی دارد.
//   ۳) رفرش صفحه فیلترها را از دست نمی‌دهد.
//
// سئو: وقتی دست‌کم یک محصولِ *کامل* هست، صفحه ایندکس‌پذیر است — صفحه‌ی
// پایه ارزش دارد. اما هر ترکیب فیلتر canonical را به همین آدرس پایه
// برمی‌گرداند تا میلیون‌ها آدرس پارامتردار محتوای تکراری نسازند.
// ⚠️ بدون هیچ محصول کامل، این آرشیو یک فروشگاه خالی است (محتوای نازک) → noindex؛
// با اولین محصول کامل در build بعدی خودکار ایندکس‌پذیر می‌شود (src/lib/indexability.ts).
// ---------------------------------------------------------------------------
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import ProductRow from '../../components/ProductRow.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CategoryFilterBar from '../../components/CategoryFilterBar.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getAllProducts, computePrice, productPath } from '../../lib/wp';
import { SILOS, BRANDS } from '../../data/taxonomy';
import { getContact } from '../../lib/site-options';
import { fa } from '../../components/catalog-presence';
import { SITE } from '../../data/site';
import { productReadiness } from '../../lib/indexability';

const all = await getAllProducts();

// رکوردهای نمایشی هرگز وارد آرشیو عمومی نمی‌شوند.
const products = all.filter((p) => !p.isDemo);

// فقط برندها و دسته‌هایی که واقعاً محصول دارند به‌عنوان فیلتر نمایش داده
// می‌شوند. یک فیلتر که همیشه صفر نتیجه می‌دهد، بدتر از نبودنش است.
const brandCounts = new Map<string, number>();
const categoryCounts = new Map<string, number>();
for (const p of products) {
  if (p.brandSlug) brandCounts.set(p.brandSlug, (brandCounts.get(p.brandSlug) ?? 0) + 1);
  for (const c of p.categorySlugs) categoryCounts.set(c, (categoryCounts.get(c) ?? 0) + 1);
}

const activeBrands = BRANDS.filter((b) => brandCounts.has(b.slug));
const activeSilos = SILOS.map((silo) => ({
  silo,
  categories: silo.categories.filter((c) => categoryCounts.has(c.slug)),
})).filter((g) => g.categories.length > 0);

const noindexArchive = !products.some((p) => productReadiness(p).ready);

const contact = await getContact();
// چیپ دسته‌ی نوار فیلتر: فقط دسته‌های دارای کالا (تصمیم D).
const categoryChips = activeSilos.flatMap(({ categories }) =>
  categories.map((c) => ({ slug: c.slug, name: c.name, count: categoryCounts.get(c.slug) ?? 0 })),
);

const title = `همه‌ی قطعات جرثقیل سقفی | ${products.length} قطعه — کرین یدک`;
const description = `فهرست کامل قطعات جرثقیل سقفی با فیلتر برند، دسته‌بندی و موجودی. جستجو با کد فنی، بررسی سازگاری و صدور فاکتور رسمی.`;

const crumbs = [
  { name: 'صفحه اصلی', href: '/' },
  { name: 'همه‌ی محصولات', href: '/products' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${SITE.url}/products#webpage`,
      url: `${SITE.url}/products`,
      name: title,
      description,
      isPartOf: { '@id': `${SITE.url}/#website` },
      inLanguage: SITE.locale,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: crumbs.map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: c.name,
        item: `${SITE.url}${c.href}`,
      })),
    },
  ],
};

/**
 * داده‌ی فیلتر روی هر ردیف/کارت — CategoryFilterBar می‌خواند (همان نوار صفحه‌ی دسته؛ فاز ۳).
 * ⚠️ هر محصول دو بار در DOM است (جدول و کارت)؛ شمار نتیجه با data-slug یکتا می‌شود.
 */
function facetAttrs(p: (typeof products)[number]) {
  const price = computePrice(p);
  return {
    'data-cat-item': '',
    'data-slug': p.slug,
    'data-brand': p.brandSlug ?? '',
    'data-categories': p.categorySlugs.join(' '),
    'data-stock': p.stockStatus,
    'data-priced': price.payable ? '1' : '0',
    'data-price': price.payable && price.effective !== null ? String(price.effective) : '',
    'data-modified': p.modified ?? '',
  };
}
---

<Layout title={title} description={description} jsonLd={jsonLd} noindex={noindexArchive}>
  {/* Frontend v2 فاز ۳ (بازبینی ۲ آبان ۱۴۰۵): همان نوار فیلتر افقی و نمای جدول صفحه‌ی دسته، تا «فروشگاه» در هدر
      دقیقاً همان تجربه باشد — نه نوار کناری و مرتب‌سازی جدا. پیوندهای قدیمی (brand=a,b، cat=…، stock=1) هنوز کار می‌کنند. */}
  <section class="bg-white border-b border-steel-300 px-4 md:px-6">
    <div class="max-w-7xl mx-auto pb-5">
      <Breadcrumb items={crumbs.map((c, i) => ({ label: c.name, href: i < crumbs.length - 1 ? c.href : undefined }))} surface />
      <h1 class="mt-1 text-2xl md:text-3xl font-black text-steel-900 leading-[1.5]">همه‌ی قطعات جرثقیل سقفی</h1>
      <p class="mt-2 text-base text-steel-700 leading-8">
        {fa(products.length)} قطعه در {fa(categoryChips.length)} دسته و {fa(activeBrands.length)} برند.
      </p>
    </div>
  </section>

  <section class="bg-steel-50 px-4 md:px-6 py-6 md:py-8" aria-label="فهرست همه‌ی قطعات">
    <div class="max-w-7xl mx-auto">
      {products.length === 0 ? (
        <EmptyState title="هنوز محصولی منتشر نشده است." text="کاتالوگ در حال تکمیل است. کد فنی یا عکس پلاک را بفرستید تا مستقیم استعلام کنیم."
          whatsappHref={contact.whatsappHref} telHref={contact.telHref} />
      ) : (
        <>
          <p class="text-sm text-steel-600 mb-3"><strong data-cat-count class="text-steel-900 font-black tabular-nums">{fa(products.length)}</strong> قطعه</p>
          <CategoryFilterBar products={products} categories={categoryChips} sortable />

          <div data-cat-view="list" hidden>
            <div class="hidden lg:grid lg:grid-cols-[7rem_9rem_1fr_7rem_10rem_8rem_9rem_auto] gap-x-4 px-3 py-2 text-xs font-bold text-steel-600 bg-steel-100 border border-steel-300 border-b-0 rounded-t">
              <span><span class="sr-only">تصویر</span></span><span>کد فنی</span><span>نام قطعه</span><span>برند</span><span>مشخصه‌ی کلیدی</span><span>موجودی</span><span>قیمت</span><span class="sr-only">عمل</span>
            </div>
            <ul class="bg-white border border-steel-300 rounded lg:rounded-t-none" role="list">
              {products.map((product) => (
                <ProductRow slug={product.slug} name={product.name} sku={product.sku} url={`${SITE.url}${productPath(product)}`}
                  brand={product.brandNameFa} keySpec={product.technicalSpecs[0]?.value ?? null} stock={product.stockStatus}
                  price={computePrice(product)} whatsappHref={contact.whatsappHref} image={product.images[0] ?? null} attrs={facetAttrs(product)} />
              ))}
            </ul>
          </div>

          <ul data-cat-view="grid" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4" role="list">
            {products.map((product) => (
              <li {...facetAttrs(product)}><ProductCard product={product} /></li>
            ))}
          </ul>

          <div data-cat-empty hidden class="mt-4">
            <EmptyState title="هیچ قطعه‌ای با این فیلترها پیدا نشد." text="فیلترها را کمتر کنید یا کد فنی و عکس پلاک را بفرستید تا معادل مناسب را پیدا کنیم."
              whatsappHref={contact.whatsappHref} telHref={contact.telHref} />
          </div>
        </>
      )}
    </div>
  </section>
</Layout>

---
// src/pages/search.astro
// ---------------------------------------------------------------------------
// صفحه‌ی جستجو — عمداً noindex (صرفه‌جویی در بودجه‌ی خزش).
//
// ═══ رفع باگ بیلد: Failed to resolve import "/pagefind/pagefind-ui.js" ═══
//
// علت واقعی: نسخه‌ی قبل کامنت `/* @vite-ignore */` را روی یک import با
// **رشته‌ی ثابت** گذاشته بود. آن کامنت فقط زمانی مؤثر است که مشخصه‌ی
// import یک *عبارت* باشد (متغیر). با رشته‌ی ثابت، Vite همچنان مسیر را در
// زمان build به‌صورت استاتیک resolve می‌کند — و چون Pagefind فایل را در
// مرحله‌ی `postbuild` (بعد از astro build) می‌سازد، هنوز وجود ندارد و کل
// بیلد شکست می‌خورد.
//
// راه‌حل: مسیر در زمان اجرا ساخته می‌شود تا هیچ تحلیل استاتیکی نتواند آن
// را به یک فایل نگاشت کند. CSS هم به همین دلیل با JS تزریق می‌شود، نه با
// یک تگ <link> که Astro ممکن است در زمان build دنبالش برود.
//
// ═══ رفتار جستجو ═══
// سه لایه، به ترتیب کاهش قطعیت:
//   ۱) پیشنهاد آنی دسته/برند از داده‌ی ثابت (همیشه کار می‌کند)
//   ۲) نتایج تمام‌متن Pagefind (اگر ایندکس ساخته و بارگذاری شده باشد)
//   ۳) حالت «پیدا نشد» با نزدیک‌ترین گزینه‌ها — نه پیام خطا
// حتی اگر لایه‌ی ۲ کاملاً از کار بیفتد، کاربر همچنان مسیر ادامه دارد.
// ---------------------------------------------------------------------------
import Layout from '../layouts/Layout.astro';
import SearchBox from '../components/SearchBox.astro';
import { SILOS, siloPath, ALL_CATEGORIES } from '../data/taxonomy';

// دسته‌های پیشنهادی برای حالت «چیزی پیدا نشد» — از تاکسونومی واقعی.
const fallbackSilos = SILOS;
---

<Layout
  title="جستجوی قطعات جرثقیل سقفی | کرین یدک"
  description="جستجوی سریع قطعات جرثقیل سقفی با کد فنی، نام قطعه یا برند."
  noindex={true}
>
  <section class="max-w-4xl mx-auto px-4 py-10 md:py-14 min-h-[60vh]">
    <h1 class="text-2xl md:text-3xl font-black text-steel-900 mb-2">جستجوی قطعات</h1>
    <p class="text-steel-600 leading-7 mb-6">
      کد فنی، نام قطعه یا نام برند را وارد کنید. پیشنهادها از همان اولین حرف نمایش داده می‌شوند.
    </p>

    <SearchBox id="page-search" tone="light" autofocus={true} class="mb-8" />

    {/* نتایج Pagefind اینجا می‌نشیند. اگر Pagefind در دسترس نباشد این
        بخش خالی می‌ماند و بخش «مسیرهای جایگزین» پایین همچنان کار می‌کند. */}
    <div id="pagefind-results" class="min-h-[4rem]"></div>

    {/* ---------------------------------------------------------------
        مسیرهای جایگزین — همیشه در صفحه هست، حتی وقتی جستجو موفق است.
        کاربری که نتیجه نمی‌گیرد نباید به بن‌بست بخورد؛ و کاربری که
        نتیجه گرفته هم از دیدن ساختار کاتالوگ ضرر نمی‌کند.
    --------------------------------------------------------------- */}
    <section class="mt-10 pt-8 border-t border-steel-300" aria-labelledby="browse-heading">
      <h2 id="browse-heading" class="text-lg font-black text-steel-900 mb-1">
        یا از روی دسته‌بندی پیش بروید
      </h2>
      <p class="text-sm text-steel-600 leading-7 mb-5">
        {ALL_CATEGORIES.length} دسته قطعه در {SILOS.length} گروه فنی.
      </p>

      <ul role="list" class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2">
        {
          fallbackSilos.map((silo) => (
            <li>
              <a
                href={siloPath(silo)}
                class="flex items-center justify-between gap-3 py-2 border-b border-steel-100 text-sm text-steel-700 hover:text-accent-ink focus:outline-none focus:ring-2 focus:ring-accent rounded"
              >
                <span class="font-bold truncate">{silo.name}</span>
                <span class="text-xs text-steel-600 tabular-nums shrink-0">
                  {silo.categories.length} دسته
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <noscript>
      <p class="text-steel-700 leading-8 bg-steel-50 p-5 rounded-lg border border-steel-300 mt-8">
        جستجوی زنده به جاوااسکریپت نیاز دارد. از فهرست دسته‌بندی‌های بالا می‌توانید قطعه‌ی
        موردنظر را پیدا کنید.
      </p>
    </noscript>
  </section>
</Layout>

<script>
  // ⚠️ این مسیرها عمداً از قطعات جدا ساخته می‌شوند.
  // یک رشته‌ی ثابت مثل '/pagefind/pagefind-ui.js' را Vite در زمان build
  // به‌صورت استاتیک resolve می‌کند و چون فایل هنوز ساخته نشده، بیلد
  // می‌شکند — همان باگی که این فایل برای رفعش بازنویسی شد. با ساختن
  // مسیر در زمان اجرا، هیچ تحلیل استاتیکی نمی‌تواند آن را دنبال کند.
  const PF_DIR = '/' + 'pagefind';
  const PF_JS = PF_DIR + '/pagefind-ui.js';
  const PF_CSS = PF_DIR + '/pagefind-ui.css';

  function currentQuery(): string {
    const p = new URLSearchParams(window.location.search);
    // ابزار Part-Finder سه پارامتر pn/brand/cat می‌فرستد؛ اگر q نبود،
    // آن‌ها به یک عبارت واحد ترکیب می‌شوند تا آن فرم به صفحه‌ی خالی نرسد.
    return (
      p.get('q') ||
      ['pn', 'brand', 'cat']
        .map((k) => (p.get(k) ?? '').trim())
        .filter(Boolean)
        .join(' ')
    );
  }

  async function initPagefind() {
    const host = document.getElementById('pagefind-results');
    if (!host) return;

    const q = currentQuery();
    const input = document.getElementById('page-search') as HTMLInputElement | null;
    if (q && input && !input.value) input.value = q;

    try {
      // CSS با JS تزریق می‌شود تا در زمان build دنبال نشود.
      if (!document.querySelector(`link[href="${PF_CSS}"]`)) {
        const link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = PF_CSS;
        document.head.appendChild(link);
      }

      const mod = await import(/* @vite-ignore */ PF_JS);
      const PagefindUI = mod.PagefindUI;
      if (!PagefindUI) throw new Error('PagefindUI export not found');

      const mount = document.createElement('div');
      host.appendChild(mount);

      new PagefindUI({
        element: mount,
        showSubResults: true,
        showImages: false,
        // فهرست پیشنهاد بالای صفحه کار اتوکامپلیت را می‌کند؛ کادر جستجوی
        // خود Pagefind اینجا اضافی و گیج‌کننده است.
        translations: {
          placeholder: 'جستجو در محصولات...',
          clear_search: 'پاک کردن',
          load_more: 'نمایش نتایج بیشتر',
          search_label: 'جستجو در محصولات',
          zero_results: 'محصولی برای [SEARCH_TERM] پیدا نشد.',
          many_results: '[COUNT] محصول برای [SEARCH_TERM]',
          one_result: 'یک محصول برای [SEARCH_TERM]',
          searching: 'در حال جستجو...',
        },
      });

      if (q) {
        const pfInput = mount.querySelector<HTMLInputElement>('input[type="text"]');
        if (pfInput) {
          pfInput.value = q;
          pfInput.dispatchEvent(new Event('input', { bubbles: true }));
        }
      }
    } catch {
      // ⚠️ عمداً هیچ پیام خطایی نشان داده نمی‌شود.
      //
      // این حالت در دو وضعیت کاملاً عادی رخ می‌دهد: (۱) `npm run dev`، چون
      // ایندکس Pagefind فقط در build ساخته می‌شود؛ (۲) بیلدی که هنوز
      // محصولی ندارد. در هر دو، نمایش «سیستم جستجو در دسترس نیست» به
      // بازدیدکننده می‌گوید سایت خراب است — در حالی که فهرست پیشنهاد و
      // دسته‌بندی‌ها کاملاً کار می‌کنند.
      host.innerHTML = '';
    }
  }

  initPagefind();
</script>

---
// src/pages/search.astro
// Pagefind search page - intentionally noindex to save crawl budget
import Layout from '../layouts/Layout.astro';
---

<Layout title="جستجوی قطعات | کرین یدک" description="جستجوی سریع قطعات جرثقیل سقفی با کد فنی یا نام محصول." noindex={true}>
  <section class="max-w-4xl mx-auto px-4 py-16 min-h-[60vh]">
    <h1 class="text-3xl md:text-4xl font-black text-crane-navy mb-8">جستجو در فروشگاه</h1>
    <div id="search" class="min-h-[300px]"></div>
    <noscript>
      <p class="text-gray-600 leading-8 text-center bg-gray-50 p-6 rounded-xl border border-gray-200">
        برای استفاده از موتور جستجوی هوشمند، لطفاً جاوااسکریپت مرورگر خود را فعال کنید. <br/>
        شما همچنین می‌توانید از <a href="/categories" class="text-crane-orange font-bold hover:underline">لیست دسته‌بندی‌ها</a> قطعه مورد نظر خود را بیابید.
      </p>
    </noscript>
  </section>
</Layout>

<script>
  async function initSearch() {
    const el = document.getElementById('search');
    if (!el) return;
    try {
      // @ts-expect-error Pagefind is built dynamically
      const { PagefindUI } = await import('/pagefind/pagefind-ui.js');
      const params = new URLSearchParams(window.location.search);
      new PagefindUI({
        element: '#search',
        showSubResults: true,
        showImages: false,
        translations: {
          placeholder: 'جستجوی قطعه، برند یا کد فنی...',
          clear_search: 'پاک کردن',
          load_more: 'نمایش نتایج بیشتر',
          search_label: 'جستجو در سایت',
          zero_results: 'هیچ نتیجه‌ای برای [SEARCH_TERM] یافت نشد.',
          many_results: '[COUNT] نتیجه برای [SEARCH_TERM] پیدا شد',
          one_result: 'یک نتیجه برای [SEARCH_TERM] پیدا شد',
          searching: 'در حال جستجو...',
        },
      });

      const q = params.get('q');
      if (q) {
        const input = el.querySelector<HTMLInputElement>('input[type="text"]');
        if (input) {
          input.value = q;
          input.dispatchEvent(new Event('input', { bubbles: true }));
        }
      }
    } catch {
      el.innerHTML = '<p class="text-gray-600 leading-8 text-center bg-red-50 p-6 rounded-xl border border-red-100">سیستم جستجو در حالت توسعه در دسترس نیست. <a class="text-crane-orange font-bold" href="/categories">مشاهده دسته‌بندی‌ها</a>.</p>';
    }
  }
  initSearch();
</script>

<link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
<style is:global>
  :root {
    --pagefind-ui-primary: #0a192f;
    --pagefind-ui-text: #0a192f;
    --pagefind-ui-background: #ffffff;
    --pagefind-ui-border: #e5e7eb;
    --pagefind-ui-tag: #f8fafc;
    --pagefind-ui-border-radius: 0.75rem;
    /* نکته دیباگ: قبلاً به فونت تجاری 'IRANSansX' اشاره می‌کرد که هرگز در
       پروژه وجود نداشت (۴۰۴ در بارگذاری فونت). سایت اکنون سراسر از
       Vazirmatn (سلف‌هاست، متن‌باز) استفاده می‌کند — همان مقداری که در
       src/styles/global.css به‌عنوان --font-sans تعریف شده. */
    --pagefind-ui-font: 'Vazirmatn', sans-serif;
  }
  .pagefind-ui {
    direction: rtl;
    text-align: right;
  }
</style>
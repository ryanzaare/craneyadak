---
// src/pages/blog/[slug].astro
// صفحه‌ی اختصاصی هر مقاله — پیش‌تر این مقصد وجود نداشت و لینک «مطالعه مقاله»
// در src/pages/blog/index.astro به href="#" (لینک مرده) اشاره می‌کرد؛ یعنی
// صفر ارزش کرال/PageRank و صفر محتوای واقعی برای رتبه گرفتن روی کوئری‌های
// آموزشی/معنایی (Semantic SEO). این صفحه آن گپ را می‌بندد.
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { buildTitle } from '../../lib/seo-meta';
import { SITE } from '../../data/site';
import { getPosts, type BlogPost } from '../../lib/posts';
import { getAuthorByName } from '../../lib/authors';
import AuthorBox from '../../components/AuthorBox.astro';

export async function getStaticPaths() {
  return (await getPosts()).map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
/* ⚠️ این صفحه از قلم افتاده بود: دسته و برند و محصول به عنوانِ قطعه‌ای
   منتقل شدند ولی مقاله نه. «راهنمای کالیبراسیون…» با دُم کامل ۶۴ کاراکتر
   می‌شد و بریده می‌شد. حالا قطعه‌ی آخر کنار می‌رود، نه وسط کلمه. */
const title = buildTitle([post.title, 'مجله تخصصی', SITE.name], `/blog/${post.slug}/`);
const description = post.excerpt;
const canonicalPostUrl = `${SITE.url}/blog/${post.slug}`;

/* ⚠️ نویسنده‌ی واقعی از وردپرس. اگر پروفایلش پیدا نشود `null` می‌ماند و
   جعبه‌ی نویسنده رندر نمی‌شود — بهتر از نسبت‌دادن مقاله به آدم اشتباه یا
   چاپ یک نام هاردکد. */
const author = await getAuthorByName(post.authorName);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalPostUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'صفحه اصلی', item: SITE.url },
        { '@type': 'ListItem', position: 2, name: 'مجله تخصصی', item: `${SITE.url}/blog` },
        { '@type': 'ListItem', position: 3, name: post.title, item: canonicalPostUrl },
      ],
    },
    {
      '@type': 'BlogPosting',
      '@id': `${canonicalPostUrl}#article`,
      mainEntityOfPage: { '@id': `${canonicalPostUrl}#webpage` },
      headline: post.title,
      description: post.excerpt,
      datePublished: post.isoDate,
      dateModified: post.isoModified,
      articleSection: post.category,
      inLanguage: SITE.locale,
      image: `${SITE.url}/og-default.jpg`,
      /* ⚠️ نویسنده‌ی واقعی، نه سازمان. در دسته‌ی YMYL (قطعه‌ای که بار
         چندتنی را نگه می‌دارد)، نویسنده‌ی قابل‌شناسایی یک سیگنال E-E-A-T
         است و «Organization» آن را خنثی می‌کرد. */
      author: author
        ? {
            '@type': 'Person',
            name: author.name,
            ...(author.jobTitle ? { jobTitle: author.jobTitle } : {}),
            ...(author.expertise.length ? { knowsAbout: author.expertise } : {}),
            ...(author.bio ? { description: author.bio } : {}),
          }
        : { '@type': 'Organization', '@id': `${SITE.url}/#organization`, name: SITE.name },
      publisher: { '@id': `${SITE.url}/#organization` },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalPostUrl}#webpage`,
      url: canonicalPostUrl,
      name: title,
      description,
      isPartOf: { '@id': `${SITE.url}/#website` },
      inLanguage: SITE.locale,
    },
  ],
};
---

<Layout title={title} description={description} jsonLd={jsonLd} isArticle={true}>
  <section class="bg-crane-navy text-white pt-12 pb-16 px-4 border-b-[8px] border-crane-orange relative">
    <div class="max-w-4xl mx-auto relative z-10">
      <Breadcrumb items={[{ label: 'صفحه اصلی', href: '/' }, { label: 'مجله تخصصی', href: '/blog' }, { label: post.title }]} />
      <span class="inline-block px-3 py-1 rounded-full bg-white/10 text-gray-300 text-xs font-black tracking-widest mb-4 uppercase border border-white/20">{post.category}</span>
      <h1 class="text-3xl md:text-4xl font-black mb-4 tracking-tight leading-tight drop-shadow-md">{post.title}</h1>
      <time datetime={post.isoDate} class="text-sm text-gray-400 font-bold">
        {post.date}{author ? ` — ${author.name}` : ''}
      </time>
    </div>
  </section>

  <section class="py-16 px-4 bg-white">
    <article class="max-w-3xl mx-auto text-gray-700 leading-9 text-right text-lg space-y-6">
      {/* ⚠️ بدنه حالا یک HTML واحد از ویرایشگر وردپرس است، نه آرایه‌ی
          پاراگراف. `prose-crane` همان استایلی است که بلوک‌های متن دارند،
          پس مقاله و صفحه‌ی برند یک‌شکل دیده می‌شوند. */}
      <div class="prose-crane" set:html={post.bodyHtml} />

      {/* جعبه‌ی نویسنده — ساخته شده بود و هیچ صفحه‌ای استفاده‌اش نمی‌کرد. */}
      {author && <AuthorBox author={author} reviewedAt={post.isoModified} class="mt-12" />}
    </article>

    <div class="max-w-3xl mx-auto mt-16 bg-crane-light rounded-3xl p-8 md:p-10 border border-gray-200 text-center">
      <h2 class="text-xl md:text-2xl font-black text-crane-navy mb-3">قطعه مورد نظر خود را پیدا نکردید؟</h2>
      <p class="text-gray-600 leading-7 mb-6">کد فنی یا عکس قطعه را برای کارشناسان فنی کرین یدک ارسال کنید تا امکان تامین و زمان تحویل بررسی شود.</p>
      <a href="/contact" class="inline-block bg-crane-orange text-white px-8 py-3.5 rounded-full font-bold hover:bg-orange-800 transition-colors focus:outline-none focus:ring-4 focus:ring-crane-orange/40">ثبت درخواست استعلام</a>
    </div>

    <nav class="max-w-3xl mx-auto mt-10 flex justify-between items-center text-sm font-bold" aria-label="بازگشت به مجله">
      <a href="/blog" class="text-crane-orange hover:underline flex items-center gap-2">
        <svg class="w-4 h-4 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        بازگشت به مجله تخصصی
      </a>
    </nav>
  </section>
</Layout>

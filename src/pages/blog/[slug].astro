---
// src/pages/blog/[slug].astro
// صفحه‌ی اختصاصی هر مقاله — پیش‌تر این مقصد وجود نداشت و لینک «مطالعه مقاله»
// در src/pages/blog/index.astro به href="#" (لینک مرده) اشاره می‌کرد؛ یعنی
// صفر ارزش کرال/PageRank و صفر محتوای واقعی برای رتبه گرفتن روی کوئری‌های
// آموزشی/معنایی (Semantic SEO). این صفحه آن گپ را می‌بندد.
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { buildTitle } from '../../lib/seo-meta';
import { SITE } from '../../data/site';
import { getPosts, type BlogPost } from '../../lib/posts';
import { getAuthorByName } from '../../lib/authors';
import AuthorBox from '../../components/AuthorBox.astro';
import { buildToc } from '../../components/toc';

export async function getStaticPaths() {
  return (await getPosts()).map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
/* ⚠️ این صفحه از قلم افتاده بود: دسته و برند و محصول به عنوانِ قطعه‌ای
   منتقل شدند ولی مقاله نه. «راهنمای کالیبراسیون…» با دُم کامل ۶۴ کاراکتر
   می‌شد و بریده می‌شد. حالا قطعه‌ی آخر کنار می‌رود، نه وسط کلمه. */
const title = buildTitle([post.title, 'مجله تخصصی', SITE.name], `/blog/${post.slug}/`);
const description = post.excerpt;
const canonicalPostUrl = `${SITE.url}/blog/${post.slug}`;

/* ⚠️ نویسنده‌ی واقعی از وردپرس. اگر پروفایلش پیدا نشود `null` می‌ماند و
   جعبه‌ی نویسنده رندر نمی‌شود — بهتر از نسبت‌دادن مقاله به آدم اشتباه یا
   چاپ یک نام هاردکد. */
const author = await getAuthorByName(post.authorName);
// فهرست مطالب (فاز ۵) فقط با ۳ سرفصل یا بیشتر — برای دو سرفصل، فهرست از خودِ متن بلندتر است.
const toc = buildToc(post.bodyHtml);
const showToc = toc.items.length >= 3;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalPostUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'صفحه اصلی', item: SITE.url },
        { '@type': 'ListItem', position: 2, name: 'مجله تخصصی', item: `${SITE.url}/blog` },
        { '@type': 'ListItem', position: 3, name: post.title, item: canonicalPostUrl },
      ],
    },
    {
      '@type': 'BlogPosting',
      '@id': `${canonicalPostUrl}#article`,
      mainEntityOfPage: { '@id': `${canonicalPostUrl}#webpage` },
      headline: post.title,
      description: post.excerpt,
      datePublished: post.isoDate,
      dateModified: post.isoModified,
      articleSection: post.category,
      inLanguage: SITE.locale,
      image: `${SITE.url}/og-default.jpg`,
      /* ⚠️ نویسنده‌ی واقعی، نه سازمان. در دسته‌ی YMYL (قطعه‌ای که بار
         چندتنی را نگه می‌دارد)، نویسنده‌ی قابل‌شناسایی یک سیگنال E-E-A-T
         است و «Organization» آن را خنثی می‌کرد. */
      author: author
        ? {
            '@type': 'Person',
            name: author.name,
            ...(author.jobTitle ? { jobTitle: author.jobTitle } : {}),
            ...(author.expertise.length ? { knowsAbout: author.expertise } : {}),
            ...(author.bio ? { description: author.bio } : {}),
          }
        : { '@type': 'Organization', '@id': `${SITE.url}/#organization`, name: SITE.name },
      publisher: { '@id': `${SITE.url}/#organization` },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalPostUrl}#webpage`,
      url: canonicalPostUrl,
      name: title,
      description,
      isPartOf: { '@id': `${SITE.url}/#website` },
      inLanguage: SITE.locale,
    },
  ],
};
---

<Layout title={title} description={description} jsonLd={jsonLd} isArticle={true}>
  {/* Frontend v2 فاز ۵: نوار عنوان روشن زیر هدر گرافیت (هم‌خانواده‌ی دسته/محصول)، نه نوار تیره‌ی دوم با خط ۸px. */}
  <section class="bg-white text-steel-900 border-b border-steel-300 px-4 py-6 md:py-8 relative">
    <div class="max-w-6xl mx-auto relative z-10">
      <Breadcrumb surface items={[{ label: 'صفحه اصلی', href: '/' }, { label: 'مجله تخصصی', href: '/blog' }, { label: post.title }]} />
      <span class="inline-block px-3 py-1 rounded bg-steel-100 text-steel-700 text-xs font-black mb-3 border border-steel-200">{post.category}</span>
      <h1 class="text-2xl md:text-3xl font-black mb-2 tracking-tight leading-tight">{post.title}</h1>
      <time datetime={post.isoDate} class="text-sm text-steel-600 font-bold">
        {post.date}{author ? ` — ${author.name}` : ''}
      </time>
    </div>
  </section>

  {/* Frontend v2 فاز ۵: ستون خواندن ۶۸ کاراکتر (۱۶px/۳۲px)، فهرست مطالب چسبان از lg، جعبه‌ی نویسنده و پیشنهاد
      استعلام با ریل ۴px. ⚠️ JSON-LD و canonical بالا دست نخورده‌اند. */}
  <section class="px-4 py-8 md:py-10 bg-white">
    <div class:list={['max-w-6xl mx-auto', showToc && 'lg:grid lg:grid-cols-[minmax(0,68ch)_16rem] lg:justify-between lg:gap-10']}>
      <article class="max-w-[68ch] text-steel-700 leading-8 text-right text-base">
        {showToc && (
          <nav class="lg:hidden mb-6 bg-steel-50 border border-steel-200 rounded-md p-4" aria-label="فهرست مطالب">
            <p class="text-sm font-black text-steel-900 mb-2">در این مقاله</p>
            <ol class="space-y-1 text-sm list-decimal ps-5 marker:font-mono marker:text-steel-600">
              {toc.items.map((t) => <li><a href={`#${t.id}`} class="text-steel-700 hover:text-accent-ink">{t.text}</a></li>)}
            </ol>
          </nav>
        )}
        {/* ⚠️ بدنه یک HTML واحد از ویرایشگر وردپرس است؛ `prose-crane` همان استایل بلوک‌های متن — مقاله و صفحه‌ی برند یک‌شکل. */}
        <div class="prose-crane" set:html={toc.html} />

        {/* جعبه‌ی نویسنده — نویسنده‌ی واقعی از وردپرس؛ نبودِ پروفایل = بی‌جعبه. */}
        {author && <AuthorBox author={author} reviewedAt={post.isoModified} class="mt-10" />}

        <div class="mt-10 bg-steel-50 border border-steel-300 border-s-4 border-s-action rounded-md p-5 md:p-6">
          <h2 class="text-xl font-black text-steel-900 mb-2">قطعه مورد نظر خود را پیدا نکردید؟</h2>
          <p class="text-steel-700 leading-7 mb-4">کد فنی یا عکس قطعه را برای کارشناسان فنی کرین یدک ارسال کنید تا امکان تامین و زمان تحویل بررسی شود.</p>
          <a href="/contact/" class="inline-flex items-center min-h-11 bg-action text-white px-5 rounded-md font-black text-sm hover:bg-accent-strong">ثبت درخواست استعلام</a>
        </div>

        <nav class="mt-8 text-sm font-bold" aria-label="بازگشت به مجله">
          <a href="/blog/" class="inline-flex items-center gap-2 min-h-11 text-accent-ink hover:underline">
            <svg class="w-4 h-4 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
            بازگشت به مجله تخصصی
          </a>
        </nav>
      </article>

      {showToc && (
        <aside class="hidden lg:block">
          <nav class="sticky top-28 bg-white border border-steel-300 border-s-4 border-s-action rounded-md p-4" aria-label="فهرست مطالب کناری">
            <p class="text-sm font-black text-steel-900 mb-2">در این مقاله</p>
            <ol class="space-y-1.5 text-sm">
              {toc.items.map((t, i) => (
                <li class="flex gap-2"><span class="font-mono text-xs text-steel-600 tabular-nums pt-0.5" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><a href={`#${t.id}`} class="text-steel-700 hover:text-accent-ink leading-6">{t.text}</a></li>
              ))}
            </ol>
          </nav>
        </aside>
      )}
    </div>
  </section>
</Layout>

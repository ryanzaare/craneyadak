---
// src/pages/blog/index.astro
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { SITE } from '../../data/site';
import { getPosts } from '../../lib/posts';

// ⚠️ پیش از اولین استفاده — JSON-LD بالاتر از این خط از `posts` می‌خواند.
const posts = await getPosts();

const title = `مجله تخصصی و مقالات آموزشی جرثقیل سقفی | ${SITE.name}`;
const description = 'مقالات تخصصی، آموزش‌های اورهال، راهنمای انتخاب قطعات و اخبار صنعت بالابر. مرجع علمی مهندسین نت برای تعمیر و نگهداری جرثقیل.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      '@id': `${SITE.url}/blog#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'صفحه اصلی', item: SITE.url },
        { '@type': 'ListItem', position: 2, name: 'مجله تخصصی', item: `${SITE.url}/blog` },
      ],
    },
    {
      '@type': 'Blog',
      '@id': `${SITE.url}/blog#webpage`,
      url: `${SITE.url}/blog`,
      name: title,
      description: description,
      isPartOf: { '@id': `${SITE.url}/#website` },
      blogPost: posts.map((p) => ({ '@type': 'BlogPosting', '@id': `${SITE.url}/blog/${p.slug}#article`, headline: p.title, url: `${SITE.url}/blog/${p.slug}` })),
    }
  ]
};

// تک منبع داده (src/data/content.ts) — همین آرایه در blog/[slug].astro هم
// استفاده می‌شود تا عنوان/تاریخ هرگز بین لیست و صفحه‌ی مقاله واگرا نشود.
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  {/* Frontend v2 فاز ۵: نوار عنوان روشن زیر هدر گرافیت (هم‌خانواده‌ی دسته/محصول)، نه نوار تیره‌ی دوم با خط ۸px. */}
  <section class="bg-white text-steel-900 border-b border-steel-300 px-4 py-6 md:py-8 relative">
    <div class="max-w-7xl mx-auto relative z-10">
      <Breadcrumb surface items={[{ label: 'صفحه اصلی', href: '/' }, { label: 'مجله تخصصی' }]} />
      <h1 class="text-2xl md:text-3xl font-black mb-2 tracking-tight">دانشنامه تخصصی تجهیزات بالابر</h1>
      <p class="text-base md:text-xl text-steel-600 max-w-2xl leading-8 font-normal">مقالات مهندسی، آموزش‌های گام‌به‌گام تعمیرات و راهنمای انتخاب اصولی قطعات برای بهینه‌سازی واحدهای نت.</p>
    </div>
  </section>

  <section class="py-8 md:py-10 px-4 md:px-8 bg-steel-50 min-h-[60vh]">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map((post) => (
          <article class="bg-white rounded-md border border-steel-300 hover:border-steel-400 transition-colors overflow-hidden flex flex-col group">
            <div class="aspect-video bg-steel-50 relative flex items-center justify-center overflow-hidden">
              <svg class="w-16 h-16 text-steel-300 group-hover:scale-110 transition-transform duration-150" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path>
              </svg>
              <span class="absolute top-4 right-4 bg-action text-white text-xs font-bold px-3 py-1.5 rounded-md">{post.category}</span>
            </div>
            <div class="p-6 md:p-8 flex flex-col flex-grow">
              <time datetime={post.isoDate} class="text-xs font-bold text-steel-500 mb-3 block">{post.date}</time>
              <h2 class="font-black text-steel-900 text-xl mb-4 leading-8">
                <a href={`/blog/${post.slug}`} class="hover:text-accent-ink before:absolute before:inset-0 focus:outline-none focus:ring-4 focus:ring-accent-ink/30 rounded">{post.title}</a>
              </h2>
              <p class="text-sm text-steel-600 leading-7 line-clamp-3 mb-6">{post.excerpt}</p>
              <div class="mt-auto pt-4 border-t border-steel-100 flex items-center text-accent-ink font-bold text-sm">
                <span>مطالعه مقاله</span>
                <svg class="w-4 h-4 mr-2 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
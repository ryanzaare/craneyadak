---
// src/pages/account/wishlist.astro
// علاقه‌مندی‌ها — فهرست محصولاتی که کاربر نشان کرده.
// سرور محصولِ حذف‌شده یا پیش‌نویس‌شده را خودش از فهرست پاک می‌کند
// (cyh_rest_account_wishlist_get)، پس اینجا لینک ۴۰۴ نمایش داده نمی‌شود.
import Layout from '../../layouts/Layout.astro';
import AccountNav from '../../components/AccountNav.astro';
import { SITE } from '../../data/site';

const title = `علاقه‌مندی‌ها | ${SITE.name}`;
const description = 'محصولاتی که در حساب کاربری نشان کرده‌اید.';
---

<Layout title={title} description={description} noindex>
  <section class="bg-steel-900 text-white px-4 py-10">
    <div class="max-w-5xl mx-auto">
      <h1 class="text-2xl md:text-3xl font-black">علاقه‌مندی‌ها</h1>
    </div>
  </section>

  <section class="bg-white px-4 py-10">
    <div class="max-w-5xl mx-auto grid md:grid-cols-[14rem_minmax(0,1fr)] gap-6 items-start">
      <AccountNav />

      <div class="min-w-0">
        <p id="wish-loading" class="text-steel-600">در حال بارگذاری…</p>
        <p id="wish-error" hidden class="text-sm leading-7 text-red-700 font-bold bg-red-50 border border-red-200 rounded-md p-4"></p>
        <div id="wish-empty" hidden class="bg-steel-50 border border-steel-300 rounded-lg p-6 text-center">
          <p class="text-steel-700 leading-7 mb-4">هنوز محصولی را نشان نکرده‌اید. روی صفحه‌ی هر محصول، دکمه‌ی «افزودن به علاقه‌مندی‌ها» را بزنید.</p>
          <a href="/products" class="inline-block bg-accent text-white px-6 py-3 rounded-md font-black hover:bg-accent-ink transition-colors">مشاهده‌ی محصولات</a>
        </div>
        <ul id="wish-list" role="list" class="space-y-2"></ul>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { api, errorMessage, requireLogin } from '../../scripts/account';

  const $ = (id: string) => document.getElementById(id)!;

  function showError(text: string) {
    const el = $('wish-error');
    el.textContent = text;
    el.hidden = false;
  }

  function render(items: { slug: string; name: string }[]) {
    const list = $('wish-list');
    list.textContent = '';
    $('wish-empty').hidden = items.length > 0;

    for (const item of items) {
      const li = document.createElement('li');
      li.className = 'bg-steel-50 border border-steel-300 rounded-md px-4 py-3 flex items-center justify-between gap-3';

      const link = document.createElement('a');
      link.href = `/products/${encodeURIComponent(item.slug)}`;
      link.className = 'font-bold text-steel-900 hover:text-accent-ink';
      link.textContent = item.name; // textContent — نام از پایگاه داده می‌آید

      const remove = document.createElement('button');
      remove.type = 'button';
      remove.className = 'text-sm text-red-700 hover:underline shrink-0 focus:outline-none focus:ring-2 focus:ring-red-300 rounded px-1';
      remove.textContent = 'حذف';
      remove.addEventListener('click', async () => {
        remove.disabled = true;
        const res = await api('/account/wishlist', { method: 'POST', auth: true, body: { slug: item.slug, action: 'remove' } });
        if (res.status === 401) return requireLogin();
        if (!res.ok) {
          remove.disabled = false;
          showError(errorMessage(res, 'حذف انجام نشد.'));
          return;
        }
        li.remove();
        if (!list.children.length) $('wish-empty').hidden = false;
      });

      li.append(link, remove);
      list.appendChild(li);
    }
  }

  async function load() {
    if (!requireLogin()) return;
    const res = await api<{ items?: { slug: string; name: string }[] }>('/account/wishlist', { auth: true });
    $('wish-loading').hidden = true;
    if (res.status === 401) return requireLogin();
    if (!res.ok) return showError(errorMessage(res, 'فهرست بارگذاری نشد.'));
    render(res.data.items ?? []);
  }

  void load();
</script>

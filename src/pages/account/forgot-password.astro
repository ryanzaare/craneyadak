---
// src/pages/account/forgot-password.astro
//
// ⚠️ همیشه یک پیام موفق نشان می‌دهد — چه ایمیل واقعاً ثبت شده باشد چه
// نه. سرور (class-customer-accounts.php) هم دقیقاً همین رفتار را دارد؛
// افشای «این ایمیل ثبت نیست» یعنی هر کسی می‌تواند حساب‌های سایت را
// شمارش کند.
import Layout from '../../layouts/Layout.astro';
import { SITE } from '../../data/site';

const wpBase = (import.meta.env.WP_GRAPHQL_URL as string | undefined)?.replace(/\/+$/, '') ?? null;
const title = `فراموشی رمز عبور | ${SITE.name}`;
const description = 'بازیابی رمز عبور حساب کاربری.';
---

<Layout title={title} description={description} noindex>
  <section class="bg-steel-900 text-white px-4 py-10">
    <div class="max-w-md mx-auto">
      <h1 class="text-2xl md:text-3xl font-black mb-2">فراموشی رمز عبور</h1>
      <p class="text-steel-300 leading-8">ایمیل حساب خود را وارد کنید تا لینک تعیین رمز تازه برایتان ارسال شود.</p>
    </div>
  </section>

  <section class="bg-white px-4 py-10">
    <div class="max-w-md mx-auto">
      <form id="forgot-form" class="bg-steel-50 border border-steel-300 rounded-lg p-5 space-y-3">
        <div>
          <label for="forgot-email" class="block text-sm font-bold text-steel-900 mb-1">ایمیل</label>
          <input id="forgot-email" name="email" type="email" required dir="ltr" class="w-full text-sm border border-steel-300 rounded-md px-3 py-2.5 focus:outline-none focus:ring-4 focus:ring-accent/40" />
        </div>
        <button type="submit" id="forgot-submit" class="w-full bg-accent text-white py-3 rounded-md font-black hover:bg-accent-ink transition-colors focus:outline-none focus:ring-4 focus:ring-accent/40 min-h-[48px]">
          ارسال لینک بازیابی
        </button>
        <p id="forgot-msg" class="text-sm leading-7" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>
</Layout>

<script define:vars={{ wpBase }}>
  (function () {
    const form = document.getElementById('forgot-form');
    const msg = document.getElementById('forgot-msg');
    const button = document.getElementById('forgot-submit');

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!wpBase) {
        if (msg) {
          msg.className = 'text-sm leading-7 text-red-700 font-bold';
          msg.textContent = 'این سرویس در دسترس نیست. لطفاً تماس بگیرید.';
        }
        return;
      }

      const email = String(new FormData(form).get('email') || '');

      if (button) {
        button.disabled = true;
        button.textContent = 'در حال ارسال…';
      }
      if (msg) msg.textContent = '';

      try {
        await fetch(`${wpBase}/wp-json/crane-yadak/v1/account/forgot-password`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });
        // ⚠️ پاسخ همیشه همین پیام است، صرف‌نظر از نتیجه‌ی واقعی سرور —
        // همان دلیل ضدِ شمارش کاربر که بالای فایل توضیح داده شد.
        if (msg) {
          msg.className = 'text-sm leading-7 text-green-700 font-bold';
          msg.textContent = 'اگر این ایمیل در سایت ثبت شده باشد، لینک بازیابی رمز برایش ارسال شد.';
        }
        form.reset();
      } catch {
        if (msg) {
          msg.className = 'text-sm leading-7 text-red-700 font-bold';
          msg.textContent = 'ارتباط با سرور برقرار نشد. اتصال اینترنت را بررسی کنید.';
        }
      } finally {
        if (button) {
          button.disabled = false;
          button.textContent = 'ارسال لینک بازیابی';
        }
      }
    });
  })();
</script>

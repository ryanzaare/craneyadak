---
// src/pages/account/reset-password.astro
// لینک ایمیل بازیابی به همین صفحه می‌آید: ?email=...&token=...
// (ساخته‌شده در class-customer-accounts.php → cyh_rest_account_forgot_password)
import Layout from '../../layouts/Layout.astro';
import { SITE } from '../../data/site';

const wpBase = (import.meta.env.WP_GRAPHQL_URL as string | undefined)?.replace(/\/+$/, '') ?? null;
const title = `تعیین رمز تازه | ${SITE.name}`;
const description = 'تعیین رمز عبور تازه برای حساب کاربری.';
---

<Layout title={title} description={description} noindex>
  <section class="bg-steel-900 text-white px-4 py-10">
    <div class="max-w-md mx-auto">
      <h1 class="text-2xl md:text-3xl font-black mb-2">تعیین رمز تازه</h1>
    </div>
  </section>

  <section class="bg-white px-4 py-10">
    <div class="max-w-md mx-auto">
      <form id="reset-form" class="bg-steel-50 border border-steel-300 rounded-lg p-5 space-y-3">
        <div>
          <label for="reset-password" class="block text-sm font-bold text-steel-900 mb-1">رمز عبور تازه</label>
          <input id="reset-password" name="password" type="password" required minlength="10" dir="ltr" class="w-full text-sm border border-steel-300 rounded-md px-3 py-2.5 focus:outline-none focus:ring-4 focus:ring-accent/40" />
          <p class="text-xs text-steel-600 mt-1">حداقل ۱۰ کاراکتر، شامل حرف و عدد. با تعیین رمز تازه، ورود در سایر دستگاه‌ها لغو می‌شود.</p>
        </div>
        <button type="submit" id="reset-submit" class="w-full bg-accent text-white py-3 rounded-md font-black hover:bg-accent-ink transition-colors focus:outline-none focus:ring-4 focus:ring-accent/40 min-h-[48px]">
          تعیین رمز تازه
        </button>
        <p id="reset-msg" class="text-sm leading-7" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>
</Layout>

<script define:vars={{ wpBase }}>
  (function () {
    const form = document.getElementById('reset-form');
    const msg = document.getElementById('reset-msg');
    const button = document.getElementById('reset-submit');

    const params = new URLSearchParams(location.search);
    const email = params.get('email') || '';
    const token = params.get('token') || '';

    if (!email || !token) {
      if (form) form.hidden = true;
      if (msg) {
        msg.className = 'text-sm leading-7 text-red-700 font-bold';
        msg.textContent = 'لینک ناقص است. از ایمیل بازیابی دوباره استفاده کنید.';
      }
    }

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!wpBase) {
        if (msg) {
          msg.className = 'text-sm leading-7 text-red-700 font-bold';
          msg.textContent = 'این سرویس در دسترس نیست. لطفاً تماس بگیرید.';
        }
        return;
      }

      const password = String(new FormData(form).get('password') || '');

      if (button) {
        button.disabled = true;
        button.textContent = 'در حال ثبت…';
      }
      if (msg) msg.textContent = '';

      try {
        const res = await fetch(`${wpBase}/wp-json/crane-yadak/v1/account/reset-password`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, token, password }),
        });
        const json = await res.json().catch(() => ({}));

        if (res.ok && json.success) {
          if (msg) {
            msg.className = 'text-sm leading-7 text-green-700 font-bold';
            msg.textContent = 'رمز عبور تغییر کرد. اکنون می‌توانید وارد شوید.';
          }
          form.hidden = true;
          setTimeout(() => { location.href = '/account/login'; }, 1500);
          return;
        }

        if (msg) {
          msg.className = 'text-sm leading-7 text-red-700 font-bold';
          msg.textContent = json.message || 'لینک نامعتبر یا منقضی است. دوباره درخواست بازیابی بدهید.';
        }
      } catch {
        if (msg) {
          msg.className = 'text-sm leading-7 text-red-700 font-bold';
          msg.textContent = 'ارتباط با سرور برقرار نشد. اتصال اینترنت را بررسی کنید.';
        }
      } finally {
        if (button) {
          button.disabled = false;
          button.textContent = 'تعیین رمز تازه';
        }
      }
    });
  })();
</script>

---
// src/pages/categories/index.astro
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { CATEGORIES, SITE } from '../../data/site';

const title = `دسته‌بندی قطعات جرثقیل سقفی | ${SITE.name}`;
const description = 'مشاهده کامل‌ترین دسته‌بندی تجهیزات و لوازم یدکی جرثقیل سقفی شامل موتور گیربکس، شین، ریموت و قطعات مکانیکی با ارسال فوری.';

// Breadcrumb & CollectionPage Schema
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      '@id': `${SITE.url}/categories#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'صفحه اصلی', item: SITE.url },
        { '@type': 'ListItem', position: 2, name: 'دسته‌بندی‌ها', item: `${SITE.url}/categories` },
      ],
    },
    {
      '@type': 'CollectionPage',
      '@id': `${SITE.url}/categories#webpage`,
      url: `${SITE.url}/categories`,
      name: title,
      description: description,
      isPartOf: { '@id': `${SITE.url}/#website` }
    }
  ]
};
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  {/* -------------------- Hero & Breadcrumb -------------------- */}
  <section class="bg-crane-navy text-white pt-12 pb-20 px-4 border-b-[8px] border-crane-orange">
    <div class="max-w-7xl mx-auto">
      <Breadcrumb items={[{ label: 'صفحه اصلی', href: '/' }, { label: 'دسته‌بندی‌ها' }]} />
      <h1 class="text-3xl md:text-5xl font-black mb-4 tracking-tight drop-shadow-md">دسته‌بندی قطعات و تجهیزات</h1>
      <p class="text-lg text-gray-300 max-w-2xl leading-8 font-light">تامین بی‌واسطه تمامی اقلام مکانیکی و الکتریکال مورد نیاز جرثقیل‌های سقفی صنعتی.</p>
    </div>
  </section>

  {/* ----------------------------- Categories Grid ----------------------------- */}
  <section class="py-20 px-4 md:px-8 lg:px-12 bg-gray-50 min-h-[50vh]" aria-label="لیست دسته‌بندی‌ها">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 lg:gap-8">
        {CATEGORIES.map((category) => (
          <article>
            <a href={category.slug} class="group h-full bg-white p-6 md:p-8 rounded-3xl shadow-sm hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 flex flex-col items-center text-center border border-transparent hover:border-orange-100 focus:outline-none focus:ring-4 focus:ring-orange-500/30">
              <span class="w-24 h-24 bg-gray-50 text-crane-navy group-hover:text-crane-orange group-hover:bg-orange-50 rounded-2xl flex items-center justify-center mb-6 transition-colors shadow-inner shrink-0" aria-hidden="true">
                <svg class="w-12 h-12" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2" d={category.icon} />
                </svg>
              </span>
              <h2 class="font-bold text-crane-navy group-hover:text-crane-orange transition-colors text-lg md:text-xl mb-3">{category.name}</h2>
              <p class="text-sm text-gray-500 leading-7 line-clamp-3">{category.blurb}</p>
              <div class="mt-auto pt-6 flex items-center justify-center gap-2 text-crane-orange font-bold text-sm opacity-0 group-hover:opacity-100 transition-opacity transform translate-y-2 group-hover:translate-y-0">
                مشاهده محصولات
                <svg class="w-4 h-4 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ----------------------------- SEO Text (Bottom) ----------------------------- */}
  <section class="bg-white py-20 px-4 md:px-12 lg:px-20 border-t border-gray-100">
    <div class="max-w-4xl mx-auto text-gray-700 text-justify leading-8 space-y-6">
      <h2 class="text-2xl md:text-3xl font-black text-crane-navy mb-8">راهنمای جامع خرید قطعات جرثقیل سقفی</h2>
      <p class="text-base md:text-lg">در کرین یدک، ما مجموعه‌ای کامل از قطعات یدکی اورجینال و باکیفیت را برای اطمینان از عملکرد بی‌نقص و ایمن جرثقیل‌های صنعتی شما فراهم کرده‌ایم. تمامی دسته‌بندی‌های بالا شامل محصولاتی هستند که با استانداردهای سخت‌گیرانه بین‌المللی تولید شده‌اند.</p>
      <p class="text-base md:text-lg">برای یافتن قطعه مورد نظر خود، می‌توانید از طریق <strong>دسته‌بندی‌های اختصاصی</strong> (مانند موتور گیربکس، ریموت کنترل و...) اقدام کنید و یا با استفاده از <strong>سیستم جستجوی سریع</strong>، کد فنی (Part Numbers) دقیق قطعه را استعلام بگیرید.</p>
    </div>
  </section>
</Layout>
---
// src/pages/categories/index.astro
// ---------------------------------------------------------------------------
// هاب دسته‌بندی‌ها — نقشه‌ی کامل کاتالوگ.
//
// ⚠️ تصمیم ضد هم‌نوع‌خواری (Cannibalization):
// این صفحه عمداً عبارت «قطعات جرثقیل سقفی» را هدف نمی‌گیرد — آن عبارت
// متعلق به صفحه‌ی اصلی است. اگر هر دو صفحه یک عبارت را هدف بگیرند، بر سر
// یک کوئری با هم رقابت می‌کنند و هر دو ضعیف می‌شوند. نقش این صفحه
// «ناوبری و مرور کامل کاتالوگ» است: عبارت هدفش «لیست/دسته‌بندی قطعات» است،
// یعنی نیت مرور، نه نیت خرید یک قطعه‌ی مشخص.
// ---------------------------------------------------------------------------
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { SITE } from '../../data/site';
import { SILOS, ALL_CATEGORIES, categoryPath, siloPath } from '../../data/taxonomy';

const title = `لیست کامل دسته‌بندی قطعات جرثقیل سقفی | ${SITE.name}`;
const description = `مرور کامل ${ALL_CATEGORIES.length} دسته قطعه‌ی جرثقیل سقفی در ${SILOS.length} گروه تخصصی: از بالابر و برق‌رسانی تا ترمز، محرکه و ریل. یافتن سریع قطعه بر اساس گروه فنی.`;
const canonical = `${SITE.url}/categories`;

const breadcrumbItems = [{ label: 'صفحه اصلی', href: '/' }, { label: 'دسته‌بندی‌ها' }];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: breadcrumbItems.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: item.label,
        ...(item.href ? { item: `${SITE.url}${item.href}` } : {}),
      })),
    },
    {
      '@type': 'CollectionPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      isPartOf: { '@id': `${SITE.url}/#website` },
      inLanguage: SITE.locale,
      mainEntity: {
        '@type': 'ItemList',
        '@id': `${canonical}#silos`,
        numberOfItems: SILOS.length,
        itemListElement: SILOS.map((silo, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: silo.keyword,
          url: `${SITE.url}${siloPath(silo)}`,
        })),
      },
    },
  ],
};
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <section class="bg-crane-navy text-white pt-10 pb-16 px-4 border-b-[8px] border-crane-orange">
    <div class="max-w-7xl mx-auto">
      <Breadcrumb items={breadcrumbItems} />
      <h1 class="text-3xl md:text-5xl font-black mb-4 tracking-tight drop-shadow-md leading-relaxed">
        دسته‌بندی کامل قطعات جرثقیل سقفی
      </h1>
      <p class="text-lg text-gray-300 max-w-3xl leading-8">
        {ALL_CATEGORIES.length} دسته قطعه در {SILOS.length} گروه فنی سازمان‌دهی شده‌اند. اگر نام دقیق قطعه را نمی‌دانید، از روی گروه پیش بروید؛ اگر کد فنی دارید، مستقیماً استعلام بگیرید.
      </p>
      <div class="flex flex-wrap gap-3 mt-8">
        <a href="/contact" class="bg-crane-orange text-white px-6 py-3.5 rounded-xl font-bold hover:bg-orange-800 transition-colors focus:outline-none focus:ring-4 focus:ring-crane-orange/40">استعلام با کد فنی</a>
        <a href="/search" class="bg-white/10 border border-white/20 text-white px-6 py-3.5 rounded-xl font-bold hover:bg-white/20 transition-colors focus:outline-none focus:ring-4 focus:ring-white/30">جستجو در قطعات</a>
      </div>
    </div>
  </section>

  {/* -------- نقشه‌ی کامل: هر سیلو با تمام فرزندانش در یک نگاه -------- */}
  <section class="bg-gray-50 px-4 py-14">
    <div class="max-w-7xl mx-auto space-y-12">
      {SILOS.map((silo) => (
        <section aria-labelledby={`silo-${silo.slug}`}>
          <div class="flex flex-wrap items-center gap-4 mb-6 border-b border-gray-200 pb-4">
            <span class="w-12 h-12 shrink-0 bg-white border border-gray-100 text-crane-orange rounded-xl flex items-center justify-center shadow-sm" aria-hidden="true">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d={silo.icon} /></svg>
            </span>
            <h2 id={`silo-${silo.slug}`} class="text-xl md:text-2xl font-black text-crane-navy">
              <a href={siloPath(silo)} class="hover:text-crane-orange transition-colors focus:outline-none focus:ring-2 focus:ring-crane-orange rounded">
                {silo.name}
              </a>
            </h2>
            <span class="text-sm text-gray-600 font-bold bg-white border border-gray-200 px-3 py-1 rounded-full tabular-nums">
              {silo.categories.length} دسته
            </span>
            <a href={siloPath(silo)} class="md:mr-auto text-sm font-bold text-crane-orange hover:underline focus:outline-none focus:ring-2 focus:ring-crane-orange rounded">
              مشاهده گروه ←
            </a>
          </div>

          <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4" role="list">
            {silo.categories.map((category) => (
              <li>
                <a
                  href={categoryPath({ ...category, silo })}
                  class="group h-full bg-white p-5 rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg hover:border-orange-100 transition-all flex items-start gap-3 focus:outline-none focus:ring-4 focus:ring-crane-orange/30"
                >
                  <span class="w-10 h-10 shrink-0 bg-gray-50 text-crane-navy group-hover:text-crane-orange group-hover:bg-orange-50 rounded-xl flex items-center justify-center transition-colors" aria-hidden="true">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.4" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d={category.icon} /></svg>
                  </span>
                  <span class="min-w-0">
                    <span class="block font-bold text-crane-navy group-hover:text-crane-orange transition-colors text-sm leading-6">{category.name}</span>
                    {category.aka && category.aka.length > 0 && (
                      <span class="block text-xs text-gray-500 mt-1 line-clamp-1">{category.aka.join('، ')}</span>
                    )}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </section>

  {/* ----------------------------- متن سئویی ----------------------------- */}
  <section class="bg-white px-4 py-14 border-t border-gray-100">
    <div class="max-w-4xl mx-auto text-gray-700 leading-8 text-right">
      <h2 class="text-2xl font-black text-crane-navy mb-6">چطور قطعه‌ی درست را پیدا کنیم؟</h2>
      <p class="mb-4">
        شناسایی درست قطعه، پیش از قیمت، مهم‌ترین مرحله‌ی خرید صنعتی است. مطمئن‌ترین راه، کد فنی (Part Number) روی خود قطعه یا پلاک دستگاه است؛ این کد مستقل از نام تجاری قطعه، دقیقاً مشخص می‌کند چه چیزی لازم دارید.
      </p>
      <p class="mb-4">
        اگر کد در دسترس نیست، از روی گروه فنی پیش بروید: ابتدا گروه (مثلاً <a href={siloPath(SILOS[1])} class="text-crane-orange font-bold hover:underline">{SILOS[1].name}</a>) و سپس دسته‌ی دقیق قطعه. در هر صفحه‌ی دسته، نام‌های رایج دیگر همان قطعه هم آورده شده تا اگر در کارخانه‌ی شما با نام دیگری شناخته می‌شود، باز هم آن را پیدا کنید.
      </p>
      <p>
        در نهایت، پیش از صدور پیش‌فاکتور، کارشناسان فنی سازگاری قطعه با مدل دستگاه شما را بررسی می‌کنند — این کار از هزینه‌ی توقف خط تولید به‌مراتب ارزان‌تر است.
      </p>
    </div>
  </section>
</Layout>

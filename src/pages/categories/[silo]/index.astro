---
// src/pages/categories/[silo]/index.astro
// ---------------------------------------------------------------------------
// صفحه‌ی سیلو — والد یک گروه از دسته‌ها.
//
// نقش سئویی: عبارت گروهی و کلی‌تر را هدف می‌گیرد («سیستم برق رسانی جرثقیل
// سقفی») در حالی که فرزندان عبارت‌های دقیق قطعه را می‌گیرند. متن مقدمه‌ی
// این صفحه عمداً «ارزش مستقل» دارد (توضیح مهندسی درباره‌ی انتخاب صحیح این
// گروه از قطعات) و صرفاً فهرست فرزندان را تکرار نمی‌کند — صفحه‌ی والدی که
// فقط لینک باشد، محتوای نازک است و رتبه نمی‌گیرد.
// ---------------------------------------------------------------------------
import Layout from '../../../layouts/Layout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import ProductCard from '../../../components/ProductCard.astro';
import { SITE } from '../../../data/site';
import { SILOS, categoryPath, siloPath, type Silo } from '../../../data/taxonomy';
import { getProductsBySilo, type CraneProduct } from '../../../lib/wp';
import { getBlocks } from '../../../lib/content-blocks';
import { categoryReadiness, productReadiness, siloReadiness, blocksWordCount } from '../../../lib/indexability';

export async function getStaticPaths() {
  return Promise.all(
    SILOS.map(async (silo) => ({
      params: { silo: silo.slug },
      props: {
        silo,
        products: await getProductsBySilo(silo.categories.map((c) => c.slug)),
      },
    }))
  );
}

interface Props {
  silo: Silo;
  products: CraneProduct[];
}

const { silo, products } = Astro.props as Props;

const title = `${silo.keyword} | ${SITE.name}`;
const description = `${silo.intro.slice(0, 150)}`;
const canonical = `${SITE.url}${siloPath(silo)}`;

// چند نمونه‌ی واقعی از محصولات این گروه — «حس فروشگاه» بدون داده‌ی ساختگی.
const featured = products.slice(0, 8);

// ⚠️ سیلو فقط وقتی ایندکس‌پذیر است که دست‌کم یک دسته‌ی فرزندش آماده باشد (تصمیم کارفرما ۱۹ مهر ۱۴۰۵:
// «سیلوی بدون محتوا noindex»). متن مقدمه‌ی عمومی سیلو محتوا حساب نمی‌شود. همان تابعِ آمادگی دسته
// استفاده می‌شود تا سیلو و فرزندش هرگز دو قاعده‌ی متفاوت نداشته باشند (src/lib/indexability.ts).
const overrideEmpty = (process.env.INDEX_EMPTY_CATEGORIES ?? import.meta.env.INDEX_EMPTY_CATEGORIES) === '1';
const childReady = await Promise.all(
  silo.categories.map(async (c) =>
    categoryReadiness({
      readyProducts: products.filter((p) => p.categorySlugs.includes(c.slug) && productReadiness(p).ready).length,
      contentWords: blocksWordCount(await getBlocks('category', c.slug)),
      override: overrideEmpty,
    }).ready,
  ),
);
const noindexSilo = !siloReadiness(childReady).ready;

const otherSilos = SILOS.filter((s) => s.slug !== silo.slug);

const breadcrumbItems = [
  { label: 'صفحه اصلی', href: '/' },
  { label: 'دسته‌بندی‌ها', href: '/categories' },
  { label: silo.name },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: breadcrumbItems.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: item.label,
        ...(item.href ? { item: `${SITE.url}${item.href}` } : {}),
      })),
    },
    {
      '@type': 'CollectionPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      isPartOf: { '@id': `${SITE.url}/#website` },
      inLanguage: SITE.locale,
      // فرزندان سیلو به‌عنوان ItemList — این‌ها دسته‌بندی‌اند نه محصول، پس
      // به‌جای Product از CollectionPage/URL استفاده می‌شود.
      mainEntity: {
        '@type': 'ItemList',
        '@id': `${canonical}#categories`,
        numberOfItems: silo.categories.length,
        itemListElement: silo.categories.map((category, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: category.keyword,
          url: `${SITE.url}${categoryPath({ ...category, silo })}`,
        })),
      },
    },
  ],
};
---

<Layout title={title} description={description} jsonLd={jsonLd} noindex={noindexSilo}>
  <section class="bg-steel-900 text-white pt-10 pb-16 px-4 border-b-[8px] border-accent-ink">
    <div class="max-w-7xl mx-auto">
      <Breadcrumb items={breadcrumbItems} />
      <div class="flex flex-col md:flex-row items-start gap-6">
        <span class="w-16 h-16 bg-white/10 rounded-lg flex items-center justify-center shrink-0 border border-white/20" aria-hidden="true">
          <svg class="w-8 h-8 text-accent-ink" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d={silo.icon} /></svg>
        </span>
        <div>
          <h1 class="text-3xl md:text-4xl font-black mb-4 tracking-tight drop-shadow-md leading-relaxed">{silo.keyword}</h1>
          <p class="text-steel-300 max-w-3xl leading-8 text-right">{silo.intro}</p>
        </div>
      </div>
    </div>
  </section>

  {/* ---------------------------- فرزندان سیلو ---------------------------- */}
  <section class="bg-steel-50 px-4 py-14" aria-labelledby="silo-categories-heading">
    <div class="max-w-7xl mx-auto">
      <h2 id="silo-categories-heading" class="text-2xl font-black text-steel-900 mb-8 border-b border-steel-200 pb-4">
        قطعات گروه {silo.name}
      </h2>
      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5" role="list">
        {silo.categories.map((category) => (
          <li>
            <a
              href={categoryPath({ ...category, silo })}
              class="group h-full bg-white p-6 rounded-lg border border-steel-300 hover:border-steel-400 transition-colors flex items-start gap-4 focus:outline-none focus:ring-4 focus:ring-accent-ink/30"
            >
              <span class="w-12 h-12 shrink-0 bg-steel-50 text-steel-900 group-hover:text-accent-ink group-hover:bg-accent-soft rounded-lg flex items-center justify-center transition-colors" aria-hidden="true">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.4" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d={category.icon} /></svg>
              </span>
              <span class="min-w-0">
                <span class="block font-black text-steel-900 group-hover:text-accent-ink transition-colors leading-7">{category.name}</span>
                <span class="block text-sm text-steel-600 mt-1.5 leading-6 line-clamp-2">{category.blurb}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ------------------- نمونه‌ی محصولات واقعی این گروه ------------------- */}
  {featured.length > 0 && (
    <section class="bg-white px-4 py-14 border-t border-steel-100" aria-labelledby="silo-products-heading">
      <div class="max-w-7xl mx-auto">
        <h2 id="silo-products-heading" class="text-2xl font-black text-steel-900 mb-8 border-b border-steel-200 pb-4">
          قطعات موجود در این گروه
        </h2>
        <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6" role="list">
          {featured.map((product, index) => (
            <li><ProductCard product={product} eager={index < 4} /></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {/* ----------------------- سایر گروه‌ها (ناوبری) ----------------------- */}
  <section class="bg-steel-50 px-4 py-14 border-t border-steel-100" aria-labelledby="other-silos-heading">
    <div class="max-w-7xl mx-auto">
      <h2 id="other-silos-heading" class="text-xl md:text-2xl font-black text-steel-900 mb-8">سایر گروه‌های قطعات</h2>
      <ul class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4" role="list">
        {otherSilos.map((other) => (
          <li>
            <a
              href={siloPath(other)}
              class="group h-full bg-white p-5 rounded-lg border border-steel-300 hover:border-steel-400 transition-colors flex flex-col items-center text-center gap-3 focus:outline-none focus:ring-4 focus:ring-accent-ink/30"
            >
              <span class="w-10 h-10 text-steel-900 group-hover:text-accent-ink transition-colors" aria-hidden="true">
                <svg class="w-full h-full" fill="none" stroke="currentColor" stroke-width="1.4" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d={other.icon} /></svg>
              </span>
              <span class="text-sm font-bold text-steel-900 group-hover:text-accent-ink transition-colors leading-6">{other.name}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>

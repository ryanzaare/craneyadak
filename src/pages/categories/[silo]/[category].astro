---
// src/pages/categories/[silo]/[category].astro
// ---------------------------------------------------------------------------
// صفحه‌ی دسته (فرزند سیلو) — عبارت کلیدی مشخص و بدون هم‌پوشانی را هدف می‌گیرد.
//
// تفکیک نیت جستجو (ضد هم‌نوع‌خواری):
//   • صفحه‌ی اصلی      → «قطعات جرثقیل سقفی» (عبارت اصلی و برند)
//   • هاب /categories  → مرور و ناوبری، نه رقابت بر سر عبارت اصلی
//   • صفحه‌ی سیلو      → عبارت گروهی («سیستم برق رسانی جرثقیل سقفی»)
//   • همین صفحه       → عبارت دقیق قطعه («شین برق‌رسان جرثقیل»)
// نام‌های مترادف (aka) عمداً صفحه‌ی جدا نمی‌گیرند و داخل همین صفحه می‌آیند.
// ---------------------------------------------------------------------------
import Layout from '../../../layouts/Layout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import ProductCard from '../../../components/ProductCard.astro';
import CategoryFilterBar from '../../../components/CategoryFilterBar.astro';
import ProductRow from '../../../components/ProductRow.astro';
import EmptyState from '../../../components/EmptyState.astro';
import { resolveFacets, specValue } from '../../../data/filters';
import { getCategoryFacets } from '../../../lib/category-facets';
import { buildTitle, buildDescription } from '../../../lib/seo-meta';
import { SITE } from '../../../data/site';
import {
  SILOS,
  categoryPath,
  siloPath,
  type Category,
  type Silo,
} from '../../../data/taxonomy';
import ContentBlocks from '../../../components/ContentBlocks.astro';
import Questions from '../../../components/Questions.astro';
import { getQuestions, questionsJsonLd } from '../../../lib/questions';
import { getProductsByCategory, computePrice, productJsonLd, productPath, type CraneProduct } from '../../../lib/wp';
import { getBlocks, specsToJsonLd } from '../../../lib/content-blocks';
import { categoryReadiness, productReadiness, blocksWordCount } from '../../../lib/indexability';
import { resolveCategoryTerm, type CategoryTerm } from '../../../lib/categories';

export async function getStaticPaths() {
  return Promise.all(
    SILOS.flatMap((silo) =>
      silo.categories.map(async (category) => ({
        params: { silo: silo.slug, category: category.slug },
        props: {
          silo,
          category,
          products: await getProductsByCategory(category.slug),
          // نام و توضیح از وردپرس؛ تاکسونومی فقط تور ایمنی است.
          term: await resolveCategoryTerm(category.slug, category.name, category.blurb),
        },
      }))
    )
  );
}

interface Props {
  silo: Silo;
  category: Category;
  products: CraneProduct[];
  term: CategoryTerm;
}

const { silo, category, products, term } = Astro.props as Props;

/* نام نمایشی و توضیح از وردپرس می‌آیند. `category.keyword` عمداً از کد
   می‌آید — عبارت هدف سئو یک تصمیم استراتژیک است، نه متنی که هر روز در
   پنل ویرایش شود. تفکیک: عنوان H1 = عبارت هدف، نام دسته = محتوای وردپرس. */
const displayName = term.name;
const displayBlurb = term.blurb;
const reviewMode = import.meta.env.CONTENT_REVIEW === '1';
const blocks = await getBlocks('category', category.slug);
const specJsonLd = specsToJsonLd(blocks);

/* پرسش‌های کاربران — فقط آن‌هایی که کارشناس پاسخ داده است.
   ⚠️ روی برند عمداً وجود ندارد: پاسخ‌دادن به پرسش گارانتیِ یک سازنده،
   رابطه‌ای را تلویحاً ادعا می‌کند که مستندی برایش نداریم. */
const questions = await getQuestions('category', category.slug);
const wpBase = (import.meta.env.WP_GRAPHQL_URL as string | undefined)?.replace(/\/+$/, '') ?? null;

/* ⚠️ قطعه‌ای ساخته می‌شود، نه رشته‌ی یک‌تکه. با رشته‌ی یک‌تکه، بریدنِ طول
   همیشه دُم را می‌خورد — و دُم همان‌جایی است که «فاکتور رسمی» و نام برند
   نوشته شده. ۱۸ دسته از ۳۱ دسته دقیقاً همین را از دست می‌دادند. */
const title = buildTitle(
  [category.keyword, 'خرید و استعلام قیمت', SITE.name],
  `/categories/${silo.slug}/${category.slug}/`,
);
const description = buildDescription(
  category.blurb,
  [
    `تامین ${category.keyword} با تضمین اصالت کالا، بررسی سازگاری فنی و صدور فاکتور رسمی.`,
    `تامین ${category.keyword} با تضمین اصالت کالا و فاکتور رسمی.`,
    'تامین با تضمین اصالت کالا و فاکتور رسمی.',
    'استعلام قیمت و فاکتور رسمی.',
  ],
  `/categories/${silo.slug}/${category.slug}/`,
);

const path = categoryPath({ ...category, silo });
const canonical = `${SITE.url}${path}`;

// دسته‌های هم‌سیلو — لینک‌سازی داخلی درون همان سیلو، نه پراکنده در کل سایت.
// این کار قدرت موضوعی (Topical Authority) را داخل سیلو نگه می‌دارد.
const siblings = silo.categories.filter((c) => c.slug !== category.slug);

// ⚠️ دسته‌ی بدون محصول → noindex (تصمیم کارفرما، ۷ مهر ۱۴۰۵): محتوای نازک نباید
// ایندکس شود. این شرط *خودکار* است، نه فهرست دستی: با اولین محصول منتشرشده،
// همان build بعدی noindex را برمی‌دارد و نشانی به sitemap برمی‌گردد
// (scripts/prune-noindex-sitemap.mjs از روی HTML واقعی تصمیم می‌گیرد).
// ⚠️ فراموش نشود: پیش از انتشار عمومی، وقتی محتوای دسته‌ها نهایی شد و می‌خواهیم
// دسته‌ی بدون محصول هم ایندکس شود → `INDEX_EMPTY_CATEGORIES=1 npm run build`.
// هر build فهرست دسته‌های noindex را چاپ می‌کند تا این قرارداد دیده بماند.
// ⚠️ «آماده» یعنی محصولِ *کامل* (کد فنی، برند، تصویر، متن) یا محتوای تخصصی نهایی ≥ ۳۰۰ کلمه —
// نه «هر محصولی»: محصول آزمایشی/ناقص دسته را ایندکس‌پذیر نمی‌کند (src/lib/indexability.ts).
const readiness = categoryReadiness({
  readyProducts: products.filter((p) => productReadiness(p).ready).length,
  contentWords: blocksWordCount(blocks),
  override: (process.env.INDEX_EMPTY_CATEGORIES ?? import.meta.env.INDEX_EMPTY_CATEGORIES) === '1',
});
const noindexEmpty = !readiness.ready;

const breadcrumbItems = [
  { label: 'صفحه اصلی', href: '/' },
  { label: 'دسته‌بندی‌ها', href: '/categories' },
  { label: silo.name, href: siloPath(silo) },
  { label: displayName },
];

const itemList =
  products.length > 0
    ? {
        '@type': 'ItemList',
        '@id': `${canonical}#products`,
        name: `فهرست ${category.keyword}`,
        numberOfItems: products.length,
        itemListElement: products.map((product, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          item: productJsonLd(product, SITE.url, computePrice(product)),
        })),
      }
    : null;

/* FAQPage اینجا ساخته نمی‌شود — `ContentBlocks.astro` خودش آن را از بلوک
   پرسش و پاسخ تولید می‌کند. دو گره FAQPage روی یک صفحه، سیگنال متناقض
   برای گوگل است. */

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: breadcrumbItems.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: item.label,
        ...(item.href ? { item: `${SITE.url}${item.href}` } : {}),
      })),
    },
    {
      '@type': 'CollectionPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      /* نام‌های رایج بازار به‌صورت `alternateName`.
         این خاصیت استاندارد Schema.org است و راه *مجاز* اعلام مترادف به
         موتور جستجوست — برخلاف ریختن همان کلمات در یک عنصر پنهان، که
         «متن مخفی» است و در دستورالعمل اسپم گوگل صراحتاً منع شده.
         همین مترادف‌ها بالای صفحه هم به‌صورت مرئی («نام‌های دیگر: …»)
         نمایش داده می‌شوند؛ داده‌ی ساختاریافته باید بازتاب چیزی باشد که
         کاربر می‌بیند، نه چیزی بیشتر. */
      ...(category.aka && category.aka.length > 0 ? { alternateName: category.aka } : {}),
      description,
      isPartOf: { '@id': `${SITE.url}/#website` },
      inLanguage: SITE.locale,
      ...(itemList ? { mainEntity: itemList } : {}),
      /* ⚠️ `specsToJsonLd()` ساخته شده بود و **هیچ‌جا صدا زده نمی‌شد** —
         یعنی بلوک «مشخصات فنی» روی صفحه دیده می‌شد ولی هیچ داده‌ی
         ساختاریافته‌ای تولید نمی‌کرد. برای یک کاتالوگ قطعه‌ی صنعتی، مشخصه‌ها
         دقیقاً همان چیزی‌اند که باید ساختاریافته باشند.

         روی `about` می‌نشیند نه خود CollectionPage، چون `additionalProperty`
         خاصیت `Thing` است نه `WebPage`. */
      ...(specJsonLd.length
        ? {
            about: {
              '@type': 'Thing',
              name: category.keyword,
              additionalProperty: specJsonLd,
            },
          }
        : {}),
    },
    /* ⚠️ `QAPage` و نه `FAQPage`. تفاوتشان در *منشأ* است، نه در شکل:
       FAQPage برای پرسشی است که خود سایت نوشته (بلوک پرسش‌های متداول،
       که `ContentBlocks.astro` تولیدش می‌کند)، و QAPage برای پرسشی که
       کاربر پرسیده و پاسخ گرفته. جابه‌جا استفاده‌کردنشان نقض راهنمای
       گوگل است.

       این دو روی یک صفحه تداخل ندارند چون موجودیت‌های متفاوتی را توصیف
       می‌کنند — برخلاف دو گره FAQPage که سیگنال متناقض می‌دهد. */
    ...(questionsJsonLd(questions, canonical) ? [questionsJsonLd(questions, canonical)!] : []),
  ],
};

// فیلترهای تخصصی همین دسته — مقادیر از خودِ محصولات استخراج می‌شوند.
const categoryFacets = await getCategoryFacets(category.slug);
const catFacets = resolveFacets(products, categoryFacets);

/** صفت‌های داده روی هر کارت تا فیلتر سمت کلاینت بتواند بخواندشان. */
function catAttrs(product: typeof products[number]) {
  const attrs: Record<string, string> = {
    'data-cat-item': '',
    // ⚠️ هر محصول دو بار در DOM است (نمای جدول و کارت)؛ شمار نتیجه با slug یکتا می‌شود.
    'data-slug': product.slug,
    'data-brand': product.brandSlug ?? '',
    'data-stock': product.stockStatus,
    'data-buymode': product.buyMode,
    // «دارای قیمت» از قیمت *موثر* می‌آید (با احتساب تخفیف فعال)، نه از
    // buyMode. محصولی می‌تواند حالت استعلام داشته باشد ولی قیمت پایه هم
    // داشته باشد؛ computePrice تنها مرجع قیمت در کل پروژه است.
    'data-priced': computePrice(product).payable ? '1' : '0',
  };
  for (const f of catFacets) {
    const raw = specValue(product, f.specLabel);
    if (raw) attrs[`data-spec-${f.id}`] = raw;
  }
  return attrs;
}
import { getContact } from '../../../lib/site-options';

/* ⚠️ اعلان‌های داده‌ی وردپرس بلافاصله بعد از import ها.
   قبلاً انتهای فرontmatter بودند و کدِ بالاتر که از آن‌ها استفاده
   می‌کرد با «Cannot access before initialization» می‌شکست:
   `const` هویست می‌شود اما تا نقطه‌ی اعلان در ناحیه‌ی مرده‌ی
   زمانی (TDZ) است و دسترسی به آن خطا می‌دهد. */
const contact = await getContact();

---

<Layout title={title} description={description} jsonLd={jsonLd} noindex={noindexEmpty}>
  {/* ── Frontend v2 (فاز ۲): سرصفحه‌ی روشن به‌جای نوار گرافیتی (§5: گرافیت فقط هدر و فوتر) — عنوان، یک
      پاراگراف راهنما، مترادف‌ها؛ بعد بلافاصله فهرست. «یک کار در هر صفحه»: خریدار برای پیدا کردن قطعه آمده. ── */}
  <section class="bg-white border-b border-steel-300 px-4 md:px-6">
    <div class="max-w-7xl mx-auto pb-5">
      <Breadcrumb items={breadcrumbItems} surface />
      <h1 class="mt-1 text-2xl md:text-3xl font-black text-steel-900 leading-[1.5]">{category.keyword}</h1>
      {displayBlurb && <p class="mt-2 text-base text-steel-700 leading-8 max-w-3xl">{displayBlurb}</p>}
      {category.aka && category.aka.length > 0 && (
        /* مترادف‌ها مرئی‌اند تا کاربرِ آشنا با نام دیگر همین قطعه صفحه را بشناسد — بدون صفحه‌ی دوم
           (و هم‌خوان با alternateName در JSON-LD). */
        <p class="mt-2 text-sm text-steel-600">نام‌های دیگر: {category.aka.join('، ')}</p>
      )}
    </div>
  </section>

  {/* ------------------------------ محصولات ------------------------------ */}
  {/* ⚠️ عنوان دوم («{displayName}») بالای فهرست حذف شد (بازبینی ۲ آبان ۱۴۰۵): همان H1 دو سانت بالاتر را تکرار می‌کرد
      (اصل ۵). بخش با aria-label نام می‌گیرد، نه با سرتیتر تکراری. */}
  <section class="bg-steel-50 px-4 md:px-6 py-6 md:py-8" aria-labelledby="products-list-heading">
    {/* ⚠️ H2 پنهان (فاز ۵): با نمای کارت پیش‌فرض، عنوان h3 کارت‌ها مستقیم بعد از H1 می‌آمد — Lighthouse «heading-order» و
        a11y ۰٫۹۸ روی remote-control (build زنده‌ی 558f2e3). H2 دیدنی همان تکراری‌ای بود که فاز ۳ حذف کرد؛ پس sr-only. */}
    <h2 id="products-list-heading" class="sr-only">{`فهرست قطعات ${displayName}`}</h2>
    <div class="max-w-7xl mx-auto">
      {products.length > 0 && (
        <p class="text-sm text-steel-600 mb-3"><strong data-cat-count class="text-steel-900 font-black tabular-nums">{products.length.toLocaleString('fa-IR')}</strong> قطعه</p>
      )}

      {products.length > 0 ? (
        <>
          <CategoryFilterBar products={products} categorySlug={category.slug} />

          {/* نمای جدول — دوم؛ کارت پیش‌فرض است (کارفرما، ۳ آبان ۱۴۰۵): کد · نام · برند · مشخصه‌ی کلیدی · موجودی · قیمت · افزودن سریع. */}
          <div data-cat-view="list" hidden>
            <div class="hidden lg:grid lg:grid-cols-[7rem_9rem_1fr_7rem_10rem_8rem_9rem_auto] gap-x-4 px-3 py-2 text-xs font-bold text-steel-600 bg-steel-100 border border-steel-300 border-b-0 rounded-t">
              <span><span class="sr-only">تصویر</span></span><span>کد فنی</span><span>نام قطعه</span><span>برند</span><span>مشخصه‌ی کلیدی</span><span>موجودی</span><span>قیمت</span><span class="sr-only">عمل</span>
            </div>
            <ul class="bg-white border border-steel-300 rounded lg:rounded-t-none" role="list">
              {products.map((product) => (
                <ProductRow slug={product.slug} name={product.name} sku={product.sku} url={`${SITE.url}${productPath(product)}`}
                  brand={product.brandNameFa} keySpec={product.technicalSpecs[0]?.value ?? null} stock={product.stockStatus}
                  price={computePrice(product)} whatsappHref={contact.whatsappHref} image={product.images[0] ?? null} attrs={catAttrs(product)} />
              ))}
            </ul>
          </div>

          {/* نمای کارت — با جابه‌جایی نما. ⚠️ hidden تا اسکریپت؛ تصویرهای lazy داخل display:none بار نمی‌شوند. */}
          <ul data-cat-view="grid" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4" role="list">
            {products.map((product) => (
              <li {...catAttrs(product)}>
                <ProductCard product={product} />
              </li>
            ))}
          </ul>

          <div data-cat-empty hidden class="mt-4">
            <EmptyState title="هیچ قطعه‌ای با این فیلترها پیدا نشد." text="فیلترها را کمتر کنید یا کد فنی و عکس پلاک را بفرستید تا معادل مناسب را پیدا کنیم."
              whatsappHref={contact.whatsappHref} telHref={contact.telHref} />
          </div>
        </>
      ) : (
        /* حالت خالیِ صادقانه — هیچ محصول ساختگی ساخته نمی‌شود، هیچ «به‌زودی» با تاریخ. */
        <EmptyState
          title={`هنوز محصولی در «${displayName}» ثبت نشده است.`}
          text="فهرست آنلاین این دسته در حال تکمیل است و فقط اقلامی منتشر می‌شوند که تامینشان قطعی باشد. کد فنی، پلاک دستگاه یا عکس قطعه را بفرستید تا سازگاری بررسی و پیش‌فاکتور صادر شود."
          whatsappHref={contact.whatsappHref}
          telHref={contact.telHref}
        >
          <a href={`/contact/?category=${encodeURIComponent(displayName)}`} class="inline-flex items-center min-h-11 text-sm font-bold text-accent-ink hover:text-accent-strong hover:underline underline-offset-4">ثبت استعلام</a>
        </EmptyState>
      )}
    </div>
  </section>

  {/* ------------------ راهنمای فنی (محتوای وردپرس) ------------------ */}
  <ContentBlocks blocks={blocks} title={displayName} reviewMode={reviewMode} eyebrow="راهنمای فنی" />

  {/* ------------------ پرسش و پاسخ کاربران ------------------ */}
  {/* جایش عمدی است: **بعد از** راهنمای فنی. محتوای تخصصیِ ما اول، محتوای
      کاربر بعد — هم برای خواننده منطقی‌تر است و هم سیگنال تخصص صفحه را
      بالای صفحه نگه می‌دارد. */}
  <Questions
    questions={questions}
    entity="category"
    entitySlug={category.slug}
    entityName={displayName}
    wpBase={wpBase}
  />

  {/* --------------------- لینک‌سازی داخلی درون سیلو --------------------- */}
  {siblings.length > 0 && (
    <section class="bg-white px-4 py-14 border-t border-steel-100" aria-labelledby="siblings-heading">
      <div class="max-w-7xl mx-auto">
        <h2 id="siblings-heading" class="text-xl md:text-2xl font-black text-steel-900 mb-3">
          سایر قطعات گروه {silo.name}
        </h2>
        <p class="text-steel-600 leading-8 mb-8 max-w-3xl">
          <a href={siloPath(silo)} class="text-accent-ink font-bold hover:underline">{silo.keyword}</a> — مشاهده‌ی کل این گروه.
        </p>
        <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4" role="list">
          {siblings.map((sibling) => (
            <li>
              <a
                href={categoryPath({ ...sibling, silo })}
                class="group h-full bg-steel-50 hover:bg-white p-5 rounded-lg border border-steel-300 hover:border-steel-400 transition-colors flex items-center gap-3 focus:outline-none focus:ring-4 focus:ring-accent-ink/30"
              >
                <span class="w-10 h-10 shrink-0 bg-white text-steel-900 group-hover:text-accent-ink group-hover:bg-accent-soft rounded-lg flex items-center justify-center transition-colors" aria-hidden="true">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.4" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d={sibling.icon} /></svg>
                </span>
                <span class="text-sm font-bold text-steel-900 group-hover:text-accent-ink transition-colors leading-6">{sibling.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</Layout>

---
// src/pages/categories/[silo]/[category].astro
// ---------------------------------------------------------------------------
// صفحه‌ی دسته (فرزند سیلو) — عبارت کلیدی مشخص و بدون هم‌پوشانی را هدف می‌گیرد.
//
// تفکیک نیت جستجو (ضد هم‌نوع‌خواری):
//   • صفحه‌ی اصلی      → «قطعات جرثقیل سقفی» (عبارت اصلی و برند)
//   • هاب /categories  → مرور و ناوبری، نه رقابت بر سر عبارت اصلی
//   • صفحه‌ی سیلو      → عبارت گروهی («سیستم برق رسانی جرثقیل سقفی»)
//   • همین صفحه       → عبارت دقیق قطعه («شین برق‌رسان جرثقیل»)
// نام‌های مترادف (aka) عمداً صفحه‌ی جدا نمی‌گیرند و داخل همین صفحه می‌آیند.
// ---------------------------------------------------------------------------
import Layout from '../../../layouts/Layout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import ProductCard from '../../../components/ProductCard.astro';
import { SITE } from '../../../data/site';
import {
  SILOS,
  categoryPath,
  siloPath,
  type Category,
  type Silo,
} from '../../../data/taxonomy';
import CategoryGuide from '../../../components/CategoryGuide.astro';
import { getProductsByCategory, computePrice, productJsonLd, type CraneProduct } from '../../../lib/wp';
import { getCategoryContent, isReviewMode, type CategoryContent } from '../../../lib/category-content';

export async function getStaticPaths() {
  return Promise.all(
    SILOS.flatMap((silo) =>
      silo.categories.map(async (category) => ({
        params: { silo: silo.slug, category: category.slug },
        props: {
          silo,
          category,
          products: await getProductsByCategory(category.slug),
          content: await getCategoryContent(category.slug),
        },
      }))
    )
  );
}

interface Props {
  silo: Silo;
  category: Category;
  products: CraneProduct[];
  content: CategoryContent;
}

const { silo, category, products, content } = Astro.props as Props;
const reviewMode = isReviewMode();

const title = `${category.keyword} | خرید و استعلام قیمت | ${SITE.name}`;
const description = `${category.blurb} تامین ${category.keyword} با تضمین اصالت کالا، بررسی سازگاری فنی و صدور فاکتور رسمی.`;

const path = categoryPath({ ...category, silo });
const canonical = `${SITE.url}${path}`;

// دسته‌های هم‌سیلو — لینک‌سازی داخلی درون همان سیلو، نه پراکنده در کل سایت.
// این کار قدرت موضوعی (Topical Authority) را داخل سیلو نگه می‌دارد.
const siblings = silo.categories.filter((c) => c.slug !== category.slug);

const breadcrumbItems = [
  { label: 'صفحه اصلی', href: '/' },
  { label: 'دسته‌بندی‌ها', href: '/categories' },
  { label: silo.name, href: siloPath(silo) },
  { label: category.name },
];

const itemList =
  products.length > 0
    ? {
        '@type': 'ItemList',
        '@id': `${canonical}#products`,
        name: `فهرست ${category.keyword}`,
        numberOfItems: products.length,
        itemListElement: products.map((product, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          item: productJsonLd(product, SITE.url, computePrice(product)),
        })),
      }
    : null;

// نکته سئو: پرسش‌های واقعیِ ثبت‌شده در وردپرس مستقیماً وارد اسکیمای
// FAQPage می‌شوند. بدون این، محتوای پرسش و پاسخ فقط برای انسان مفید است و
// شانس ریچ‌ریزالت را از دست می‌دهد. گره فقط وقتی ساخته می‌شود که پرسش
// واقعی وجود داشته باشد — FAQPage خالی خطای اعتبارسنجی می‌دهد.
const faqNode =
  content.faqs.length > 0
    ? {
        '@type': 'FAQPage',
        '@id': `${canonical}#faq`,
        isPartOf: { '@id': `${canonical}#webpage` },
        mainEntity: content.faqs.map((faq) => ({
          '@type': 'Question',
          name: faq.question,
          acceptedAnswer: { '@type': 'Answer', text: faq.answer },
        })),
      }
    : null;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: breadcrumbItems.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: item.label,
        ...(item.href ? { item: `${SITE.url}${item.href}` } : {}),
      })),
    },
    {
      '@type': 'CollectionPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      isPartOf: { '@id': `${SITE.url}/#website` },
      inLanguage: SITE.locale,
      ...(itemList ? { mainEntity: itemList } : {}),
    },
    ...(faqNode ? [faqNode] : []),
  ],
};
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  {/* ------------------------------- Hero ------------------------------- */}
  <section class="bg-crane-navy text-white pt-10 pb-16 px-4 border-b-[8px] border-crane-orange">
    <div class="max-w-7xl mx-auto">
      <Breadcrumb items={breadcrumbItems} />
      <div class="flex flex-col md:flex-row items-start gap-6">
        <span class="w-16 h-16 bg-white/10 rounded-2xl flex items-center justify-center shrink-0 border border-white/20" aria-hidden="true">
          <svg class="w-8 h-8 text-crane-orange" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d={category.icon} /></svg>
        </span>
        <div>
          <h1 class="text-3xl md:text-5xl font-black mb-4 tracking-tight drop-shadow-md leading-relaxed">{category.keyword}</h1>
          <p class="text-lg text-gray-300 max-w-2xl leading-8">{category.blurb}</p>
          {category.aka && category.aka.length > 0 && (
            /* مترادف‌ها اینجا نمایش داده می‌شوند تا کاربرِ آشنا با نام دیگرِ
               همین قطعه، صفحه را درست تشخیص دهد — بدون ساختن صفحه‌ی دوم. */
            <p class="text-sm text-gray-400 mt-4">
              نام‌های دیگر: {category.aka.join('، ')}
            </p>
          )}
        </div>
      </div>
    </div>
  </section>

  {/* ------------------------------ محصولات ------------------------------ */}
  <section class="bg-gray-50 px-4 py-14" aria-labelledby="products-heading">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-wrap gap-4 justify-between items-end mb-8 border-b border-gray-200 pb-4">
        <h2 id="products-heading" class="text-2xl font-black text-crane-navy">{category.name}</h2>
        {products.length > 0 && (
          <span class="text-sm text-gray-600 font-bold bg-gray-100 px-3 py-1 rounded-full tabular-nums">
            {products.length} قطعه
          </span>
        )}
      </div>

      {products.length > 0 ? (
        <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6" role="list">
          {products.map((product, index) => (
            <li><ProductCard product={product} eager={index < 4} /></li>
          ))}
        </ul>
      ) : (
        /* حالت خالیِ صادقانه — هیچ محصول ساختگی ساخته نمی‌شود. */
        <div class="bg-white rounded-3xl border border-gray-100 shadow-sm p-8 md:p-12 max-w-3xl">
          <span class="w-14 h-14 rounded-2xl bg-orange-50 text-crane-orange flex items-center justify-center mb-6" aria-hidden="true">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z" /></svg>
          </span>
          <h3 class="text-xl md:text-2xl font-black text-crane-navy mb-4 leading-9">
            استعلام {category.keyword} با کد فنی
          </h3>
          <p class="text-gray-700 leading-8 mb-8">
            فهرست آنلاین این دسته در حال تکمیل است و تنها اقلامی منتشر می‌شود که تامین آن‌ها قطعی باشد. سریع‌ترین مسیر این است که کد فنی (Part Number)، پلاک دستگاه یا عکس قطعه‌ی فرسوده را برای کارشناسان ما بفرستید تا سازگاری بررسی و پیش‌فاکتور رسمی صادر شود.
          </p>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href={`/contact?category=${encodeURIComponent(category.name)}`} class="bg-crane-orange text-white px-8 py-4 rounded-xl font-black text-center hover:bg-orange-800 transition-colors focus:outline-none focus:ring-4 focus:ring-crane-orange/40 min-h-[52px] flex items-center justify-center">ثبت استعلام</a>
            <a href={`tel:${SITE.phone}`} class="bg-crane-navy text-white px-8 py-4 rounded-xl font-black text-center hover:bg-gray-800 transition-colors focus:outline-none focus:ring-4 focus:ring-crane-navy/30 min-h-[52px] flex items-center justify-center">تماس با واحد فروش</a>
            <a href={`https://wa.me/${SITE.whatsapp.replace('+', '')}`} target="_blank" rel="noopener noreferrer" class="bg-emerald-50 text-emerald-800 border border-emerald-200 px-8 py-4 rounded-xl font-black text-center hover:bg-emerald-600 hover:text-white transition-colors focus:outline-none focus:ring-4 focus:ring-emerald-500/30 min-h-[52px] flex items-center justify-center">ارسال عکس در واتساپ</a>
          </div>
        </div>
      )}
    </div>
  </section>

  {/* ------------------ راهنمای فنی (محتوای وردپرس) ------------------ */}
  <CategoryGuide content={content} categoryName={category.name} reviewMode={reviewMode} />

  {/* --------------------- لینک‌سازی داخلی درون سیلو --------------------- */}
  {siblings.length > 0 && (
    <section class="bg-white px-4 py-14 border-t border-gray-100" aria-labelledby="siblings-heading">
      <div class="max-w-7xl mx-auto">
        <h2 id="siblings-heading" class="text-xl md:text-2xl font-black text-crane-navy mb-3">
          سایر قطعات گروه {silo.name}
        </h2>
        <p class="text-gray-600 leading-8 mb-8 max-w-3xl">
          <a href={siloPath(silo)} class="text-crane-orange font-bold hover:underline">{silo.keyword}</a> — مشاهده‌ی کل این گروه.
        </p>
        <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4" role="list">
          {siblings.map((sibling) => (
            <li>
              <a
                href={categoryPath({ ...sibling, silo })}
                class="group h-full bg-gray-50 hover:bg-white p-5 rounded-2xl border border-gray-100 hover:border-orange-100 hover:shadow-md transition-all flex items-center gap-3 focus:outline-none focus:ring-4 focus:ring-crane-orange/30"
              >
                <span class="w-10 h-10 shrink-0 bg-white text-crane-navy group-hover:text-crane-orange group-hover:bg-orange-50 rounded-xl flex items-center justify-center transition-colors" aria-hidden="true">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.4" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d={sibling.icon} /></svg>
                </span>
                <span class="text-sm font-bold text-crane-navy group-hover:text-crane-orange transition-colors leading-6">{sibling.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</Layout>

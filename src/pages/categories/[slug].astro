---
// src/pages/categories/[slug].astro
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import { CATEGORIES, ENRICHED_BRANDS, SITE } from '../../data/site';
import { getProductsByCategory, productJsonLd, type CraneProduct } from '../../lib/wp';

// ---------------------------------------------------------------------------
// نکته‌ی معماری (مهم): `getStaticPaths` عمداً async است و محصولات واقعی را در
// زمان BUILD از WPGraphQL می‌گیرد. خروجی سایت همچنان کاملاً static است و
// بازدیدکننده هیچ درخواستی به وردپرس نمی‌زند.
//
// پیش از این، همین‌جا یک آرایه‌ی `mockProducts` با نام و کد فنی جعلی
// (DMG-1024، TLC-F21، …) ساخته می‌شد و مستقیماً وارد JSON-LD می‌شد. آن کد
// حذف شد: نقض قانون غیرقابل‌مذاکره‌ی پروژه و مصداق Structured Data Spam.
// ---------------------------------------------------------------------------
export async function getStaticPaths() {
  return Promise.all(
    CATEGORIES.map(async (cat) => {
      const slugPath = cat.slug.replace('/categories/', '');
      return {
        params: { slug: slugPath },
        props: { category: cat, products: await getProductsByCategory(slugPath) },
      };
    })
  );
}

interface Props {
  category: (typeof CATEGORIES)[number];
  products: CraneProduct[];
}

const { category, products } = Astro.props as Props;

const title = `خرید و قیمت ${category.keyword} | ${SITE.name}`;
const description = `مرجع تخصصی خرید ${category.keyword}. ${category.blurb} تضمین اصالت کالا و ارسال سریع به سراسر ایران.`;

// نکته سئو/لینک‌سازی داخلی: سه دسته‌ی دیگر (غیر از دسته‌ی جاری) را در پایین
// صفحه پیشنهاد می‌دهیم تا PageRank بین سیلوی دسته‌بندی‌ها جریان پیدا کند و
// کاربر مسیر خرید جایگزین هم ببیند (کاهش نرخ پرش/Bounce).
const relatedCategories = CATEGORIES.filter((c) => c.slug !== category.slug).slice(0, 3);

const breadcrumb = {
  '@type': 'BreadcrumbList',
  '@id': `${SITE.url}${category.slug}#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'صفحه اصلی', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'دسته‌بندی‌ها', item: `${SITE.url}/categories` },
    { '@type': 'ListItem', position: 3, name: category.name, item: `${SITE.url}${category.slug}` },
  ],
};

const collectionPage = {
  '@type': 'CollectionPage',
  '@id': `${SITE.url}${category.slug}#webpage`,
  url: `${SITE.url}${category.slug}`,
  name: title,
  description,
  isPartOf: { '@id': `${SITE.url}/#website` },
  inLanguage: SITE.locale,
};

// نکته سئو: گره‌ی ItemList فقط وقتی ساخته می‌شود که واقعاً محصول واقعی
// وجود داشته باشد. یک ItemList خالی (`numberOfItems: 0`) در Rich Results
// بی‌ارزش است و یک ItemList پرشده با داده‌ی ساختگی، مستوجب جریمه.
const itemList =
  products.length > 0
    ? {
        '@type': 'ItemList',
        '@id': `${SITE.url}${category.slug}#products`,
        url: `${SITE.url}${category.slug}`,
        name: `لیست محصولات ${category.keyword}`,
        numberOfItems: products.length,
        itemListElement: products.map((product, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          item: productJsonLd(product, SITE.url),
        })),
      }
    : null;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [breadcrumb, collectionPage, ...(itemList ? [itemList] : [])],
};
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  {/* -------------------- Hero & Breadcrumb -------------------- */}
  <section class="bg-crane-navy text-white pt-12 pb-20 px-4 border-b-[8px] border-crane-orange">
    <div class="max-w-7xl mx-auto">
      <Breadcrumb items={[{ label: 'صفحه اصلی', href: '/' }, { label: 'دسته‌بندی‌ها', href: '/categories' }, { label: category.name }]} />
      <div class="flex flex-col md:flex-row items-start gap-6">
        <span class="w-16 h-16 bg-white/10 rounded-2xl flex items-center justify-center shrink-0 border border-white/20" aria-hidden="true">
          <svg class="w-8 h-8 text-crane-orange" fill="currentColor" viewBox="0 0 24 24"><path d={category.icon} /></svg>
        </span>
        <div>
          <h1 class="text-3xl md:text-5xl font-black mb-4 tracking-tight drop-shadow-md">{category.keyword}</h1>
          <p class="text-lg text-gray-300 max-w-2xl leading-8">{category.blurb}</p>
        </div>
      </div>
    </div>
  </section>

  {/* --------------------------- Product Grid --------------------------- */}
  <ProductGrid
    products={products}
    heading={`محصولات دسته‌ی ${category.name}`}
    emptyTitle={`استعلام ${category.keyword} بر اساس کد فنی`}
    emptyBody={`فهرست آنلاین این دسته در حال تکمیل است و تنها قطعاتی در آن منتشر می‌شود که موجودی یا امکان تامین آن‌ها قطعی باشد. تا آن زمان، سریع‌ترین مسیر این است که کد فنی (Part Number)، پلاک دستگاه یا عکس قطعه‌ی فرسوده را برای کارشناسان ما بفرستید؛ سازگاری قطعه بررسی و پیش‌فاکتور رسمی صادر می‌شود.`}
    inquiryQuery={{ category: category.name }}
  />

  {/* ------------------- Brands covered (Internal Linking) ------------------- */}
  <section class="bg-white py-16 px-4 border-t border-gray-100" aria-labelledby="covered-brands-heading">
    <div class="max-w-7xl mx-auto">
      <h2 id="covered-brands-heading" class="text-xl md:text-2xl font-black text-crane-navy mb-3">
        برندهای تحت پوشش در تامین {category.keyword}
      </h2>
      <p class="text-gray-600 leading-8 mb-8 max-w-3xl">
        قطعات این دسته برای بالابرها و جرثقیل‌های سقفی برندهای زیر تامین می‌شود. برای دیدن جزئیات هر برند، روی نام آن کلیک کنید.
      </p>
      <ul class="grid grid-cols-2 md:grid-cols-4 gap-4" role="list">
        {ENRICHED_BRANDS.map((brand) => (
          <li>
            <a
              href={brand.slug}
              class="group bg-gray-50 hover:bg-white p-5 rounded-2xl border border-gray-100 hover:border-orange-100 hover:shadow-md transition-all flex flex-col items-center text-center focus:outline-none focus:ring-4 focus:ring-crane-orange/30"
            >
              <span class="text-xs font-black tracking-widest text-gray-500 group-hover:text-crane-orange transition-colors uppercase" dir="ltr">{brand.nameEn}</span>
              <span class="text-sm font-bold text-crane-navy mt-1">{brand.nameFa}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ----------------------------- SEO Content ----------------------------- */}
  <section class="bg-gray-50 py-16 px-4 border-t border-gray-100">
    <div class="max-w-4xl mx-auto text-gray-700 text-justify leading-8">
      <h2 class="text-2xl font-bold text-crane-navy mb-6">راهنمای خرید {category.keyword}</h2>
      <p class="mb-4">جهت دریافت اطلاعات دقیق فنی و ثبت سفارش <strong class="text-crane-navy">{category.keyword}</strong>، پیشنهاد می‌شود پیش از خرید با تیم مهندسی ما مشورت نمایید تا از سازگاری کامل قطعه با تجهیزات شما اطمینان حاصل شود.</p>
      <p>در صورتی که کد فنی (Part Number) قطعه‌ی مورد نظر را در اختیار دارید، همان را در <a href="/contact" class="text-crane-orange font-bold hover:underline">فرم استعلام قیمت</a> وارد کنید؛ در غیر این صورت عکس پلاک دستگاه و مشخصات ظرفیت جرثقیل برای شناسایی قطعه کافی است.</p>
    </div>
  </section>

  {/* ------------------- Related Categories (Internal Linking) ------------------- */}
  <section class="bg-white py-16 px-4 border-t border-gray-100" aria-labelledby="related-categories-heading">
    <div class="max-w-7xl mx-auto">
      <h2 id="related-categories-heading" class="text-xl md:text-2xl font-black text-crane-navy mb-8">دسته‌بندی‌های مرتبط</h2>
      <ul class="grid grid-cols-1 sm:grid-cols-3 gap-6" role="list">
        {relatedCategories.map((rc) => (
          <li>
            <a href={rc.slug} class="group h-full bg-gray-50 p-6 rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg hover:border-orange-100 hover:bg-white transition-all flex items-center gap-4 focus:outline-none focus:ring-4 focus:ring-crane-orange/30">
              <span class="w-12 h-12 shrink-0 bg-white text-crane-navy group-hover:text-crane-orange group-hover:bg-orange-50 rounded-xl flex items-center justify-center transition-colors" aria-hidden="true">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.4" d={rc.icon} /></svg>
              </span>
              <span>
                <span class="block font-bold text-crane-navy group-hover:text-crane-orange transition-colors text-sm md:text-base">{rc.keyword}</span>
                <span class="block text-xs text-gray-600 mt-1 line-clamp-1">{rc.blurb}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>

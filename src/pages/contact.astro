---
// src/pages/contact.astro
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { SITE } from '../data/site';
import { getContact, getSiteOptions } from '../lib/site-options';

/* ⚠️ بالای فرontmatter اعلان می‌شوند.
   قبلاً پایین‌تر از محل استفاده بودند و رندر با خطای
   «Cannot access 'contact' before initialization» می‌شکست —
   `const` تا نقطه‌ی اعلان در ناحیه‌ی مرده‌ی زمانی است. */
const contact = await getContact();
const social = (await getSiteOptions()).social;

const title = `استعلام قیمت و تماس با کرین یدک | تامین قطعات جرثقیل سقفی`;
const description = 'ثبت درخواست پیش‌فاکتور رسمی، مشاوره فنی رایگان و استعلام قیمت قطعات جرثقیل سقفی. ارسال تصویر پلاک دستگاه و کدهای فنی جهت تایید سازگاری.';

// ---------------------------------------------------------------------------
// اندپوینت واقعی ثبت استعلام (پلاگین وردپرس crane-yadak-headless).
//
// چرا این‌طور نوشته شده:
// فرم قبلاً به `/api/contact` پست می‌شد. آن مسیر یک Astro API Route بود و
// چون پروژه در حالت `output: 'static'` بیلد می‌شود (بدون server adapter)،
// در خروجی نهایی اصلاً وجود نداشت — یعنی هر کاربری که جاوااسکریپت‌اش
// غیرفعال بود یا اسکریپت صفحه بارگذاری نمی‌شد، فرم را پر می‌کرد و به یک
// صفحه‌ی ۴۰۴ می‌رسید و لید بی‌سروصدا از بین می‌رفت. آن فایل حذف شد.
//
// حالا `action` خودِ فرم مستقیماً به اندپوینت وردپرس اشاره می‌کند؛ بنابراین
// حتی بدون جاوااسکریپت هم ارسال واقعاً ثبت می‌شود (WP REST هم JSON و هم
// form-encoded را می‌پذیرد). اسکریپت پایین صفحه فقط یک بهبود تدریجی است:
// جلوگیری از ترک صفحه و نمایش خطا/موفقیت درجا.
//
// اگر PUBLIC_WP_API_URL تنظیم نشده باشد، هیچ فرمی که به جایی نمی‌رسد نمایش
// داده نمی‌شود؛ به‌جای آن کانال‌های تماس مستقیم برجسته می‌شوند — بهتر از
// فرمی که وانمود می‌کند کار می‌کند.
// ---------------------------------------------------------------------------
const wpApiBase = (import.meta.env.PUBLIC_WP_API_URL ?? '').replace(/\/+$/, '');
const inquiryEndpoint = wpApiBase ? `${wpApiBase}/wp-json/crane/v1/inquiry` : null;

// نکته سئوی محلی: آدرس کامل برای Google Maps embed query — تا زمانی که
// آدرس واقعی جایگزین placeholder فعلی نشده، این نقشه موقعیت دقیقی نشان
// نمی‌دهد (فقط شهر تهران). این خودش یک TODO سئوی محلی است — نگاه کنید
// به کامنت‌های src/data/site.ts.
const fullAddress = [contact.street, contact.city, contact.region, 'Iran'].filter(Boolean).join(', ');
const mapQuery = encodeURIComponent(fullAddress);

const localCitations = [
  social.googleBusinessProfile && { label: 'گوگل بیزینس پروفایل', href: social.googleBusinessProfile },
  social.neshan && { label: 'نشان', href: social.neshan },
  social.balad && { label: 'بلد', href: social.balad },
].filter((c): c is { label: string; href: string } => Boolean(c));

// E-E-A-T & Local Business Schema Integration
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      '@id': `${SITE.url}/contact#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'صفحه اصلی', item: SITE.url },
        { '@type': 'ListItem', position: 2, name: 'تماس و استعلام قیمت', item: `${SITE.url}/contact` },
      ],
    },
    {
      '@type': 'ContactPage',
      '@id': `${SITE.url}/contact#webpage`,
      url: `${SITE.url}/contact`,
      name: title,
      description: description,
      isPartOf: { '@id': `${SITE.url}/#website` },
      about: { '@id': `${SITE.url}/#organization` },
    },
  ],
};



---

<Layout title={title} description={description} jsonLd={jsonLd}>
  {/* -------------------- Hero & Breadcrumb -------------------- */}
  <section class="bg-crane-navy text-white pt-12 pb-20 px-4 border-b-[8px] border-crane-orange relative overflow-hidden">
    <div class="max-w-7xl mx-auto relative z-10">
      <Breadcrumb items={[{ label: 'صفحه اصلی', href: '/' }, { label: 'تماس و استعلام قیمت' }]} />

      <h1 class="text-3xl md:text-5xl font-black mb-4 tracking-tight drop-shadow-md">
        استعلام قیمت و مشاوره فنی قطعات
      </h1>
      <p class="text-lg text-gray-300 max-w-2xl leading-8 font-light">
        کد فنی یا عکس قطعه فرسوده را بفرستید؛ کارشناسان واحد فروش و نت در سریع‌ترین زمان پیش‌فاکتور رسمی صادر می‌کنند.
      </p>
    </div>
  </section>

  {/* ----------------------------- Main Content Grid ----------------------------- */}
  <section class="py-16 px-4 md:px-8 lg:px-12 bg-gray-50 min-h-[60vh]">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">

      {/* Right Column: Contact Info & E-E-A-T Signals (5 Cols) */}
      <div class="lg:col-span-5 space-y-8">
        
        {/* Direct Call / WhatsApp Card */}
        <div class="bg-white rounded-3xl p-8 border border-gray-100 shadow-sm space-y-6">
          <h2 class="text-2xl font-black text-crane-navy border-b border-gray-100 pb-4">ارتباط مستقیم با واحد فروش</h2>
          
          <div class="space-y-4">
            <a href={contact.telHref} class="flex items-center gap-4 bg-orange-50 hover:bg-crane-orange hover:text-white p-4 rounded-2xl transition-all duration-300 text-crane-orange group focus:outline-none focus:ring-4 focus:ring-crane-orange/30">
              <span class="w-12 h-12 rounded-xl bg-white text-crane-orange flex items-center justify-center shrink-0 shadow-sm group-hover:bg-white/20 group-hover:text-white" aria-hidden="true">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
              </span>
              <div>
                <span class="text-xs text-gray-500 group-hover:text-white/80 block font-medium">تلفن دفتر مرکزی (تهران)</span>
                <span class="text-xl font-black dir-ltr text-right block">{contact.phoneDisplay}</span>
              </div>
            </a>

            <a href={contact.whatsappHref} target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 bg-emerald-50 hover:bg-emerald-600 hover:text-white p-4 rounded-2xl transition-all duration-300 text-emerald-700 group focus:outline-none focus:ring-4 focus:ring-emerald-500/30">
              <span class="w-12 h-12 rounded-xl bg-white text-emerald-600 flex items-center justify-center shrink-0 shadow-sm group-hover:bg-white/20 group-hover:text-white" aria-hidden="true">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.296-.883-.649-1.479-1.451-1.652-1.749-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
              </span>
              <div>
                <span class="text-xs text-gray-500 group-hover:text-white/80 block font-medium">ارسال عکس و مشخصات در واتساپ</span>
                <span class="text-lg font-black dir-ltr text-right block">ارسال سریع تصویر قطعه</span>
              </div>
            </a>

            <a href={social.telegram} target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 bg-sky-50 hover:bg-sky-500 hover:text-white p-4 rounded-2xl transition-all duration-300 text-sky-700 group focus:outline-none focus:ring-4 focus:ring-sky-500/30">
              <span class="w-12 h-12 rounded-xl bg-white text-sky-500 flex items-center justify-center shrink-0 shadow-sm group-hover:bg-white/20 group-hover:text-white" aria-hidden="true">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M22.05 2.638a1.68 1.68 0 00-1.72-.24L2.36 9.75c-1.15.46-1.14 1.03-.2 1.32l4.6 1.44 10.68-6.74c.5-.31.96-.14.58.2l-8.65 7.82h0l-.32 4.65c.46 0 .67-.21.92-.46l2.21-2.14 4.6 3.4c.85.47 1.46.23 1.67-.79l3.03-14.29c.3-1.25-.47-1.82-1.43-2.32z"/></svg>
              </span>
              <div>
                <span class="text-xs text-gray-500 group-hover:text-white/80 block font-medium">پاسخ‌گویی سریع در تلگرام</span>
                <span class="text-lg font-black dir-ltr text-right block">{social.telegram}</span>
              </div>
            </a>
          </div>
        </div>

        {/* Address & Hours */}
        <div class="bg-white rounded-3xl p-8 border border-gray-100 shadow-sm space-y-4">
          <h3 class="font-bold text-lg text-crane-navy">اطلاعات دفتر و انبار مرکزی</h3>
          <address class="not-italic text-sm text-gray-600 leading-7 space-y-2">
            <p><strong>آدرس:</strong> {contact.city}، {contact.street}</p>
            <p><strong>ایمیل رسمی:</strong> {contact.email}</p>
            <p><strong>ساعات کاری:</strong> شنبه تا چهارشنبه: ۸:۳۰ الی ۱۷:۰۰ | پنجشنبه: ۸:۳۰ الی ۱۳:۰۰</p>
          </address>

          {/* نکته سئوی محلی: نقشه‌ی جاسازی‌شده بر اساس متن آدرس (بدون نیاز
              به API Key). دقت موقعیت وابسته به صحت نشانی ثبت‌شده در وردپرس است — با
              آدرس placeholder فعلی فقط مرکز تهران را نشان می‌دهد؛ به محض
              ثبت آدرس واقعی دفتر/انبار در src/data/site.ts، این نقشه
              خودکار روی موقعیت درست متمرکز می‌شود. */}
          <div class="rounded-2xl overflow-hidden border border-gray-200 aspect-video">
            <iframe
              title={`نقشه موقعیت ${SITE.name}`}
              src={`https://www.google.com/maps?q=${mapQuery}&output=embed`}
              width="100%"
              height="100%"
              style="border:0;"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>

          {localCitations.length > 0 && (
            <div class="flex flex-wrap gap-2 pt-2">
              {localCitations.map((c) => (
                <a href={c.href} target="_blank" rel="noopener noreferrer" class="text-xs font-bold bg-gray-50 hover:bg-orange-50 hover:text-crane-orange text-gray-600 px-3 py-1.5 rounded-full border border-gray-200 transition-colors">
                  {c.label}
                </a>
              ))}
            </div>
          )}
        </div>

        {/* Guarantee Banner */}
        <div class="bg-crane-light rounded-3xl p-6 border border-gray-200 flex items-center gap-4">
          <span class="w-12 h-12 rounded-2xl bg-orange-100 text-crane-orange flex items-center justify-center shrink-0 font-bold text-xl" aria-hidden="true">✓</span>
          <p class="text-xs md:text-sm text-gray-700 leading-6">
            تمام پیش‌فاکتورهای صادرشده توسط کرین یدک معتبر بوده و شامل <strong>ضمانت کتبی اصالت کالا و گارانتی تعویض</strong> می‌باشند.
          </p>
        </div>

      </div>

      {/* Left Column: RFQ Form (7 Cols) */}
      <div class="lg:col-span-7 bg-white rounded-3xl p-8 md:p-10 border border-gray-100 shadow-lg">
        {!inquiryEndpoint && (
          /* حالت «بک‌اند هنوز وصل نشده»: به‌جای نمایش فرمی که ارسالش به هیچ
             مقصدی نمی‌رسد (و لید را بی‌صدا از بین می‌برد)، کانال‌های واقعی
             و فعال تماس نمایش داده می‌شوند. */
          <div class="bg-amber-50 border border-amber-200 rounded-2xl p-6" role="status">
            <h2 class="text-2xl font-black text-crane-navy mb-3">ثبت آنلاین درخواست موقتاً در دسترس نیست</h2>
            <p class="text-sm text-gray-700 leading-7 mb-6">
              سامانه‌ی ثبت آنلاین استعلام در حال راه‌اندازی است. تا آن زمان، سریع‌ترین راه دریافت پیش‌فاکتور، تماس تلفنی یا ارسال عکس قطعه در واتساپ/تلگرام است — پاسخ‌گویی در ساعات کاری انجام می‌شود.
            </p>
            <div class="flex flex-col sm:flex-row gap-3">
              <a href={contact.telHref} class="flex-1 bg-crane-orange text-white text-center px-6 py-4 rounded-xl font-black hover:bg-orange-800 transition-colors focus:outline-none focus:ring-4 focus:ring-crane-orange/40 min-h-[52px] flex items-center justify-center">تماس تلفنی</a>
              <a href={contact.whatsappHref} target="_blank" rel="noopener noreferrer" class="flex-1 bg-emerald-600 text-white text-center px-6 py-4 rounded-xl font-black hover:bg-emerald-700 transition-colors focus:outline-none focus:ring-4 focus:ring-emerald-500/30 min-h-[52px] flex items-center justify-center">ارسال در واتساپ</a>
              <a href={social.telegram} target="_blank" rel="noopener noreferrer" class="flex-1 bg-sky-500 text-white text-center px-6 py-4 rounded-xl font-black hover:bg-sky-600 transition-colors focus:outline-none focus:ring-4 focus:ring-sky-500/30 min-h-[52px] flex items-center justify-center">ارسال در تلگرام</a>
            </div>
          </div>
        )}

        {inquiryEndpoint && (
        <>
        <h2 class="text-2xl font-black text-crane-navy mb-2">فرم درخواست پیش‌فاکتور و استعلام</h2>
        <p class="text-sm text-gray-600 mb-8">مشخصات قطعه مورد نیاز را وارد کنید. کارشناسان ما در اولین فرصت کاری با شما تماس می‌گیرند.</p>

        {/* Progressive enhancement: `action` مستقیماً به اندپوینت REST وردپرس
            اشاره می‌کند، پس ارسال بدون جاوااسکریپت هم واقعاً ثبت می‌شود.
            اسکریپت پایین صفحه فقط تجربه را بهتر می‌کند (بدون ترک صفحه). */}
        <div id="form-feedback" class="hidden mb-6 border rounded-2xl p-5 text-sm font-bold leading-6" role="alert"></div>

        <form id="rfq-form" action={inquiryEndpoint} data-endpoint={inquiryEndpoint} method="POST" enctype="multipart/form-data" class="space-y-6">
          {/* هانی‌پات ضداسپم: برای کاربران واقعی نامرئی (هم بصری و هم برای
              screen reader)، اما ربات‌های فرم‌پرکن معمولاً این فیلد را هم پر
              می‌کنند. اگر پر شده باشد، بک‌اند (class-rest-contact.php) بی‌سروصدا
              رد می‌کند. */}
          <div class="cyh-honeypot" aria-hidden="true">
            <label for="contact-website">وب‌سایت (خالی بگذارید)</label>
            <input type="text" id="contact-website" name="website" tabindex="-1" autocomplete="off" />
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            
            {/* Name */}
            <div>
              <label for="contact-name" class="block text-sm font-bold text-gray-700 mb-2">نام و نام خانوادگی <span class="text-red-500">*</span></label>
              <input type="text" id="contact-name" name="name" required placeholder="مثال: مهندس رضایی" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3.5 min-h-[48px] focus:outline-none focus:ring-2 focus:ring-crane-orange focus:border-transparent text-sm" />
            </div>

            {/* Phone */}
            <div>
              <label for="contact-phone" class="block text-sm font-bold text-gray-700 mb-2">شماره همراه (جهت ارسال پیش‌فاکتور) <span class="text-red-500">*</span></label>
              <input type="tel" id="contact-phone" name="phone" required placeholder="۰۹۱۲XXXXXXX" dir="ltr" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3.5 min-h-[48px] focus:outline-none focus:ring-2 focus:ring-crane-orange focus:border-transparent text-sm text-right" />
            </div>

          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            
            {/* Company */}
            <div>
              <label for="contact-company" class="block text-sm font-bold text-gray-700 mb-2">نام شرکت / کارخانه (اختیاری)</label>
              <input type="text" id="contact-company" name="company" placeholder="مثال: فولاد کویر" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3.5 min-h-[48px] focus:outline-none focus:ring-2 focus:ring-crane-orange focus:border-transparent text-sm" />
            </div>

            {/* SKU / Part Number Auto-Filled */}
            <div>
              <label for="contact-sku" class="block text-sm font-bold text-gray-700 mb-2">کد فنی یا مدل قطعه (Part Number)</label>
              <input type="text" id="contact-sku" name="sku" placeholder="مثال: DMG-1024" dir="ltr" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3.5 min-h-[48px] focus:outline-none focus:ring-2 focus:ring-crane-orange focus:border-transparent text-sm text-left font-mono" />
            </div>

          </div>

          {/* Description */}
          <div>
            <label for="contact-message" class="block text-sm font-bold text-gray-700 mb-2">توضیحات و مشخصات قطعه <span class="text-red-500">*</span></label>
            <textarea id="contact-message" name="message" rows="4" required placeholder="شرح قطعه، برند سازنده، ظرفیت جرثقیل یا سوالات فنی خود را بنویسید..." class="w-full bg-gray-50 border border-gray-200 rounded-xl p-4 focus:outline-none focus:ring-2 focus:ring-crane-orange focus:border-transparent text-sm leading-6"></textarea>
          </div>

          {/* عکس پلاک — مهم‌ترین داده‌ی یک استعلام.
              راهنمای خواندن پلاک به مشتری می‌گوید عکس بفرستد؛ تا امروز هیچ
              راهی برایش نبود. */}
          <div>
            <label for="contact-photos" class="block text-sm font-bold text-gray-700 mb-2">
              عکس پلاک یا قطعه <span class="font-normal text-gray-500">(اختیاری، ولی استعلام را چند برابر سریع‌تر می‌کند)</span>
            </label>
            <input
              type="file"
              id="contact-photos"
              name="photos[]"
              multiple
              accept="image/jpeg,image/png,image/webp"
              class="w-full bg-gray-50 border border-dashed border-gray-300 rounded-xl px-4 py-3.5 text-sm file:ml-3 file:rounded-lg file:border-0 file:bg-crane-navy file:px-4 file:py-2 file:text-white file:font-bold file:cursor-pointer hover:border-crane-orange focus:outline-none focus:ring-2 focus:ring-crane-orange"
            />
            <p id="photos-hint" class="text-xs text-gray-500 mt-2 leading-6">
              حداکثر ۳ عکس، هرکدام تا ۵ مگابایت — JPG، PNG یا WebP. اگر پلاک ناخوانا است، از قطعه کنار یک خط‌کش عکس بگیرید.
            </p>
            <ul id="photos-list" class="mt-2 space-y-1 text-xs text-gray-600" role="list"></ul>
          </div>

          {/* Submit Button */}
          <button id="rfq-submit-btn" type="submit" class="w-full bg-crane-orange text-white font-black py-4 rounded-xl text-lg hover:bg-orange-800 transition-colors shadow-lg shadow-orange-500/20 focus:outline-none focus:ring-4 focus:ring-crane-orange/40 flex items-center justify-center gap-2 min-h-[52px] disabled:opacity-60 disabled:cursor-not-allowed">
            <span>ثبت و ارسال درخواست استعلام</span>
            <svg class="w-5 h-5 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
          </button>
        </form>
        </>
        )}

      </div>

    </div>
  </section>
</Layout>

<script>
  // خوانش هوشمند URL Params و پر کردن خودکار کد فنی/برند در فرم
  document.addEventListener('DOMContentLoaded', () => {
    const params = new URLSearchParams(window.location.search);
    const sku = params.get('sku') || params.get('pn');
    const brand = params.get('brand');

    const skuInput = document.getElementById('contact-sku') as HTMLInputElement | null;
    const msgInput = document.getElementById('contact-message') as HTMLTextAreaElement | null;

    if (skuInput && sku) {
      skuInput.value = sku;
    }

    if (msgInput && (sku || brand)) {
      const brandText = brand ? `برند: ${brand}` : '';
      const skuText = sku ? `کد فنی: ${sku}` : '';
      msgInput.value = `درخواست استعلام قیمت برای ${skuText} ${brandText}`.trim();
    }

    // ------------------------------------------------------------
    // بهبود تدریجی (Progressive Enhancement) ارسال فرم.
    //
    // مقصد ارسال از خودِ `action`/`data-endpoint` فرم خوانده می‌شود — تک
    // منبع حقیقت. اگر جاوااسکریپت اجرا نشود، مرورگر همان `action` را
    // به‌صورت native POST می‌کند و لید باز هم در وردپرس ثبت می‌شود؛ این
    // اسکریپت فقط جلوی ترک صفحه را می‌گیرد و خطا/موفقیت را درجا نشان
    // می‌دهد. (مسیر قدیمی /api/contact حذف شد: در بیلد static اصلاً وجود
    // نداشت و باعث ۴۰۴ و از دست رفتن خاموش لید می‌شد.)
    // ------------------------------------------------------------
    const form = document.getElementById('rfq-form') as HTMLFormElement | null;
    const submitBtn = document.getElementById('rfq-submit-btn') as HTMLButtonElement | null;
    const feedback = document.getElementById('form-feedback') as HTMLDivElement | null;
    const endpoint = form?.dataset.endpoint;

    const showFeedback = (message: string, tone: 'error' | 'success') => {
      if (!feedback) return;
      feedback.textContent = message;
      feedback.classList.remove('hidden', 'bg-red-50', 'border-red-200', 'text-red-700', 'bg-emerald-50', 'border-emerald-200', 'text-emerald-700');
      if (tone === 'error') {
        feedback.classList.add('bg-red-50', 'border-red-200', 'text-red-700');
      } else {
        feedback.classList.add('bg-emerald-50', 'border-emerald-200', 'text-emerald-700');
      }
      feedback.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    };

    if (form && submitBtn && endpoint) {
      // ── اعتبارسنجی سمت کلاینت ────────────────────────────────────────
      // سرور هم همین‌ها را بررسی می‌کند و آنجا حرف آخر را می‌زند؛ این فقط
      // برای این است که کاربر ۵ مگابایت را آپلود نکند تا بعد رد شود.
      const MAX_FILES = 3;
      const MAX_BYTES = 5 * 1024 * 1024;
      const OK_TYPES = ['image/jpeg', 'image/png', 'image/webp'];

      const photos = document.getElementById('contact-photos') as HTMLInputElement | null;
      const photosList = document.getElementById('photos-list');

      const kb = (n: number) => (n < 1024 * 1024 ? `${Math.round(n / 1024)} کیلوبایت` : `${(n / 1048576).toFixed(1)} مگابایت`);

      const checkPhotos = (): string | null => {
        if (!photos?.files?.length) return null;
        const files = Array.from(photos.files);

        if (files.length > MAX_FILES) return `حداکثر ${MAX_FILES} عکس — شما ${files.length} عکس انتخاب کرده‌اید.`;

        for (const f of files) {
          if (!OK_TYPES.includes(f.type)) return `«${f.name}» عکس JPG، PNG یا WebP نیست.`;
          if (f.size > MAX_BYTES) return `«${f.name}» ${kb(f.size)} است — حداکثر ۵ مگابایت.`;
        }
        return null;
      };

      photos?.addEventListener('change', () => {
        if (!photosList) return;
        photosList.innerHTML = '';
        const problem = checkPhotos();

        for (const f of Array.from(photos.files ?? [])) {
          const li = document.createElement('li');
          li.textContent = `${f.name} — ${kb(f.size)}`;
          photosList.appendChild(li);
        }
        if (problem) showFeedback(problem, 'error');
      });

      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const photoProblem = checkPhotos();
        if (photoProblem) { showFeedback(photoProblem, 'error'); return; }
        if (submitBtn.disabled) return; // جلوگیری از ارسال دوباره با دابل‌کلیک
        submitBtn.disabled = true;
        const originalHtml = submitBtn.innerHTML;
        submitBtn.innerHTML = '<span>در حال ارسال...</span>';

        try {
          // ⚠️ دیگر JSON نیست. فایل را نمی‌شود در JSON فرستاد؛ FormData
          // خودش مرز multipart و Content-Type را می‌سازد — به همین دلیل
          // هدر Content-Type را *دستی نمی‌گذاریم*. اگر بگذاریم، مرورگر
          // مرز (boundary) را اضافه نمی‌کند و سرور هیچ فیلدی نمی‌بیند.
          const formData = new FormData(form);

          const res = await fetch(endpoint, {
            method: 'POST',
            headers: { Accept: 'application/json' },
            body: formData,
          });

          const data = (await res.json().catch(() => ({}))) as { success?: boolean; message?: string };

          if (res.ok && data.success) {
            window.location.href = '/thank-you';
            return;
          }

          showFeedback(
            data.message ||
              'ارسال درخواست انجام نشد. لطفاً نام، شماره همراه (۰۹۱۲XXXXXXX) و توضیحات را کامل وارد کنید و دوباره تلاش نمایید. در صورت تکرار مشکل، از طریق واتساپ یا تلگرام با ما در ارتباط باشید.',
            'error'
          );
        } catch {
          showFeedback('خطا در ارتباط با سرور. لطفاً اتصال اینترنت خود را بررسی کنید یا از طریق واتساپ/تلگرام پیام دهید.', 'error');
        } finally {
          submitBtn.disabled = false;
          submitBtn.innerHTML = originalHtml;
        }
      });
    }
  });
</script>
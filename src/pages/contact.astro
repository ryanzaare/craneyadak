---
// src/pages/contact.astro
import Layout from '../layouts/Layout.astro';
import { SITE } from '../data/site';

const title = `استعلام قیمت و تماس با کرین یدک | تامین قطعات جرثقیل سقفی`;
const description = 'ثبت درخواست پیش‌فاکتور رسمی، مشاوره فنی رایگان و استعلام قیمت قطعات جرثقیل سقفی. ارسال تصویر پلاک دستگاه و کدهای فنی جهت تایید سازگاری.';

// E-E-A-T & Local Business Schema Integration
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      '@id': `${SITE.url}/contact#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'صفحه اصلی', item: SITE.url },
        { '@type': 'ListItem', position: 2, name: 'تماس و استعلام قیمت', item: `${SITE.url}/contact` },
      ],
    },
    {
      '@type': 'ContactPage',
      '@id': `${SITE.url}/contact#webpage`,
      url: `${SITE.url}/contact`,
      name: title,
      description: description,
      isPartOf: { '@id': `${SITE.url}/#website` },
      about: { '@id': `${SITE.url}/#organization` },
    },
  ],
};
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  {/* -------------------- Hero & Breadcrumb -------------------- */}
  <section class="bg-crane-navy text-white pt-12 pb-20 px-4 border-b-[8px] border-crane-orange relative overflow-hidden">
    <div class="max-w-7xl mx-auto relative z-10">
      <nav class="text-sm text-gray-400 mb-8 flex items-center gap-2" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-crane-orange rounded py-1 px-2 -ml-2">صفحه اصلی</a>
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
        <span class="text-white font-bold" aria-current="page">تماس و استعلام قیمت</span>
      </nav>

      <h1 class="text-3xl md:text-5xl font-black mb-4 tracking-tight drop-shadow-md">
        استعلام قیمت و مشاوره فنی قطعات
      </h1>
      <p class="text-lg text-gray-300 max-w-2xl leading-8 font-light">
        کد فنی یا عکس قطعه فرسوده را بفرستید؛ کارشناسان واحد فروش و نت در سریع‌ترین زمان پیش‌فاکتور رسمی صادر می‌کنند.
      </p>
    </div>
  </section>

  {/* ----------------------------- Main Content Grid ----------------------------- */}
  <section class="py-16 px-4 md:px-8 lg:px-12 bg-gray-50 min-h-[60vh]">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      {/* Right Column: Contact Info & E-E-A-T Signals (5 Cols) */}
      <div class="lg:col-span-5 space-y-8">
        
        {/* Direct Call / WhatsApp Card */}
        <div class="bg-white rounded-3xl p-8 border border-gray-100 shadow-sm space-y-6">
          <h2 class="text-2xl font-black text-crane-navy border-b border-gray-100 pb-4">ارتباط مستقیم با واحد فروش</h2>
          
          <div class="space-y-4">
            <a href={`tel:${SITE.phone}`} class="flex items-center gap-4 bg-orange-50 hover:bg-crane-orange hover:text-white p-4 rounded-2xl transition-all duration-300 text-crane-orange group focus:outline-none focus:ring-4 focus:ring-crane-orange/30">
              <span class="w-12 h-12 rounded-xl bg-white text-crane-orange flex items-center justify-center shrink-0 shadow-sm group-hover:bg-white/20 group-hover:text-white" aria-hidden="true">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
              </span>
              <div>
                <span class="text-xs text-gray-500 group-hover:text-white/80 block font-medium">تلفن دفتر مرکزی (تهران)</span>
                <span class="text-xl font-black dir-ltr text-right block">{SITE.phoneDisplay}</span>
              </div>
            </a>

            <a href={`https://wa.me/${SITE.whatsapp.replace('+', '')}`} target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 bg-emerald-50 hover:bg-emerald-600 hover:text-white p-4 rounded-2xl transition-all duration-300 text-emerald-700 group focus:outline-none focus:ring-4 focus:ring-emerald-500/30">
              <span class="w-12 h-12 rounded-xl bg-white text-emerald-600 flex items-center justify-center shrink-0 shadow-sm group-hover:bg-white/20 group-hover:text-white" aria-hidden="true">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.296-.883-.649-1.479-1.451-1.652-1.749-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
              </span>
              <div>
                <span class="text-xs text-gray-500 group-hover:text-white/80 block font-medium">ارسال عکس و مشخصات در واتساپ</span>
                <span class="text-lg font-black dir-ltr text-right block">ارسال سریع تصویر قطعه</span>
              </div>
            </a>
          </div>
        </div>

        {/* Address & Hours */}
        <div class="bg-white rounded-3xl p-8 border border-gray-100 shadow-sm space-y-4">
          <h3 class="font-bold text-lg text-crane-navy">اطلاعات دفتر و انبار مرکزی</h3>
          <address class="not-italic text-sm text-gray-600 leading-7 space-y-2">
            <p><strong>آدرس:</strong> {SITE.address.city}، {SITE.address.street}</p>
            <p><strong>ایمیل رسمی:</strong> {SITE.email}</p>
            <p><strong>ساعات کاری:</strong> شنبه تا چهارشنبه: ۸:۳۰ الی ۱۷:۰۰ | پنجشنبه: ۸:۳۰ الی ۱۳:۰۰</p>
          </address>
        </div>

        {/* Guarantee Banner */}
        <div class="bg-crane-light rounded-3xl p-6 border border-gray-200 flex items-center gap-4">
          <span class="w-12 h-12 rounded-2xl bg-orange-100 text-crane-orange flex items-center justify-center shrink-0 font-bold text-xl" aria-hidden="true">✓</span>
          <p class="text-xs md:text-sm text-gray-700 leading-6">
            تمام پیش‌فاکتورهای صادرشده توسط کرین یدک معتبر بوده و شامل <strong>ضمانت کتبی اصالت کالا و گارانتی تعویض</strong> می‌باشند.
          </p>
        </div>

      </div>

      {/* Left Column: RFQ Form (7 Cols) */}
      <div class="lg:col-span-7 bg-white rounded-3xl p-8 md:p-10 border border-gray-100 shadow-lg">
        <h2 class="text-2xl font-black text-crane-navy mb-2">فرم درخواست پیش‌فاکتور و استعلام</h2>
        <p class="text-sm text-gray-500 mb-8">مشخصات قطعه مورد نیاز را وارد کنید. کارشناسان ما ظرف حداکثر ۲ ساعت کاری با شما تماس می‌گیرند.</p>

        <form action="/api/contact" method="POST" class="space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            
            {/* Name */}
            <div>
              <label for="contact-name" class="block text-sm font-bold text-gray-700 mb-2">نام و نام خانوادگی <span class="text-red-500">*</span></label>
              <input type="text" id="contact-name" name="name" required placeholder="مثال: مهندس رضایی" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3.5 min-h-[48px] focus:outline-none focus:ring-2 focus:ring-crane-orange focus:border-transparent text-sm" />
            </div>

            {/* Phone */}
            <div>
              <label for="contact-phone" class="block text-sm font-bold text-gray-700 mb-2">شماره همراه (جهت ارسال پیش‌فاکتور) <span class="text-red-500">*</span></label>
              <input type="tel" id="contact-phone" name="phone" required placeholder="۰۹۱۲XXXXXXX" dir="ltr" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3.5 min-h-[48px] focus:outline-none focus:ring-2 focus:ring-crane-orange focus:border-transparent text-sm text-right" />
            </div>

          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            
            {/* Company */}
            <div>
              <label for="contact-company" class="block text-sm font-bold text-gray-700 mb-2">نام شرکت / کارخانه (اختیاری)</label>
              <input type="text" id="contact-company" name="company" placeholder="مثال: فولاد کویر" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3.5 min-h-[48px] focus:outline-none focus:ring-2 focus:ring-crane-orange focus:border-transparent text-sm" />
            </div>

            {/* SKU / Part Number Auto-Filled */}
            <div>
              <label for="contact-sku" class="block text-sm font-bold text-gray-700 mb-2">کد فنی یا مدل قطعه (Part Number)</label>
              <input type="text" id="contact-sku" name="sku" placeholder="مثال: DMG-1024" dir="ltr" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3.5 min-h-[48px] focus:outline-none focus:ring-2 focus:ring-crane-orange focus:border-transparent text-sm text-left font-mono" />
            </div>

          </div>

          {/* Description */}
          <div>
            <label for="contact-message" class="block text-sm font-bold text-gray-700 mb-2">توضیحات و مشخصات قطعه <span class="text-red-500">*</span></label>
            <textarea id="contact-message" name="message" rows="4" required placeholder="شرح قطعه، برند سازنده، ظرفیت جرثقیل یا سوالات فنی خود را بنویسید..." class="w-full bg-gray-50 border border-gray-200 rounded-xl p-4 focus:outline-none focus:ring-2 focus:ring-crane-orange focus:border-transparent text-sm leading-6"></textarea>
          </div>

          {/* Submit Button */}
          <button type="submit" class="w-full bg-crane-orange text-white font-black py-4 rounded-xl text-lg hover:bg-orange-600 transition-colors shadow-lg shadow-orange-500/20 focus:outline-none focus:ring-4 focus:ring-crane-orange/40 flex items-center justify-center gap-2 min-h-[52px]">
            <span>ثبت و ارسال درخواست استعلام</span>
            <svg class="w-5 h-5 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
          </button>
        </form>

      </div>

    </div>
  </section>
</Layout>

<script>
  // خوانش هوشمند URL Params و پر کردن خودکار کد فنی/برند در فرم
  document.addEventListener('DOMContentLoaded', () => {
    const params = new URLSearchParams(window.location.search);
    const sku = params.get('sku') || params.get('pn');
    const brand = params.get('brand');

    const skuInput = document.getElementById('contact-sku') as HTMLInputElement | null;
    const msgInput = document.getElementById('contact-message') as HTMLTextAreaElement | null;

    if (skuInput && sku) {
      skuInput.value = sku;
    }

    if (msgInput && (sku || brand)) {
      const brandText = brand ? `برند: ${brand}` : '';
      const skuText = sku ? `کد فنی: ${sku}` : '';
      msgInput.value = `درخواست استعلام قیمت برای ${skuText} ${brandText}`.trim();
    }
  });
</script>
---
// src/pages/contact.astro
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import InquiryForm from '../components/InquiryForm.astro';
import { SITE } from '../data/site';
import { getContact, getSiteOptions } from '../lib/site-options';
import { mobileLine } from '../components/contact-mobile';

/* ⚠️ بالای فرontmatter اعلان می‌شوند.
   قبلاً پایین‌تر از محل استفاده بودند و رندر با خطای
   «Cannot access 'contact' before initialization» می‌شکست —
   `const` تا نقطه‌ی اعلان در ناحیه‌ی مرده‌ی زمانی است. */
const contact = await getContact();
const social = (await getSiteOptions()).social;
// خط همراه «تماس فوری» بالای کارت فروش، ۰۲۱ زیرش (کارفرما، ۴ آبان ۱۴۰۵ — همراه در این کارت اصلاً نبود).
const mobile = mobileLine(contact);

const title = `استعلام قیمت و تماس با کرین یدک | تامین قطعات جرثقیل سقفی`;
const description = 'ثبت درخواست پیش‌فاکتور رسمی، مشاوره فنی رایگان و استعلام قیمت قطعات جرثقیل سقفی. ارسال تصویر پلاک دستگاه و کدهای فنی جهت تایید سازگاری.';

// فرم استعلام و اندپوینتش: src/components/InquiryForm.astro (مشترک با /part-finder/).

// نکته سئوی محلی: آدرس کامل برای Google Maps embed query — تا زمانی که
// آدرس واقعی جایگزین placeholder فعلی نشده، این نقشه موقعیت دقیقی نشان
// نمی‌دهد (فقط شهر تهران). این خودش یک TODO سئوی محلی است — نگاه کنید
// به کامنت‌های src/data/site.ts.
const fullAddress = [contact.street, contact.city, contact.region, 'Iran'].filter(Boolean).join(', ');
const mapQuery = encodeURIComponent(fullAddress);

const localCitations = [
  social.googleBusinessProfile && { label: 'گوگل بیزینس پروفایل', href: social.googleBusinessProfile },
  social.neshan && { label: 'نشان', href: social.neshan },
  social.balad && { label: 'بلد', href: social.balad },
].filter((c): c is { label: string; href: string } => Boolean(c));

// E-E-A-T & Local Business Schema Integration
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      '@id': `${SITE.url}/contact#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'صفحه اصلی', item: SITE.url },
        { '@type': 'ListItem', position: 2, name: 'تماس و استعلام قیمت', item: `${SITE.url}/contact` },
      ],
    },
    {
      '@type': 'ContactPage',
      '@id': `${SITE.url}/contact#webpage`,
      url: `${SITE.url}/contact`,
      name: title,
      description: description,
      isPartOf: { '@id': `${SITE.url}/#website` },
      about: { '@id': `${SITE.url}/#organization` },
    },
  ],
};



---

<Layout title={title} description={description} jsonLd={jsonLd}>
  {/* -------------------- Hero & Breadcrumb -------------------- */}
  {/* Frontend v2 فاز ۵: نوار عنوان روشن زیر هدر گرافیت (هم‌خانواده‌ی دسته/محصول)، نه نوار تیره‌ی دوم با خط ۸px. */}
  <section class="bg-white text-steel-900 border-b border-steel-300 px-4 py-6 md:py-8 relative">
    <div class="max-w-7xl mx-auto relative z-10">
      <Breadcrumb surface items={[{ label: 'صفحه اصلی', href: '/' }, { label: 'تماس و استعلام قیمت' }]} />

      <h1 class="text-2xl md:text-3xl font-black mb-2 tracking-tight">
        استعلام قیمت و مشاوره فنی قطعات
      </h1>
      <p class="text-base md:text-xl text-steel-600 max-w-2xl leading-8 font-normal">
        کد فنی یا عکس قطعه فرسوده را بفرستید؛ کارشناسان واحد فروش و نت در سریع‌ترین زمان پیش‌فاکتور رسمی صادر می‌کنند.
      </p>
    </div>
  </section>

  {/* ----------------------------- Main Content Grid ----------------------------- */}
  <section class="py-8 md:py-10 px-4 md:px-8 lg:px-12 bg-steel-50 min-h-[60vh]">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">

      {/* Right Column: Contact Info & E-E-A-T Signals (5 Cols) */}
      <div class="lg:col-span-5 space-y-8">
        
        {/* Direct Call / WhatsApp Card */}
        <div class="bg-white rounded-md p-8 border border-steel-100 space-y-6">
          <h2 class="text-2xl font-bold text-steel-900 border-b border-steel-100 pb-4">ارتباط مستقیم با واحد فروش</h2>
          
          <div class="space-y-4">
            {mobile && (
              <a href={mobile.href} class="flex items-center gap-4 bg-steel-900 hover:bg-action text-white p-4 rounded-md border-s-4 border-s-action transition-all duration-150 group">
                <span class="w-12 h-12 rounded-md bg-white/10 flex items-center justify-center shrink-0" aria-hidden="true">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                </span>
                <div>
                  <span class="text-xs text-steel-300 group-hover:text-white block font-normal"><span class="inline-block w-2 h-2 rounded-full bg-emerald-400 me-1.5" aria-hidden="true"></span>خط ویژه تامین و استعلام فوری</span>
                  <span class="text-xl font-bold tabular-nums block text-right" dir="ltr">{mobile.display}</span>
                </div>
              </a>
            )}
            <a href={contact.telHref} class="flex items-center gap-4 bg-accent-soft hover:bg-action hover:text-white p-4 rounded-md transition-all duration-150 text-accent-ink group focus:outline-none focus:ring-4 focus:ring-accent-ink/30">
              <span class="w-12 h-12 rounded-md bg-white text-accent-ink flex items-center justify-center shrink-0 group-hover:bg-white/20 group-hover:text-white" aria-hidden="true">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
              </span>
              <div>
                <span class="text-xs text-steel-500 group-hover:text-white/80 block font-normal">تلفن دفتر مرکزی (تهران)</span>
                <span class="text-xl font-bold tabular-nums text-right block" dir="ltr">{contact.phoneDisplay}</span>
              </div>
            </a>

            <a href={contact.whatsappHref} target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 bg-emerald-50 hover:bg-emerald-600 hover:text-white p-4 rounded-md transition-all duration-150 text-emerald-700 group focus:outline-none focus:ring-4 focus:ring-emerald-500/30">
              <span class="w-12 h-12 rounded-md bg-white text-emerald-600 flex items-center justify-center shrink-0 group-hover:bg-white/20 group-hover:text-white" aria-hidden="true">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.296-.883-.649-1.479-1.451-1.652-1.749-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
              </span>
              <div>
                <span class="text-xs text-steel-500 group-hover:text-white/80 block font-normal">ارسال عکس و مشخصات در واتساپ</span>
                <span class="text-xl font-bold dir-ltr text-right block">ارسال سریع تصویر قطعه</span>
              </div>
            </a>

            <a href={social.telegram} target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 bg-sky-50 hover:bg-sky-500 hover:text-white p-4 rounded-md transition-all duration-150 text-sky-700 group focus:outline-none focus:ring-4 focus:ring-sky-500/30">
              <span class="w-12 h-12 rounded-md bg-white text-sky-500 flex items-center justify-center shrink-0 group-hover:bg-white/20 group-hover:text-white" aria-hidden="true">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M22.05 2.638a1.68 1.68 0 00-1.72-.24L2.36 9.75c-1.15.46-1.14 1.03-.2 1.32l4.6 1.44 10.68-6.74c.5-.31.96-.14.58.2l-8.65 7.82h0l-.32 4.65c.46 0 .67-.21.92-.46l2.21-2.14 4.6 3.4c.85.47 1.46.23 1.67-.79l3.03-14.29c.3-1.25-.47-1.82-1.43-2.32z"/></svg>
              </span>
              <div>
                <span class="text-xs text-steel-500 group-hover:text-white/80 block font-normal">پاسخ‌گویی سریع در تلگرام</span>
                <span class="text-xl font-bold dir-ltr text-right block">{social.telegram}</span>
              </div>
            </a>
          </div>
        </div>

        {/* Address & Hours */}
        <div class="bg-white rounded-md p-8 border border-steel-100 space-y-4">
          <h3 class="font-bold text-xl text-steel-900">اطلاعات دفتر مرکزی</h3>
          <address class="not-italic text-sm text-steel-600 leading-7 space-y-2">
            {/* ارقام نشانی فقط در نمایش فارسی (همان قاعده‌ی فوتر) — mapQuery و JSON-LD رشته‌ی خام را نگه می‌دارند. */}
            <p><strong>آدرس:</strong> {contact.city}، {contact.street?.replace(/\d/g, (d) => '۰۱۲۳۴۵۶۷۸۹'[Number(d)]!)}</p>
            <p><strong>ایمیل رسمی:</strong> {contact.email}</p>
            <p><strong>ساعات کاری:</strong> شنبه تا چهارشنبه: ۸:۳۰ الی ۱۷:۰۰ | پنجشنبه: ۸:۳۰ الی ۱۳:۰۰</p>
          </address>

          {/* نکته سئوی محلی: نقشه‌ی جاسازی‌شده بر اساس متن آدرس (بدون نیاز
              به API Key). دقت موقعیت وابسته به صحت نشانی ثبت‌شده در وردپرس است — با
              آدرس placeholder فعلی فقط مرکز تهران را نشان می‌دهد؛ به محض
              ثبت آدرس واقعی دفتر/انبار در src/data/site.ts، این نقشه
              خودکار روی موقعیت درست متمرکز می‌شود. */}
          <div class="rounded-md overflow-hidden border border-steel-200 aspect-video">
            <iframe
              title={`نقشه موقعیت ${SITE.name}`}
              src={`https://www.google.com/maps?q=${mapQuery}&output=embed`}
              width="100%"
              height="100%"
              style="border:0;"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>

          {localCitations.length > 0 && (
            <div class="flex flex-wrap gap-2 pt-2">
              {localCitations.map((c) => (
                <a href={c.href} target="_blank" rel="noopener noreferrer" class="text-xs font-bold bg-steel-50 hover:bg-accent-soft hover:text-accent-ink text-steel-600 px-3 py-1.5 rounded-full border border-steel-200 transition-colors">
                  {c.label}
                </a>
              ))}
            </div>
          )}
        </div>

        {/* Guarantee Banner */}
        <div class="bg-steel-50 rounded-md p-6 border border-steel-200 flex items-center gap-4">
          <span class="w-12 h-12 rounded-md bg-accent-soft text-accent-ink flex items-center justify-center shrink-0 font-bold text-xl" aria-hidden="true">✓</span>
          <p class="text-xs md:text-sm text-steel-700 leading-6">
            تمام پیش‌فاکتورهای صادرشده توسط کرین یدک معتبر بوده و شامل <strong>ضمانت اصالت کالا و گارانتی تعمیر</strong> می‌باشند.
          </p>
        </div>

      </div>

      {/* Left Column: RFQ Form (7 Cols) */}
      <div class="lg:col-span-7 bg-white rounded-md p-5 md:p-8 border border-steel-300 border-s-4 border-s-action">
        <InquiryForm />
      </div>

    </div>
  </section>
</Layout>

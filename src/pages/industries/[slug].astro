---
// src/pages/industries/[slug].astro
// ---------------------------------------------------------------------------
// صفحه‌ی صنعت.
//
// ⚠️ خطر «صفحه‌ی دروازه‌ای» (Doorway Page): صفحه‌ی صنعتی که فقط کاتالوگ را
// با یک عنوان متفاوت تکرار کند، از نگاه گوگل محتوای کم‌ارزش و بازنویسی‌شده
// است و ارزش منفی دارد. برای همین هر صنعت در `taxonomy.ts` یک «الزام فنی
// متمایز» دارد (کلاس کاری، گواهی ضدانفجار، درجه‌ی حفاظت IP، قابلیت
// شست‌وشو، دقت جای‌گذاری، نرخ سیکل کاری) و همان چیزی است که این صفحه را
// از بقیه متمایز می‌کند — نه فهرست قطعات.
//
// نیت جستجو: «قطعات جرثقیل <صنعت>» — نه نام قطعه (که به صفحه‌ی دسته تعلق
// دارد) و نه نام برند (که به صفحه‌ی برند تعلق دارد).
// ---------------------------------------------------------------------------
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { SITE } from '../../data/site';
import { INDUSTRIES, SILOS, siloPath, type Industry } from '../../data/taxonomy';

export function getStaticPaths() {
  return INDUSTRIES.map((industry) => ({
    params: { slug: industry.slug },
    props: { industry },
  }));
}

interface Props {
  industry: Industry;
}

const { industry } = Astro.props as Props;

const title = `${industry.keyword} | ${SITE.name}`;
const description = `${industry.requirement}. ${industry.desc.slice(0, 120)}`;
const canonical = `${SITE.url}/industries/${industry.slug}`;

const otherIndustries = INDUSTRIES.filter((i) => i.slug !== industry.slug);

const breadcrumbItems = [
  { label: 'صفحه اصلی', href: '/' },
  { label: 'صنایع تحت پوشش', href: '/industries' },
  { label: industry.name },
];

const themeClasses: Record<Industry['theme'], string> = {
  slate: 'bg-slate-800',
  emerald: 'bg-emerald-900',
  amber: 'bg-amber-800',
  sky: 'bg-sky-900',
  rose: 'bg-rose-900',
  indigo: 'bg-indigo-900',
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: breadcrumbItems.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: item.label,
        ...(item.href ? { item: `${SITE.url}${item.href}` } : {}),
      })),
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      isPartOf: { '@id': `${SITE.url}/#website` },
      about: { '@id': `${SITE.url}/#organization` },
      inLanguage: SITE.locale,
    },
  ],
};
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <section class:list={['text-white pt-10 pb-16 px-4 border-b-[8px] border-crane-orange', themeClasses[industry.theme]]}>
    <div class="max-w-7xl mx-auto">
      <Breadcrumb items={breadcrumbItems} light />
      <div class="flex flex-col md:flex-row items-start gap-6">
        <span class="w-16 h-16 bg-white/10 rounded-2xl flex items-center justify-center shrink-0 border border-white/20" aria-hidden="true">
          <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 24 24"><path d={industry.icon} /></svg>
        </span>
        <div>
          <h1 class="text-3xl md:text-5xl font-black mb-4 tracking-tight drop-shadow-md leading-relaxed">{industry.keyword}</h1>
          <p class="text-lg text-gray-200 max-w-3xl leading-8">{industry.desc}</p>
        </div>
      </div>
    </div>
  </section>

  {/* ------------- الزام فنی متمایز — دلیل وجودی این صفحه ------------- */}
  <section class="bg-white px-4 py-14 border-b border-gray-100" aria-labelledby="requirement-heading">
    <div class="max-w-4xl mx-auto">
      <h2 id="requirement-heading" class="text-2xl font-black text-crane-navy mb-6">
        الزام فنی قطعات در {industry.name}
      </h2>
      <div class="bg-orange-50 border-r-4 border-crane-orange rounded-2xl p-6 md:p-8 mb-8">
        <p class="text-lg font-bold text-crane-navy leading-9">{industry.requirement}</p>
      </div>
      <p class="text-gray-700 leading-8 text-justify mb-4">
        انتخاب قطعه در این صنعت با انتخاب همان قطعه در یک کارگاه عمومی فرق دارد. مشخصات ظاهری و ابعادی ممکن است یکسان باشد، اما قطعه‌ای که برای شرایط این محیط طراحی نشده باشد، زودتر از موعد از کار می‌افتد و هزینه‌ی واقعی آن، هزینه‌ی توقف خط تولید است، نه قیمت خرید.
      </p>
      <p class="text-gray-700 leading-8 text-justify">
        پیش از ثبت سفارش، مشخصات دستگاه و شرایط کاری (دما، رطوبت، گردوغبار، تعداد راه‌اندازی در ساعت و کلاس کاری) را برای کارشناسان ما بفرستید تا قطعه‌ی متناسب با همین شرایط پیشنهاد شود.
      </p>
    </div>
  </section>

  {/* ------------------- گروه‌های قطعات پرمصرف این صنعت ------------------- */}
  <section class="bg-gray-50 px-4 py-14 border-b border-gray-100" aria-labelledby="industry-silos-heading">
    <div class="max-w-7xl mx-auto">
      <h2 id="industry-silos-heading" class="text-xl md:text-2xl font-black text-crane-navy mb-3">
        گروه‌های قطعات مورد نیاز {industry.name}
      </h2>
      <p class="text-gray-600 leading-8 mb-8 max-w-3xl">
        برای مشاهده‌ی جزئیات فنی و ثبت استعلام، وارد گروه مربوطه شوید.
      </p>
      <ul class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-7 gap-4" role="list">
        {SILOS.map((silo) => (
          <li>
            <a href={siloPath(silo)} class="group h-full bg-white hover:shadow-md p-5 rounded-2xl border border-gray-100 hover:border-orange-100 transition-all flex flex-col items-center text-center gap-3 focus:outline-none focus:ring-4 focus:ring-crane-orange/30">
              <span class="w-9 h-9 text-crane-navy group-hover:text-crane-orange transition-colors" aria-hidden="true">
                <svg class="w-full h-full" fill="none" stroke="currentColor" stroke-width="1.4" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d={silo.icon} /></svg>
              </span>
              <span class="text-xs font-bold text-crane-navy group-hover:text-crane-orange transition-colors leading-6">{silo.name}</span>
            </a>
          </li>
        ))}
      </ul>

      <div class="mt-10 bg-white rounded-3xl border border-gray-100 p-8 flex flex-col md:flex-row items-center justify-between gap-6">
        <div>
          <h3 class="font-black text-xl text-crane-navy mb-2">مشاوره‌ی فنی برای {industry.name}</h3>
          <p class="text-gray-700 text-sm leading-7">شرایط کاری دستگاه خود را بفرستید تا قطعه‌ی متناسب با همان شرایط پیشنهاد شود.</p>
        </div>
        <a href={`/contact?industry=${encodeURIComponent(industry.name)}`} class="bg-crane-orange text-white px-8 py-4 rounded-xl font-black shrink-0 hover:bg-orange-800 transition-colors focus:outline-none focus:ring-4 focus:ring-crane-orange/40 min-h-[52px] flex items-center">
          درخواست مشاوره فنی
        </a>
      </div>
    </div>
  </section>

  {/* --------------------------- سایر صنایع --------------------------- */}
  <section class="bg-white px-4 py-14" aria-labelledby="other-industries-heading">
    <div class="max-w-7xl mx-auto">
      <h2 id="other-industries-heading" class="text-xl md:text-2xl font-black text-crane-navy mb-8">سایر صنایع تحت پوشش</h2>
      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4" role="list">
        {otherIndustries.map((other) => (
          <li>
            <a href={`/industries/${other.slug}`} class="group h-full bg-gray-50 hover:bg-white p-5 rounded-2xl border border-gray-100 hover:border-orange-100 hover:shadow-md transition-all flex flex-col gap-2 focus:outline-none focus:ring-4 focus:ring-crane-orange/30">
              <span class="w-9 h-9 text-crane-navy group-hover:text-crane-orange transition-colors" aria-hidden="true">
                <svg class="w-full h-full" fill="currentColor" viewBox="0 0 24 24"><path d={other.icon} /></svg>
              </span>
              <span class="text-sm font-bold text-crane-navy group-hover:text-crane-orange transition-colors leading-6">{other.name}</span>
              <span class="text-xs text-gray-600 leading-5 line-clamp-2">{other.requirement}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>

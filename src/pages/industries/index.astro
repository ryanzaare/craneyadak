---
// src/pages/industries/index.astro
import Layout from '../../layouts/Layout.astro';
import { SITE } from '../../data/site';

const title = `صنایع تحت پوشش | قطعات جرثقیل ویژه صنایع سنگین | ${SITE.name}`;
const description = 'تامین تخصصی قطعات و لوازم یدکی جرثقیل‌های سقفی ویژه صنایع فولاد، پتروشیمی (ضدانفجار EX) و معادن با استانداردهای بالای صنعتی (IP65/M7).';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      '@id': `${SITE.url}/industries#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'صفحه اصلی', item: SITE.url },
        { '@type': 'ListItem', position: 2, name: 'صنایع تحت پوشش', item: `${SITE.url}/industries` },
      ],
    },
    {
      '@type': 'CollectionPage',
      '@id': `${SITE.url}/industries#webpage`,
      url: `${SITE.url}/industries`,
      name: title,
      description: description,
      isPartOf: { '@id': `${SITE.url}/#website` }
    }
  ]
};

const industries = [
  { slug: 'steel', name: 'صنایع فولاد و ذوب‌آهن', icon: 'M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 9h-2V7h-2v5H6v-2H4v6h16v-6h-2v2h-2v-5h-2v5z', desc: 'محیط‌های با حرارت بالا و غبار شدید نیازمند قطعاتی با کلاس کاری 4m/M7 و مقاومت حرارتی ویژه هستند. ما موتور گیربکس‌ها و کابل‌های نسوز این صنایع را تامین می‌کنیم.', bg: 'bg-zinc-800' },
  { slug: 'petrochemical', name: 'نفت، گاز و پتروشیمی', icon: 'M12 2L2 22h20L12 2zm0 3.83L18.17 19H5.83L12 5.83zM11 10h2v5h-2v-5zm0 6h2v2h-2v-2z', desc: 'تجهیزات بالابر در مناطق خطرناک (Hazardous Areas) نیازمند قطعات ضدانفجار (EX) با گواهینامه‌های ATEX هستند. تخصص ما تامین وینچ‌ها و تابلو برق‌های EX است.', bg: 'bg-emerald-900' },
  { slug: 'mining', name: 'معادن و صنایع سیمان', icon: 'M14 6l-3.75 5 2.85 3.8-1.6 1.2C9.81 13.75 7 10 7 10l-6 8h22l-9-12z', desc: 'جرثقیل‌های فعال در معادن در معرض ذرات ساینده و رطوبت قرار دارند. تامین چرخ‌های راهبر ضدسایش و قطعات برقی با استاندارد حفاظتی IP65/IP66 رسالت ماست.', bg: 'bg-amber-800' },
];
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <section class="bg-crane-navy text-white pt-12 pb-20 px-4 border-b-[8px] border-crane-orange relative overflow-hidden">
    <div class="max-w-7xl mx-auto relative z-10">
      <nav class="text-sm text-gray-400 mb-8 flex items-center gap-2" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-crane-orange rounded py-1 px-2 -ml-2">صفحه اصلی</a>
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
        <span class="text-white font-bold" aria-current="page">صنایع تحت پوشش</span>
      </nav>
      <h1 class="text-3xl md:text-5xl font-black mb-4 tracking-tight drop-shadow-md">استاندارد قطعات در صنایع سنگین</h1>
      <p class="text-lg text-gray-300 max-w-2xl leading-8 font-light">هر صنعت چالش‌های منحصر‌به‌فرد خود را دارد. قطعات جرثقیل باید بر اساس شرایط محیطی (حرارت، رطوبت، گازهای قابل اشتعال) کالیبره و انتخاب شوند.</p>
    </div>
  </section>

  <section class="py-20 px-4 md:px-8 bg-gray-50 min-h-[50vh]">
    <div class="max-w-7xl mx-auto flex flex-col gap-12">
      {industries.map((ind) => (
        <article class={`rounded-3xl overflow-hidden shadow-lg flex flex-col md:flex-row ${ind.bg} text-white group`}>
          <div class="md:w-1/3 p-12 flex items-center justify-center bg-black/20">
             <svg class="w-32 h-32 text-white/50 group-hover:scale-110 transition-transform duration-500" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d={ind.icon}/></svg>
          </div>
          <div class="md:w-2/3 p-8 md:p-12 flex flex-col justify-center">
            <h2 class="text-3xl font-black mb-4">{ind.name}</h2>
            <p class="text-gray-300 leading-8 text-lg mb-8">{ind.desc}</p>
            <div class="mt-auto">
              <a href="/contact" class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 border border-white/20 px-6 py-3 rounded-xl font-bold transition-colors focus:outline-none focus:ring-4 focus:ring-white/30">
                <span>مشاوره و تامین قطعات این صنعت</span>
                <svg class="w-5 h-5 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
</Layout>
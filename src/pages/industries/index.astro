---
// src/pages/industries/index.astro
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { SITE } from '../../data/site';
import { INDUSTRIES, type Industry } from '../../data/taxonomy';

// نگاشت تم رنگی به کلاس Tailwind — پیش‌تر کلاس خام (`bg-zinc-800`) داخل
// داده ذخیره می‌شد که یعنی نشت جزئیات پیاده‌سازی فرانت‌اند به لایه‌ی
// محتوا؛ حالا داده فقط یک نام معنایی دارد و نگاشت اینجاست.
const themeClasses: Record<Industry['theme'], string> = {
  slate: 'bg-slate-800',
  emerald: 'bg-emerald-900',
  amber: 'bg-amber-800',
  sky: 'bg-sky-900',
  rose: 'bg-rose-900',
  indigo: 'bg-indigo-900',
};

const title = `صنایع تحت پوشش | قطعات جرثقیل ویژه صنایع سنگین | ${SITE.name}`;
const description = `تامین قطعات جرثقیل سقفی برای ${INDUSTRIES.length} صنعت — هر صنعت با الزام فنی مخصوص خودش: کلاس کاری، گواهی ضدانفجار، درجه حفاظت IP و شرایط محیطی.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      '@id': `${SITE.url}/industries#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'صفحه اصلی', item: SITE.url },
        { '@type': 'ListItem', position: 2, name: 'صنایع تحت پوشش', item: `${SITE.url}/industries` },
      ],
    },
    {
      '@type': 'CollectionPage',
      '@id': `${SITE.url}/industries#webpage`,
      url: `${SITE.url}/industries`,
      name: title,
      description: description,
      isPartOf: { '@id': `${SITE.url}/#website` }
    }
  ]
};

// نکته معماری: آرایه‌ی محلی قبلی اینجا کپی دستی INDUSTRIES از
// src/data/content.ts بود (با ریسک واگرایی نام/توضیحات صنایع در دو فایل).
// اکنون مستقیماً از تک منبع حقیقت import می‌شود.
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <section class="bg-crane-navy text-white pt-12 pb-20 px-4 border-b-[8px] border-crane-orange relative overflow-hidden">
    <div class="max-w-7xl mx-auto relative z-10">
      <Breadcrumb items={[{ label: 'صفحه اصلی', href: '/' }, { label: 'صنایع تحت پوشش' }]} />
      <h1 class="text-3xl md:text-5xl font-black mb-4 tracking-tight drop-shadow-md">استاندارد قطعات در صنایع سنگین</h1>
      <p class="text-lg text-gray-300 max-w-2xl leading-8 font-light">هر صنعت چالش‌های منحصر‌به‌فرد خود را دارد. قطعات جرثقیل باید بر اساس شرایط محیطی (حرارت، رطوبت، گازهای قابل اشتعال) کالیبره و انتخاب شوند.</p>
    </div>
  </section>

  <section class="py-20 px-4 md:px-8 bg-gray-50 min-h-[50vh]">
    <div class="max-w-7xl mx-auto flex flex-col gap-12">
      {INDUSTRIES.map((ind) => (
        <article class={`rounded-3xl overflow-hidden shadow-lg flex flex-col md:flex-row ${themeClasses[ind.theme]} text-white group`}>
          <div class="md:w-1/3 p-12 flex items-center justify-center bg-black/20">
             <svg class="w-32 h-32 text-white/50 group-hover:scale-110 transition-transform duration-500" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d={ind.icon}/></svg>
          </div>
          <div class="md:w-2/3 p-8 md:p-12 flex flex-col justify-center">
            <h2 class="text-3xl font-black mb-4">
              <a href={`/industries/${ind.slug}`} class="hover:underline focus:outline-none focus:ring-2 focus:ring-white/50 rounded">{ind.name}</a>
            </h2>
            <p class="text-gray-200 leading-8 text-lg mb-4">{ind.desc}</p>
            <p class="text-sm font-bold text-white/90 bg-white/10 border border-white/20 rounded-xl px-4 py-3 mb-8 leading-7">
              الزام فنی: {ind.requirement}
            </p>
            <div class="mt-auto flex flex-wrap gap-3">
              <a href={`/industries/${ind.slug}`} class="inline-flex items-center gap-2 bg-white text-crane-navy px-6 py-3 rounded-xl font-bold transition-colors hover:bg-gray-100 focus:outline-none focus:ring-4 focus:ring-white/30">
                <span>جزئیات و استاندارد {ind.name}</span>
                <svg class="w-5 h-5 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
              </a>
              <a href="/contact" class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 border border-white/20 px-6 py-3 rounded-xl font-bold transition-colors focus:outline-none focus:ring-4 focus:ring-white/30">
                <span>استعلام قیمت</span>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
</Layout>
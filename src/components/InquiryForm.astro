---
// src/components/InquiryForm.astro
// ---------------------------------------------------------------------------
// فرم استعلام با عکس پلاک — یک نسخه برای /contact/ و /part-finder/.
//
// ⚠️ چرا جدا شد (۲۹ آبان ۱۴۰۵): کارفرما پس از دیدن craneset.com گفت «سایت ما سیستم بارگذاری عکس ندارد». داشت — همین
// فرم، روی /contact/، با ۳ عکس ۵MB و اعتبارسنجی سمت سرور (class-inquiry-uploads.php) — ولی پنهان در صفحه‌ی تماس، و
// هیچ مسیری به آن «قطعه را پیدا نمی‌کنم» نمی‌گفت. قطعه‌یاب همان فرم را لازم داشت؛ کپی دوم یعنی دو اعتبارسنجی که از هم
// می‌رانند (همان درسی که search-score.ts را جدا کرد). یک کامپوننت، یک اسکریپت، یک اندپوینت.
// ⚠️ شناسه‌ها (rfq-form، contact-*) ثابت‌اند: هر صفحه فقط یک نمونه از این فرم دارد.
// ---------------------------------------------------------------------------
import { getContact, getSiteOptions } from '../lib/site-options';

export interface Props {
  heading?: string;
  intro?: string;
  skuLabel?: string;
  messageLabel?: string;
  messagePlaceholder?: string;
  submitLabel?: string;
}
const {
  heading = 'فرم درخواست پیش‌فاکتور و استعلام',
  intro = "مشخصات قطعه مورد نیاز را وارد کنید. کارشناسان ما در اولین فرصت کاری با شما تماس می‌گیرند.",
  skuLabel = "کد فنی یا مدل قطعه (Part Number)",
  messageLabel = "توضیحات و مشخصات قطعه",
  messagePlaceholder = "شرح قطعه، برند سازنده، ظرفیت جرثقیل یا سوالات فنی خود را بنویسید...",
  submitLabel = "ثبت و ارسال درخواست استعلام",
} = Astro.props;

const contact = await getContact();
const social = (await getSiteOptions()).social;
// اندپوینت واقعی (پلاگین crane-yadak-headless). توضیح کامل «چرا action مستقیم به وردپرس» در تاریخچه‌ی contact.astro:
// مسیر قدیمی /api/contact در build استاتیک وجود نداشت و لید بی‌صدا ۴۰۴ می‌شد. بی PUBLIC_WP_API_URL فرمی نشان داده
// نمی‌شود که به جایی نرسد؛ کانال‌های تماس مستقیم جایش.
const wpApiBase = (import.meta.env.PUBLIC_WP_API_URL ?? '').replace(/\/+$/, '');
const inquiryEndpoint = wpApiBase ? `${wpApiBase}/wp-json/crane/v1/inquiry` : null;
---

        {!inquiryEndpoint && (
          /* حالت «بک‌اند هنوز وصل نشده»: به‌جای نمایش فرمی که ارسالش به هیچ
             مقصدی نمی‌رسد (و لید را بی‌صدا از بین می‌برد)، کانال‌های واقعی
             و فعال تماس نمایش داده می‌شوند. */
          <div class="bg-amber-50 border border-amber-200 rounded-md p-6" role="status">
            <h2 class="text-2xl font-bold text-steel-900 mb-3">ثبت آنلاین درخواست موقتاً در دسترس نیست</h2>
            <p class="text-sm text-steel-700 leading-7 mb-6">
              سامانه‌ی ثبت آنلاین استعلام در حال راه‌اندازی است. تا آن زمان، سریع‌ترین راه دریافت پیش‌فاکتور، تماس تلفنی یا ارسال عکس قطعه در واتساپ/تلگرام است — پاسخ‌گویی در ساعات کاری انجام می‌شود.
            </p>
            <div class="flex flex-col sm:flex-row gap-3">
              <a href={contact.telHref} class="flex-1 bg-action text-white text-center px-6 py-4 rounded-md font-bold hover:bg-accent-strong transition-colors focus:outline-none focus:ring-4 focus:ring-accent-ink/40 min-h-[52px] flex items-center justify-center">تماس تلفنی</a>
              <a href={contact.whatsappHref} target="_blank" rel="noopener noreferrer" class="flex-1 bg-emerald-600 text-white text-center px-6 py-4 rounded-md font-bold hover:bg-emerald-700 transition-colors focus:outline-none focus:ring-4 focus:ring-emerald-500/30 min-h-[52px] flex items-center justify-center">ارسال در واتساپ</a>
              <a href={social.telegram} target="_blank" rel="noopener noreferrer" class="flex-1 bg-sky-500 text-white text-center px-6 py-4 rounded-md font-bold hover:bg-sky-600 transition-colors focus:outline-none focus:ring-4 focus:ring-sky-500/30 min-h-[52px] flex items-center justify-center">ارسال در تلگرام</a>
            </div>
          </div>
        )}

        {inquiryEndpoint && (
        <>
        <h2 class="text-2xl font-bold text-steel-900 mb-2">{heading}</h2>
        <p class="text-sm text-steel-600 mb-8">{intro}</p>

        {/* Progressive enhancement: `action` مستقیماً به اندپوینت REST وردپرس
            اشاره می‌کند، پس ارسال بدون جاوااسکریپت هم واقعاً ثبت می‌شود.
            اسکریپت پایین صفحه فقط تجربه را بهتر می‌کند (بدون ترک صفحه). */}
        <div id="form-feedback" class="hidden mb-6 border rounded-md p-5 text-sm font-bold leading-6" role="alert"></div>

        <form id="rfq-form" action={inquiryEndpoint} data-endpoint={inquiryEndpoint} method="POST" enctype="multipart/form-data" class="space-y-6">
          {/* هانی‌پات ضداسپم: برای کاربران واقعی نامرئی (هم بصری و هم برای
              screen reader)، اما ربات‌های فرم‌پرکن معمولاً این فیلد را هم پر
              می‌کنند. اگر پر شده باشد، بک‌اند (class-rest-contact.php) بی‌سروصدا
              رد می‌کند. */}
          <div class="cyh-honeypot" aria-hidden="true">
            <label for="contact-website">وب‌سایت (خالی بگذارید)</label>
            <input type="text" id="contact-website" name="website" tabindex="-1" autocomplete="off" />
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            
            {/* Name */}
            <div>
              <label for="contact-name" class="block text-sm font-bold text-steel-700 mb-2">نام و نام خانوادگی <span class="text-red-500">*</span></label>
              <input type="text" id="contact-name" name="name" required placeholder="مثال: مهندس رضایی" class="w-full bg-steel-50 border border-steel-200 rounded-md px-4 py-3.5 min-h-[48px] focus:outline-none focus:ring-2 focus:ring-accent-ink focus:border-transparent text-sm" />
            </div>

            {/* Phone */}
            <div>
              <label for="contact-phone" class="block text-sm font-bold text-steel-700 mb-2">شماره همراه (جهت ارسال پیش‌فاکتور) <span class="text-red-500">*</span></label>
              <input type="tel" id="contact-phone" name="phone" required placeholder="۰۹۱۲XXXXXXX" dir="ltr" class="w-full bg-steel-50 border border-steel-200 rounded-md px-4 py-3.5 min-h-[48px] focus:outline-none focus:ring-2 focus:ring-accent-ink focus:border-transparent text-sm text-right" />
            </div>

          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            
            {/* Company */}
            <div>
              <label for="contact-company" class="block text-sm font-bold text-steel-700 mb-2">نام شرکت / کارخانه (اختیاری)</label>
              <input type="text" id="contact-company" name="company" placeholder="مثال: فولاد کویر" class="w-full bg-steel-50 border border-steel-200 rounded-md px-4 py-3.5 min-h-[48px] focus:outline-none focus:ring-2 focus:ring-accent-ink focus:border-transparent text-sm" />
            </div>

            {/* SKU / Part Number Auto-Filled */}
            <div>
              <label for="contact-sku" class="block text-sm font-bold text-steel-700 mb-2">{skuLabel}</label>
              <input type="text" id="contact-sku" name="sku" placeholder="SAGA1-L12 / DMG-1024" dir="ltr" class="w-full bg-steel-50 border border-steel-200 rounded-md px-4 py-3.5 min-h-[48px] focus:outline-none focus:ring-2 focus:ring-accent-ink focus:border-transparent text-sm text-left font-mono" />
            </div>

          </div>

          {/* Description */}
          <div>
            <label for="contact-message" class="block text-sm font-bold text-steel-700 mb-2">{messageLabel} <span class="text-red-500">*</span></label>
            <textarea id="contact-message" name="message" rows="4" required placeholder="{messagePlaceholder}" class="w-full bg-steel-50 border border-steel-200 rounded-md p-4 focus:outline-none focus:ring-2 focus:ring-accent-ink focus:border-transparent text-sm leading-6"></textarea>
          </div>

          {/* عکس پلاک — مهم‌ترین داده‌ی یک استعلام.
              راهنمای خواندن پلاک به مشتری می‌گوید عکس بفرستد؛ تا امروز هیچ
              راهی برایش نبود. */}
          <div>
            <label for="contact-photos" class="block text-sm font-bold text-steel-700 mb-2">
              عکس پلاک یا قطعه <span class="font-normal text-steel-500">(اختیاری، ولی استعلام را چند برابر سریع‌تر می‌کند)</span>
            </label>
            <input
              type="file"
              id="contact-photos"
              name="photos[]"
              multiple
              accept="image/jpeg,image/png,image/webp"
              class="w-full bg-steel-50 border border-dashed border-steel-300 rounded-md px-4 py-3.5 text-sm file:ml-3 file:rounded-md file:border-0 file:bg-steel-900 file:px-4 file:py-2 file:text-white file:font-bold file:cursor-pointer hover:border-accent-ink focus:outline-none focus:ring-2 focus:ring-accent-ink"
            />
            <p id="photos-hint" class="text-xs text-steel-500 mt-2 leading-6">
              حداکثر ۳ عکس، هرکدام تا ۵ مگابایت — JPG، PNG یا WebP. اگر پلاک ناخوانا است، از قطعه کنار یک خط‌کش عکس بگیرید.
            </p>
            <ul id="photos-list" class="mt-2 space-y-1 text-xs text-steel-600" role="list"></ul>
          </div>

          {/* Submit Button */}
          <button id="rfq-submit-btn" type="submit" class="w-full bg-action text-white font-bold py-4 rounded-md text-xl hover:bg-accent-strong transition-colors focus:outline-none focus:ring-4 focus:ring-accent-ink/40 flex items-center justify-center gap-2 min-h-[52px] disabled:opacity-60 disabled:cursor-not-allowed">
            <span>{submitLabel}</span>
            <svg class="w-5 h-5 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
          </button>
        </form>
        </>
        )}


<script>
  // خوانش هوشمند URL Params و پر کردن خودکار کد فنی/برند در فرم
  document.addEventListener('DOMContentLoaded', () => {
    const params = new URLSearchParams(window.location.search);
    const sku = params.get('sku') || params.get('pn');
    const brand = params.get('brand');

    const skuInput = document.getElementById('contact-sku') as HTMLInputElement | null;
    const msgInput = document.getElementById('contact-message') as HTMLTextAreaElement | null;

    if (skuInput && sku) {
      skuInput.value = sku;
    }

    if (msgInput && (sku || brand)) {
      const brandText = brand ? `برند: ${brand}` : '';
      const skuText = sku ? `کد فنی: ${sku}` : '';
      msgInput.value = `درخواست استعلام قیمت برای ${skuText} ${brandText}`.trim();
    }

    // ⚠️ فهرست چندقلمی صفحه‌ی اصلی (فرم GET با name="parts"). تا فاز ۳ این پارامتر هیچ‌جا خوانده نمی‌شد: خریدار
    // هشت کد تایپ می‌کرد، «ارسال» می‌زد و فرم تماس *خالی* باز می‌شد — فهرست بی‌صدا گم می‌شد.
    const parts = params.get('parts')?.trim();
    if (msgInput && parts) {
      msgInput.value = [msgInput.value, `فهرست کدهای فنی برای پیش‌فاکتور:\n${parts}`].filter(Boolean).join('\n\n');
    }

    // ------------------------------------------------------------
    // بهبود تدریجی (Progressive Enhancement) ارسال فرم.
    //
    // مقصد ارسال از خودِ `action`/`data-endpoint` فرم خوانده می‌شود — تک
    // منبع حقیقت. اگر جاوااسکریپت اجرا نشود، مرورگر همان `action` را
    // به‌صورت native POST می‌کند و لید باز هم در وردپرس ثبت می‌شود؛ این
    // اسکریپت فقط جلوی ترک صفحه را می‌گیرد و خطا/موفقیت را درجا نشان
    // می‌دهد. (مسیر قدیمی /api/contact حذف شد: در بیلد static اصلاً وجود
    // نداشت و باعث ۴۰۴ و از دست رفتن خاموش لید می‌شد.)
    // ------------------------------------------------------------
    const form = document.getElementById('rfq-form') as HTMLFormElement | null;
    const submitBtn = document.getElementById('rfq-submit-btn') as HTMLButtonElement | null;
    const feedback = document.getElementById('form-feedback') as HTMLDivElement | null;
    const endpoint = form?.dataset.endpoint;

    const showFeedback = (message: string, tone: 'error' | 'success') => {
      if (!feedback) return;
      feedback.textContent = message;
      feedback.classList.remove('hidden', 'bg-red-50', 'border-red-200', 'text-red-700', 'bg-emerald-50', 'border-emerald-200', 'text-emerald-700');
      if (tone === 'error') {
        feedback.classList.add('bg-red-50', 'border-red-200', 'text-red-700');
      } else {
        feedback.classList.add('bg-emerald-50', 'border-emerald-200', 'text-emerald-700');
      }
      feedback.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    };

    if (form && submitBtn && endpoint) {
      // ── اعتبارسنجی سمت کلاینت ────────────────────────────────────────
      // سرور هم همین‌ها را بررسی می‌کند و آنجا حرف آخر را می‌زند؛ این فقط
      // برای این است که کاربر ۵ مگابایت را آپلود نکند تا بعد رد شود.
      const MAX_FILES = 3;
      const MAX_BYTES = 5 * 1024 * 1024;
      const OK_TYPES = ['image/jpeg', 'image/png', 'image/webp'];

      const photos = document.getElementById('contact-photos') as HTMLInputElement | null;
      const photosList = document.getElementById('photos-list');

      const kb = (n: number) => (n < 1024 * 1024 ? `${Math.round(n / 1024)} کیلوبایت` : `${(n / 1048576).toFixed(1)} مگابایت`);

      const checkPhotos = (): string | null => {
        if (!photos?.files?.length) return null;
        const files = Array.from(photos.files);

        if (files.length > MAX_FILES) return `حداکثر ${MAX_FILES} عکس — شما ${files.length} عکس انتخاب کرده‌اید.`;

        for (const f of files) {
          if (!OK_TYPES.includes(f.type)) return `«${f.name}» عکس JPG، PNG یا WebP نیست.`;
          if (f.size > MAX_BYTES) return `«${f.name}» ${kb(f.size)} است — حداکثر ۵ مگابایت.`;
        }
        return null;
      };

      photos?.addEventListener('change', () => {
        if (!photosList) return;
        photosList.innerHTML = '';
        const problem = checkPhotos();

        for (const f of Array.from(photos.files ?? [])) {
          const li = document.createElement('li');
          li.textContent = `${f.name} — ${kb(f.size)}`;
          photosList.appendChild(li);
        }
        if (problem) showFeedback(problem, 'error');
      });

      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const photoProblem = checkPhotos();
        if (photoProblem) { showFeedback(photoProblem, 'error'); return; }
        if (submitBtn.disabled) return; // جلوگیری از ارسال دوباره با دابل‌کلیک
        submitBtn.disabled = true;
        const originalHtml = submitBtn.innerHTML;
        submitBtn.innerHTML = '<span>در حال ارسال...</span>';

        try {
          // ⚠️ دیگر JSON نیست. فایل را نمی‌شود در JSON فرستاد؛ FormData
          // خودش مرز multipart و Content-Type را می‌سازد — به همین دلیل
          // هدر Content-Type را *دستی نمی‌گذاریم*. اگر بگذاریم، مرورگر
          // مرز (boundary) را اضافه نمی‌کند و سرور هیچ فیلدی نمی‌بیند.
          const formData = new FormData(form);

          const res = await fetch(endpoint, {
            method: 'POST',
            headers: { Accept: 'application/json' },
            body: formData,
          });

          const data = (await res.json().catch(() => ({}))) as { success?: boolean; message?: string };

          if (res.ok && data.success) {
            window.location.href = '/thank-you';
            return;
          }

          showFeedback(
            data.message ||
              'ارسال درخواست انجام نشد. لطفاً نام، شماره همراه (۰۹۱۲XXXXXXX) و توضیحات را کامل وارد کنید و دوباره تلاش نمایید. در صورت تکرار مشکل، از طریق واتساپ یا تلگرام با ما در ارتباط باشید.',
            'error'
          );
        } catch {
          showFeedback('خطا در ارتباط با سرور. لطفاً اتصال اینترنت خود را بررسی کنید یا از طریق واتساپ/تلگرام پیام دهید.', 'error');
        } finally {
          submitBtn.disabled = false;
          submitBtn.innerHTML = originalHtml;
        }
      });
    }
  });
</script>

---
// src/components/AccountNav.astro
// نوار کناری صفحات حساب — همان فهرست منوی هدر (src/data/account-menu.ts).
import { ACCOUNT_MENU } from '../data/account-menu';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<nav aria-label="منوی حساب" class="bg-steel-50 border border-steel-300 rounded-lg p-2">
  <ul role="list" class="flex md:flex-col gap-1 overflow-x-auto">
    {ACCOUNT_MENU.map((item) => {
      const active = path === item.href;
      return (
        <li class="shrink-0">
          <a
            href={item.href}
            aria-current={active ? 'page' : undefined}
            class:list={[
              'flex items-center gap-2.5 rounded-md px-3 py-2.5 text-sm transition-colors focus:outline-none focus:ring-2 focus:ring-accent/40',
              active ? 'bg-white text-accent-ink font-bold shadow-sm' : 'text-steel-700 hover:bg-white',
            ]}
          >
            <svg class="w-5 h-5 shrink-0" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d={item.icon} /></svg>
            {item.label}
          </a>
        </li>
      );
    })}
    <li class="shrink-0 md:border-t md:border-steel-300 md:mt-1 md:pt-1">
      <button
        id="accnav-logout"
        type="button"
        class="w-full flex items-center gap-2.5 rounded-md px-3 py-2.5 text-sm text-red-700 hover:bg-red-50 transition-colors focus:outline-none focus:ring-2 focus:ring-red-300"
      >
        <svg class="w-5 h-5 shrink-0" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 16l4-4-4-4M19 12H9M13 20H6a2 2 0 01-2-2V6a2 2 0 012-2h7" /></svg>
        خروج
      </button>
    </li>
  </ul>
</nav>

<script>
  import { logout } from '../scripts/account';
  document.getElementById('accnav-logout')?.addEventListener('click', () => {
    logout();
  });
</script>

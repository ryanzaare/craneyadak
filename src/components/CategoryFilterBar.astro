---
// src/components/CategoryFilterBar.astro — فیلتر فروشگاه (بازطراحی ۳ آذر ۱۴۰۵؛ مرجع: دیجی‌کالا)
// ---------------------------------------------------------------------------
// کارفرما: «فیلترهای فروشگاه خیلی محدود است؛ با دیجی‌کالا مقایسه کن» (backlog O28). نسخه‌ی قبل یک نوار چیپ افقی بود
// با فیلتر تخصصی پشت یک <details> بسته. حالا:
//   • دسکتاپ (lg+): ستون کناری راست با گروه‌های تاشونده — همیشه دیده می‌شود، فهرست کنارش.
//   • موبایل: دکمه‌ی «فیلترها (n)» برگه‌ی تمام‌صفحه باز می‌کند؛ پایینش «نمایش n کالا». فیلتر زنده اعمال می‌شود.
//   • گروه‌ها: موجودی و قیمت، «فقط کالای اصل»، دسته (آرشیو)، برند، مشخصه‌های وردپرس + خودکار (src/data/filters.ts
//     allFacets — «نوع» ست/فرستنده/گیرنده از همین‌جا می‌آید). شمار کالای هر گزینه کنارش.
//   • چیپ فیلترهای فعال بالای فهرست، هر کدام با ×، و «حذف همه».
//   • مرتب‌سازی همه‌جا (پیش از این فقط آرشیو)، شمار نتیجه‌ی برجسته، جابه‌جایی نمای کارت/جدول.
// همه‌چیز ترکیب‌پذیر و در URL (stock، orig، brand، cat، f_<id>، max_<id>، sort، view) تا نشانی فیلترشده قابل
// اشتراک با همکار باشد — خرید صنعتی چندنفره است. منطق خالص و آزموده: ./category-filter.ts.
//
// ⚠️ CLS: هیچ چیزی با جاوااسکریپت جا باز نمی‌کند. ستون کناری از HTML اولیه در جایش است؛ برگه‌ی موبایل با CSS پنهان
// است (position:fixed، نه در جریان صفحه). نسخه‌ی اول نوار با hidden-تا-JS، CLS موبایل ۰٫۱۰۲ ساخته بود.
// ⚠️ بی‌جاوااسکریپت: فهرست کامل دیده می‌شود؛ گزینه‌ها بی‌اثرند و دکمه‌ی «فیلترها» کاری نمی‌کند.
// نتیجه‌ها (کارت‌ها/جدول) در slot پیش‌فرض می‌آیند و صفت‌هایشان از src/lib/filter-attrs.ts.
// ---------------------------------------------------------------------------
import type { ResolvedFacet } from '../data/filters';
import { BRANDS } from '../data/taxonomy';
import { computePrice, type CraneProduct } from '../lib/wp';

interface Props {
  products: CraneProduct[];
  /** فیلترهای مشخصه (وردپرس + خودکار) — همان آرایه‌ای که صفت‌های data-spec کارت‌ها از آن ساخته شده. */
  facets: ResolvedFacet[];
  /** آرشیو /products/: گروه دسته (چک‌باکس) — دسته‌های دارای کالا. */
  categories?: { slug: string; name: string; count: number }[];
  /** صفحه‌ی دسته: گروه دسته = پیوند به دسته‌های هم‌سیلو (فیلتر کردن خودِ دسته بی‌معناست). */
  related?: { name: string; href: string; current: boolean }[];
  /** شمار کالاهای دارای کاتالوگ PDF (همان مجموعه‌ای که data-catalog کارت‌ها از آن ساخته شده). */
  docCount?: number;
}

const { products, facets, categories = [], related = [], docCount = 0 } = Astro.props;

const brandCounts = new Map<string, number>();
for (const p of products) if (p.brandSlug) brandCounts.set(p.brandSlug, (brandCounts.get(p.brandSlug) ?? 0) + 1);
const brands = BRANDS.filter((b) => brandCounts.has(b.slug));

const inStock = products.filter((p) => p.stockStatus === 'in_stock').length;
const rfq = products.filter((p) => !computePrice(p).payable).length;
const originals = products.filter((p) => p.authenticity === 'original').length;
const prices = products.map((p) => computePrice(p)).filter((x) => x.payable && x.effective !== null).map((x) => x.effective as number);
const discounted = products.filter((p) => { const st = computePrice(p); return st.payable && st.onSale; }).length;
const usefulSpecs = facets.filter((f) => (f.kind === 'range' ? f.min !== f.max : f.values.length >= 2));

const fa = (n: number) => n.toLocaleString('fa-IR');
const pmin = prices.length ? Math.min(...prices) : null;
const pmax = prices.length ? Math.max(...prices) : null;
const priceInput = 'w-full min-h-11 rounded-md border border-steel-300 bg-white px-3 text-base text-steel-900 tabular-nums disabled:bg-steel-100 disabled:text-steel-500';
const opt = 'flex items-center gap-3 min-h-11 px-1 cursor-pointer rounded hover:bg-steel-50';
const box = 'w-5 h-5 shrink-0 accent-action';
const group = 'border-b border-steel-200 [&[open]>summary_svg]:rotate-180';
const summary = 'flex items-center justify-between gap-2 min-h-12 px-4 cursor-pointer list-none text-base font-bold text-steel-900 [&::-webkit-details-marker]:hidden';
const chev = '<svg class="w-5 h-5 text-steel-500 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>';
---

<div data-category-filters class="lg:grid lg:grid-cols-[17rem_minmax(0,1fr)] lg:gap-6 lg:items-start">
  {/* ── گروه‌های فیلتر: ستون کناری دسکتاپ / برگه‌ی موبایل (.cat-panel در global.css) ── */}
  <aside data-cat-panel id="cat-panel" class="cat-panel bg-white lg:rounded-lg lg:border lg:border-steel-300 lg:sticky lg:top-(--sticky-off)" aria-label="فیلترها">
    <div class="flex items-center justify-between gap-3 px-4 min-h-14 border-b border-steel-300">
      <p class="text-xl font-bold text-steel-900">فیلترها</p>
      <button type="button" data-cat-clear hidden class="text-sm font-bold text-accent-ink hover:underline underline-offset-4 min-h-11 px-1">حذف همه</button>
      <button type="button" data-cat-close class="lg:hidden w-11 h-11 grid place-items-center rounded-full hover:bg-steel-100" aria-label="بستن فیلترها">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
    </div>

    <div class="cat-panel-body">
      {/* جستجو در نتایج (۴ آذر ۱۴۰۵) — نام یا کد فنی، با ی/ک عربی و خط تیره یکسان (normText). */}
      <div class="px-4 pt-4 pb-3 border-b border-steel-200">
        <label for="cat-q" class="block text-base font-bold text-steel-900 mb-2">جستجو در نتایج</label>
        <input id="cat-q" type="search" data-cat-q autocomplete="off" placeholder="نام یا کد فنی" class={priceInput} />
      </div>
      {/* کلیدهای سریع — مثل «فقط کالاهای موجود» دیجی‌کالا. */}
      <div class="px-4 py-3 border-b border-steel-200 space-y-1">
        <label class={opt}><input type="checkbox" data-cat-instock class={box} /><span class="flex-1 text-base text-steel-900">فقط کالای موجود</span><span class="text-sm text-steel-600 tabular-nums">{fa(inStock)}</span></label>
        {originals > 0 && (
          <label class={opt}><input type="checkbox" data-cat-original class={box} /><span class="flex-1 text-base text-steel-900">فقط کالای اصل</span><span class="text-sm text-steel-600 tabular-nums">{fa(originals)}</span></label>
        )}
        {discounted > 0 && (
          <label class={opt}><input type="checkbox" data-cat-discount class={box} /><span class="flex-1 text-base text-steel-900">فقط تخفیف‌دار</span><span class="text-sm text-steel-600 tabular-nums">{fa(discounted)}</span></label>
        )}
        {docCount > 0 && (
          <label class={opt}><input type="checkbox" data-cat-doc class={box} /><span class="flex-1 text-base text-steel-900">دارای کاتالوگ PDF</span><span class="text-sm text-steel-600 tabular-nums">{fa(docCount)}</span></label>
        )}
        {rfq > 0 && rfq < products.length && (
          <label class={opt}><input type="checkbox" data-cat-rfq class={box} /><span class="flex-1 text-base text-steel-900">فقط استعلامی (بدون قیمت آنلاین)</span><span class="text-sm text-steel-600 tabular-nums">{fa(rfq)}</span></label>
        )}
      </div>

      {/* بازه‌ی قیمت (۴ آذر ۱۴۰۵، الگوی دیجی‌کالا). ⚠️ همیشه دیده می‌شود تا خریدار بداند هست؛ وقتی هیچ کالای این
          فهرست قیمت آنلاین ندارد، ورودی‌ها غیرفعال‌اند و دلیلش نوشته شده — فیلتری که همه را حذف کند بدتر از نبودنش است. */}
      <details class={group} open>
        <summary class={summary}><span>محدوده‌ی قیمت <span class="text-sm font-normal text-steel-600">(تومان)</span></span><Fragment set:html={chev} /></summary>
        <div class="px-4 pb-4">
          <div class="grid grid-cols-2 gap-2">
            <label class="text-sm font-bold text-steel-700">از<input type="text" inputmode="numeric" data-cat-pmin disabled={!prices.length} placeholder={pmin !== null ? fa(pmin) : '—'} class={`${priceInput} mt-1`} /></label>
            <label class="text-sm font-bold text-steel-700">تا<input type="text" inputmode="numeric" data-cat-pmax disabled={!prices.length} placeholder={pmax !== null ? fa(pmax) : '—'} class={`${priceInput} mt-1`} /></label>
          </div>
          {prices.length === 0 && <p class="mt-2 text-sm text-steel-600 leading-7">کالاهای این فهرست هنوز قیمت آنلاین ندارند و استعلامی‌اند؛ قیمت روز را با استعلام بگیرید.</p>}
          {prices.length > 0 && rfq > 0 && <p class="mt-2 text-sm text-steel-600 leading-7">با بازه‌ی قیمت، کالاهای استعلامی (بی‌قیمت) کنار می‌روند.</p>}
        </div>
      </details>

      {related.length > 0 && (
        <details class={group} open>
          <summary class={summary}>دسته‌بندی <Fragment set:html={chev} /></summary>
          <ul class="px-4 pb-3" role="list">
            {related.map((c) => (
              <li>{c.current
                ? <span class="flex items-center min-h-11 px-1 text-base font-bold text-accent-ink" aria-current="page">{c.name}</span>
                : <a href={c.href} class="flex items-center min-h-11 px-1 rounded text-base text-steel-800 hover:bg-steel-50 hover:text-accent-ink">{c.name}</a>}</li>
            ))}
          </ul>
        </details>
      )}

      {categories.length >= 1 && (
        <details class={group} open>
          <summary class={summary}>دسته <Fragment set:html={chev} /></summary>
          <fieldset class="px-4 pb-3"><legend class="sr-only">دسته</legend>
            {categories.map((c) => (
              <label class={opt}><input type="checkbox" data-cat-category value={c.slug} class={box} /><span class="flex-1 text-base text-steel-800">{c.name}</span><span class="text-sm text-steel-600 tabular-nums">{fa(c.count)}</span></label>
            ))}
          </fieldset>
        </details>
      )}

      {/* ⚠️ برند و دسته حتی با یک گزینه (کارفرما ۴ آذر ۱۴۰۵: «فیلتر برند و دسته نیست»): قاعده‌ی قبلی «فقط از ۲ گزینه»
          منطقی بود ولی خریدار نمی‌فهمید فیلتر برند وجود دارد؛ با رشد کاتالوگ گزینه‌ها خودشان اضافه می‌شوند. */}
      {brands.length >= 1 && (
        <details class={group} open>
          <summary class={summary}>برند <Fragment set:html={chev} /></summary>
          <fieldset class="px-4 pb-3"><legend class="sr-only">برند</legend>
            {brands.map((b) => (
              <label class={opt}><input type="checkbox" data-cat-brand value={b.slug} class={box} /><span class="flex-1 text-base text-steel-800">{b.nameFa}</span><span class="text-sm text-steel-600 tabular-nums">{fa(brandCounts.get(b.slug) ?? 0)}</span></label>
            ))}
          </fieldset>
        </details>
      )}

      {usefulSpecs.map((facet, i) => (
        <details class={group} open={i < 3}>
          <summary class={summary}>
            <span>{facet.label}{facet.unit && <span class="font-normal text-steel-600 text-sm"> ({facet.unit})</span>}</span>
            <Fragment set:html={chev} />
          </summary>
          <fieldset class="px-4 pb-3"><legend class="sr-only">{facet.label}</legend>
            {facet.hint && <p class="text-sm text-steel-600 leading-7 mb-2">{facet.hint}</p>}
            {facet.kind === 'checkbox' ? (
              facet.values.map((value) => (
                <label class={opt}>
                  <input type="checkbox" data-cat-spec={facet.id} data-label={facet.label} value={value} class={box} />
                  <span class="flex-1 text-base text-steel-800 leading-7 text-right" dir="auto">{value}</span>
                  <span class="text-sm text-steel-600 tabular-nums">{fa(facet.valueCounts[value] ?? 0)}</span>
                </label>
              ))
            ) : (
              <div class="pt-1">
                <label class="sr-only" for={`range-${facet.id}`}>حداکثر {facet.label}</label>
                <input id={`range-${facet.id}`} type="range" data-cat-range={facet.id} data-label={facet.label} min={facet.min ?? 0} max={facet.max ?? 100}
                  value={facet.max ?? 100} step="any" class="w-full accent-action" />
                <p class="flex justify-between text-sm text-steel-700 tabular-nums mt-1">
                  <span>{facet.min}</span><span>تا <strong data-range-out={facet.id} class="text-steel-900">{facet.max}</strong></span>
                </p>
              </div>
            )}
          </fieldset>
        </details>
      ))}
    </div>

    {/* پایین برگه‌ی موبایل — فیلترها زنده‌اند؛ این دکمه فقط می‌بندد و شمار را نشان می‌دهد. */}
    <div class="lg:hidden p-3 border-t border-steel-300 bg-white">
      <button type="button" data-cat-apply class="w-full min-h-12 rounded-md bg-action text-white text-base font-bold hover:bg-accent-ink">
        نمایش <span data-cat-count-btn class="tabular-nums">{fa(products.length)}</span> کالا
      </button>
    </div>
  </aside>

  <div class="min-w-0">
    {/* نوار بالای فهرست: شمار، دکمه‌ی فیلتر موبایل، مرتب‌سازی، نما. */}
    <div class="flex items-center gap-2 mb-3">
      <button type="button" data-cat-open aria-controls="cat-panel" aria-expanded="false"
        class="lg:hidden inline-flex items-center gap-2 min-h-11 px-4 rounded-md border-2 border-steel-900 bg-white text-sm font-bold text-steel-900">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5h18M6 12h12M10 19h4" /></svg>
        فیلترها<span data-cat-badge hidden class="min-w-5 h-5 px-1 rounded-full bg-action text-white text-xs grid place-items-center tabular-nums"></span>
      </button>
      <p class="hidden lg:block text-base text-steel-700"><strong data-cat-count class="text-steel-900 font-bold tabular-nums">{fa(products.length)}</strong> کالا</p>
      <label class="ms-auto inline-flex items-center gap-2 text-sm font-bold text-steel-700">
        <span class="hidden sm:inline">مرتب‌سازی:</span>
        <select data-cat-sort aria-label="مرتب‌سازی" class="min-h-11 rounded-md border border-steel-300 bg-white px-2 text-sm font-bold text-steel-900">
          <option value="relevant">مرتبط‌ترین</option>
          <option value="newest">جدیدترین</option>
          <option value="cheapest">ارزان‌ترین</option>
          <option value="expensive">گران‌ترین</option>
        </select>
      </label>
      {/* ⚠️ کارت پیش‌فرض و اول است (کارفرما، ۳ آبان ۱۴۰۵)؛ HTML اولیه هم کارت را نشان می‌دهد تا بی‌پرش (CLS). */}
      <div class="shrink-0 inline-flex rounded-md border border-steel-300 overflow-hidden" role="group" aria-label="نوع نمایش">
        <button type="button" data-cat-view-btn="grid" aria-pressed="true" class="min-h-11 px-3 text-sm font-bold text-steel-700 bg-white aria-pressed:bg-steel-900 aria-pressed:text-white">کارت</button>
        <button type="button" data-cat-view-btn="list" aria-pressed="false" class="min-h-11 px-3 text-sm font-bold text-steel-700 bg-white border-s border-steel-300 aria-pressed:bg-steel-900 aria-pressed:text-white">جدول</button>
      </div>
    </div>
    <p class="lg:hidden text-sm text-steel-700 mb-3"><strong data-cat-count class="text-steel-900 font-bold tabular-nums">{fa(products.length)}</strong> کالا</p>

    {/* چیپ فیلترهای فعال — با جاوااسکریپت پر می‌شود؛ خالی = بی‌ارتفاع (CLS صفر تا کاربر فیلتری نزند). */}
    <ul data-cat-active class="flex flex-wrap gap-2 empty:hidden mb-3" role="list" aria-label="فیلترهای فعال"></ul>

    <slot />
  </div>
</div>

<script>
  import { matches, parseState, toQuery, compareItems, money, EMPTY, type FilterState, type ItemData, type SortMode } from './category-filter';

  const root = document.querySelector<HTMLElement>('[data-category-filters]');
  if (root) {
    const fa = (n: number) => n.toLocaleString('fa-IR');
    const items = [...document.querySelectorAll<HTMLElement>('[data-cat-item]')];
    const views = [...document.querySelectorAll<HTMLElement>('[data-cat-view]')];
    const counts = [...root.querySelectorAll<HTMLElement>('[data-cat-count], [data-cat-count-btn]')];
    const emptyEl = document.querySelector<HTMLElement>('[data-cat-empty]');
    const panel = root.querySelector<HTMLElement>('[data-cat-panel]')!;
    const openBtn = root.querySelector<HTMLButtonElement>('[data-cat-open]');
    const badge = root.querySelector<HTMLElement>('[data-cat-badge]');
    const activeList = root.querySelector<HTMLElement>('[data-cat-active]')!;
    const clear = root.querySelector<HTMLButtonElement>('[data-cat-clear]');
    const inStockBox = root.querySelector<HTMLInputElement>('[data-cat-instock]');
    const rfqBox = root.querySelector<HTMLInputElement>('[data-cat-rfq]');
    const origBox = root.querySelector<HTMLInputElement>('[data-cat-original]');
    const discBox = root.querySelector<HTMLInputElement>('[data-cat-discount]');
    const docBox = root.querySelector<HTMLInputElement>('[data-cat-doc]');
    const qEl = root.querySelector<HTMLInputElement>('[data-cat-q]');
    const pminEl = root.querySelector<HTMLInputElement>('[data-cat-pmin]');
    const pmaxEl = root.querySelector<HTMLInputElement>('[data-cat-pmax]');
    const brandBoxes = [...root.querySelectorAll<HTMLInputElement>('[data-cat-brand]')];
    const specBoxes = [...root.querySelectorAll<HTMLInputElement>('[data-cat-spec]')];
    const ranges = [...root.querySelectorAll<HTMLInputElement>('[data-cat-range]')];
    const viewBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-cat-view-btn]')];
    const catBoxes = [...root.querySelectorAll<HTMLInputElement>('[data-cat-category]')];
    const sortEl = root.querySelector<HTMLSelectElement>('[data-cat-sort]');

    const data = (el: HTMLElement): ItemData => {
      const specs: Record<string, string> = {};
      for (const a of el.getAttributeNames()) if (a.startsWith('data-spec-')) specs[a.slice(10)] = el.getAttribute(a) ?? '';
      const price = el.dataset.price ? Number(el.dataset.price) : null;
      return {
        stock: el.dataset.stock ?? '', priced: el.dataset.priced === '1', brand: el.dataset.brand ?? '', specs,
        categories: (el.dataset.categories ?? '').split(' ').filter(Boolean), price, modified: el.dataset.modified ?? '',
        original: el.dataset.original === '1',
        text: el.dataset.text ?? '', discount: el.dataset.discount === '1', catalog: el.dataset.catalog === '1',
      };
    };
    const itemData = new Map(items.map((el) => [el, data(el)]));

    // «موجود» و «استعلامی» دو کلید جدا در رابط‌اند ولی در وضعیت یک فیلد (stock) — هم‌زمان روشن شدنشان را مهار کن.
    const read = (): FilterState => ({
      ...EMPTY,
      stock: inStockBox?.checked ? 'in' : rfqBox?.checked ? 'rfq' : 'all',
      original: !!origBox?.checked,
      discount: !!discBox?.checked,
      catalog: !!docBox?.checked,
      q: (qEl?.value ?? '').trim(),
      pmin: pminEl?.disabled ? null : money(pminEl?.value),
      pmax: pmaxEl?.disabled ? null : money(pmaxEl?.value),
      brands: brandBoxes.filter((b) => b.checked).map((b) => b.value),
      cats: catBoxes.filter((b) => b.checked).map((b) => b.value),
      specs: specBoxes.reduce<Record<string, string[]>>((acc, b) => { if (b.checked) (acc[b.dataset.catSpec!] ??= []).push(b.value); return acc; }, {}),
      ranges: ranges.reduce<Record<string, number>>((acc, r) => { if (r.value !== r.max) acc[r.dataset.catRange!] = Number(r.value); return acc; }, {}),
      sort: (sortEl?.value as SortMode) ?? 'relevant',
      view: viewBtns.find((b) => b.getAttribute('aria-pressed') === 'true')?.dataset.catViewBtn === 'list' ? 'list' : 'grid',
    });

    const write = (s: FilterState) => {
      if (inStockBox) inStockBox.checked = s.stock === 'in';
      if (rfqBox) rfqBox.checked = s.stock === 'rfq';
      if (origBox) origBox.checked = s.original;
      if (discBox) discBox.checked = s.discount;
      if (docBox) docBox.checked = s.catalog;
      if (qEl) qEl.value = s.q;
      if (pminEl && !pminEl.disabled) pminEl.value = s.pmin === null ? '' : fa(s.pmin);
      if (pmaxEl && !pmaxEl.disabled) pmaxEl.value = s.pmax === null ? '' : fa(s.pmax);
      for (const b of brandBoxes) b.checked = s.brands.includes(b.value);
      for (const b of catBoxes) b.checked = s.cats.includes(b.value);
      for (const b of specBoxes) b.checked = (s.specs[b.dataset.catSpec!] ?? []).includes(b.value);
      for (const r of ranges) {
        const v = s.ranges[r.dataset.catRange!];
        r.value = v === undefined ? r.max : String(v);
        const out = root.querySelector<HTMLElement>(`[data-range-out="${r.dataset.catRange}"]`);
        if (out) out.textContent = r.value;
      }
      for (const b of viewBtns) b.setAttribute('aria-pressed', String(b.dataset.catViewBtn === s.view));
      if (sortEl) sortEl.value = s.sort;
    };

    /** ترتیب DOM هر نما — مرتب‌سازی پایدار؛ «مرتبط‌ترین» ترتیب build را برمی‌گرداند. */
    const original = new Map(items.map((el, i) => [el, i]));
    const reorder = (mode: SortMode) => {
      for (const v of views) {
        const list = v.matches('ul') ? v : v.querySelector('ul');
        if (!list) continue;
        const own = [...list.children].filter((c): c is HTMLElement => itemData.has(c as HTMLElement));
        own.sort((a, b) => compareItems(itemData.get(a)!, itemData.get(b)!, mode) || original.get(a)! - original.get(b)!);
        for (const el of own) list.appendChild(el);
      }
    };

    // چیپ‌های فعال: هر کدام یک کنترل را خاموش می‌کند. متن از برچسب خود کنترل، پس همیشه با نوار هم‌خوان است.
    const textOf = (el: HTMLInputElement) => el.closest('label')?.querySelector('span')?.textContent?.trim() ?? el.value;
    const renderChips = () => {
      const on: { label: string; off: () => void }[] = [];
      for (const b of [inStockBox, rfqBox, origBox, discBox, docBox]) if (b?.checked) on.push({ label: textOf(b), off: () => (b.checked = false) });
      if (qEl?.value.trim()) on.push({ label: `جستجو: ${qEl.value.trim()}`, off: () => (qEl.value = '') });
      const lo = money(pminEl?.value), hi = money(pmaxEl?.value);
      if (lo !== null || hi !== null) on.push({
        label: `قیمت: ${lo !== null ? `از ${fa(lo)}` : ''}${lo !== null && hi !== null ? ' ' : ''}${hi !== null ? `تا ${fa(hi)}` : ''} تومان`,
        off: () => { if (pminEl) pminEl.value = ''; if (pmaxEl) pmaxEl.value = ''; },
      });
      for (const b of [...catBoxes, ...brandBoxes]) if (b.checked) on.push({ label: textOf(b), off: () => (b.checked = false) });
      for (const b of specBoxes) if (b.checked) on.push({ label: `${b.dataset.label}: ${b.value}`, off: () => (b.checked = false) });
      for (const r of ranges) if (r.value !== r.max) on.push({ label: `${r.dataset.label}: تا ${r.value}`, off: () => (r.value = r.max) });
      activeList.replaceChildren(...on.map((c) => {
        const li = document.createElement('li');
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'inline-flex items-center gap-2 min-h-10 ps-3 pe-2 rounded-full border border-action bg-accent-soft text-sm font-bold text-accent-ink hover:bg-white';
        btn.setAttribute('aria-label', `حذف فیلتر ${c.label}`);
        btn.textContent = c.label;
        const x = document.createElement('span');
        x.setAttribute('aria-hidden', 'true'); x.className = 'text-base leading-none'; x.textContent = '×';
        btn.appendChild(x);
        btn.addEventListener('click', () => { c.off(); apply(); });
        li.appendChild(btn);
        return li;
      }));
      if (badge) { badge.hidden = on.length === 0; badge.textContent = fa(on.length); }
      return on.length;
    };

    const apply = (push = true) => {
      const s = read();
      const shown = new Set<string>();
      for (const el of items) {
        const ok = matches(itemData.get(el)!, s);
        el.hidden = !ok;
        if (ok && el.dataset.slug) shown.add(el.dataset.slug);
      }
      for (const v of views) v.hidden = v.dataset.catView !== s.view;
      reorder(s.sort);
      for (const c of counts) c.textContent = fa(shown.size);
      if (emptyEl) emptyEl.hidden = shown.size !== 0;
      const n = renderChips();
      if (clear) clear.hidden = n === 0;
      if (push) {
        const qs = toQuery(s);
        history.replaceState(null, '', location.pathname + (qs ? `?${qs}` : '') + location.hash);
      }
    };

    // ── برگه‌ی موبایل ──
    const mq = matchMedia('(min-width: 1024px)');
    let lastFocus: HTMLElement | null = null;
    const setOpen = (open: boolean) => {
      panel.toggleAttribute('data-open', open);
      openBtn?.setAttribute('aria-expanded', String(open));
      document.documentElement.style.overflow = open && !mq.matches ? 'hidden' : '';
      if (open) { lastFocus = document.activeElement as HTMLElement; panel.querySelector<HTMLElement>('[data-cat-close]')?.focus(); }
      else lastFocus?.focus();
    };
    openBtn?.addEventListener('click', () => setOpen(true));
    for (const b of root.querySelectorAll('[data-cat-close], [data-cat-apply]')) b.addEventListener('click', () => setOpen(false));
    panel.addEventListener('keydown', (e) => { if (e.key === 'Escape' && panel.hasAttribute('data-open')) setOpen(false); });
    mq.addEventListener('change', () => { if (mq.matches && panel.hasAttribute('data-open')) setOpen(false); });

    write(parseState(new URLSearchParams(location.search)));
    apply(false);

    inStockBox?.addEventListener('change', () => { if (inStockBox.checked && rfqBox) rfqBox.checked = false; apply(); });
    rfqBox?.addEventListener('change', () => { if (rfqBox.checked && inStockBox) inStockBox.checked = false; apply(); });
    for (const el of [origBox, discBox, docBox, ...brandBoxes, ...specBoxes, ...catBoxes]) el?.addEventListener('change', () => apply());
    // جستجو و قیمت: با تایپ (کمی درنگ) — هر کلید یک بار کل فهرست را نمی‌چیند.
    let typing: number | undefined;
    for (const el of [qEl, pminEl, pmaxEl]) el?.addEventListener('input', () => { clearTimeout(typing); typing = window.setTimeout(() => apply(), 250); });
    // قیمت با جداکننده‌ی هزارگان فارسی پس از ترک فیلد: «۱۲۵۰۰۰۰۰» ⇒ «۱۲٬۵۰۰٬۰۰۰».
    for (const el of [pminEl, pmaxEl]) el?.addEventListener('change', () => { const v = money(el.value); el.value = v === null ? '' : fa(v); apply(); });
    sortEl?.addEventListener('change', () => apply());
    for (const r of ranges) r.addEventListener('input', () => {
      const out = root.querySelector<HTMLElement>(`[data-range-out="${r.dataset.catRange}"]`);
      if (out) out.textContent = r.value;
      apply();
    });
    for (const b of viewBtns) b.addEventListener('click', () => {
      for (const o of viewBtns) o.setAttribute('aria-pressed', String(o === b));
      apply();
    });
    clear?.addEventListener('click', () => {
      const s = read();
      write({ ...EMPTY, view: s.view, sort: s.sort });
      apply();
    });
  }
</script>

---
// src/components/HighWearParts.astro
// ---------------------------------------------------------------------------
// «قطعات مصرفی و پرتعویض» — جایگزین صادقانه‌ی بخش «پرفروش‌ترین‌ها».
//
// خلاصه: هیچ داده‌ی فروشی وجود ندارد، پس «پرفروش‌ترین» یک ادعای آماری
// بی‌پشتوانه می‌شد. اما «قطعه‌ای که ذاتاً ساییده می‌شود» یک واقعیت
// مهندسی است، روی هر کارت دلیلش نوشته شده، و برای مدیر نگهداری مفیدتر
// هم هست: این دقیقاً فهرست چیزهایی است که باید در انبار داشته باشد.
//
// ⚠️ فهرست از وردپرس می‌آید (ایست ۳، docs/backlog.md) — نه از این فایل.
// اگر اسلاگی در تاکسونومی پیدا نشود، بی‌سروصدا حذف نمی‌شود — در زمان
// build هشدار می‌دهد. کارت شکسته بدتر از کارت غایب است.
// ---------------------------------------------------------------------------
import { getHighWearParts } from '../lib/site-options';
import { findCategory, categoryPath } from '../data/taxonomy';
import { hairlineGrid, hairlineCell } from './hairline';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const highWearParts = await getHighWearParts();
const missing: string[] = [];
const items = highWearParts.map((entry) => {
  const category = findCategory(entry.categorySlug);
  if (!category) {
    missing.push(entry.categorySlug);
    return null;
  }
  return { category, reason: entry.reason };
}).filter((x): x is { category: NonNullable<ReturnType<typeof findCategory>>; reason: string } =>
  Boolean(x)
);

if (missing.length > 0) {
  console.warn(
    `\n⚠️  [HighWearParts] ${missing.length} اسلاگ دسته در تاکسونومی پیدا نشد و از صفحه‌ی اصلی حذف شد:\n` +
      missing.map((s) => `    • ${s}`).join('\n') +
      `\n  اسلاگ‌ها را در src/data/discovery.ts با src/data/taxonomy.ts هم‌خوان کنید.\n`
  );
}
---

{/* فاز ۴ (کارفرما، ۳ آبان ۱۴۰۵ — بازگشت به صفحه‌ی اصلی): شبکه‌ی خط مو با شماره‌ی مونو «۰۱، ۰۲…» به‌جای کارت گرد.
    فاز ۵: آیکن دسته + هاور قاب نارنجی درونی (ring-inset) که در شبکه‌ی خط مو مرز همسایه را نمی‌شکند. */}
{
  items.length > 0 && (
    <section class={`bg-white px-4 py-8 md:py-10 border-b border-steel-300 ${className}`} aria-labelledby="wear-heading">
      <div class="max-w-7xl mx-auto">
        <div class="flex flex-wrap items-end justify-between gap-x-4 gap-y-1 mb-4">
          <div class="min-w-0">
            <h2 id="wear-heading" class="text-xl md:text-2xl font-black text-steel-900">قطعات مصرفی و پرتعویض جرثقیل سقفی</h2>
            <p class="mt-1 text-sm text-steel-600 leading-7 max-w-3xl">
              قطعاتی که بر اساس سایش، حرارت یا خستگی مکانیکی عمر محدود دارند و در برنامه‌ی نگهداری پیشگیرانه دوره‌ای تعویض
              می‌شوند — همان اقلامی که بهتر است همیشه در انبار موجود باشند.
            </p>
          </div>
          <a href="/categories/" class="inline-flex items-center min-h-11 text-sm font-bold text-accent-ink hover:underline underline-offset-4 shrink-0">همه‌ی دسته‌ها ←</a>
        </div>
        <ol class={hairlineGrid(items.length)}>
          {items.map(({ category, reason }, i) => (
            <li class={`${hairlineCell(i, items.length)} relative transition-all duration-150 hover:ring-2 hover:ring-inset hover:ring-action hover:z-10`}>
              <a href={categoryPath(category)} class="group h-full flex flex-col gap-2 p-4">
                <span class="flex items-center gap-3">
                  <span class="w-10 h-10 shrink-0 rounded bg-steel-100 border border-steel-200 grid place-items-center" aria-hidden="true">
                    <svg class="w-6 h-6 text-action" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d={category.icon} /></svg>
                  </span>
                  <span class="min-w-0 flex-1 font-black text-steel-900 text-sm leading-6 group-hover:text-accent-ink">{category.name}</span>
                  <span class="font-mono text-xs text-steel-600 tabular-nums" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                </span>
                {/* دلیل فنی — همان چیزی که این ادعا را قابل ارزیابی می‌کند و از یک برچسب تبلیغاتی جدا. */}
                <span class="text-xs text-steel-600 leading-6 mt-auto pt-2 border-t border-steel-200">{reason}</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )
}

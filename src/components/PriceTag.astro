---
// src/components/PriceTag.astro
// ---------------------------------------------------------------------------
// نمایش قیمت — تنها کامپوننت مجاز برای رندر قیمت در کل سایت.
//
// چرا متمرکز: قانون «قیمت خط‌خورده فقط وقتی قیمت قبلی واقعی باشد» نباید در
// چند فایل تکرار (و روزی فراموش) شود. هر جای سایت که قیمت نشان داده می‌شود
// از همین کامپوننت و همان محاسبه‌ی `computePrice` استفاده می‌کند.
//
// سه حالت (src/lib/pricing.ts):
//   • پرداخت‌پذیر  → قیمت + «معتبر تا …»
//   • مرجع         → «آخرین قیمت (تاریخ)» کم‌رنگ + «استعلام قیمت روز».
//                    تصمیم مدیرعامل (ایست ۲): قلم منقضی/ناموجود قیمت قبلی را
//                    با تاریخ نشان دهد. ⚠️ این عدد وارد JSON-LD نمی‌شود.
//   • بدون قیمت    → برچسب صادقانه‌ی «استعلام قیمت»؛ هیچ عددی ساخته نمی‌شود.
// ---------------------------------------------------------------------------
import { formatPrice, schemaPriceValidUntil, type PriceState } from '../lib/wp';

export interface Props {
  price: PriceState;
  /** اندازه‌ی نمایش: کارت فهرست یا صفحه‌ی محصول. */
  size?: 'card' | 'page';
  class?: string;
}

const { price, size = 'card', class: className = '' } = Astro.props;

const isPage = size === 'page';
const faDate = (iso: string | null) =>
  iso ? new Date(iso).toLocaleDateString('fa-IR', { timeZone: 'Asia/Tehran', year: 'numeric', month: 'long', day: 'numeric' }) : null;
// ⚠️ همان تاریخِ priceValidUntil در JSON-LD (زودترینِ پایان اعتبار و پایان
// تخفیف) — متن صفحه و داده‌ی ساختاریافته نباید دو تاریخ متفاوت بگویند.
const validUntilDay = schemaPriceValidUntil(price);
const validUntilLabel = validUntilDay ? faDate(`${validUntilDay}T12:00:00+03:30`) : null;
const priceDateLabel = faDate(price.priceDate);
---

{price.payable && price.effective !== null ? (
  <div class:list={['flex flex-wrap items-baseline gap-x-3 gap-y-1', className]}>
    {price.onSale && price.previous !== null && (
      <>
        {/* قیمت قبلی فقط زمانی رندر می‌شود که واقعاً یک قیمت عادیِ ثبت‌شده
            وجود داشته باشد و از قیمت فعلی بیشتر باشد — نگاه کنید به
            computePrice در src/lib/pricing.ts. */}
        <s class:list={['text-gray-500 tabular-nums', isPage ? 'text-lg' : 'text-sm']}>
          {formatPrice(price.previous)}
        </s>
        <span
          class:list={[
            'inline-flex items-center justify-center rounded-full bg-rose-600 text-white font-black tabular-nums shrink-0',
            isPage ? 'text-sm w-14 h-14' : 'text-xs w-11 h-11',
          ]}
          aria-label={`${price.discountPercent} درصد تخفیف`}
        >
          ٪{price.discountPercent}
        </span>
      </>
    )}
    <span
      class:list={[
        'font-black text-crane-navy tabular-nums',
        isPage ? 'text-3xl md:text-4xl' : 'text-base',
      ]}
    >
      {formatPrice(price.effective)}
    </span>
  </div>
) : price.reference && price.effective !== null ? (
  <div class:list={['flex flex-col gap-1', className]}>
    <span
      class:list={[
        'inline-flex items-center gap-2 font-bold text-crane-orange',
        isPage ? 'text-xl' : 'text-sm',
      ]}
    >
      استعلام قیمت روز
    </span>
    <span class:list={['text-gray-500 tabular-nums', isPage ? 'text-sm' : 'text-xs']}>
      آخرین قیمت{priceDateLabel ? ` (${priceDateLabel})` : ''}: {formatPrice(price.effective)}
    </span>
  </div>
) : (
  <span
    class:list={[
      'inline-flex items-center gap-2 font-bold text-crane-orange',
      isPage ? 'text-xl' : 'text-sm',
      className,
    ]}
  >
    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h8M8 14h5m-9 7l3-3h10a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v13z" />
    </svg>
    استعلام قیمت
  </span>
)}

{price.payable && validUntilLabel && isPage && (
  /* data-price-valid-until: محافظ مرورگر (فاز سبدها) پس از این لحظه دکمه‌ی
     خرید را به استعلام تبدیل می‌کند — بی‌نیاز از rebuild. */
  <p class="text-xs text-gray-600 mt-2" data-price-valid-until={price.validUntil}>
    اعتبار این قیمت تا <time datetime={validUntilDay}>{validUntilLabel}</time>
  </p>
)}

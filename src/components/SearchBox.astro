---
// src/components/SearchBox.astro
// ---------------------------------------------------------------------------
// کادر جستجو با پیشنهاد آنی (اتوکامپلیت).
//
// چرا پیشنهادها از Pagefind نمی‌آیند: Pagefind تا دانلود فایل ایندکس هیچ
// جوابی نمی‌دهد، و دقیقاً همان اولین کاراکترها — جایی که اتوکامپلیت
// بیشترین ارزش را دارد — خالی می‌ماند. ۳۱ دسته و ۱۸ برند از زمان build
// معلوم‌اند، پس به‌صورت یک آرایه‌ی کوچک (~۵۶ مدخل) همراه صفحه می‌آیند و از
// اولین حرف جواب می‌دهند. Pagefind کار خودش را جای دیگری می‌کند: جستجوی
// تمام‌متن داخل محصولات.
//
// دسترس‌پذیری: الگوی رسمی combobox از APG — `role="combobox"` روی input،
// `aria-expanded`، `aria-controls`، `aria-activedescendant` و پیمایش با
// کلیدهای جهت‌دار. یک فهرست پیشنهاد که فقط با ماوس کار کند، برای کاربر
// کیبورد و اسکرین‌ریدر عملاً وجود ندارد.
// ---------------------------------------------------------------------------
import { buildStructuralIndex } from '../lib/search-index';
import { withTrailingSlash } from '../lib/urls.mjs';

interface Props {
  id?: string;
  placeholder?: string;
  /** ظاهر تیره برای هیرو، روشن برای صفحه‌ی جستجو. */
  tone?: 'dark' | 'light';
  autofocus?: boolean;
  /** هدف میان‌بر «/» هدر (فاز ۳) + نشان kbd از lg. فقط یک SearchBox در صفحه. */
  slash?: boolean;
  class?: string;
}

const {
  id = 'search-box',
  // «جستجو»، تک‌کلمه (بازبینی کارفرما، ۱ آبان ۱۴۰۵): placeholder بلند زیر آیکن بریده می‌شد. راهنمای «کد فنی» در
  // label (sr-only) و aria هست؛ placeholder جای راهنما نیست.
  placeholder = 'جستجو',
  tone = 'dark',
  autofocus = false,
  slash = false,
  class: className = '',
} = Astro.props;

/* ⚠️ فقط لایه‌ی ساختاری inline می‌شود — نه محصولات.
   این کامپوننت در هدر است و روی هر صفحه رندر می‌شود. قبلاً کل کاتالوگ
   (نام، کد فنی و همه‌ی کدهای معادل OEM هر محصول) داخل HTML هر صفحه
   سریال می‌شد. با رشد کاتالوگ، این به صدها کیلوبایت روی هر بازدید
   تبدیل می‌شد.

   حالا:
     • این آرایه = ۷ سیلو + ۳۱ دسته + ~۱۹ برند. اندازه‌اش ثابت است و
       با رشد کاتالوگ بزرگ نمی‌شود. از اولین کاراکتر بدون شبکه جواب
       می‌دهد — همان هدف اصلی این کامپوننت.
     • محصولات از `/search-index.json` و فقط هنگام اولین تعامل کاربر
       با کادر جستجو واکشی می‌شوند.
   (توضیح کامل در src/pages/search-index.json.ts) */
// ⚠️ پیوندهای دسته/برند فهرست ساختاری «/» پایانی نداشتند (siloPath/categoryPath) — normalizeInternalLinks فقط href
// داخل HTML را اصلاح می‌کند، نه این JSON؛ هر کلیک روی پیشنهاد یک ریدایرکت ۳۰۱ اضافه می‌خورد. (دیده‌شده در build زنده‌ی
// 3a44360، فاز ۴.) محصولات (/search-index.json) از قبل درست بودند.
const index = buildStructuralIndex().map((e) => ({ ...e, href: withTrailingSlash(e.href) }));
const listId = `${id}-listbox`;
---

<div class={`cy-search relative ${className}`} data-search-root>
  <form action="/search/" method="GET" role="search" class="w-full">
    <label for={id} class="sr-only">جستجوی نام، برند یا کد فنی قطعه</label>

    <div
      class={
        tone === 'dark'
          ? 'flex flex-col md:flex-row items-stretch bg-white rounded-lg p-1.5 ring-1 ring-black/20 focus-within:ring-4 focus-within:ring-accent/60 transition-shadow'
          : 'flex flex-col md:flex-row items-stretch bg-white rounded-lg p-1.5 ring-2 ring-steel-300 focus-within:ring-4 focus-within:ring-accent/60 transition-shadow'
      }
    >
      <span class="hidden md:flex items-center px-4 text-steel-600" aria-hidden="true">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </span>

      <input
        id={id}
        type="search"
        name="q"
        placeholder={placeholder}
        class="grow bg-transparent text-steel-900 px-4 md:px-0 py-3.5 focus:outline-none text-right placeholder-steel-600 text-base font-normal w-full"
        dir="rtl"
        autocomplete="off"
        autocorrect="off"
        spellcheck="false"
        required
        role="combobox"
        aria-expanded="false"
        aria-controls={listId}
        aria-autocomplete="list"
        aria-haspopup="listbox"
        data-search-input
        data-slash-target={slash || undefined}
        autofocus={autofocus || undefined}
      />
      {slash && <kbd class="hidden lg:grid place-items-center self-center w-6 h-6 me-3 rounded border border-steel-300 font-mono text-xs text-steel-600" aria-hidden="true">/</kbd>}

      <button
        type="submit"
        class="w-full md:w-auto bg-action text-white px-8 py-3.5 rounded-md font-black hover:bg-accent-strong transition-colors shrink-0 mt-1.5 md:mt-0"
      >
        جستجو
      </button>
    </div>
  </form>

  {/* فهرست پیشنهاد. تا وقتی پیشنهادی نیست، از DOM حذف نمی‌شود بلکه مخفی
      می‌ماند — تا `aria-controls` همیشه به یک عنصر موجود اشاره کند. */}
  <ul
    id={listId}
    role="listbox"
    aria-label="پیشنهادهای جستجو"
    hidden
    class="absolute z-50 top-full mt-1.5 w-full bg-white rounded-lg border-2 border-steel-900 max-h-[22rem] overflow-y-auto text-right"
    data-search-list
  >
  </ul>

  {/* داده‌ی ساختاری برای اسکریپت (JSON، نه کد اجرایی). اسکریپت ماژول پایین همه‌ی SearchBoxهای صفحه را می‌خواند. */}
  {/* ⚠️ «<» به \u003c: نامی که «</script>» داشته باشد نباید تگ را زودتر ببندد. */}
  <script type="application/json" data-search-index set:html={JSON.stringify(index).replace(/</g, '\\u003c')} />
</div>

<script>
  /* ⚠️ منطق امتیاز از src/lib/search-score.ts import می‌شود — همان فایلی که آزمون Node اجرا می‌کند
     (npm run test:search). نسخه‌ی قبل یک کپی inline بود که از سرور رانده بود (محدوده‌ی اعراب U+0650 به‌جای
     U+0652): آزمون چیزی را تأیید می‌کرد که مرورگر اجرا نمی‌کرد. حالا یک منطق، باندل‌شده و کش‌شونده. */
  import { suggest, type SuggestEntry } from '../lib/search-score';

  const KIND_LABEL: Record<string, string> = { category: 'دسته', brand: 'برند', silo: 'گروه', product: 'محصول' };
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  /* ───────── واکشی تنبل فهرست محصولات — یک‌بار برای کل صفحه ─────────
     لایه‌ی ساختاری inline است و فوراً جواب می‌دهد؛ محصولات فقط با اولین تعامل. ⚠️ شکست واکشی جستجو را
     نمی‌شکند — فقط به دسته و برند محدود می‌شود. */
  let products: SuggestEntry[] | null = null;
  let loading: Promise<SuggestEntry[]> | null = null;
  const loadProducts = () =>
    (loading ??= fetch('/search-index.json')
      .then((r) => (r.ok ? r.json() : []))
      .catch(() => [])
      .then((list) => (products = Array.isArray(list) ? list : [])));

  document.querySelectorAll<HTMLElement>('[data-search-root]').forEach((root) => {
    const input = root.querySelector<HTMLInputElement>('[data-search-input]');
    const list = root.querySelector<HTMLUListElement>('[data-search-list]');
    const data = root.querySelector('[data-search-index]');
    if (!input || !list || !data) return;
    const structural: SuggestEntry[] = JSON.parse(data.textContent || '[]');
    // محصولات جلوتر از ساختار: در تساوی امتیاز، قطعه‌ی واقعیِ قابل سفارش بر صفحه‌ی دسته اولویت دارد.
    const index = () => (products ? [...products, ...structural] : structural);
    const id = input.id;
    let active = -1;

    const close = () => {
      list.hidden = true;
      input.setAttribute('aria-expanded', 'false');
      input.removeAttribute('aria-activedescendant');
      active = -1;
    };

    const render = (items: SuggestEntry[], query: string) => {
      active = -1;
      input.removeAttribute('aria-activedescendant');
      if (!query.trim()) return close();
      if (!items.length) {
        /* «پیدا نشد» بن‌بست نیست: جستجوی کامل (با پیشنهاد عکس/تماس در /search/) یا فهرست دسته‌ها. */
        list.innerHTML =
          '<li class="px-4 py-3 text-sm text-steel-700 leading-6"><strong class="block text-steel-900 mb-1">موردی با این عبارت پیدا نشد.</strong>' +
          'جستجوی کامل، ارسال عکس پلاک یا تماس را امتحان کنید.</li>' +
          '<li class="border-t border-steel-100"><a href="/search/?q=' + encodeURIComponent(query) + '" class="block px-4 py-2.5 text-sm font-bold text-accent-ink hover:bg-accent-soft">' +
          'جستجوی «' + esc(query) + '» در تمام محصولات ←</a></li>';
      } else {
        list.innerHTML = items
          .map((e, i) =>
            '<li role="option" id="' + id + '-opt-' + i + '" aria-selected="false" class="border-b border-steel-100 last:border-b-0">' +
            '<a href="' + esc(e.href) + '" tabindex="-1" class="flex items-baseline justify-between gap-3 px-4 py-2.5 hover:bg-accent-soft focus:bg-accent-soft">' +
            '<span class="min-w-0"><span class="block font-bold text-steel-900 text-sm truncate">' + esc(e.label) + '</span>' +
            '<span class="block text-xs text-steel-600 truncate">' +
            (e.code ? '<code class="font-mono font-bold text-steel-900" dir="ltr">' + esc(e.code) + '</code> · ' : '') +
            esc(e.context) + '</span></span>' +
            '<span class="text-xs font-black rounded px-1.5 py-0.5 shrink-0 ' +
            (e.kind === 'product' ? 'text-white bg-action' : 'text-steel-600 bg-steel-100') + '">' + (KIND_LABEL[e.kind] || '') + '</span>' +
            '</a></li>'
          )
          .join('');
      }
      list.hidden = false;
      input.setAttribute('aria-expanded', 'true');
    };

    const highlight = (next: number) => {
      const opts = list.querySelectorAll<HTMLElement>('[role="option"]');
      if (!opts.length) return;
      if (active >= 0) opts[active]!.setAttribute('aria-selected', 'false');
      active = (next + opts.length) % opts.length;
      const el = opts[active]!;
      el.setAttribute('aria-selected', 'true');
      input.setAttribute('aria-activedescendant', el.id);
      el.scrollIntoView({ block: 'nearest' });
    };

    const update = () => render(suggest(index(), input.value, 7), input.value);
    input.addEventListener('input', () => {
      update();
      // پس از رسیدن محصولات همان پرس‌وجو دوباره امتیاز می‌گیرد — بدون تایپ دوباره.
      loadProducts().then(() => { if (document.activeElement === input && input.value.trim()) update(); });
    });
    // ⚠️ فقط پس از تایپ واقعی: در /search/?q=… کادر autofocus است و مقدار از URL دارد؛ باز کردن فهرست
    // روی focus، پنل «پیدا نشد» صفحه را زیر یک فهرست «پیدا نشد» دوم می‌پوشاند (اسکرین‌شات فاز ۲).
    let typed = false;
    input.addEventListener('input', () => { typed = true; }, { capture: true });
    input.addEventListener('focus', () => { loadProducts(); if (typed && input.value.trim()) update(); });
    input.addEventListener('keydown', (ev) => {
      if (list.hidden) return;
      if (ev.key === 'ArrowDown') { ev.preventDefault(); highlight(active + 1); }
      else if (ev.key === 'ArrowUp') { ev.preventDefault(); highlight(active - 1); }
      else if (ev.key === 'Escape') close();
      else if (ev.key === 'Enter' && active >= 0) {
        // فقط انتخاب عمدی یک پیشنهاد ارسال فرم را کنار می‌گذارد؛ در غیر این صورت جستجوی کامل.
        const link = list.querySelectorAll<HTMLAnchorElement>('[role="option"] a')[active];
        if (link) { ev.preventDefault(); window.location.href = link.getAttribute('href')!; }
      }
    });
    document.addEventListener('click', (ev) => { if (!root.contains(ev.target as Node)) close(); });
  });
</script>


---
// src/components/MetricsStrip.astro
// ---------------------------------------------------------------------------
// نوار سنجه‌های شرکت — «۳۰ سال سابقه»، «٪۹۸ رضایت» و…
//
// چرا این بخش برگشت (و چرا این‌بار درست است):
// در نسخه‌ی قبلی صفحه‌ی اصلی یک «نوار آمار» حذف شد، و آن حذف درست بود —
// چون محتوای خودِ سایت را می‌شمرد («+۸ دسته‌بندی»، «۸ پرسش پاسخ‌داده‌شده»).
// آن اعداد دستاورد نبودند؛ عملاً کوچک‌بودن را تبلیغ می‌کردند.
//
// این نوار متفاوت است: سنجه‌های کسب‌وکار است که خریدار صنعتی واقعاً بر
// اساسشان تامین‌کننده انتخاب می‌کند — سابقه، تطابق فنی، گارانتی، زمان ارسال.
// در فروش B2B صنعتی، ریسکِ «قطعه‌ی اشتباه روی جرثقیلِ در حال کار» بزرگ‌ترین
// مانع خرید است و این چهار عدد دقیقاً به همان ریسک پاسخ می‌دهند.
//
// شفافیت: هر سنجه‌ی تاییدنشده برچسب «جای‌گذار» می‌گیرد و در JSON-LD نمی‌آید.
// کارفرما چیدمان و وزن روانی نهایی را می‌بیند بدون آن‌که سایت ادعای
// اثبات‌نشده‌ای را به‌عنوان واقعیت ماشین‌خوان منتشر کند.
// ---------------------------------------------------------------------------
import { COMPANY_METRICS } from '../data/trust';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
const hasPlaceholder = COMPANY_METRICS.some((m) => !m.verified);
---

<section class={`bg-steel-900 border-y border-white/10 ${className}`} aria-labelledby="metrics-heading">
  <div class="max-w-7xl mx-auto px-4 py-8">
    <h2 id="metrics-heading" class="sr-only">چرا کرین یدک</h2>

    <ul role="list" class="grid grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-7">
      {
        COMPANY_METRICS.map((metric) => (
          <li class="flex items-start gap-3 min-w-0">
            <span class="w-9 h-9 shrink-0 text-accent" aria-hidden="true">
              <svg class="w-full h-full" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d={metric.icon} />
              </svg>
            </span>

            <div class="min-w-0">
              <p class="text-xl md:text-2xl font-black text-white leading-8 tabular-nums">{metric.value}</p>
              <p class="text-xs md:text-sm text-steel-300 leading-6 mt-0.5">{metric.label}</p>
              {!metric.verified && (
                <span class="inline-block mt-1.5 text-[10px] font-bold text-steel-900 bg-amber-400 px-1.5 py-0.5 rounded">
                  جای‌گذار
                </span>
              )}
            </div>
          </li>
        ))
      }
    </ul>

    {
      hasPlaceholder && (
        /* این یادداشت فقط تا زمانی دیده می‌شود که حتی یک سنجه تاییدنشده باشد.
           به‌محض `verified: true` شدن همه، خودکار ناپدید می‌شود — یعنی
           هیچ‌کس لازم نیست یادش بماند آن را پاک کند. */
        <p class="mt-6 pt-4 border-t border-white/10 text-xs text-steel-300 leading-6">
          <strong class="text-amber-400">یادداشت داخلی:</strong> اعداد بالا جای‌گذار هستند تا
          چیدمان نهایی ارزیابی شود. پس از جایگزینی با مقادیر واقعی، در فایل
          <code class="mx-1 bg-white/10 px-1 rounded">src/data/trust.ts</code>
          مقدار <code class="mx-1 bg-white/10 px-1 rounded">verified</code> را
          <code class="mx-1 bg-white/10 px-1 rounded">true</code> کنید تا این یادداشت و
          برچسب‌ها حذف شوند.
        </p>
      )
    }
  </div>
</section>

---
// src/components/MetricsStrip.astro
// ---------------------------------------------------------------------------
// نوار سنجه‌های شرکت — «۳۰ سال سابقه»، «٪۹۸ رضایت» و…
//
// چرا این بخش برگشت (و چرا این‌بار درست است):
// در نسخه‌ی قبلی صفحه‌ی اصلی یک «نوار آمار» حذف شد، و آن حذف درست بود —
// چون محتوای خودِ سایت را می‌شمرد («+۸ دسته‌بندی»، «۸ پرسش پاسخ‌داده‌شده»).
// آن اعداد دستاورد نبودند؛ عملاً کوچک‌بودن را تبلیغ می‌کردند.
//
// این نوار متفاوت است: سنجه‌های کسب‌وکار است که خریدار صنعتی واقعاً بر
// اساسشان تامین‌کننده انتخاب می‌کند — سابقه، تطابق فنی، گارانتی، زمان ارسال.
// در فروش B2B صنعتی، ریسکِ «قطعه‌ی اشتباه روی جرثقیلِ در حال کار» بزرگ‌ترین
// مانع خرید است و این چهار عدد دقیقاً به همان ریسک پاسخ می‌دهند.
//
// شفافیت: هر سنجه‌ی تاییدنشده برچسب «جای‌گذار» می‌گیرد و در JSON-LD نمی‌آید.
// کارفرما چیدمان و وزن روانی نهایی را می‌بیند بدون آن‌که سایت ادعای
// اثبات‌نشده‌ای را به‌عنوان واقعیت ماشین‌خوان منتشر کند.
// ---------------------------------------------------------------------------
import { COMPANY_METRICS } from '../data/trust';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

/* ⚠️ فقط سنجه‌های تاییدشده رندر می‌شوند.
   نسخه‌ی قبل هر چهار سنجه را نشان می‌داد و زیرشان برچسب «جای‌گذار»
   می‌گذاشت. اما «۳۰ سال سابقه»، «٪۹۸ رضایت» و «ارسال ۴۸ ساعته» عددهایی
   بودند که من ساخته بودم — نه کارفرما داده بود، نه از جایی اندازه‌گیری
   شده بود. برچسبِ «جای‌گذار» آن‌ها را از حالت ادعای نادرست خارج نمی‌کند؛
   بازدیدکننده عدد را می‌بیند و باور می‌کند، و رقیب یا مشتری می‌تواند
   همان عدد را به چالش بکشد.
   قاعده‌ی ساده: عددی که پشتوانه ندارد، روی سایت نمی‌آید.
   وقتی کارفرما عدد واقعی داد، در src/data/trust.ts مقدار را عوض کنید و
   verified: true بگذارید — همان لحظه اینجا ظاهر می‌شود. */
const metrics = COMPANY_METRICS.filter((m) => m.verified);
---

{ metrics.length > 0 && (
<section class={`relative bg-steel-950 ${className}`} aria-labelledby="metrics-heading">
  {/* شبکه‌ی ظریف پس‌زمینه — زبان بصری داشبورد صنعتی/کنترل‌روم.
      یک گرادیان تکرارشونده، بدون تصویر و بدون هزینه‌ی شبکه. */}
  <div
    class="absolute inset-0 opacity-[0.5] pointer-events-none"
    aria-hidden="true"
    style="background-image: linear-gradient(rgba(255,255,255,.028) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.028) 1px, transparent 1px); background-size: 46px 46px;"
  >
  </div>

  <div class="relative max-w-7xl mx-auto px-4 py-9">
    <h2 id="metrics-heading" class="sr-only">چرا کرین یدک</h2>

    {/* کارت‌های داشبورد: هر سنجه یک «پنل» با نوار وضعیت رنگی بالای آن.
        قبلاً چهار آیکون و متن روی پس‌زمینه‌ی تخت بود که از یک فوتر معمولی
        قابل تشخیص نبود. */}
    <ul role="list" class="grid grid-cols-2 lg:grid-cols-4 gap-3 md:gap-4">
      {
        metrics.map((metric) => (
          <li class="group relative bg-steel-900/80 border border-white/10 rounded-lg overflow-hidden hover:border-accent/50 transition-colors">
            <span class="block h-1 bg-accent" aria-hidden="true" />

            <div class="p-4 md:p-5">
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="w-9 h-9 shrink-0 rounded-md bg-accent/10 border border-accent/25 text-accent flex items-center justify-center" aria-hidden="true">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d={metric.icon} />
                  </svg>
                </span>

                {!metric.verified && (
                  <span class="text-[10px] font-black text-amber-400 border border-amber-400/40 bg-amber-400/10 px-1.5 py-0.5 rounded">
                    جای‌گذار
                  </span>
                )}
              </div>

              <p class="text-2xl md:text-3xl font-black text-white leading-9 tabular-nums tracking-tight">
                {metric.value}
              </p>
              <p class="text-xs md:text-[13px] text-steel-300 leading-6 mt-1">{metric.label}</p>
            </div>
          </li>
        ))
      }
    </ul>

  </div>
</section>
) }

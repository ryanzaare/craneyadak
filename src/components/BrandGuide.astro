---
// src/components/BrandGuide.astro
// ---------------------------------------------------------------------------
// «هاب برند» — لایه‌ی تحریریه‌ی صفحه‌ی برند.
//
// ═══════════════════════════════════════════════════════════════════════════
// استراتژی محتوایی که این ساختار از آن می‌آید
// ═══════════════════════════════════════════════════════════════════════════
// تاریخچه‌ی شرکت، محتوای «کالایی» است: سایت خود سازنده و ویکی‌پدیا همیشه
// برایش بالاتر از ما رتبه می‌گیرند و نیت جستجوی «قطعات دماگ» هم اصلاً
// تاریخی نیست — تراکنشی است.
//
// پس وزن صفحه روی چیزی گذاشته شده که *فقط یک تأمین‌کننده‌ی ایرانی*
// می‌تواند بنویسد:
//
//   ۱) جدول سری‌ها با ستون «رایج در ایران»
//   ۲) راهنمای خواندن پلاک و کد فنی  ← بالاترین ارزش عملی
//   ۳) قطعات پرتقاضا، با لینک واقعی به سیلوی دسته‌ها
//
// این سه، هم تفکیک‌پذیرند و هم دقیقاً همان چیزی که خریدار دنبالش است.
//
// ═══════════════════════════════════════════════════════════════════════════
// چرا هیچ کتابخانه‌ی نمودار یا iframe ویدیو اینجا نیست
// ═══════════════════════════════════════════════════════════════════════════
// یک iframe یوتیوب/آپارات معمولاً بیش از ۵۰۰ کیلوبایت و چند درخواست
// مسدودکننده‌ی رندر است؛ کتابخانه‌ی نمودار سه‌بعدی بین ۵۰۰ کیلوبایت تا
// ۱ مگابایت جاوااسکریپت. گوگل برای «داشتن نمودار» رتبه نمی‌دهد، ولی
// Core Web Vitals را *اندازه می‌گیرد* — یعنی این دو، سئو را پایین
// می‌آورند نه بالا.
//
// جایگزین‌ها: جدول‌های معنایی (که برای موتور جستجو خواناترند)، و ویدیو با
// الگوی facade — فقط تصویر پوستر، و پخش‌کننده تنها پس از کلیک کاربر.
// ---------------------------------------------------------------------------

import SectionNav from './SectionNav.astro';
import { autolinkHtml } from '../lib/autolink';
import { getImage } from 'astro:assets';
import { wrapProseTables, normalizeProseImages, optimizeProseImages, mergeAudit, reportImageAudit, EMPTY_AUDIT } from '../lib/prose-html';
import { findCategory, categoryPath } from '../data/taxonomy';
import type { BrandProfile } from '../lib/brand-profile';

export interface Props {
  profile: BrandProfile;
  brandName: string;
  reviewMode: boolean;
}

const { profile, brandName, reviewMode } = Astro.props;

// جدول‌ها و تصاویر داخل متن از یک ماژول مشترک عبور می‌کنند — پیش‌تر
// `wrapProseTables` در این فایل و در CategoryGuide کپی شده بود و دو نسخه
// از هم واگرا شده بودند.
let imgAudit = EMPTY_AUDIT;
const link = async (html: string | null) => {
  if (!html) return '';
  const linked = wrapProseTables(autolinkHtml(html, { currentPath: Astro.url.pathname }));
  // ترتیب مهم است: بهینه‌سازی، width/height واقعی را اضافه می‌کند؛
  // بعد نرمال‌سازی lazy/decoding می‌گذارد و آنچه واقعاً ابعاد ندارد را می‌شمارد.
  const { html: optimised } = await optimizeProseImages(linked, getImage);
  const { html: out, audit } = normalizeProseImages(optimised);
  imgAudit = mergeAudit(imgAudit, audit);
  return out;
};

/* رسانه اول می‌آید — تصمیم تجاری: بازدیدکننده باید ویدیو را اول ببیند.
   دو پیامد فنی که با همین تغییر مدیریت شده‌اند:

   ۱) LCP. تا پیش از این، بزرگ‌ترین عنصرِ قابل رنگ‌آمیزی، متنِ هیرو بود که
      عملاً آنی رندر می‌شود. حالا یک تصویر بالای صفحه می‌آید و به احتمال
      زیاد خودش LCP می‌شود. پس تصویر *اول* دیگر lazy نیست: با
      fetchpriority='high' زودتر از بقیه دانلود می‌شود. اگر lazy می‌ماند،
      مرورگر عمداً عقب می‌انداختش و LCP بدتر از قبل می‌شد.

   ۲) شماره‌گذاری. «معرفی» و «رسانه» هر دو مقدمه‌اند، نه گامِ شماره‌دار.
      اگر رسانه شماره می‌گرفت، «معرفی» بدون شماره وسط دو بخش شماره‌دار
      می‌افتاد و ترتیب بی‌معنا می‌شد. */
const sections = [
  { id: 'brand-media', label: 'تصاویر و ویدیو', show: profile.media.length > 0 },
  { id: 'brand-intro', label: 'معرفی', show: Boolean(profile.introHtml) },
  { id: 'brand-series', label: 'سری‌های محصول', show: profile.series.length > 0 },
  { id: 'brand-nameplate', label: 'خواندن پلاک', show: Boolean(profile.identificationHtml) },
  { id: 'brand-iran', label: 'در بازار ایران', show: Boolean(profile.iranPresenceHtml) },
  { id: 'brand-parts', label: 'قطعات پرتقاضا', show: profile.commonParts.length > 0 },
  { id: 'brand-tech', label: 'فناوری‌ها', show: profile.technologies.length > 0 },
  { id: 'brand-faq', label: 'پرسش‌های متداول', show: profile.faqs.length > 0 },
].filter((s) => s.show);

const LEAD_IN = new Set(['brand-intro', 'brand-media']);
const numbered = sections.filter((s) => !LEAD_IN.has(s.id));
const numberOf = (id: string) => numbered.findIndex((s) => s.id === id) + 1;

/** نشانِ «نیاز به بازبینی» فقط در حالت بازبینی دیده می‌شود. */
const flag = (needs: boolean) => (reviewMode && needs ? 'bg-amber-50 ring-1 ring-amber-300' : '');

/* ═══════════════════════════════════════════════════════════════════════════
   وضعیت تأمین — تنها جایی که رنگ در این صفحه معنا دارد
   ═══════════════════════════════════════════════════════════════════════════
   صفحه قبلاً سراسر خاکستری بود، ولی مشکل «کمبود رنگ» نبود؛ مشکل این بود که
   هیچ واقعیتی *کدگذاری بصری* نشده بود. «هنوز در تولید است» و «۲۰ سال است
   توقف تولید شده» با یک وزن و یک رنگ چاپ می‌شدند، داخل سلولی که ۱۳۶ تا ۳۳۰
   کاراکتر متن داشت.

   رنگ اینجا تزئین نیست؛ جواب همان سؤالی است که خریدار با آن وارد صفحه شده:
   «برای دستگاه من هنوز قطعه پیدا می‌شود؟»

   سه دلیل که این کار سئو یا سرعت را خراب نمی‌کند:
     • هیچ جاوااسکریپت و هیچ تصویری اضافه نمی‌شود.
     • متن کامل سر جایش می‌ماند و ایندکس می‌شود — نشان *جایگزینش* نمی‌شود،
       خلاصه‌اش می‌کند.
     • رنگ تنها حاملِ معنا نیست: متن فارسی کنارش هست (WCAG 1.4.1)، پس
       کوررنگی یا چاپ سیاه‌وسفید چیزی را از بین نمی‌برد.
   ═══════════════════════════════════════════════════════════════════════════ */
const SUPPLY = {
  current:    { label: 'در تولید',        cls: 'bg-emerald-50 text-emerald-900 ring-emerald-200/70', dot: 'bg-emerald-500' },
  supported:  { label: 'قطعه موجود',      cls: 'bg-sky-50 text-sky-900 ring-sky-200/70',             dot: 'bg-sky-500' },
  equivalent: { label: 'معادل‌یابی',       cls: 'bg-amber-50 text-amber-900 ring-amber-200/70',       dot: 'bg-amber-500' },
} as const;

/* ⚠️ ستونی که در *همه‌ی* ردیف‌ها خالی است، نباید رندر شود.
   ستون «رایج در ایران» برای هر ۶ سری دماگ خالی بود و یک ستون تمام‌قد «—»
   می‌ساخت: هم فضا را می‌گرفت، هم به بازدیدکننده حس خرابی می‌داد، هم هیچ
   اطلاعاتی نمی‌داد. این بررسی عمومی است، پس برای ۱۸ برند بعدی هم — که هنوز
   داده‌شان وارد نشده — خودبه‌خود درست عمل می‌کند. */
const showIran   = profile.series.some((s) => s.commonInIran);
const showSupply = profile.series.some((s) => s.supplyStatus !== null);
const showCap    = profile.series.some((s) => s.capacityNote.trim() !== '');
const showType   = profile.series.some((s) => s.equipmentType.trim() !== '');
const showNotes  = profile.series.some((s) => s.notes.trim() !== '');

const supplyCounts = {
  current: profile.series.filter((s) => s.supplyStatus === 'current').length,
  supported: profile.series.filter((s) => s.supplyStatus === 'supported').length,
  equivalent: profile.series.filter((s) => s.supplyStatus === 'equivalent').length,
};

// ⚠️ متن‌ها *اینجا* آماده می‌شوند، نه داخل قالب. اگر `link()` وسط رندر صدا
// زده شود، شمارشِ تصاویر بعد از چاپ شدن صفحه کامل می‌شود و دیگر جایی برای
// گزارش دادنش نیست — هشدار CLS هرگز به لاگ build نمی‌رسید.
const introHtml = await link(profile.introHtml);
const identificationHtml = await link(profile.identificationHtml);
const iranPresenceHtml = await link(profile.iranPresenceHtml);
reportImageAudit(imgAudit, `صفحه‌ی برند ${brandName}`);
---

{profile.hasContent && (
  <>
    {reviewMode && profile.pendingReview > 0 && (
      <div class="bg-amber-100 border-y-2 border-amber-400 px-4 py-3 print:hidden">
        <p class="max-w-7xl mx-auto text-sm font-bold text-amber-900">
          حالت بازبینی — {profile.pendingReview} ردیف نیاز به تایید دارد.
        </p>
      </div>
    )}

    <SectionNav sections={sections} eyebrow="پروفایل برند" ariaLabel={`بخش‌های صفحه‌ی ${brandName}`} />

    <div class="bg-white">
      {/* ---- رسانه‌ها — اولین چیزی که بازدیدکننده می‌بیند ---- */}
      {profile.media.length > 0 && (
        <section id="brand-media" class="px-4 pt-12 pb-12 scroll-mt-32" aria-labelledby="brand-media-heading">
          <div class="max-w-7xl mx-auto">
            <h2 id="brand-media-heading" class="text-2xl md:text-3xl font-black text-crane-navy leading-relaxed mb-8">
              {brandName} در یک نگاه
            </h2>

            <div class={`grid gap-6 ${profile.media.length > 1 ? 'sm:grid-cols-2 lg:grid-cols-3' : 'max-w-3xl'}`}>
              {profile.media.map((m, i) => (
                <figure class="rounded-2xl overflow-hidden border border-gray-200 bg-white">
                  {m.kind === 'video' && m.videoUrl ? (
                    /* ⚠️ الگوی facade: هیچ iframeای تا کلیک کاربر ساخته نمی‌شود.
                       جاسازی مستقیم، بیش از ۵۰۰ کیلوبایت و چند درخواست
                       مسدودکننده به هر بازدید اضافه می‌کند — یعنی LCP بدتر و
                       سئوی پایین‌تر، نه بالاتر. */
                    <a
                      href={m.videoUrl}
                      target="_blank"
                      rel="noopener"
                      class="group block relative aspect-video bg-crane-navy"
                      aria-label={`پخش ویدیو: ${m.alt || m.caption || 'ویدیو'}`}
                    >
                      {m.url && (
                        <img
                          src={m.url}
                          alt={m.alt}
                          width={m.width ?? undefined}
                          height={m.height ?? undefined}
                          loading={i === 0 ? 'eager' : 'lazy'}
                          fetchpriority={i === 0 ? 'high' : undefined}
                          decoding="async"
                          class="w-full h-full object-cover opacity-80 group-hover:opacity-100 transition-opacity"
                        />
                      )}
                      <span class="absolute inset-0 grid place-items-center" aria-hidden="true">
                        <span class="w-16 h-16 rounded-full bg-white/95 grid place-items-center shadow-lg group-hover:scale-110 transition-transform">
                          <svg viewBox="0 0 24 24" class="w-7 h-7 translate-x-0.5" fill="currentColor" aria-hidden="true">
                            <path d="M8 5v14l11-7z" />
                          </svg>
                        </span>
                      </span>
                    </a>
                  ) : (
                    m.url && (
                      <img
                        src={m.url}
                        alt={m.alt}
                        width={m.width ?? undefined}
                        height={m.height ?? undefined}
                        loading="lazy"
                        decoding="async"
                        class="w-full h-auto"
                      />
                    )
                  )}
                  {m.caption && (
                    <figcaption class="px-4 py-3 text-sm text-steel-600 border-t border-gray-100">{m.caption}</figcaption>
                  )}
                </figure>
              ))}
            </div>
          </div>
        </section>
      )}

      {/* ------------------------------ معرفی ------------------------------ */}
      {profile.introHtml && (
        <section id="brand-intro" class="px-4 pt-16 pb-12 scroll-mt-32" aria-labelledby="brand-intro-heading">
          <div class="max-w-7xl mx-auto">
            <p class="text-sm font-black text-crane-orange tracking-widest mb-3">پروفایل فنی</p>
            <h2 id="brand-intro-heading" class="text-3xl md:text-4xl font-black text-crane-navy leading-relaxed mb-6 max-w-3xl">
              {brandName} چه می‌سازد؟
            </h2>

            {(profile.foundedYear || profile.headquarters) && (
              <dl class="flex flex-wrap gap-x-8 gap-y-3 mb-8 text-sm">
                {profile.foundedYear && (
                  <div class="flex gap-2">
                    <dt class="font-black text-steel-500">سال تأسیس:</dt>
                    <dd class="font-bold text-crane-navy tabular-nums">{profile.foundedYear}</dd>
                  </div>
                )}
                {profile.headquarters && (
                  <div class="flex gap-2">
                    <dt class="font-black text-steel-500">دفتر مرکزی:</dt>
                    <dd class="font-bold text-crane-navy">{profile.headquarters}</dd>
                  </div>
                )}
              </dl>
            )}

            <div class="prose-crane max-w-[70ch] text-lg text-steel-700 leading-9" set:html={introHtml} />
          </div>
        </section>
      )}

      {/* --------------------------- سری‌های محصول --------------------------- */}
      {profile.series.length > 0 && (
        <section id="brand-series" class="px-4 py-16 border-t border-gray-100 bg-gray-50 scroll-mt-32" aria-labelledby="brand-series-heading">
          <div class="max-w-7xl mx-auto">
            <div class="flex items-start gap-4 mb-8">
              <span class="shrink-0 w-11 h-11 rounded-2xl bg-crane-navy text-white flex items-center justify-center font-black text-lg tabular-nums" aria-hidden="true">{numberOf('brand-series')}</span>
              <div>
                <h2 id="brand-series-heading" class="text-2xl md:text-3xl font-black text-crane-navy leading-relaxed">
                  سری‌های {brandName} و وضعیت تأمین قطعه
                </h2>
                <p class="text-steel-600 mt-1">ستون «رایج در ایران» بر اساس تجربه‌ی میدانی تیم فنی است.</p>
              </div>
            </div>

            {showSupply && (
              <ul class="flex flex-wrap gap-2 mb-5 text-xs font-bold" role="list">
                <li class="px-3 py-1.5 rounded-lg bg-gray-100 text-steel-700 tabular-nums">{profile.series.length} سری</li>
                {(['current', 'supported', 'equivalent'] as const).map((k) => supplyCounts[k] > 0 && (
                  <li class={`inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg ring-1 ${SUPPLY[k].cls}`}>
                    <span class={`w-1.5 h-1.5 rounded-full ${SUPPLY[k].dot}`} aria-hidden="true"></span>
                    <span class="tabular-nums">{supplyCounts[k]}</span> {SUPPLY[k].label}
                  </li>
                ))}
              </ul>
            )}

            <div class="table-scroll bg-white rounded-2xl border border-gray-200">
              <table class="w-full text-sm">
                <thead>
                  <tr class="bg-gray-50 border-b border-gray-200">
                    <th scope="col" class="text-right font-black text-crane-navy px-5 py-3">سری</th>
                    {showType && <th scope="col" class="text-right font-black text-crane-navy px-5 py-3">نوع تجهیز</th>}
                    {showCap && <th scope="col" class="text-right font-black text-crane-navy px-5 py-3 whitespace-nowrap">ظرفیت</th>}
                    {showSupply && <th scope="col" class="text-right font-black text-crane-navy px-5 py-3 whitespace-nowrap">وضعیت تأمین</th>}
                    {showIran && <th scope="col" class="text-right font-black text-crane-navy px-5 py-3 whitespace-nowrap">رایج در ایران</th>}
                    {showNotes && <th scope="col" class="text-right font-black text-crane-navy px-5 py-3">توضیح</th>}
                  </tr>
                </thead>
                <tbody>
                  {profile.series.map((s, i) => (
                    <tr class={`border-b border-gray-100 last:border-0 transition-colors hover:bg-orange-50/40 ${i % 2 ? 'bg-gray-50/50' : ''} ${flag(s.needsReview)}`}>
                      {/* نامِ سری لنگرِ اسکن است — پس تنها ستونی است که وزن کامل می‌گیرد. */}
                      <th scope="row" class="text-right px-5 py-4 font-black text-crane-navy whitespace-nowrap align-top border-r-2 border-crane-orange/30">
                        {s.seriesName}
                      </th>
                      {showType && <td class="px-5 py-4 text-steel-700 align-top">{s.equipmentType || '—'}</td>}
                      {showCap && <td class="px-5 py-4 text-steel-700 tabular-nums align-top whitespace-nowrap">{s.capacityNote || '—'}</td>}
                      {showSupply && (
                        <td class="px-5 py-4 align-top">
                          {s.supplyStatus ? (
                            <span class={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full ring-1 font-bold text-xs whitespace-nowrap ${SUPPLY[s.supplyStatus].cls}`}>
                              <span class={`w-1.5 h-1.5 rounded-full ${SUPPLY[s.supplyStatus].dot}`} aria-hidden="true"></span>
                              {SUPPLY[s.supplyStatus].label}
                            </span>
                          ) : (
                            <span class="text-steel-400">—</span>
                          )}
                        </td>
                      )}
                      {showIran && (
                        <td class="px-5 py-4 align-top">
                          {s.commonInIran
                            ? <span class="inline-flex items-center px-2.5 py-1 rounded-full bg-crane-navy text-white font-bold text-xs">بله</span>
                            : <span class="text-steel-400">—</span>}
                        </td>
                      )}
                      {/* متن کامل حذف نمی‌شود — فقط از «تیترِ» سلول به «زیرنویس»
                          تنزل می‌کند. گوگل همان متن را می‌خواند؛ انسان دیگر
                          مجبور نیست برای یک بیت اطلاعات، سه خط بخواند. */}
                      {showNotes && <td class="px-5 py-4 text-steel-600 leading-7 align-top max-w-md">{s.notes || '—'}</td>}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </section>
      )}

      {/* --------------------------- خواندن پلاک --------------------------- */}
      {profile.identificationHtml && (
        <section id="brand-nameplate" class="px-4 py-16 border-t border-gray-100 scroll-mt-32" aria-labelledby="brand-nameplate-heading">
          <div class="max-w-7xl mx-auto">
            <div class="flex items-start gap-4 mb-8">
              <span class="shrink-0 w-11 h-11 rounded-2xl bg-crane-navy text-white flex items-center justify-center font-black text-lg tabular-nums" aria-hidden="true">{numberOf('brand-nameplate')}</span>
              <div>
                <h2 id="brand-nameplate-heading" class="text-2xl md:text-3xl font-black text-crane-navy leading-relaxed">
                  پلاک {brandName} را چطور بخوانیم؟
                </h2>
                <p class="text-steel-600 mt-1">بدون کد درست، هیچ استعلامی دقیق نیست.</p>
              </div>
            </div>
            <div class="prose-crane max-w-[70ch] text-lg text-steel-700 leading-9" set:html={identificationHtml} />
          </div>
        </section>
      )}

      {/* --------------------------- بازار ایران --------------------------- */}
      {profile.iranPresenceHtml && (
        <section id="brand-iran" class="px-4 py-16 border-t border-gray-100 bg-gray-50 scroll-mt-32" aria-labelledby="brand-iran-heading">
          <div class="max-w-7xl mx-auto">
            <div class="flex items-start gap-4 mb-8">
              <span class="shrink-0 w-11 h-11 rounded-2xl bg-crane-navy text-white flex items-center justify-center font-black text-lg tabular-nums" aria-hidden="true">{numberOf('brand-iran')}</span>
              <h2 id="brand-iran-heading" class="text-2xl md:text-3xl font-black text-crane-navy leading-relaxed">
                {brandName} در صنعت ایران
              </h2>
            </div>
            <div class="prose-crane max-w-[70ch] text-lg text-steel-700 leading-9" set:html={iranPresenceHtml} />
          </div>
        </section>
      )}

      {/* ------------------------- قطعات پرتقاضا ------------------------- */}
      {profile.commonParts.length > 0 && (
        <section id="brand-parts" class="px-4 py-16 border-t border-gray-100 scroll-mt-32" aria-labelledby="brand-parts-heading">
          <div class="max-w-7xl mx-auto">
            <div class="flex items-start gap-4 mb-8">
              <span class="shrink-0 w-11 h-11 rounded-2xl bg-crane-navy text-white flex items-center justify-center font-black text-lg tabular-nums" aria-hidden="true">{numberOf('brand-parts')}</span>
              <h2 id="brand-parts-heading" class="text-2xl md:text-3xl font-black text-crane-navy leading-relaxed">
                پرتقاضاترین قطعات {brandName}
              </h2>
            </div>

            <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" role="list">
              {profile.commonParts.map((p) => (
                <li class={`rounded-2xl border border-gray-200 p-5 hover:border-crane-orange transition-colors ${flag(p.needsReview)}`}>
                  <h3 class="font-black text-crane-navy mb-2">{p.partName}</h3>
                  {p.failureReason && <p class="text-sm text-steel-600 leading-7 mb-3">{p.failureReason}</p>}
                  {/* لینک واقعی به سیلوی دسته — انتقال ارزش پیوندی برند ← دسته. */}
                  {(() => {
                    // مسیر واقعی دسته، نه جستجو: لینک به /categories/[silo]/[cat]
                    // ارزش پیوندی را به سیلو منتقل می‌کند؛ لینک به صفحه‌ی
                    // جستجو هیچ ارزشی منتقل نمی‌کند و معمولاً noindex است.
                    const cat = p.categorySlug ? findCategory(p.categorySlug) : undefined;
                    if (!cat) return null;
                    return (
                      <a href={categoryPath(cat)} class="text-sm font-black text-crane-orange hover:underline">
                        دیدن {p.categoryName ?? cat.name} ←
                      </a>
                    );
                  })()}
                </li>
              ))}
            </ul>
          </div>
        </section>
      )}

      {/* ---------------------------- فناوری‌ها ---------------------------- */}
      {profile.technologies.length > 0 && (
        <section id="brand-tech" class="px-4 py-16 border-t border-gray-100 bg-gray-50 scroll-mt-32" aria-labelledby="brand-tech-heading">
          <div class="max-w-7xl mx-auto">
            <div class="flex items-start gap-4 mb-8">
              <span class="shrink-0 w-11 h-11 rounded-2xl bg-crane-navy text-white flex items-center justify-center font-black text-lg tabular-nums" aria-hidden="true">{numberOf('brand-tech')}</span>
              <h2 id="brand-tech-heading" class="text-2xl md:text-3xl font-black text-crane-navy leading-relaxed">
                فناوری‌های شاخص {brandName}
              </h2>
            </div>

            {/* ⚠️ `md:grid-cols-2` با یک آیتم، نیمی از ردیف را خالی می‌گذارد و
                کارت را بی‌دلیل باریک می‌کند — دقیقاً چیزی که در صفحه‌ی دماگ
                دیده می‌شد. تعداد ستون از تعداد داده می‌آید، نه برعکس. */}
            <div class={`grid gap-5 ${profile.technologies.length > 1 ? 'md:grid-cols-2 max-w-5xl' : 'max-w-3xl'}`}>
              {profile.technologies.map((t) => (
                <article class={`rounded-2xl bg-white border border-gray-200 border-r-4 border-r-crane-orange/50 p-6 ${flag(t.needsReview)}`}>
                  <h3 class="font-black text-crane-navy text-lg mb-2">{t.name}</h3>
                  {t.summary && <p class="text-steel-700 leading-8 mb-3">{t.summary}</p>}
                  {t.whyItMatters && (
                    <p class="text-sm text-steel-600 leading-7 border-t border-gray-100 pt-3">
                      <strong class="text-crane-navy">برای خریدار قطعه:</strong> {t.whyItMatters}
                    </p>
                  )}
                </article>
              ))}
            </div>
          </div>
        </section>
      )}

      {/* ------------------------ پرسش‌های متداول ------------------------ */}
      {profile.faqs.length > 0 && (
        <section id="brand-faq" class="px-4 py-16 border-t border-gray-100 bg-gray-50 scroll-mt-32" aria-labelledby="brand-faq-heading">
          <div class="max-w-7xl mx-auto">
            <div class="flex items-start gap-4 mb-8">
              <span class="shrink-0 w-11 h-11 rounded-2xl bg-crane-navy text-white flex items-center justify-center font-black text-lg tabular-nums" aria-hidden="true">{numberOf('brand-faq')}</span>
              <h2 id="brand-faq-heading" class="text-2xl md:text-3xl font-black text-crane-navy leading-relaxed">
                پرسش‌های متداول درباره‌ی {brandName}
              </h2>
            </div>

            {/* <details> بومی: بدون هیچ جاوااسکریپتی باز و بسته می‌شود، و
                محتوایش برای گوگل همیشه قابل خواندن است. */}
            <div class="max-w-3xl space-y-3">
              {profile.faqs.map((f) => (
                <details class={`group rounded-2xl bg-white border border-gray-200 border-r-4 border-r-transparent open:border-r-crane-orange/60 overflow-hidden transition-colors ${flag(f.needsReview)}`}>
                  <summary class="cursor-pointer list-none px-6 py-4 font-black text-crane-navy flex items-center justify-between gap-4 hover:bg-orange-50/50 transition-colors">
                    <span>{f.question}</span>
                    <span class="shrink-0 w-6 h-6 grid place-items-center rounded-full bg-orange-50 text-crane-orange text-lg leading-none transition-transform group-open:rotate-45" aria-hidden="true">+</span>
                  </summary>
                  <div class="px-6 pb-5 text-steel-700 leading-8 whitespace-pre-line">{f.answer}</div>
                </details>
              ))}
            </div>
          </div>
        </section>
      )}

      {/* ------------------------------ منابع ------------------------------ */}
      {profile.sources.length > 0 && (
        <section class="px-4 py-10 border-t border-gray-100" aria-labelledby="brand-sources-heading">
          <div class="max-w-7xl mx-auto">
            <h2 id="brand-sources-heading" class="text-lg font-black text-crane-navy mb-3">منابع</h2>
            <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm" role="list">
              {profile.sources.map((s) => (
                <li>
                  {/* rel=nofollow عمدی نیست — لینک به منبع معتبر، سیگنال
                      E-E-A-T مثبت است. ولی noopener برای امنیت لازم است. */}
                  <a href={s.url} target="_blank" rel="noopener" class="text-steel-600 hover:text-crane-orange underline underline-offset-4">
                    {s.title || s.url}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )}
    </div>
  </>
)}

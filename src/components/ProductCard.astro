---
// src/components/ProductCard.astro
// ---------------------------------------------------------------------------
// کارت محصول — تنها کارت محصول در کل سایت.
//
// چرا یکی: این کارت در صفحه‌ی دسته، سیلو، برند، جستجو و صفحه‌ی اصلی استفاده
// می‌شود. اگر هرکدام کارت خودش را داشته باشد، قانون «قیمت خط‌خورده فقط با
// قیمت قبلیِ واقعی» باید در پنج جا تکرار شود و روزی یکی از آن‌ها فراموش
// می‌شود. یک کارت = یک نقطه‌ی حقیقت.
// ---------------------------------------------------------------------------
import PriceTag from './PriceTag.astro';
import RemoteImage from './RemoteImage.astro';
import AuthenticityBadge from './AuthenticityBadge.astro';
import StockPill from './StockPill.astro';
import { whatsappInquiryHref } from './inquiry-message';
import { computePrice, productPath, type CraneProduct } from '../lib/wp';
import { getContact } from '../lib/site-options';
import { SITE } from '../data/site';

export interface Props {
  product: CraneProduct;
  /** بارگذاری مشتاقانه‌ی تصویر برای کارت‌های بالای صفحه (LCP). */
  eager?: boolean;
  /** نمایش نام برند روی تصویر — در صفحه‌ی برند زائد است. */
  showBrand?: boolean;
}

const { product, eager = false, showBrand = true } = Astro.props;

const price = computePrice(product);
const image = product.images[0] ?? null;
const href = productPath(product);
const keySpec = product.technicalSpecs[0] ?? null;
const contact = await getContact();
// عمل‌ها همان قاعده‌ی ProductRow (تصمیم ۴ برای کارت/ردیف): پرداخت‌پذیر «+ سبد»؛ استعلامی «واتساپ» + «+ استعلام».
const inquiryHref = price.payable ? null : whatsappInquiryHref(contact.whatsappHref, { name: product.name, sku: product.sku, url: `${SITE.url}${href}` });
const basket = { 'data-basket-name': product.name, 'data-basket-sku': product.sku ?? '' };
const btn = 'relative z-10 inline-flex items-center justify-center min-h-11 px-3 rounded-md text-sm font-bold whitespace-nowrap';
---

{/* Frontend v2 فاز ۵ (کارفرما، ۳ آبان ۱۴۰۵ — کارت نمای پیش‌فرض شد):
    • قاب تصویر «کاغذ نقشه» (bg-steel-50 + شبکه‌ی نقطه‌ای) + object-contain p-4 — عکس قطعه بریده نمی‌شود (کانکتور، شیار) و
      جایگزینِ بی‌عکس هم شکل کاتالوگ فنی دارد. ⚠️ بی backdrop-blur و بی scale روی عکس (قفل سرعت).
    • هاور لمسی: بالا رفتن ۲px + قاب action + سایه‌ی نرم — فقط transform/box-shadow (بی‌پرش چیدمان؛ کاهش حرکت سراسری خاموشش می‌کند).
    • پیوند کل کارت با ::before روی عنوان؛ دکمه‌های عمل relative z-10 روی آن. data-*های سبد = قرارداد §7. */}
<article class="h-full bg-white rounded-md border border-steel-300 overflow-hidden flex flex-col relative transition-all duration-150 hover:-translate-y-0.5 hover:border-action hover:shadow-[0_6px_16px_rgba(15,23,42,0.08)]">
  <div class="aspect-square bg-steel-50 bg-blueprint relative flex items-center justify-center overflow-hidden border-b border-steel-200">
    {image ? (
      <RemoteImage src={image.url} alt={image.altText || product.name} width={600} height={600} eager={eager}
        sizes="(max-width: 640px) 100vw, (max-width: 1280px) 50vw, 33vw" class="w-full h-full object-contain p-4" />
    ) : (
      <svg class="w-1/3 h-1/3 text-steel-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.75" role="img" aria-label={`${product.name} — تصویر به‌زودی`}><path d="M5 5h14v14H5zM5 12h14M12 5v14M9 9h6v6H9z" /></svg>
    )}

    {product.isDemo && (
      <span class="absolute top-3 left-3 z-10 bg-amber-400 text-amber-950 text-xs font-black px-2 py-1 rounded">نمونه‌ی نمایشی</span>
    )}
    {!product.isDemo && price.onSale && price.discountPercent !== null && (
      <span class="absolute top-3 left-3 bg-rose-700 text-white text-xs font-black px-2 py-1 rounded tabular-nums">٪{price.discountPercent} تخفیف</span>
    )}
    {showBrand && product.brandNameFa && (
      <span class="absolute top-3 right-3 bg-white border border-steel-200 text-xs font-bold px-2 py-1 rounded text-steel-700">{product.brandNameFa}</span>
    )}
  </div>

  <div class="p-4 flex flex-col grow gap-2">
    <div class="flex items-center justify-between gap-2">
      {product.sku ? <p class="text-sm font-bold text-steel-900 font-mono truncate" dir="ltr">{product.sku}</p> : <span />}
      <AuthenticityBadge authenticity={product.authenticity} />
    </div>

    <h3 class="font-bold text-steel-900 leading-7 line-clamp-2">
      <a href={href} class="hover:text-accent-ink before:absolute before:inset-0 rounded">{product.name}</a>
    </h3>

    {/* کد معادل OEM مهم‌ترین سیگنال تطابق است (خریدار کد سازنده‌ی اصلی را در دست دارد)؛ نبود → مشخصه‌ی کلیدی. */}
    {product.oemCrossReference.length > 0 ? (
      <p class="text-xs text-steel-600 leading-6 line-clamp-1">
        <span class="font-bold">معادل:</span> <span dir="ltr" class="font-mono">{product.oemCrossReference.map((r) => r.oemPartNumber).join(' · ')}</span>
      </p>
    ) : keySpec && (
      <p class="text-xs text-steel-600 leading-6 line-clamp-1"><span class="font-bold">{keySpec.label}:</span> <span dir="auto">{keySpec.value}</span></p>
    )}

    <div class="mt-auto pt-3 border-t border-steel-200 flex flex-wrap items-end justify-between gap-2">
      <div class="min-w-0 space-y-1">
        <StockPill status={product.stockStatus} />
        <PriceTag price={price} />
      </div>
      <div class="flex items-center gap-1">
        {price.payable ? (
          <button type="button" class={`${btn} bg-action text-white hover:bg-accent-strong`}
            data-cart-add={product.slug} {...basket} data-guard-until={price.validUntil} data-payable-only aria-label={`افزودن ${product.name} به سبد خرید`}>
            <span data-basket-label>+ سبد</span>
          </button>
        ) : (
          <>
            {inquiryHref && (
              <a href={inquiryHref} target="_blank" rel="noopener noreferrer" class={`${btn} bg-action text-white hover:bg-accent-strong`} aria-label={`استعلام قیمت ${product.name} در واتساپ`}>واتساپ</a>
            )}
            <button type="button" class={`${btn} ${inquiryHref ? 'text-accent-ink hover:text-accent-strong hover:underline' : 'bg-action text-white hover:bg-accent-strong'}`}
              data-quote-add={product.slug} data-quote-mode="rfq" {...basket} aria-label={`افزودن ${product.name} به سبد استعلام`}>
              <span data-basket-label>+ استعلام</span>
            </button>
          </>
        )}
      </div>
    </div>
  </div>
</article>

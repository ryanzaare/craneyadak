---
// src/components/ProductCard.astro
// ---------------------------------------------------------------------------
// کارت محصول — تنها کارت محصول در کل سایت.
//
// چرا یکی: این کارت در صفحه‌ی دسته، سیلو، برند، جستجو و صفحه‌ی اصلی استفاده
// می‌شود. اگر هرکدام کارت خودش را داشته باشد، قانون «قیمت خط‌خورده فقط با
// قیمت قبلیِ واقعی» باید در پنج جا تکرار شود و روزی یکی از آن‌ها فراموش
// می‌شود. یک کارت = یک نقطه‌ی حقیقت.
// ---------------------------------------------------------------------------
import PriceTag from './PriceTag.astro';
import { computePrice, productPath, type CraneProduct } from '../lib/wp';

export interface Props {
  product: CraneProduct;
  /** بارگذاری مشتاقانه‌ی تصویر برای کارت‌های بالای صفحه (LCP). */
  eager?: boolean;
  /** نمایش نام برند روی تصویر — در صفحه‌ی برند زائد است. */
  showBrand?: boolean;
}

const { product, eager = false, showBrand = true } = Astro.props;

const price = computePrice(product);
const image = product.images[0] ?? null;
---

<article class="h-full bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-xl transition-shadow duration-300 overflow-hidden flex flex-col group relative">
  <div class="aspect-square bg-gray-50 relative flex items-center justify-center overflow-hidden">
    {image ? (
      <img
        src={image.url}
        alt={image.altText}
        width={image.width ?? 600}
        height={image.height ?? 600}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
      />
    ) : (
      /* بدون تصویر واقعی، آیکون خنثی — نه تصویر یک محصول دیگر. */
      <svg class="w-16 h-16 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
    )}

    {price.onSale && price.discountPercent !== null && (
      <span class="absolute top-3 left-3 bg-rose-600 text-white text-xs font-black px-2.5 py-1.5 rounded-lg shadow-sm tabular-nums">
        ٪{price.discountPercent} تخفیف
      </span>
    )}

    {showBrand && product.brandNameFa && (
      <span class="absolute top-3 right-3 bg-white/95 backdrop-blur text-xs font-bold px-2 py-1 rounded text-gray-700 shadow-sm">
        {product.brandNameFa}
      </span>
    )}

    {product.stockStatus === 'in_stock' && (
      <span class="absolute bottom-3 right-3 bg-emerald-50 text-emerald-800 border border-emerald-200 text-[11px] font-bold px-2 py-1 rounded">
        موجود
      </span>
    )}
  </div>

  <div class="p-5 flex flex-col grow">
    {product.sku && <p class="text-xs text-gray-500 mb-1 font-mono" dir="ltr">{product.sku}</p>}

    <h3 class="font-bold text-crane-navy leading-7 mb-3 line-clamp-2">
      <a
        href={productPath(product)}
        class="hover:text-crane-orange before:absolute before:inset-0 focus:outline-none focus:ring-4 focus:ring-crane-orange/30 rounded"
      >
        {product.name}
      </a>
    </h3>

    {product.oemCrossReference.length > 0 && (
      /* کد معادل OEM مهم‌ترین سیگنال تطابق برای خریدار صنعتی است — او معمولاً
         کد سازنده‌ی اصلی را در دست دارد، نه کد داخلی فروشگاه. */
      <p class="text-xs text-gray-600 mb-3 leading-6 line-clamp-1">
        <span class="font-bold">معادل:</span>
        <span dir="ltr" class="font-mono">
          {product.oemCrossReference.map((r) => r.oemPartNumber).join(' · ')}
        </span>
      </p>
    )}

    <div class="mt-auto pt-4 border-t border-gray-100 relative z-10">
      <PriceTag price={price} />
    </div>
  </div>
</article>

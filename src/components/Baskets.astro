---
// src/components/Baskets.astro
// ---------------------------------------------------------------------------
// کشوی «سبد خرید» و کشوی «سبد استعلام» — در Layout، روی همه‌ی صفحات.
// منطق سبدها در src/scripts/baskets.ts است (آزمون: baskets.test.mts).
//
// ═══════════════════════════════════════════════════════════════════════════
// تاریخچه
// ═══════════════════════════════════════════════════════════════════════════
// جایگزین QuoteBasket.astro شد (ایست ۲، فاز ۳). آن نسخه یک سبد داشت که
// اگر همه‌ی اقلامش قیمت‌دار بودند عنوانش «سبد سفارش» می‌شد — یعنی سبد
// مخلوط با برچسب متغیر. مدیرعامل دو سبد جدا خواست و این شکل تمیزتر است:
// خریدار همیشه می‌داند کدام دکمه به پرداخت می‌رسد و کدام به پیش‌فاکتور.
//
// ⚠️ ورودی‌ها در هدر است (#cart-open، #quote-open)، نه دکمه‌ی شناور. دکمه‌ی
// شناور قبلی گوشه‌ی پایین روی نوار MobileCTA می‌افتاد، و کارفرما پیش‌تر
// گفته بود پایین صفحه عملاً دیده نمی‌شود (همان دلیلِ آیکن حساب در هدر).
//
// ═══════════════════════════════════════════════════════════════════════════
// محافظ مرورگر (نسخه‌ی سبکِ اعتبار ۱۰ روزه)
// ═══════════════════════════════════════════════════════════════════════════
// صفحه‌ی استاتیک ممکن است از build چند روز پیش باشد. هر عنصر با
// data-guard-until پس از آن لحظه عوض می‌شود:
//   • data-payable-only  → پنهان (دکمه‌ی خرید، دکمه‌ی پیش‌فاکتور)
//   • data-expired-only  → نمایان (دکمه‌ی استعلام، توضیح انقضا)
// ⚠️ فقط دکمه عوض می‌شود، نه عدد قیمت — تا متن صفحه و JSON-LD از هم جدا
// نشوند. و این راحتی کاربر است، نه امنیت: سرور هنگام پرداخت خودش
// می‌سنجد (cyh_product_pricing).
// ---------------------------------------------------------------------------
const drawerClass = 'fixed inset-0 z-50 print:hidden';
// بازطراحی ۳ آذر ۱۴۰۵ (کارفرما: «سبد استعلام و خرید را هم بازطراحی کن»؛ «خوانایی سایت ضعیف است»). پیش از این:
// سرصفحه‌ی گرافیتی، متن‌های ۱۲–۱۳px، ورودی تعداد ۶۴px، ✕ ریز، و فرمی که فقط placeholder داشت (برچسب با اولین حرف
// ناپدید می‌شد) با ورودی‌های ۱۴px که در iOS صفحه را زوم می‌کرد (زیر ۱۶px). حالا: سرصفحه‌ی سفید با جابه‌جای دو سبد،
// ردیف‌های بزرگ، دکمه‌ی −/+ ۴۴px، «حذف» با برچسب، برچسب دیدنی بالای هر فیلد، ورودی ۱۶px.
// ⚠️ این نشانه‌گذاری روی *همه‌ی* صفحه‌هاست؛ هر بایت آن در مسیر بحرانی LCP صفحه‌ی محصول است (backlog O23). کلاس‌های
// تکراری در ثابت‌ها، و قلم‌های سبد با جاوااسکریپت ساخته می‌شوند.
const panelClass = 'absolute inset-y-0 left-0 w-full max-w-md bg-white shadow-2xl flex flex-col';
const headClass = 'flex items-center justify-between gap-3 px-4 min-h-16 border-b border-steel-300 shrink-0';
const closeClass = 'w-11 h-11 grid place-items-center rounded-full text-steel-700 hover:bg-steel-100';
const switchClass = 'flex-1 min-h-11 rounded-md text-sm font-bold text-steel-700 aria-pressed:bg-white aria-pressed:text-steel-900 aria-pressed:shadow';
const inputClass = 'w-full min-h-12 text-base text-steel-900 bg-white border border-steel-300 rounded-md px-3 focus:outline-none focus:border-action focus:ring-2 focus:ring-accent/30';
const labelClass = 'block text-sm font-bold text-steel-800 mb-1';
const noteClass = 'text-sm leading-7 text-steel-700 bg-steel-50 border border-steel-200 rounded-md p-3';
const warnClass = 'text-sm leading-7 text-amber-900 bg-amber-50 border border-amber-200 rounded-md p-3 mb-4';
const primaryClass = 'flex items-center justify-center w-full min-h-12 bg-action text-white rounded-md text-base font-bold hover:bg-accent-strong focus:outline-none focus:ring-4 focus:ring-accent/40';
const emptyClass = 'text-base text-steel-700 leading-8 text-center py-10';
const x = '<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M6 18L18 6M6 6l12 12"/></svg>';
const head = (kind: 'cart' | 'quote', title: string) => `<div class="${headClass}"><h2 id="${kind}-title" class="text-xl font-bold text-steel-900">${title}</h2>` +
  `<button type="button" class="${closeClass}" aria-label="بستن" data-basket-close>${x}</button></div>` +
  `<div class="flex gap-1 p-1 m-4 mb-0 rounded-lg bg-steel-100" role="group" aria-label="سبدها">` +
  `<button type="button" class="${switchClass}" data-basket-switch="cart" aria-pressed="${kind === 'cart'}">سبد خرید (<span data-basket-n="cart">۰</span>)</button>` +
  `<button type="button" class="${switchClass}" data-basket-switch="quote" aria-pressed="${kind === 'quote'}">سبد استعلام (<span data-basket-n="quote">۰</span>)</button></div>`;
---

{/* ═══ سبد خرید ═══ */}
<div id="cart-drawer" hidden class={drawerClass} role="dialog" aria-modal="true" aria-labelledby="cart-title" data-basket-drawer="cart">
  <div class="absolute inset-0 bg-steel-900/60" data-basket-close></div>
  <div class={panelClass}>
    <Fragment set:html={head('cart', 'سبد خرید')} />
    <div class="flex-1 overflow-y-auto p-4">
      {/* پیام جابه‌جایی: قلمی که اعتبار قیمتش گذشت به سبد استعلام رفت. */}
      <p id="cart-notice" hidden class={warnClass} role="status" aria-live="polite"></p>
      <ul id="cart-items" role="list" class="divide-y divide-steel-200"></ul>
      <div id="cart-empty" class={emptyClass}>
        <p class="text-xl font-bold text-steel-900 mb-2">سبد خرید خالی است</p>
        <p>قطعه‌های قیمت‌دار را از صفحه‌ی هر قطعه به سبد بیفزایید.</p>
        <a href="/products/" class="inline-flex items-center min-h-11 mt-3 px-4 rounded-md border border-steel-300 text-sm font-bold text-steel-900 hover:border-action">مشاهده‌ی فروشگاه ←</a>
      </div>
    </div>
    {/* پایین ثابت — دکمه‌ی پرداخت همیشه دیده می‌شود، هر چقدر فهرست بلند باشد. */}
    <div id="cart-footer" hidden class="shrink-0 p-4 border-t border-steel-300 space-y-3 bg-white">
      {/* ⚠️ عدد قیمت عمداً در کشو نیست. سبد در localStorage است و قیمتش ممکن است از build چند روز پیش باشد؛ مبلغ
          قطعی را سرور در صفحه‌ی پرداخت می‌دهد و همان را محترم می‌شمارد (تصمیم کارفرما). دو عدد متفاوت در دو صفحه همان
          «قیمت تغییر کرد» است که ممنوع شد. */}
      <p class={noteClass}>مبلغ نهایی در صفحه‌ی پرداخت اعلام می‌شود. پرداخت آنلاین فقط بهای قطعه است؛ هزینه‌ی ارسال پس‌کرایه است.</p>
      {/* ⚠️ پرداخت مهمان ندارد (تصمیم کارفرما): بدون توکن، مستقیم به ورود/ثبت‌نام و بعد برگشت به /checkout. */}
      <a id="cart-checkout" href="/checkout" class={primaryClass}>ادامه جهت تسویه‌حساب</a>
    </div>
  </div>
</div>

{/* ═══ سبد استعلام ═══ */}
<div id="quote-drawer" hidden class={drawerClass} role="dialog" aria-modal="true" aria-labelledby="quote-title" data-basket-drawer="quote">
  <div class="absolute inset-0 bg-steel-900/60" data-basket-close></div>
  <div class={panelClass}>
    <Fragment set:html={head('quote', 'سبد استعلام')} />
    <div class="flex-1 overflow-y-auto p-4">
      <p id="quote-notice" hidden class={warnClass} role="status" aria-live="polite"></p>
      <ul id="quote-items" role="list" class="divide-y divide-steel-200"></ul>
      <div id="quote-empty" class={emptyClass}>
        <p class="text-xl font-bold text-steel-900 mb-2">سبد استعلام خالی است</p>
        <p>از صفحه‌ی هر قطعه «افزودن به سبد استعلام» یا «دریافت پیش‌فاکتور» را بزنید.</p>
        <a href="/part-finder/" class="inline-flex items-center min-h-11 mt-3 px-4 rounded-md border border-steel-300 text-sm font-bold text-steel-900 hover:border-action">قطعه را نمی‌شناسید؟ قطعه‌یاب ←</a>
      </div>

      {/* فرم — فقط همان چیزی که برای تماس لازم است. ⚠️ عمداً بدون ثبت‌نام و رمز عبور: مهندس نت وسط توقف خط تولید
          حساب کاربری نمی‌سازد. هر فیلد اضافه یک دلیل برای رها کردن است. ⚠️ برچسب دیدنی، نه فقط placeholder. */}
      <form id="quote-form" class="mt-4 pt-4 border-t-2 border-steel-200 space-y-4" hidden>
        <p class={noteClass}>پس از ثبت، کارشناس سازگاری فنی را بررسی و پیش‌فاکتور رسمی صادر می‌کند.</p>
        <label class="cyh-honeypot" aria-hidden="true">
          وب‌سایت <input type="text" name="website" tabindex="-1" autocomplete="off" />
        </label>
        <div><label for="q-name" class={labelClass}>نام و نام خانوادگی</label><input id="q-name" type="text" name="name" required autocomplete="name" class={inputClass} /></div>
        <div><label for="q-phone" class={labelClass}>شماره تماس</label><input id="q-phone" type="tel" name="phone" required autocomplete="tel" inputmode="tel" dir="ltr" placeholder="۰۹۱۲…" class={`${inputClass} text-right`} /></div>
        <div><label for="q-org" class={labelClass}>نام شرکت یا کارخانه <span class="font-normal text-steel-600">(اختیاری)</span></label><input id="q-org" type="text" name="organization" autocomplete="organization" class={inputClass} /></div>
        <div><label for="q-note" class={labelClass}>توضیح یا مدل دستگاه <span class="font-normal text-steel-600">(اختیاری)</span></label><textarea id="q-note" name="note" rows="2" class={`${inputClass} py-2 resize-y`}></textarea></div>
        <button type="submit" id="quote-submit" class={primaryClass}>ثبت درخواست پیش‌فاکتور</button>
      </form>
      {/* ⚠️ پیام بیرون از فرم است: فرم با خالی‌شدن سبد پنهان می‌شود و پیام «ثبت شد، کد رهگیری …» درست در لحظه‌ی
          موفقیت ناپدید می‌شد (QuoteBasket.astro قدیمی). */}
      <p id="quote-msg" class="mt-3 text-sm leading-7" role="status" aria-live="polite"></p>
    </div>
  </div>
</div>

<script>
  import {
    addToCart,
    addToQuote,
    BASKET_EVENT,
    browserStore,
    isExpired,
    readBasket,
    removeItem,
    setQty,
    sweepExpiredCart,
    writeBasket,
    type BasketItem,
    type BasketKind,
  } from '../scripts/baskets';
  import { getToken, wpBase } from '../scripts/account';

  document.getElementById('cart-checkout')?.addEventListener('click', (e) => {
    if (getToken()) return;
    e.preventDefault();
    location.href = `/account/login/?next=${encodeURIComponent('/checkout')}`;
  });

  const store = browserStore();
  const $ = (id: string) => document.getElementById(id);
  let lastOpener: HTMLElement | null = null;

  /* ─── کشوها ─── */
  function openDrawer(kind: BasketKind) {
    // جابه‌جایی بین دو کشو بازگشت فوکوس را به دکمه‌ی پنهان‌شده نبرد — فقط بازکننده‌ی بیرون از کشو ثبت شود.
    const active = document.activeElement as HTMLElement | null;
    if (!active?.closest('[data-basket-drawer]')) lastOpener = active;
    for (const d of document.querySelectorAll<HTMLElement>('[data-basket-drawer]')) {
      d.hidden = d.dataset.basketDrawer !== kind;
    }
    document.body.style.overflow = 'hidden';
    $(`${kind}-drawer`)?.querySelector<HTMLElement>('button[data-basket-close]')?.focus();
  }

  function closeDrawers() {
    let wasOpen = false;
    for (const d of document.querySelectorAll<HTMLElement>('[data-basket-drawer]')) {
      wasOpen ||= !d.hidden;
      d.hidden = true;
    }
    if (!wasOpen) return;
    document.body.style.overflow = '';
    lastOpener?.focus();
  }

  document.querySelectorAll('[data-basket-close]').forEach((el) => el.addEventListener('click', closeDrawers));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeDrawers();
  });
  // جابه‌جای «سبد خرید | سبد استعلام» بالای هر کشو — خریدار هر دو سبد را بی بستن و یافتن دکمه‌ی دیگر در هدر می‌بیند.
  document.querySelectorAll<HTMLElement>('[data-basket-switch]').forEach((b) =>
    b.addEventListener('click', () => { if (b.getAttribute('aria-pressed') !== 'true') openDrawer(b.dataset.basketSwitch as BasketKind); }));
  $('cart-open')?.addEventListener('click', () => openDrawer('cart'));
  $('quote-open')?.addEventListener('click', () => openDrawer('quote'));

  function notice(kind: BasketKind, text: string) {
    const el = $(`${kind}-notice`);
    if (!el) return;
    el.textContent = text;
    el.hidden = !text;
  }

  /* ─── رندر ─── */
  // ردیف قلم سبد. ⚠️ textContent نه innerHTML — نام و کد از localStorage است و دست‌کاری‌پذیر.
  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls: string, text?: string) => {
    const e = document.createElement(tag);
    e.className = cls;
    if (text !== undefined) e.textContent = text;
    return e;
  };
  const STEP = 'w-11 h-11 grid place-items-center text-xl font-bold text-steel-900 hover:bg-steel-100 disabled:text-steel-400 disabled:hover:bg-transparent';
  function renderList(kind: BasketKind, list: BasketItem[]) {
    const ul = $(`${kind}-items`);
    if (!ul) return;
    ul.textContent = '';
    for (const item of list) {
      const label = item.name || item.slug;
      // ⚠️ خط تیره‌ی کد فنی با «خط تیره‌ی نشکن» (U+2011): وگرنه «SAGA1-L10» سر خط می‌شکند و در متن راست‌به‌چپ
      // «‎-SAGA1 / L10» خوانده می‌شود (دیده‌شده ۳ آذر ۱۴۰۵). U+2011 در unicode-range فونت Vazirmatn هست.
      const shown = label.replace(/([A-Za-z0-9])-([A-Za-z0-9])/g, '$1\u2011$2');
      const li = el('li', 'py-4 first:pt-0');
      const name = el('a', 'block text-base font-bold text-steel-900 leading-7 hover:text-accent-ink', shown);
      name.href = `/products/${encodeURIComponent(item.slug)}/`;
      li.appendChild(name);
      const meta = el('div', 'flex flex-wrap items-center gap-2 mt-1');
      if (item.sku) {
        const sku = el('span', 'text-sm text-steel-600 font-mono', item.sku);
        sku.dir = 'ltr';
        meta.appendChild(sku);
      }
      if (kind === 'quote') {
        /* برچسب مسیر، بدون عدد: قلم قیمت‌دار که برای پیش‌فاکتور آمده، از قلمی که قیمتش را کارشناس تعیین می‌کند جداست. */
        const priced = item.mode === 'cart';
        meta.appendChild(el('span', priced
          ? 'text-xs font-bold text-emerald-800 bg-emerald-50 border border-emerald-200 rounded px-2 py-0.5'
          : 'text-xs font-bold text-steel-700 bg-steel-100 border border-steel-300 rounded px-2 py-0.5', priced ? 'قیمت‌دار' : 'نیازمند استعلام'));
      }
      li.appendChild(meta);

      // −/+ به‌جای ورودی عددی ۶۴px: انگشت روی کف کارگاه. ورودی وسط برای تایپ مستقیم ۲۰۰ عدد هم می‌ماند.
      const row = el('div', 'flex items-center justify-between gap-3 mt-3');
      const stepper = el('div', 'inline-flex items-center rounded-md border border-steel-300 overflow-hidden');
      const minus = el('button', STEP, '−');
      const plus = el('button', STEP, '+');
      const qty = el('input', 'w-14 h-11 text-center text-base font-bold text-steel-900 border-x border-steel-300 tabular-nums [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none');
      minus.type = plus.type = 'button';
      minus.setAttribute('aria-label', `کم کردن تعداد ${label}`);
      plus.setAttribute('aria-label', `افزودن تعداد ${label}`);
      minus.disabled = item.qty <= 1;
      qty.type = 'number'; qty.min = '1'; qty.max = '9999'; qty.inputMode = 'numeric';
      qty.value = String(item.qty);
      qty.setAttribute('aria-label', `تعداد ${label}`);
      qty.addEventListener('change', () => setQty(store, kind, item.slug, qty.value));
      minus.addEventListener('click', () => setQty(store, kind, item.slug, String(item.qty - 1)));
      plus.addEventListener('click', () => setQty(store, kind, item.slug, String(item.qty + 1)));
      stepper.append(minus, qty, plus);

      const del = el('button', 'inline-flex items-center gap-1.5 min-h-11 px-3 rounded-md text-sm font-bold text-steel-700 hover:text-red-700 hover:bg-red-50');
      del.type = 'button';
      del.setAttribute('aria-label', `حذف ${label}`);
      del.innerHTML = '<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.35 9m-4.78 0L9.26 9m9.97-3.21c.34.05.68.11 1.02.17m-1.02-.17L18.16 19.67A2.25 2.25 0 0115.92 21.75H8.08a2.25 2.25 0 01-2.24-2.08L4.77 5.79m14.46 0a48.1 48.1 0 00-3.48-.4m-12 .56c.34-.06.68-.11 1.02-.17m0 0a48.1 48.1 0 013.48-.4m7.5 0v-.92c0-1.18-.91-2.16-2.09-2.2a51.96 51.96 0 00-3.32 0c-1.18.04-2.09 1.02-2.09 2.2v.92m7.5 0a48.67 48.67 0 00-7.5 0"/></svg>حذف';
      del.addEventListener('click', () => removeItem(store, kind, item.slug));
      row.append(stepper, del);
      li.appendChild(row);
      ul.appendChild(li);
    }
  }

  function syncButtons(attr: 'cartAdd' | 'quoteAdd', inBasket: Set<string>, doneLabel: string) {
    const sel = attr === 'cartAdd' ? '[data-cart-add]' : '[data-quote-add]';
    document.querySelectorAll<HTMLElement>(sel).forEach((btn) => {
      const label = btn.querySelector<HTMLElement>('[data-basket-label]');
      if (!label) return;
      // برچسب اولیه‌ی هر دکمه («افزودن به سبد استعلام» یا «دریافت پیش‌فاکتور») حفظ می‌شود.
      label.dataset.idle ??= label.textContent ?? '';
      const has = inBasket.has(btn.dataset[attr] ?? '');
      label.textContent = has ? doneLabel : label.dataset.idle;
      btn.dataset.inBasket = has ? '1' : '0';
    });
  }

  function render() {
    const cart = readBasket(store, 'cart');
    const quote = readBasket(store, 'quote');

    for (const [kind, list] of [['cart', cart], ['quote', quote]] as const) {
      renderList(kind, list);
      const count = $(`${kind}-count`);
      if (count) count.textContent = list.length.toLocaleString('fa-IR');
      for (const n of document.querySelectorAll<HTMLElement>(`[data-basket-n="${kind}"]`)) n.textContent = list.length.toLocaleString('fa-IR');
      const opener = $(`${kind}-open`);
      if (opener) opener.hidden = list.length === 0;
      const empty = $(`${kind}-empty`);
      if (empty) empty.hidden = list.length > 0;
    }
    const cartFooter = $('cart-footer');
    if (cartFooter) cartFooter.hidden = cart.length === 0;
    const form = $('quote-form');
    if (form) form.hidden = quote.length === 0;

    syncButtons('cartAdd', new Set(cart.map((x) => x.slug)), '✓ در سبد خرید');
    syncButtons('quoteAdd', new Set(quote.map((x) => x.slug)), '✓ در سبد استعلام');
  }

  window.addEventListener(BASKET_EVENT, render);
  // هم‌گامی بین زبانه‌ها: افزودن در یک زبانه، شمارنده‌ی زبانه‌ی دیگر را هم عوض کند.
  window.addEventListener('storage', render);

  /* ─── محافظ مرورگر ─── */
  let guardTimer: number | undefined;
  function guard() {
    const now = new Date();
    let next = Infinity;
    document.querySelectorAll<HTMLElement>('[data-guard-until]').forEach((el) => {
      const until = el.dataset.guardUntil || null;
      const expired = isExpired(until, now);
      el.hidden = el.hasAttribute('data-expired-only') ? !expired : expired;
      if (!expired && until) next = Math.min(next, Date.parse(until) - now.getTime());
    });

    const moved = sweepExpiredCart(store, now);
    if (moved.length) {
      const names = moved.map((x) => x.name || x.slug).join('، ');
      const text = `اعتبار قیمت این اقلام به پایان رسید و به سبد استعلام منتقل شدند: ${names}`;
      notice('cart', text);
      notice('quote', text);
    }
    for (const item of readBasket(store, 'cart')) {
      if (item.validUntil) next = Math.min(next, Date.parse(item.validUntil) - now.getTime());
    }

    /* ⚠️ setTimeout بیش از ~۲۴٫۸ روز سرریز می‌کند و *فوراً* اجرا می‌شود
       (عدد ۳۲ بیتی). قیمت ۱۰ روزه زیر این سقف است، ولی مدت اعتبار تنظیم
       پنل است و تا ۹۰ روز می‌رود — بدون این سقف، حلقه‌ی بی‌وقفه می‌ساخت. */
    window.clearTimeout(guardTimer);
    if (Number.isFinite(next)) {
      guardTimer = window.setTimeout(guard, Math.min(Math.max(next, 0) + 1000, 2_000_000_000));
    }
  }

  /* ─── دکمه‌های افزودن، در هر صفحه‌ای که باشند ─── */
  document.querySelectorAll<HTMLElement>('[data-cart-add]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const slug = btn.dataset.cartAdd;
      if (!slug) return;
      const went = addToCart(store, {
        slug,
        name: btn.dataset.basketName || slug,
        sku: btn.dataset.basketSku || '',
        mode: 'cart',
        validUntil: btn.dataset.guardUntil || null,
      });
      if (went === 'quote') {
        // قیمت همین حالا منقضی شد (صفحه مدتی باز مانده بود): دکمه‌ها هم عوض شوند.
        notice('quote', 'اعتبار قیمت این قلم به پایان رسیده؛ برای قیمت روز به سبد استعلام افزوده شد.');
        guard();
      }
      openDrawer(went);
    });
  });

  document.querySelectorAll<HTMLElement>('[data-quote-add]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const slug = btn.dataset.quoteAdd;
      if (!slug) return;
      addToQuote(store, {
        slug,
        name: btn.dataset.basketName || slug,
        sku: btn.dataset.basketSku || '',
        mode: btn.dataset.quoteMode === 'cart' ? 'cart' : 'rfq',
        validUntil: btn.dataset.guardUntil || null,
      });
      openDrawer('quote');
    });
  });

  /* ─── ارسال استعلام ─── */
  const form = $('quote-form') as HTMLFormElement | null;
  const msg = $('quote-msg');
  const say = (text: string, good = false) => {
    if (!msg) return;
    msg.className = `mt-3 text-sm leading-7 font-bold ${good ? 'text-green-700' : 'text-red-700'}`;
    msg.textContent = text;
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const base = wpBase();
    if (!base) {
      say('ارسال آنلاین در دسترس نیست. لطفاً تماس بگیرید.');
      return;
    }
    const button = $('quote-submit') as HTMLButtonElement | null;
    const data = new FormData(form);
    /* ⚠️ فقط اسلاگ و تعداد به سرور می‌رود که معنا دارد؛ نام، کد و قیمت را
       سرور خودش از وردپرس می‌خواند (class-quote-requests.php). */
    const payload = {
      name: String(data.get('name') || ''),
      phone: String(data.get('phone') || ''),
      organization: String(data.get('organization') || ''),
      note: String(data.get('note') || ''),
      website: String(data.get('website') || ''),
      items: readBasket(store, 'quote').map(({ slug, name, sku, qty }) => ({ slug, name, sku, qty })),
    };

    if (button) {
      button.disabled = true;
      button.textContent = 'در حال ارسال…';
    }
    if (msg) msg.textContent = '';
    document.getElementById('quote-track-link')?.remove();

    try {
      const res = await fetch(`${base}/wp-json/crane-yadak/v1/quote`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const json = await res.json().catch(() => ({}));
      if (res.ok && json.ok) {
        say(json.message || 'درخواست ثبت شد.', true);
        /* کد رهگیری روی همین دستگاه ذخیره می‌شود تا کاربر لازم نباشد
           یادداشتش کند. ⚠️ شماره تماس عمداً ذخیره نمی‌شود — نگه‌داشتنش در
           مرورگر یعنی هر کسی با دسترسی به دستگاه می‌تواند سفارش را ببیند. */
        if (json.code) {
          try {
            const CODES = 'cy-quote-codes-v1';
            const prev = JSON.parse(localStorage.getItem(CODES) || '[]');
            const next = Array.isArray(prev) ? prev : [];
            next.unshift({ code: json.code, date: new Date().toLocaleDateString('fa-IR') });
            localStorage.setItem(CODES, JSON.stringify(next.slice(0, 20)));
          } catch {
            /* بدون حافظه هم کد در پیام بالا نشان داده شده. */
          }
          const link = document.createElement('a');
          link.id = 'quote-track-link';
          link.href = `/track?code=${encodeURIComponent(json.code)}`;
          link.className = 'block mt-2 text-accent-ink font-bold underline text-sm';
          link.textContent = 'پیگیری وضعیت این درخواست ←';
          msg?.after(link);
        }
        // سبد فقط پس از ثبت *موفق* خالی می‌شود؛ شکست ارسال انتخاب‌ها را نمی‌برد.
        writeBasket(store, 'quote', []);
        form.reset();
      } else {
        say(json.message || 'ثبت نشد. لطفاً دوباره تلاش کنید.');
      }
    } catch {
      say('ارتباط با سرور برقرار نشد. اتصال اینترنت را بررسی کنید.');
    } finally {
      if (button) {
        button.disabled = false;
        button.textContent = 'ثبت درخواست پیش‌فاکتور';
      }
    }
  });

  guard();
  render();

  /* سینی شناور مقایسه — فقط وقتی فهرست مقایسه پر است، با <script src> به فایل خام public/scripts/compare-tray.js.
     ⚠️ هر راه دیگر (import ایستا/پویا، کامپوننت، inline) اندازه‌گیری شد و Lighthouse موبایل را ۰٫۹۸ کرد — دلیل کامل در
     همان فایل. با هر تغییر آن فایل ?v= را بالا ببر (نامش هش ندارد). کلید = src/scripts/compare.ts. */
  const loadTray = () => {
    let has = false;
    try { has = (localStorage.getItem('cy-compare-v1') ?? '[]') !== '[]'; } catch { /* حالت خصوصی */ }
    if (!has || document.getElementById('cy-tray-js')) return;
    const el = document.createElement('script');
    el.id = 'cy-tray-js';
    el.src = '/scripts/compare-tray.js?v=2';
    document.head.appendChild(el);
  };
  window.addEventListener('cy-compare', loadTray);
  window.addEventListener('storage', loadTray);
  loadTray();
</script>

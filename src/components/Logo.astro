---
// src/components/Logo.astro
// این کامپوننت کلاس‌های Tailwind رو از بیرون دریافت می‌کنه تا تو هدر و فوتر به اندازه دلخواه دربیاد
export interface Props {
  class?: string;
}
const { class: className = "w-10 h-10" } = Astro.props;
---

<svg class={className} viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  {/* شش‌ضلعی صنعتی (نماد مهندسی و ساختار) */}
  <path 
    d="M50 5L90 28V72L50 95L10 72V28L50 5Z" 
    stroke="currentColor" 
    stroke-width="6" 
    stroke-linejoin="round" 
    class="text-crane-navy"
  />
  {/* قلاب جرثقیل در فضای منفی (برش تیز و قدرتمند) */}
  <path 
    d="M55 25V35C62 36 67 41 67 48C67 56 61 63 53 63C46 63 41 58 40 52H32C33 63 42 71 53 71C64 71 75 62 75 48C75 36 67 27 55 25ZM45 42C45 37 49 33 54 33V42H45Z" 
    fill="currentColor" 
    class="text-crane-orange"
  />
  <circle cx="50" cy="18" r="4" fill="currentColor" class="text-crane-navy" />
</svg>
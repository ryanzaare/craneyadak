---
// src/components/AssuranceStrip.astro
// ---------------------------------------------------------------------------
// «تعهدات خرید» — نیمه‌ی دومِ AuthorityStrip قدیمی.
//
// در نسخه‌ی قبل این سه مورد در سمت چپ یک ردیف شلوغ، با فونت ریز و آیکون
// بسیار کوچک قرار داشتند و عملاً نامرئی بودند. حالا هرکدام یک کارت کامل
// با آیکون بزرگ است.
//
// این سه مورد عمداً «تعهد فرایندی» هستند، نه ادعای عددی: هر سه توصیف
// کاری‌اند که هنگام سفارش انجام می‌شود و کارفرما می‌تواند صحتشان را
// تضمین کند. ادعاهای عددی اثبات‌نشده (سابقه، درصد رضایت) جای دیگری
// زندگی می‌کنند — src/data/trust.ts — و برچسب «جای‌گذار» دارند.
// ---------------------------------------------------------------------------
const assurances = [
  {
    title: 'بررسی سازگاری پیش از فاکتور',
    detail: 'کد فنی و مشخصات مکانیزم شما بررسی می‌شود تا قطعه‌ی اشتباه سفارش داده نشود.',
    icon: 'M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  },
  {
    title: 'فاکتور رسمی و مالیاتی',
    detail: 'قابل ارائه به واحد مالی، حسابرسی و اداره‌ی دارایی سازمان شما.',
    icon: 'M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z',
  },
  {
    title: 'ضمانت کتبی اصالت کالا',
    detail: 'همراه کالا تحویل می‌شود و در صورت عدم تطابق با کد سفارش، تعویض می‌شود.',
    icon: 'M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751A11.959 11.959 0 0112 2.714z',
  },
];
---

<section class="bg-steel-50 border-b border-steel-300" aria-labelledby="assurance-heading">
  <div class="max-w-7xl mx-auto px-4 py-9">
    <h2 id="assurance-heading" class="text-sm font-black text-steel-600 tracking-wide mb-4">
      در هر سفارش
    </h2>

    <ul role="list" class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {
        assurances.map((item) => (
          <li class="bg-white border border-steel-300 rounded-lg p-5 flex flex-col">
            {/* آیکون ۴۸px به‌جای ۱۶px نسخه‌ی قبل. */}
            <span
              class="w-12 h-12 shrink-0 rounded-lg bg-accent-soft border border-accent/25 text-accent-ink flex items-center justify-center mb-3"
              aria-hidden="true"
            >
              <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
              </svg>
            </span>
            <span class="font-black text-steel-900 leading-7 mb-1">{item.title}</span>
            <span class="text-sm text-steel-600 leading-7">{item.detail}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

---
// src/components/Community.astro
// ---------------------------------------------------------------------------
// محتوای کاربر: پرسش فنی، گزارش نصب، نظر خریدار.
//
// ═══ چرا ترتیب این‌گونه است ═══
// در فروش B2B صنعتی، «امتیاز ۵ ستاره» تقریباً بی‌معناست — کسی درباره‌ی
// لنت ترمز نظر احساسی نمی‌نویسد. سوال واقعی خریدار همیشه یکی است: «آیا
// روی دستگاه من می‌خورد؟» بنابراین:
//   ۱) پرسش‌وپاسخ فنی — اصلی
//   ۲) گزارش نصب — اثبات میدانی سازگاری
//   ۳) نظر و امتیاز — فرعی
//
// ═══ ارزش سئویی ═══
// هر پرسش کاربر یک عبارت جستجوی طولانی واقعی است، با کلماتی که هیچ
// نویسنده‌ای حدس نمی‌زند. این غنی‌ترین منبع long-tail برای این صنعت است.
// اسکیمای QAPage آن را برای گوگل قابل فهم می‌کند.
//
// ⚠️ خط قرمز اسکیما — اجرا شده در کد، نه در نیت:
// `AggregateRating` فقط با حداقل یک نظر *واقعیِ تاییدشده* تولید می‌شود.
// انتشار امتیاز میانگین بدون نظر واقعی، نقض مستقیم سیاست داده‌ی
// ساختاریافته‌ی گوگل و دارای جریمه‌ی دستی است.
// ---------------------------------------------------------------------------
import type { CommunityEntry } from '../lib/community';

interface Props {
  entries: CommunityEntry[];
  productId: number | null;
  productName: string;
  wpBase: string | null;
  class?: string;
}

const { entries, productId, productName, wpBase, class: className = '' } = Astro.props;

const questions = entries.filter((e) => e.type === 'question');
const fitments = entries.filter((e) => e.type === 'fitment');
const reviews = entries.filter((e) => e.type === 'review');

const answered = questions.filter((q) => q.answer);
const canSubmit = Boolean(wpBase && productId);

/** هیچ محتوایی هنوز ثبت نشده — حالت پیش‌فرض هر محصول تازه. */
const isEmpty = questions.length === 0 && fitments.length === 0 && reviews.length === 0;

const faDate = (iso: string | null) => {
  if (!iso) return '';
  try {
    return new Intl.DateTimeFormat('fa-IR', { year: 'numeric', month: 'long' }).format(new Date(iso));
  } catch {
    return '';
  }
};
---

<section class={`bg-white border-t border-steel-300 ${className}`} aria-labelledby="community-heading">
  {/* ⚠️ چیدمان با حجم محتوا عوض می‌شود.
      وقتی هنوز هیچ پرسش، گزارش یا نظری ثبت نشده، ستون محتوا فقط دو
      جعبه‌ی «هنوز چیزی ثبت نشده» دارد و بقیه‌اش سفید می‌ماند — در حالی
      که فرم در ستون مقابل فشرده شده است. صفحه‌ی محصولِ تازه‌منتشرشده
      همیشه در همین حالت است، یعنی این حالتِ استثنا نیست، حالتِ پیش‌فرض
      است و باید مثل یک طراحی عمدی به نظر برسد.
      در حالت خالی: یک ستون، فرم در وسط، بدون فضای مرده. */}

  <div class="max-w-7xl mx-auto px-4 py-10">
    <h2 id="community-heading" class="text-xl md:text-2xl font-black text-steel-900 mb-1">
      پرسش‌ها و تجربه‌ی کاربران
    </h2>
    <p class="text-steel-600 leading-7 mb-6 pb-4 border-b border-steel-300">
      پرسش فنی درباره‌ی سازگاری این قطعه بپرسید، تجربه‌ی نصب خود را ثبت کنید، یا نظرتان را بنویسید.
    </p>

    <div class:list={[
      'gap-8 lg:gap-10 items-start',
      isEmpty ? 'max-w-xl mx-auto' : 'grid lg:grid-cols-[minmax(0,1fr)_22rem]',
    ]}>
      <div class:list={['min-w-0 space-y-8', isEmpty && 'hidden']}>
        {/* ───────────────── پرسش و پاسخ فنی ───────────────── */}
        <div>
          <h3 class="text-lg font-black text-steel-900 mb-3 flex items-center gap-2">
            پرسش فنی
            {questions.length > 0 && (
              <span class="text-xs font-bold text-steel-600 bg-steel-100 rounded px-2 py-0.5 tabular-nums">
                {questions.length}
              </span>
            )}
          </h3>

          {questions.length === 0 ? (
            <p class="text-sm text-steel-600 leading-7 bg-steel-50 border border-steel-300 rounded-lg p-4">
              هنوز پرسشی ثبت نشده. اگر درباره‌ی سازگاری این قطعه با دستگاه خود تردید دارید،
              اولین پرسش را شما بپرسید — کارشناس فنی پاسخ می‌دهد.
            </p>
          ) : (
            <ul role="list" class="space-y-3">
              {questions.map((q) => (
                <li class="border border-steel-300 rounded-lg overflow-hidden">
                  <div class="p-4 bg-white">
                    <div class="flex items-baseline justify-between gap-3 mb-1.5">
                      <span class="font-black text-steel-900 text-sm">{q.author}</span>
                      <span class="text-xs text-steel-600 shrink-0">{faDate(q.date)}</span>
                    </div>
                    {q.craneModel && (
                      <p class="text-xs text-accent-ink font-bold mb-1.5">دستگاه: {q.craneModel}</p>
                    )}
                    <p class="text-steel-700 leading-7 text-sm">{q.content}</p>
                  </div>

                  {q.answer ? (
                    <div class="p-4 bg-accent-soft border-t border-accent/25">
                      <p class="text-xs font-black text-accent-ink mb-1.5 flex items-center gap-1.5">
                        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        پاسخ کارشناس فنی{q.answerAuthor ? ` — ${q.answerAuthor}` : ''}
                      </p>
                      <p class="text-steel-800 leading-7 text-sm">{q.answer}</p>
                    </div>
                  ) : (
                    <p class="px-4 py-2 bg-steel-50 border-t border-steel-100 text-xs text-steel-600">
                      در انتظار پاسخ کارشناس فنی
                    </p>
                  )}
                </li>
              ))}
            </ul>
          )}
        </div>

        {/* ───────────────── گزارش نصب ─────────────────
            این بخش در خواسته‌ی اولیه نبود. اضافه شد چون در خرید قطعه‌ی
            صنعتی، «روی دماگ ۵ تن نصب شد و ۱۴ ماه است کار می‌کند» از هر
            امتیاز ستاره‌ای متقاعدکننده‌تر است و دقیقاً همان سوال
            سازگاری را جواب می‌دهد. */}
        <div>
          <h3 class="text-lg font-black text-steel-900 mb-3 flex items-center gap-2">
            گزارش نصب واقعی
            {fitments.length > 0 && (
              <span class="text-xs font-bold text-white bg-accent rounded px-2 py-0.5 tabular-nums">
                {fitments.length}
              </span>
            )}
          </h3>

          {fitments.length === 0 ? (
            <p class="text-sm text-steel-600 leading-7 bg-steel-50 border border-steel-300 rounded-lg p-4">
              هنوز گزارشی ثبت نشده. اگر این قطعه را نصب کرده‌اید، ثبت مدل دستگاه و مدت کارکرد
              برای خریدار بعدی ارزش زیادی دارد.
            </p>
          ) : (
            <ul role="list" class="grid sm:grid-cols-2 gap-3">
              {fitments.map((f) => (
                <li class="border-2 border-accent/25 bg-accent-soft rounded-lg p-4">
                  <p class="font-black text-steel-900 text-sm mb-1">{f.craneModel}</p>
                  {f.serviceMonths > 0 && (
                    <p class="text-xs font-bold text-accent-ink mb-2 tabular-nums">
                      {f.serviceMonths} ماه کارکرد بدون مشکل
                    </p>
                  )}
                  <p class="text-steel-700 leading-7 text-sm">{f.content}</p>
                  <p class="text-xs text-steel-600 mt-2">{f.author} — {faDate(f.date)}</p>
                </li>
              ))}
            </ul>
          )}
        </div>

        {/* ───────────────── نظر خریداران ───────────────── */}
        {reviews.length > 0 && (
          <div>
            <h3 class="text-lg font-black text-steel-900 mb-3">نظر خریداران</h3>
            <ul role="list" class="space-y-3">
              {reviews.map((r) => (
                <li class="border border-steel-300 rounded-lg p-4">
                  <div class="flex items-baseline justify-between gap-3 mb-1.5">
                    <span class="font-black text-steel-900 text-sm">{r.author}</span>
                    <span class="text-xs text-steel-600 shrink-0">{faDate(r.date)}</span>
                  </div>
                  {r.rating > 0 && (
                    <p class="text-sm text-accent mb-1.5" aria-label={`امتیاز ${r.rating} از ۵`}>
                      {'★'.repeat(r.rating)}<span class="text-steel-300">{'★'.repeat(5 - r.rating)}</span>
                    </p>
                  )}
                  <p class="text-steel-700 leading-7 text-sm">{r.content}</p>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>

      {/* ───────────────── فرم ارسال (یک فرم، سه نیت) ─────────────────
          ⚠️ بازطراحی — سه ایراد هم‌زمان رفع شد:

          ۱) سه جعبه‌ی جدا روی هم چیده شده بود و ستون کناری را شلوغ
             می‌کرد، در حالی که ستون مقابل خالی می‌ماند.
          ۲) راهی برای ثبت «نظر ساده» وجود نداشت. کسی که قطعه را نصب
             نکرده اما می‌خواست نظر بدهد، هیچ جایی نداشت — با این‌که
             اندپوینت /review از قبل در افزونه ساخته شده بود و بی‌استفاده
             مانده بود.
          ۳) عنوان «مدل جرثقیل» گمراه‌کننده بود.

          حالا یک فرم با سه نیت: پرسش، تجربه‌ی نصب، نظر کلی. فیلدهای
          غیرمرتبط با نیتِ انتخاب‌شده پنهان و از اعتبارسنجی خارج می‌شوند،
          و اندپوینت هم بر همان اساس عوض می‌شود. */}
      <aside class:list={[!isEmpty && 'lg:sticky lg:top-24']}>
        {canSubmit ? (
          <form
            class="cy-community-form bg-steel-50 border border-steel-300 rounded-lg p-4"
            data-endpoint-base={`${wpBase}/wp-json/crane-yadak/v1`}
            data-post-id={productId}
          >
            <h3 class="font-black text-steel-900 mb-3">مشارکت شما</h3>

            {/* انتخاب نیت — رادیو، نه تب: بدون جاوااسکریپت هم قابل استفاده
                است و صفحه‌خوان گروه را درست اعلام می‌کند. */}
            <fieldset class="mb-3">
              <legend class="sr-only">نوع مشارکت</legend>
              <div class="grid grid-cols-3 gap-1 bg-white border border-steel-300 rounded-md p-1">
                {[
                  { v: 'question', label: 'پرسش فنی' },
                  { v: 'fitment', label: 'تجربه‌ی نصب' },
                  { v: 'review', label: 'نظر کلی' },
                ].map((opt, i) => (
                  <label class="cy-intent-tab relative">
                    <input
                      type="radio"
                      name="intent"
                      value={opt.v}
                      checked={i === 0}
                      class="peer sr-only"
                    />
                    <span class="block text-center text-xs font-bold py-2 rounded cursor-pointer text-steel-700 peer-checked:bg-accent peer-checked:text-white peer-focus-visible:ring-4 peer-focus-visible:ring-accent/40 transition-colors">
                      {opt.label}
                    </span>
                  </label>
                ))}
              </div>
            </fieldset>

            <p class="cy-intent-hint text-xs text-steel-600 leading-6 mb-3"></p>

            <label class="cyh-honeypot" aria-hidden="true">
              وب‌سایت <input type="text" name="website" tabindex="-1" autocomplete="off" />
            </label>

            <div class="space-y-2">
              <input type="text" name="name" required placeholder="نام شما" class="w-full text-sm border border-steel-300 rounded-md px-3 py-2 focus:outline-none focus:ring-4 focus:ring-accent/40" />

              {/* «دستگاه» به‌جای «جرثقیل»:
                  این قطعه ممکن است روی جرثقیل سقفی، دروازه‌ای، بازویی یا
                  یک بالابر مستقل نصب شود. «جرثقیل» کاربرِ بالابرِ مستقل را
                  سردرگم می‌کرد. عمداً «محصول» هم نشد — مدلِ محصول از روی
                  همین صفحه معلوم است؛ چیزی که کارشناس برای پاسخ لازم دارد
                  مدلِ *دستگاهِ میزبان* است. */}
              <input type="text" name="crane_model" data-field="machine" placeholder="مدل و برند دستگاه (مثلاً دماگ DH ۵ تن)" class="w-full text-sm border border-steel-300 rounded-md px-3 py-2 focus:outline-none focus:ring-4 focus:ring-accent/40" />

              <input type="number" name="service_months" data-field="months" min="0" placeholder="چند ماه کار کرده؟" class="w-full text-sm border border-steel-300 rounded-md px-3 py-2 focus:outline-none focus:ring-4 focus:ring-accent/40" />

              <div data-field="rating" hidden>
                <label class="block text-xs font-bold text-steel-700 mb-1" for="cy-rating">امتیاز شما</label>
                <select id="cy-rating" name="rating" class="w-full text-sm border border-steel-300 rounded-md px-3 py-2 focus:outline-none focus:ring-4 focus:ring-accent/40">
                  <option value="5">۵ — عالی</option>
                  <option value="4">۴ — خوب</option>
                  <option value="3">۳ — متوسط</option>
                  <option value="2">۲ — ضعیف</option>
                  <option value="1">۱ — بد</option>
                </select>
              </div>

              <textarea name="body" required rows="3" class="cy-body w-full text-sm border border-steel-300 rounded-md px-3 py-2 focus:outline-none focus:ring-4 focus:ring-accent/40 resize-y"></textarea>
            </div>

            <button type="submit" class="cy-submit w-full mt-3 bg-accent text-white py-3 rounded-md font-black hover:bg-accent-ink transition-colors focus:outline-none focus:ring-4 focus:ring-accent/40 min-h-[48px]">
              ارسال
            </button>
            <p class="cy-form-msg text-xs leading-6 mt-2" role="status" aria-live="polite"></p>
          </form>
        ) : (
          /* بدون آدرس وردپرس، فرم رندر نمی‌شود — فرمی که به هیچ‌جا ارسال
             نمی‌کند، بدتر از نبودن فرم است چون کاربر فکر می‌کند پیامش
             رسیده. */
          <div class="bg-steel-50 border border-steel-300 rounded-lg p-4">
            <p class="text-sm text-steel-700 leading-7">
              برای پرسش فنی درباره‌ی این قطعه با ما تماس بگیرید.
            </p>
            <a href="/contact" class="inline-block mt-3 bg-accent text-white px-5 py-2.5 rounded-md font-bold text-sm hover:bg-accent-ink transition-colors">
              تماس و استعلام
            </a>
          </div>
        )}
      </aside>
    </div>
  </div>
</section>

<script>
  // ارسال با fetch — سایت استاتیک است، پس مقصد مستقیماً وردپرس است.
  document.querySelectorAll<HTMLFormElement>('.cy-community-form').forEach((form) => {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const msg = form.querySelector<HTMLElement>('.cy-form-msg');
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      // اندپوینت از روی نیتِ انتخاب‌شده ساخته می‌شود، نه از یک صفت ثابت.
      const base = form.dataset.endpointBase;
      const intent = form.querySelector<HTMLInputElement>('input[name="intent"]:checked')?.value ?? 'question';
      const endpoint = base ? `${base}/${intent}` : null;
      if (!endpoint || !msg || !button) return;

      const payload: Record<string, string> = { post_id: form.dataset.postId ?? '' };
      for (const [key, value] of new FormData(form).entries()) {
        // `intent` فقط برای انتخاب اندپوینت است و نباید به سرور برود.
        if (key === 'intent') continue;
        const text = String(value);
        // فیلد خالی اصلاً ارسال نمی‌شود تا در وردپرس متای تهی ساخته نشود.
        if (text.trim() !== '') payload[key] = text;
      }

      button.disabled = true;
      const original = button.textContent;
      button.textContent = 'در حال ارسال…';
      msg.className = 'cy-form-msg text-xs leading-6 mt-2 text-steel-600';
      msg.textContent = '';

      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json().catch(() => ({}));

        if (res.ok && data.ok) {
          msg.className = 'cy-form-msg text-xs leading-6 mt-2 text-green-700 font-bold';
          msg.textContent = data.message ?? 'ثبت شد.';
          form.reset();
        } else {
          msg.className = 'cy-form-msg text-xs leading-6 mt-2 text-red-700 font-bold';
          msg.textContent = data.message ?? 'ثبت نشد. لطفاً دوباره تلاش کنید.';
        }
      } catch {
        msg.className = 'cy-form-msg text-xs leading-6 mt-2 text-red-700 font-bold';
        msg.textContent = 'ارتباط با سرور برقرار نشد. اتصال اینترنت را بررسی کنید.';
      } finally {
        button.disabled = false;
        button.textContent = original;
      }
    });
  });

  /* ───────────────── تعویض نیت فرم ─────────────────
     هر نیت فیلدهای خودش را دارد. فیلدِ پنهان باید هم از دید و هم از
     اعتبارسنجی خارج شود؛ اگر فقط پنهان شود و `required` بماند، مرورگر
     روی یک فیلد نامرئی خطا می‌دهد و کاربر هیچ‌وقت نمی‌فهمد چرا فرم
     ارسال نمی‌شود. */
  const INTENTS: Record<string, {
    hint: string;
    placeholder: string;
    submit: string;
    show: string[];
    requireMachine: boolean;
  }> = {
    question: {
      hint: 'کارشناس فنی پاسخ می‌دهد و پرسش و پاسخ روی همین صفحه منتشر می‌شود.',
      placeholder: 'پرسش فنی خود را بنویسید…',
      submit: 'ارسال پرسش',
      show: ['machine'],
      requireMachine: false,
    },
    fitment: {
      hint: 'ثبت مدل دستگاه و مدت کارکرد، برای خریدار بعدی از هر توضیحی مفیدتر است.',
      placeholder: 'تجربه‌ی نصب و کارکرد…',
      submit: 'ثبت گزارش نصب',
      show: ['machine', 'months'],
      requireMachine: true,
    },
    review: {
      hint: 'نظرتان درباره‌ی این قطعه — حتی اگر آن را نصب نکرده‌اید.',
      placeholder: 'نظر خود را بنویسید…',
      submit: 'ثبت نظر',
      show: ['rating'],
      requireMachine: false,
    },
  };

  document.querySelectorAll<HTMLFormElement>('.cy-community-form').forEach((form) => {
    const hint = form.querySelector<HTMLElement>('.cy-intent-hint');
    const body = form.querySelector<HTMLTextAreaElement>('.cy-body');
    const submit = form.querySelector<HTMLButtonElement>('.cy-submit');
    const machine = form.querySelector<HTMLInputElement>('[data-field="machine"]');

    function apply() {
      const value = form.querySelector<HTMLInputElement>('input[name="intent"]:checked')?.value ?? 'question';
      const config = INTENTS[value];
      if (!config) return;

      for (const field of ['machine', 'months', 'rating']) {
        const el = form.querySelector<HTMLElement>(`[data-field="${field}"]`);
        if (!el) continue;
        const visible = config.show.includes(field);
        el.hidden = !visible;
        // ورودی پنهان از ارسال هم خارج می‌شود تا داده‌ی بی‌ربط نرود.
        el.querySelectorAll?.('input, select')?.forEach?.((c) => {
          (c as HTMLInputElement).disabled = !visible;
        });
        if (el instanceof HTMLInputElement || el instanceof HTMLSelectElement) el.disabled = !visible;
      }

      if (machine) machine.required = config.requireMachine;
      if (hint) hint.textContent = config.hint;
      if (body) body.placeholder = config.placeholder;
      if (submit) submit.textContent = config.submit;
    }

    form.querySelectorAll<HTMLInputElement>('input[name="intent"]').forEach((radio) => {
      radio.addEventListener('change', apply);
    });
    apply();
  });
</script>

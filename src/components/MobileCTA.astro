---
// src/components/MobileCTA.astro
// نوار تماس چسبان (Sticky Mobile CTA) — فقط در موبایل نمایش داده می‌شود.
// چرا؟ در یک سایت B2B با مخاطب صنعتی، بیشترین نرخ تبدیل موبایل از طریق
// «تماس مستقیم» و «پیام در واتساپ/تلگرام» اتفاق می‌افتد، نه پر کردن فرم؛
// این کامپوننت آن سه اکشن حیاتی را همیشه در دسترس نگه می‌دارد بدون نیاز
// به اسکرول به بالا یا پایین صفحه (کاهش اصطکاک = افزایش نرخ تبدیل).
// دسترس‌پذیری: nav با aria-label مستقل، دکمه‌ها حداقل ۴۴×۴۴px (اندازه لمسی
// استاندارد اپل/گوگل) و focus ring مشخص برای کاربران کیبورد/صفحه‌خوان.
import { SITE } from '../data/site';
---

<nav
  class="md:hidden fixed bottom-0 inset-x-0 z-40 bg-white border-t border-gray-200 shadow-[0_-4px_16px_rgba(0,0,0,0.08)] grid grid-cols-3"
  style="padding-bottom: env(safe-area-inset-bottom, 0px);"
  aria-label="راه‌های ارتباطی سریع"
>
  <a
    href={`tel:${SITE.phone}`}
    class="flex flex-col items-center justify-center gap-1 py-2.5 min-h-[56px] text-crane-navy hover:bg-gray-50 active:bg-gray-100 transition-colors focus:outline-none focus:ring-2 focus:ring-inset focus:ring-crane-orange"
  >
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
    </svg>
    <span class="text-[11px] font-bold">تماس</span>
  </a>

  <a
    href={`https://wa.me/${SITE.whatsapp.replace('+', '')}`}
    target="_blank"
    rel="noopener noreferrer"
    class="flex flex-col items-center justify-center gap-1 py-2.5 min-h-[56px] text-emerald-700 border-x border-gray-100 hover:bg-emerald-50 active:bg-emerald-100 transition-colors focus:outline-none focus:ring-2 focus:ring-inset focus:ring-crane-orange"
  >
    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12.04 2c-5.523 0-10 4.477-10 10 0 1.766.46 3.484 1.335 5L2 22l5.13-1.345A9.96 9.96 0 0012.04 22c5.523 0 10-4.477 10-10s-4.477-10-10-10zm5.87 14.13c-.245.69-1.42 1.32-1.96 1.4-.5.08-1.13.11-1.82-.115-.42-.135-.96-.315-1.65-.615-2.9-1.25-4.79-4.17-4.94-4.365-.145-.195-1.18-1.57-1.18-3 0-1.43.75-2.13 1.02-2.42.27-.29.585-.36.78-.36.195 0 .39 0 .56.01.18.01.42-.07.655.5.245.585.83 2.015.9 2.16.07.15.115.32.02.515-.095.195-.145.315-.29.485-.145.17-.305.38-.435.51-.145.145-.295.305-.125.6.17.295.755 1.245 1.62 2.015 1.115.995 2.055 1.3 2.35 1.445.295.145.465.12.635-.075.17-.195.73-.85.925-1.145.195-.295.39-.245.655-.145.265.095 1.68.79 1.965.935.285.145.475.215.545.335.07.12.07.69-.175 1.38z" />
    </svg>
    <span class="text-[11px] font-bold">واتساپ</span>
  </a>

  <a
    href={`https://t.me/${SITE.telegram}`}
    target="_blank"
    rel="noopener noreferrer"
    class="flex flex-col items-center justify-center gap-1 py-2.5 min-h-[56px] text-sky-700 hover:bg-sky-50 active:bg-sky-100 transition-colors focus:outline-none focus:ring-2 focus:ring-inset focus:ring-crane-orange"
  >
    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M22 4.01l-19.5 7.5a.6.6 0 000 1.12l4.86 1.68 1.86 5.98a.6.6 0 001.04.19l2.72-3.06 4.9 3.62a.6.6 0 00.95-.36L22 4.5a.6.6 0 00-.5-.6.6.6 0 00-.5.11zM8.5 13.6l9.3-6.02-8 7.24-.3 3.06-1-4.28z" />
    </svg>
    <span class="text-[11px] font-bold">تلگرام</span>
  </a>
</nav>

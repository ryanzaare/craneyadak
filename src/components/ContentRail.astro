---
// src/components/ContentRail.astro — ستون کناری چسبان کنار بلوک‌های محتوا (دسکتاپ، lg به بالا)
// ---------------------------------------------------------------------------
// ⚠️ چرا (کارفرما، ۲۹ آبان ۱۴۰۵): «سمت چپ هر متن جای خالی است؛ راه‌حل برای همه‌ی صفحه‌ها، نه فقط ساگا». ستون متن
// عمداً ~۷۰ نویسه است (خوانایی) و در ظرف ۱۲۸۰px نیمی از عرض خالی می‌ماند. پهن کردن متن خوانایی را می‌کشد؛ پس آن
// نیمه کار مفید می‌گیرد — همان کاری که دیجی‌کالا با جعبه‌ی خرید چسبان می‌کند:
//   محصول: کارت سفارش (عکس، نام، کد، پیش‌فاکتور، واتساپ) + قطعه‌یاب. بقیه‌ی صفحه‌ها: قطعه‌یاب.
// ⚠️ فقط عمل سریع، هیچ فهرستی (۳۰ آبان ۱۴۰۵): راهنماهای مرتبط و محصول مرتبط که روز قبل این‌جا بودند به «ادامه‌ی
// مسیر» (ExploreMore) رفتند — این ستون فقط دسکتاپ است، پس فهرست این‌جا یا در موبایل گم بود یا در دسکتاپ تکرار می‌شد.
// ⚠️ فهرست بخش‌ها هم نه: نوار چسبان «در این صفحه» (SectionNav) همان را دارد.
// ⚠️ موبایل (زیر lg) رندر نمی‌شود: آنجا نوار پایین (ActionBar) کار کارت سفارش را می‌کند و ستون کناری جایی ندارد.
// ⚠️ فقط داده‌ی واقعی: کارتی که داده ندارد (بی واتساپ) رندر نمی‌شود.
// ---------------------------------------------------------------------------
import RemoteImage from './RemoteImage.astro';
import { getContact } from '../lib/site-options';

export interface Props {
  product?: { name: string; sku: string | null; image: { url: string; altText?: string | null } | null } | null;
}
const { product = null } = Astro.props;
const contact = await getContact();
const wa = contact.whatsappHref && product ? `${contact.whatsappHref}?text=${encodeURIComponent(`استعلام ${product.sku ?? product.name}`)}` : contact.whatsappHref;
const card = 'rounded-md border border-steel-300 bg-white p-4';
---

{product && (
  <div class={`${card} border-s-4 border-s-action`}>
    <div class="flex items-center gap-3 mb-3">
      {product.image && (
        <span class="w-16 h-16 shrink-0 rounded-md border border-steel-200 bg-white p-1">
          <RemoteImage src={product.image.url} alt="" width={128} height={128} sizes="64px" class="w-full h-full object-contain" />
        </span>
      )}
      <span class="min-w-0">
        <span class="block text-sm font-bold text-steel-900 leading-6 line-clamp-2">{product.name}</span>
        {product.sku && <code class="block font-mono text-xs font-bold text-steel-700 mt-0.5" dir="ltr">{product.sku}</code>}
      </span>
    </div>
    <a href="#buy-box" class="flex items-center justify-center min-h-11 rounded-md bg-action text-white text-sm font-bold hover:bg-accent-strong">دریافت پیش‌فاکتور</a>
    {wa && (
      <a href={wa} target="_blank" rel="noopener noreferrer" class="mt-2 flex items-center justify-center min-h-11 rounded-md border border-steel-300 text-sm font-bold text-steel-900 hover:border-steel-500">استعلام در واتساپ</a>
    )}
  </div>
)}

<a href="/part-finder/" class={`${card} block bg-steel-50 hover:border-action`}>
  <span class="block text-sm font-bold text-steel-900">قطعه را پیدا نمی‌کنید؟</span>
  <span class="block text-sm text-steel-600 leading-6 mt-1">کد فنی را جستجو کنید یا عکس پلاک را بفرستید — قطعه‌یاب ←</span>
</a>

---
// src/components/ContentBlocks.astro
// ---------------------------------------------------------------------------
// رندر پالت بلوک‌ها — یک کامپوننت برای برند، محصول و دسته.
//
// این فایل جایگزین بخش‌های اختصاصیِ صفحه‌ی برند می‌شود. هر چیزی که آنجا
// دستی ساخته شده بود (جدول سری‌ها، قطعات پرتقاضا، پرسش‌های متداول) اینجا
// یک *نوع بلوک* است که هر موجودیتی می‌تواند استفاده کند.
//
// دلیل وجودی‌اش در `src/lib/content-blocks.ts` توضیح داده شده.
// ---------------------------------------------------------------------------

import SectionNav from './SectionNav.astro';
import { getImage } from 'astro:assets';
import { autolinkHtml } from '../lib/autolink';
import { wrapProseTables, normalizeProseImages, optimizeProseImages, mergeAudit, reportImageAudit, EMPTY_AUDIT } from '../lib/prose-html';
import { findCategory, categoryPath } from '../data/taxonomy';
import type { ContentBlock } from '../lib/content-blocks';
import { parseVideoUrl, videoBlocksFirst } from '../lib/video-embed';
import RemoteImage from './RemoteImage.astro';
import Logo from './Logo.astro';

export interface Props {
  blocks: readonly ContentBlock[];
  /** برای aria-label ناوبری و سرتیتر پنهان. */
  title: string;
  reviewMode?: boolean;
  eyebrow?: string;
  /** تصویر اصلی صفحه (مثلاً عکس اول محصول) برای جلد طراحی‌شده‌ی ویدیوهایی که جلد ندارند. */
  coverImage?: { url: string; alt: string } | null;
}

const { blocks: rawBlocks, title, reviewMode = false, eyebrow = 'در این صفحه', coverImage = null } = Astro.props;
// ⚠️ بلوک‌های ویدیودار همیشه اول (کارفرما، ۲۵ آبان ۱۴۰۵: «بلوک ویدیو بالای هر محتوا»). مرتب‌سازی پایدار؛ شماره‌گذاری و
// نوار ناوبری از همین ترتیب ساخته می‌شوند، پس با چیدمان روی صفحه یکی می‌مانند.
const blocks = videoBlocksFirst(rawBlocks);

let imgAudit = EMPTY_AUDIT;
const prose = async (html: string) => {
  if (!html) return '';
  const linked = wrapProseTables(autolinkHtml(html, { currentPath: Astro.url.pathname }));
  const { html: optimised } = await optimizeProseImages(linked, getImage);
  const { html: out, audit } = normalizeProseImages(optimised);
  imgAudit = mergeAudit(imgAudit, audit);
  return out;
};

// متن‌ها پیش از رندر آماده می‌شوند تا شمارش تصاویر پیش از چاپ کامل شود.
const bodies = await Promise.all(blocks.map((b) => prose(b.bodyHtml)));
// یادداشت کناری از همان مسیر عبور می‌کند تا لینک‌های داخلی خودکار در آن
// هم کار کنند — ستون کناری یکی از بهترین جاهای لینک‌دهی داخلی است.
const asides = await Promise.all(blocks.map((b) => prose(b.asideHtml)));
reportImageAudit(imgAudit, title);

/* فقط بلوک‌های عنوان‌دار وارد ناوبری می‌شوند — بلوک بی‌عنوان لنگری برای
   اشاره ندارد و در فهرست، ردیفِ خالی می‌سازد.

   ⚠️ `navLabel` و نه `heading`. تا پیش از این، عنوان کاملِ H2 مستقیم داخل
   نوار می‌رفت و یک جمله‌ی پانزده‌کلمه‌ای تمام عرض نوار را می‌گرفت. مدل
   بلوک حالا هر دو را دارد: عنوان بلند برای گوگل، برچسب کوتاه برای چشم. */
const nav = blocks
  .map((b) => ({ id: b.anchor, label: b.navLabel }))
  .filter((s) => s.label !== '');

const numbered = blocks.filter((b) => b.heading !== '');
const numberOf = (b: ContentBlock) => numbered.indexOf(b) + 1;

/* ═══════════════════════════════════════════════════════════════════════
   داده‌ی ساختاریافته‌ی پرسش و پاسخ
   ═══════════════════════════════════════════════════════════════════════
   ⚠️ ممیزی نشان داد صفحات برند پرسش‌های متداول را *نمایش* می‌دادند ولی
   هیچ FAQPage تولید نمی‌کردند — یعنی محتوایی که برای rich result گوگل
   ساخته شده بود، فقط برای انسان کار می‌کرد و کل مزیتش هدر می‌رفت.

   ⚠️ فقط پرسش‌هایی که *پاسخ* دارند وارد اسکیما می‌شوند. گوگل FAQPage با
   پاسخ خالی را نقض راهنما می‌داند و می‌تواند کل rich result صفحه را حذف
   کند. داده‌ی ساختاریافته باید بازتاب صفحه باشد، نه ادعایی فراتر از آن. */
const faqItems = blocks
  .filter((b) => b.type === 'faq')
  .flatMap((b) => b.faqs)
  .filter((f) => f.question.trim() !== '' && f.answer.trim() !== '');

const faqJsonLd = faqItems.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqItems.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    }
  : null;

/* لحن هشدار. رنگ **تنها** حامل معنا نیست — برچسب متنی همیشه کنارش است،
   وگرنه کوررنگی یا چاپ سیاه‌وسفید پیام ایمنی را از بین می‌برد (WCAG 1.4.1). */
const TONE = {
  danger: { label: 'هشدار ایمنی', box: 'bg-red-50 border-red-300 text-red-950',      dot: 'bg-red-600' },
  note:   { label: 'نکته',        box: 'bg-sky-50 border-sky-300 text-sky-950',      dot: 'bg-sky-600' },
  tip:    { label: 'توصیه',       box: 'bg-emerald-50 border-emerald-300 text-emerald-950', dot: 'bg-emerald-600' },
} as const;

const flag = (needs: boolean) => (reviewMode && needs ? 'bg-amber-50 ring-1 ring-amber-300' : '');
const band = (i: number) => (i % 2 === 1 ? 'bg-steel-50' : '');

/* ═══════════════════════════════════════════════════════════════════════
   ستون کناری
   ═══════════════════════════════════════════════════════════════════════
   مسئله: ستون متن عمداً روی ~۷۰ کاراکتر بسته است (قاعده‌ی خوانایی) ولی
   داخل ظرفی با عرض ۱۲۸۰ پیکسل می‌نشست. نتیجه روی دسکتاپ، نیمی از پهنای
   پنجره سفیدِ بلااستفاده بود.

   ⚠️ راه‌حلِ غلط، پهن‌کردن متن است. طول سطر بلند خوانایی را واقعاً خراب
   می‌کند و این صفحات برای خوانده‌شدن نوشته شده‌اند. پس عرض متن دست‌نخورده
   می‌ماند و *فضای خالی پر می‌شود*، نه ستون متن.

   `justify-center` عمدی است: جفتِ «متن + ستون» با هم وسط‌چین می‌شوند،
   وگرنه همان فضای خالی فقط از یک سمت به سمت دیگر منتقل می‌شد.

   ⚠️ نقطه‌ی شکست `lg` (۱۰۲۴px) است و نه `xl` (۱۲۸۰px). نسخه‌ی اول روی
   `xl` بود و این یک اشتباه واقعی بود: پنجره‌ی مرورگر روی مک‌بوک معمولاً
   باریک‌تر از ۱۲۸۰ است، پس ستون کناری برای کسی که سفارشش را داده بود
   **هرگز فعال نمی‌شد** — فیچر ساخته و نامرئی. CSS تولید شده بود، کلاس
   روی عنصر بود، و باز هیچ‌چیز دیده نمی‌شد.

   در ۱۰۲۴px حساب سر جایش است: ۹۹۲ پیکسل محتوا منهای ۲۸۸ (ستون) و ۴۸
   (فاصله) یعنی ۶۵۶ پیکسل برای متن. `minmax(0,70ch)` اجازه می‌دهد ستون
   متن کمی جمع شود به‌جای اینکه شبکه سرریز کند.

   پایین‌تر از `lg`، یادداشت زیر متن جریان پیدا می‌کند — روی موبایل ستون
   کناری یعنی دو ستون باریکِ ناخوانا. */
/* ⚠️ کلاس‌ها **کامل و ثابت** نوشته شده‌اند، نه ساخته‌شده با درون‌یابی.
   Tailwind سورس را متنی اسکن می‌کند؛ `xl:grid-cols-[${cols}_18rem]` هرگز
   به‌عنوان یک کلاس دیده نمی‌شود، پس CSSاش تولید نمی‌شود و چیدمان بی‌هیچ
   خطایی از هم می‌پاشد — یک «شکست بی‌صدا»ی تمام‌عیار. */
const RAIL_BASE = 'lg:grid lg:gap-12 lg:items-start lg:justify-center';
const RAIL_TEXT = 'lg:grid-cols-[minmax(0,70ch)_18rem]';
const RAIL_WIDE = 'lg:grid-cols-[minmax(0,1fr)_18rem]';

const rail = (b: ContentBlock): string =>
  b.asideHtml === '' ? '' : `${RAIL_BASE} ${b.type === 'text' ? RAIL_TEXT : RAIL_WIDE}`;
---

{blocks.length > 0 && (
  <>
    {faqJsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
    )}

    <SectionNav sections={nav} eyebrow={eyebrow} ariaLabel={`بخش‌های ${title}`} />

    <div class="bg-white">
      {blocks.map((b, i) => (
        <section
          id={b.anchor}
          class={`px-4 py-16 border-t border-steel-100 scroll-mt-32 ${band(i)} ${flag(b.needsReview)}`}
          aria-labelledby={b.heading ? `${b.anchor}-h` : undefined}
        >
          <div class="max-w-7xl mx-auto">
            {b.heading && (
              <div class="flex items-start gap-4 mb-8">
                <span class="shrink-0 w-11 h-11 rounded-md bg-steel-900 text-white flex items-center justify-center font-mono font-bold text-base tabular-nums border-s-4 border-s-action" aria-hidden="true">
                  {numberOf(b)}
                </span>
                <div>
                  <h2 id={`${b.anchor}-h`} class="text-2xl md:text-3xl font-bold text-steel-900 leading-relaxed">{b.heading}</h2>
                  {b.type === 'table' && b.intro && <p class="text-steel-600 mt-1">{b.intro}</p>}
                </div>
              </div>
            )}

            <div class={rail(b)}>
            <div class="min-w-0">

            {/* ── متن ────────────────────────────────────────────────── */}
            {b.type === 'text' && (
              <div class="prose-crane max-w-[70ch] text-xl text-steel-700 leading-9" set:html={bodies[i]} />
            )}

            {/* ── جدول ───────────────────────────────────────────────── */}
            {b.type === 'table' && (
              <div class="table-scroll bg-white rounded-md border border-steel-300">
                <table class="w-full text-sm">
                  <thead>
                    <tr class="bg-steel-50 border-b border-steel-200">
                      {b.columns.map((c) => (
                        <th scope="col" class="text-right font-bold text-steel-900 px-5 py-3 whitespace-nowrap">{c}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {b.rows.map((row, r) => (
                      <tr class={`border-b border-steel-100 last:border-0 transition-colors hover:bg-accent-soft/40 ${r % 2 ? 'bg-steel-50/50' : ''}`}>
                        {row.cells.map((cell, c) => (
                          c === 0
                            ? <th scope="row" class="text-right px-5 py-4 font-bold text-steel-900 whitespace-nowrap align-top border-s-2 border-s-action/40">{cell || '—'}</th>
                            : <td class="px-5 py-4 text-steel-700 leading-7 align-top">{cell || '—'}</td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}

            {/* ── پرسش و پاسخ ────────────────────────────────────────── */}
            {b.type === 'faq' && (
              <div class="max-w-3xl space-y-3">
                {b.faqs.map((f) => (
                  <details class="group rounded-md bg-white border border-steel-200 border-s-4 border-s-transparent open:border-s-action overflow-hidden transition-colors">
                    <summary class="cursor-pointer list-none px-6 py-4 font-bold text-steel-900 flex items-center justify-between gap-4 hover:bg-accent-soft/50 transition-colors">
                      <span>{f.question}</span>
                      <span class="shrink-0 w-6 h-6 grid place-items-center rounded-full bg-accent-soft text-accent-ink text-xl leading-none transition-transform group-open:rotate-45" aria-hidden="true">+</span>
                    </summary>
                    <div class="px-6 pb-5 text-steel-700 leading-8 whitespace-pre-line">{f.answer}</div>
                  </details>
                ))}
              </div>
            )}

            {/* ── مشخصات فنی ─────────────────────────────────────────── */}
            {b.type === 'specs' && (
              /* <dl> و نه <table>: این‌ها جفت‌های نام/مقدارند، نه یک ماتریس.
                 همین تمایز معنایی است که اجازه می‌دهد صفحه‌ی محصول از این
                 بلوک `additionalProperty` بسازد. */
              <dl class="grid gap-x-8 gap-y-0 sm:grid-cols-2 max-w-4xl">
                {b.specs.map((sp) => (
                  <div class="flex items-baseline justify-between gap-4 border-b border-steel-100 py-3">
                    <dt class="text-steel-600 shrink-0">{sp.label}</dt>
                    <dd class="font-bold text-steel-900 text-left tabular-nums">
                      {sp.value}{sp.unit && <span class="font-bold text-steel-500 text-sm"> {sp.unit}</span>}
                    </dd>
                  </div>
                ))}
              </dl>
            )}

            {/* ── هشدار ──────────────────────────────────────────────── */}
            {b.type === 'callout' && (
              <div
                role="note"
                class={`max-w-3xl rounded-md border-2 px-6 py-5 ${TONE[b.tone].box}`}
              >
                <p class="flex items-center gap-2 font-bold text-sm mb-2">
                  <span class={`w-2 h-2 rounded-full ${TONE[b.tone].dot}`} aria-hidden="true"></span>
                  {TONE[b.tone].label}
                </p>
                <p class="leading-8 whitespace-pre-line">{b.calloutBody}</p>
              </div>
            )}

            {/* ── قطعات مرتبط ────────────────────────────────────────── */}
            {b.type === 'parts' && (
              <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" role="list">
                {b.parts.map((p) => {
                  // لینک به مسیر واقعی دسته، نه صفحه‌ی جستجو: ارزش پیوندی
                  // به سیلو منتقل می‌شود. صفحه‌ی جستجو معمولاً noindex است.
                  const cat = p.categorySlug ? findCategory(p.categorySlug) : undefined;
                  return (
                    <li class="rounded-md border border-steel-300 p-5 transition-all duration-150 hover:-translate-y-0.5 hover:border-action hover:shadow-[0_6px_16px_rgba(15,23,42,0.08)]">
                      <h3 class="font-bold text-steel-900 mb-2">{p.partName}</h3>
                      {p.failureReason && <p class="text-sm text-steel-600 leading-7 mb-3">{p.failureReason}</p>}
                      {cat && (
                        <a href={categoryPath(cat)} class="text-sm font-bold text-accent-ink hover:underline">
                          دیدن {p.categoryName ?? cat.name} ←
                        </a>
                      )}
                    </li>
                  );
                })}
              </ul>
            )}

            {/* ── رسانه ──────────────────────────────────────────────── */}
            {b.type === 'media' && (
              <div class={`grid gap-6 ${b.media.length > 1 ? 'sm:grid-cols-2 lg:grid-cols-3' : 'max-w-3xl'}`}>
                {b.media.map((m) => (
                  <figure class="rounded-md overflow-hidden border border-steel-200 bg-white">
                    {m.kind === 'video' && m.videoUrl ? (() => {
                      const embed = parseVideoUrl(m.videoUrl);
                      const label = m.alt || m.caption || b.heading || 'ویدیو';
                      const cover = (
                        /* ⚠️ جلد طراحی‌شده‌ی یکسان برای همه‌ی ویدیوها (کارفرما: «جلد با سبک ثابت»): زمینه‌ی گرافیت، عکس
                           واقعی قطعه در کاشی سفید، عنوان، نشان و دکمه‌ی پخش نارنجی — تمام CSS، بدون فایل تصویر تازه و بدون
                           هوش مصنوعی (قاعده‌ی ۹: عکس قطعه دست‌نخورده). جلد آپلودی کارفرما (m.url) اگر باشد جای آن می‌نشیند. */
                        m.url ? (
                          <RemoteImage src={m.url} alt={m.alt} width={960} height={540} sizes="(max-width: 768px) 100vw, 768px" class="w-full h-full object-cover" />
                        ) : (
                          <span class="absolute inset-0 grid grid-cols-[1fr_auto] items-center gap-3 p-4 md:gap-4 md:p-8 bg-gradient-to-l from-steel-900 to-steel-800 text-right" aria-hidden="true">
                            <span class="flex flex-col gap-2 min-w-0">
                              <span class="text-xs font-bold text-accent">ویدیو · {embed?.provider === 'youtube' ? 'یوتیوب' : 'آپارات'}</span>
                              <span class="text-base md:text-2xl font-black text-white leading-7 md:leading-10 line-clamp-2 md:line-clamp-3">{label}</span>
                              <span class="hidden sm:flex items-center gap-2 mt-1 text-xs text-steel-300"><Logo inverse class="w-6 h-6" /> کرین یدک</span>
                              {/* دکمه‌ی پخش در ستون متن، نه وسط قاب: وسط قاب روی عنوان می‌نشست (preview، ۲۵ آبان). */}
                              <span class="mt-1 md:mt-2 inline-flex items-center gap-2 self-start rounded-full bg-action text-white text-sm font-bold ps-3 pe-4 py-2 group-hover:bg-accent-ink transition-colors">
                                <svg viewBox="0 0 24 24" class="w-5 h-5" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
                                پخش ویدیو
                              </span>
                            </span>
                            {coverImage && (
                              <span class="w-24 h-24 sm:w-28 sm:h-28 md:w-48 md:h-48 rounded-md bg-white p-1.5 md:p-2 shadow-sm">
                                <RemoteImage src={coverImage.url} alt="" width={240} height={240} sizes="(max-width: 768px) 112px, 192px" class="w-full h-full object-contain" />
                              </span>
                            )}
                          </span>
                        )
                      );
                      const play = (
                        <span class="absolute inset-0 grid place-items-center pointer-events-none" aria-hidden="true">
                          <span class="w-16 h-16 rounded-full bg-action text-white grid place-items-center shadow-sm group-hover:scale-110 transition-transform">
                            <svg viewBox="0 0 24 24" class="w-7 h-7 translate-x-0.5" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
                          </span>
                        </span>
                      );
                      /* الگوی facade: هیچ iframeای تا کلیک کاربر ساخته نمی‌شود (جاسازی مستقیم آپارات بیش از ۵۰۰KB به هر بازدید
                         می‌افزاید). کلیک ← iframe همان‌جا، داخل سایت (کارفرما: «نه زبانه‌ی تازه»). نشانی ناشناخته: لینک زبانه‌ی تازه. */
                      return embed ? (
                        <div class="video-facade relative aspect-video bg-steel-900" data-embed={embed.embedUrl} data-title={label}>
                          <button type="button" class="group absolute inset-0 w-full h-full cursor-pointer" aria-label={`پخش ویدیو: ${label}`}>
                            {cover}
                            {m.url && play}
                          </button>
                          <noscript><a href={m.videoUrl} class="absolute bottom-2 start-2 text-xs text-white underline">تماشا در {embed.provider === 'youtube' ? 'یوتیوب' : 'آپارات'}</a></noscript>
                        </div>
                      ) : (
                        <a href={m.videoUrl} target="_blank" rel="noopener" class="group block relative aspect-video bg-steel-900" aria-label={`پخش ویدیو: ${label}`}>
                          {cover}
                          {m.url && play}
                        </a>
                      );
                    })() : (
                      m.url && (
                        /* AVIF مثل بقیه‌ی تصاویر سایت (کارفرما: «همه‌ی عکس‌ها avif»). تا ۲۵ آبان ۱۴۰۵ این‌جا <img> خام
                           وردپرس بود — JPEG اصلی بی‌تغییر اندازه. */
                        <RemoteImage src={m.url} alt={m.alt} width={Math.min(m.width ?? 1200, 1200)} height={Math.round(Math.min(m.width ?? 1200, 1200) * ((m.height ?? 1) / (m.width ?? 1)))}
                          sizes="(max-width: 768px) 100vw, 768px" class="w-full h-auto" />
                      )
                    )}
                    {m.caption && (
                      <figcaption class="px-4 py-3 text-sm text-steel-600 border-t border-steel-100">{m.caption}</figcaption>
                    )}
                  </figure>
                ))}
              </div>
            )}

            </div>

            {/* ── ستون کناری ─────────────────────────────────────────── */}
            {b.asideHtml !== '' && (
              <aside class="mt-8 lg:mt-0 lg:sticky lg:top-32 rounded-md bg-white lg:bg-steel-50/70 border border-steel-200 p-5">
                <p class="flex items-center gap-2 text-xs font-bold text-accent-ink mb-2">
                  <span class="w-1.5 h-1.5 rounded-md bg-action" aria-hidden="true"></span>
                  نکته
                </p>
                <div class="prose-aside text-sm text-steel-600 leading-7" set:html={asides[i]} />
              </aside>
            )}
            </div>
          </div>
        </section>
      ))}
    </div>
  </>
)}

<script>
  // پخش ویدیو داخل سایت: با کلیک، جلد جای خود را به iframe می‌دهد (فقط نشانی‌هایی که parseVideoUrl ساخته — data-embed).
  document.querySelectorAll<HTMLElement>('.video-facade').forEach((box) => {
    box.querySelector('button')?.addEventListener('click', () => {
      const src = box.dataset.embed;
      if (!src) return;
      const f = document.createElement('iframe');
      f.src = src;
      f.title = box.dataset.title ?? 'ویدیو';
      f.allow = 'autoplay; fullscreen; picture-in-picture; encrypted-media';
      f.allowFullscreen = true;
      f.className = 'absolute inset-0 w-full h-full border-0';
      box.replaceChildren(f);
    }, { once: true });
  });
</script>

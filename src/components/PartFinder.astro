---
// src/components/PartFinder.astro
// ---------------------------------------------------------------------------
// ابزار جستجوی سریع قطعه.
//
// ⚠️ رفع باگ بحرانی: نسخه‌ی قبلی این فرم کاملاً بی‌اثر بود. سه پارامتر
// `brand`، `cat` و `pn` را به `/search` می‌فرستاد، در حالی که `search.astro`
// فقط `q` را می‌خواند — هر سه بی‌صدا دور ریخته می‌شدند و کاربر به یک صفحه‌ی
// جستجوی خالی می‌رسید. علاوه بر آن، مقادیر دسته (`hoist`، `electrical`، …)
// با هیچ اسلاگ واقعی‌ای در سایت مطابقت نداشت و فهرست برندها هم فقط ۴ تا از
// ۱۸ برند را نشان می‌داد.
//
// این نسخه: گزینه‌ها از تاکسونومی واقعی می‌آیند و هر سه ورودی در یک عبارت
// جستجوی واحد ترکیب و به‌عنوان `q` ارسال می‌شوند — یعنی فرم واقعاً کار
// می‌کند. صفحه‌ی `/search` هم برای سازگاری، پارامترهای جدا را می‌پذیرد و
// خودش ترکیب می‌کند (پس بدون جاوااسکریپت هم چیزی نمی‌شکند).
// ---------------------------------------------------------------------------
import { SILOS, BRANDS } from '../data/taxonomy';
---

<section class="bg-gray-50 px-4 relative z-20" aria-label="ابزار جستجوی سریع قطعات">
  <div class="max-w-5xl mx-auto bg-white rounded-3xl shadow-xl p-6 md:p-8 border border-gray-100 -mt-20 md:-mt-24 mb-12">
    <div class="flex flex-col md:flex-row md:items-center gap-4 mb-6 border-b border-gray-100 pb-4">
      <span class="bg-crane-navy text-white p-3 rounded-xl shadow-md shrink-0 w-12 h-12 flex items-center justify-center" aria-hidden="true">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 21h7a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v11m0 5l4.879-4.879m0 0a3 3 0 104.243-4.242 3 3 0 00-4.243 4.242z"></path></svg>
      </span>
      <div>
        <h2 class="text-xl md:text-2xl font-black text-crane-navy">جستجوی سریع قطعه</h2>
        <p class="text-sm text-gray-600 mt-1">برند، نوع قطعه یا کد فنی — هر کدام را که می‌دانید وارد کنید.</p>
      </div>
    </div>

    <form id="part-finder" action="/search" method="GET" class="grid grid-cols-1 md:grid-cols-4 gap-4">
      <div>
        <label class="block text-xs font-bold text-gray-700 mb-2" for="pf-brand">برند سازنده</label>
        <select id="pf-brand" name="brand" class="w-full bg-gray-50 border border-gray-200 text-gray-800 rounded-xl px-4 py-3.5 min-h-[48px] focus:outline-none focus:ring-2 focus:ring-crane-orange focus:border-transparent font-medium cursor-pointer">
          <option value="">همه برندها</option>
          {BRANDS.map((brand) => (
            <option value={brand.nameFa}>{brand.nameFa} ({brand.nameEn})</option>
          ))}
        </select>
      </div>

      <div>
        <label class="block text-xs font-bold text-gray-700 mb-2" for="pf-category">نوع قطعه</label>
        <select id="pf-category" name="cat" class="w-full bg-gray-50 border border-gray-200 text-gray-800 rounded-xl px-4 py-3.5 min-h-[48px] focus:outline-none focus:ring-2 focus:ring-crane-orange focus:border-transparent font-medium cursor-pointer">
          <option value="">همه قطعات</option>
          {SILOS.map((silo) => (
            <optgroup label={silo.name}>
              {silo.categories.map((category) => (
                <option value={category.name}>{category.name}</option>
              ))}
            </optgroup>
          ))}
        </select>
      </div>

      <div>
        <label class="block text-xs font-bold text-gray-700 mb-2" for="pf-pn">کد فنی (Part Number)</label>
        <input
          id="pf-pn"
          type="search"
          name="pn"
          placeholder="مثال: DMG-1024"
          dir="ltr"
          autocomplete="off"
          class="w-full bg-gray-50 border border-gray-200 text-gray-800 rounded-xl px-4 py-3.5 min-h-[48px] focus:outline-none focus:ring-2 focus:ring-crane-orange focus:border-transparent font-medium text-left font-mono"
        />
      </div>

      <div class="flex items-end">
        <button type="submit" class="w-full bg-crane-navy text-white rounded-xl px-4 py-3.5 min-h-[48px] font-bold hover:bg-gray-800 transition-colors flex items-center justify-center gap-2 focus:outline-none focus:ring-4 focus:ring-crane-navy/30">
          <span>یافتن قطعه</span>
          <svg aria-hidden="true" class="w-5 h-5 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
        </button>
      </div>
    </form>
  </div>
</section>

<script>
  // بهبود تدریجی: سه ورودی را در یک عبارت جستجو ترکیب و به‌صورت `q` ارسال
  // می‌کند تا URL نتیجه تمیز و قابل اشتراک‌گذاری باشد. اگر جاوااسکریپت
  // اجرا نشود، فرم همان سه پارامتر را می‌فرستد و `/search` خودش ترکیب
  // می‌کند — در هر دو حالت جستجو واقعاً انجام می‌شود.
  const form = document.getElementById('part-finder') as HTMLFormElement | null;

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const terms = ['pn', 'brand', 'cat']
      .map((key) => String(data.get(key) ?? '').trim())
      .filter(Boolean);

    const query = terms.join(' ');
    window.location.href = query ? `/search?q=${encodeURIComponent(query)}` : '/search';
  });
</script>

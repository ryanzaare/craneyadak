---
// src/components/EmptyState.astro
// ---------------------------------------------------------------------------
// حالت خالیِ صادقانه (Frontend v2، فاز ۰ — §2 اصل ۶ و تصمیم D).
//
// ⚠️ هرگز «به‌زودی موجود می‌شود» یا تاریخ: نمی‌دانیم. فقط واقعیت («هنوز محصولی ثبت نشده») + راه
// بعدی‌ای که واقعاً کار می‌کند (جستجو، عکس در واتساپ، تماس). بن‌بست، بازدیدکننده را به دکمه‌ی برگشت
// و رقیب می‌فرستد. پیوند فقط وقتی رندر می‌شود که مقصدش هست (شماره در وردپرس ثبت شده باشد).
// ---------------------------------------------------------------------------
export interface Props {
  title: string;
  text?: string;
  whatsappHref?: string | null;
  telHref?: string | null;
}

const { title, text, whatsappHref, telHref } = Astro.props;
const link = 'inline-flex items-center min-h-11 text-sm font-bold text-accent-ink hover:text-accent-strong hover:underline underline-offset-4';
---

<div class="border border-dashed border-steel-300 rounded-md bg-white px-6 py-8 text-center">
  <svg class="w-8 h-8 mx-auto text-steel-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5m8.25 3v6.75m0 0l-3-3m3 3l3-3M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" />
  </svg>
  <p class="mt-3 text-base font-bold text-steel-900">{title}</p>
  {text && <p class="mt-1 text-sm text-steel-600 leading-7 max-w-prose mx-auto">{text}</p>}
  <div class="mt-3 flex flex-wrap justify-center gap-x-5">
    <a href="/search/" class={link}>جستجوی کد فنی</a>
    {whatsappHref && <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class={link}>ارسال عکس قطعه در واتساپ</a>}
    {telHref && <a href={telHref} class={link}>تماس تلفنی</a>}
    <slot />
  </div>
</div>

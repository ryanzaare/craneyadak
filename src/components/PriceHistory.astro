---
// src/components/PriceHistory.astro
// ---------------------------------------------------------------------------
// نمودار تاریخچه‌ی قیمت — SVG خالص، بدون کتابخانه.
//
// چرا بدون کتابخانه: یک کتابخانه‌ی نمودار (Chart.js و مشابه) حدود ۶۰ تا
// ۲۰۰ کیلوبایت جاوااسکریپت اضافه می‌کند تا چند خط رسم کند. برای یک نمودار
// ساده‌ی خطی با حداکثر چند ده نقطه، SVG سمت سرور همان کار را با صفر
// بایت جاوااسکریپت انجام می‌دهد — و چون در زمان build رندر می‌شود،
// بدون جاوااسکریپت هم دیده می‌شود و در HTML قابل خزش است.
//
// ═══ چرا این بخش برای خریدار صنعتی ایرانی اهمیت دارد ═══
// در اقتصاد تورمی، مدیر خرید یک سوال همیشگی دارد: «الان بخرم یا صبر کنم؟»
// نمودار قیمت یک ادعای تبلیغاتی نیست؛ یک داده‌ی تصمیم‌گیری است و اعتماد
// می‌سازد چون قابل راستی‌آزمایی است. سایت‌های مقایسه‌ی قیمت ایرانی
// (مثل ترب) دقیقاً به همین دلیل ترافیک می‌گیرند.
//
// ⚠️ صداقت داده: اگر تاریخچه‌ای ثبت نشده باشد، نمودار جعلی ساخته
// *نمی‌شود*. فقط قیمت فعلی به‌عنوان تنها نقطه نمایش داده می‌شود و صراحتاً
// نوشته می‌شود که تاریخچه هنوز جمع نشده. ساختن یک منحنی تخیلی «نزولی»
// برای تشویق به خرید، دستکاری است نه طراحی.
// ---------------------------------------------------------------------------
import type { PricePoint } from '../lib/wp';

interface Props {
  /** نقاط تاریخی از ACF — ممکن است خالی باشد. */
  history: PricePoint[];
  /** قیمت فعلی (ریال) — از computePrice می‌آید، تنها مرجع قیمت. */
  currentPrice: number | null;
  class?: string;
}

const { history, currentPrice, class: className = '' } = Astro.props;

// نقاط معتبر + قیمت فعلی به‌عنوان آخرین نقطه.
const points = [...history]
  .filter((p) => Number.isFinite(p.price) && p.price > 0 && p.date)
  .sort((a, b) => a.date.localeCompare(b.date));

if (currentPrice !== null && currentPrice > 0) {
  const today = new Date().toISOString().slice(0, 10);
  if (points.length === 0 || points[points.length - 1]!.date !== today) {
    points.push({ date: today, price: currentPrice });
  }
}

const hasChart = points.length >= 2;
const fmt = new Intl.NumberFormat('fa-IR');

// ---- هندسه‌ی نمودار ----
const W = 640;
const H = 200;
const PAD = { top: 16, right: 16, bottom: 28, left: 64 };
const innerW = W - PAD.left - PAD.right;
const innerH = H - PAD.top - PAD.bottom;

const prices = points.map((p) => p.price);
const minP = prices.length ? Math.min(...prices) : 0;
const maxP = prices.length ? Math.max(...prices) : 0;
// دامنه‌ی صفر (همه‌ی قیمت‌ها یکسان) خط را وسط می‌نشاند به‌جای تقسیم بر صفر.
const span = maxP - minP || Math.max(maxP, 1);

const x = (i: number) => PAD.left + (points.length === 1 ? innerW / 2 : (i / (points.length - 1)) * innerW);
const y = (p: number) => PAD.top + innerH - ((p - minP) / span) * innerH;

const linePath = points.map((p, i) => `${i === 0 ? 'M' : 'L'} ${x(i).toFixed(1)} ${y(p.price).toFixed(1)}`).join(' ');
const areaPath = hasChart
  ? `${linePath} L ${x(points.length - 1).toFixed(1)} ${PAD.top + innerH} L ${x(0).toFixed(1)} ${PAD.top + innerH} Z`
  : '';

// ---- تغییر نسبت به اولین نقطه ----
const first = points[0]?.price ?? 0;
const last = points[points.length - 1]?.price ?? 0;
const changePct = first > 0 ? Math.round(((last - first) / first) * 100) : 0;

const faDate = (iso: string) => {
  try {
    return new Intl.DateTimeFormat('fa-IR', { year: '2-digit', month: 'short' }).format(new Date(iso));
  } catch {
    return iso;
  }
};

// برچسب محور عمودی — سه سطح کافی است؛ بیشتر شلوغ می‌کند.
const yTicks = hasChart ? [minP, minP + span / 2, maxP] : [];
---

{
  (points.length > 0 || currentPrice !== null) && (
    <section class={`bg-white border border-steel-300 rounded-lg overflow-hidden ${className}`} aria-labelledby="price-history-heading">
      <div class="flex flex-wrap items-center justify-between gap-3 px-4 py-3 border-b border-steel-300 bg-steel-50">
        <h2 id="price-history-heading" class="text-sm font-black text-steel-900">
          روند قیمت
        </h2>

        {hasChart && (
          <span
            class:list={[
              'text-xs font-black px-2 py-1 rounded tabular-nums',
              changePct > 0
                ? 'bg-red-50 text-red-700 border border-red-200'
                : changePct < 0
                  ? 'bg-green-50 text-green-700 border border-green-200'
                  : 'bg-steel-100 text-steel-700 border border-steel-300',
            ]}
          >
            {changePct > 0 ? '▲' : changePct < 0 ? '▼' : '='} {fmt.format(Math.abs(changePct))}٪
            <span class="font-bold"> از اولین ثبت</span>
          </span>
        )}
      </div>

      <div class="p-4">
        {hasChart ? (
          <>
            <svg
              viewBox={`0 0 ${W} ${H}`}
              class="w-full h-auto"
              role="img"
              aria-label={`نمودار روند قیمت از ${faDate(points[0]!.date)} تا ${faDate(points[points.length - 1]!.date)}`}
            >
              {/* خطوط راهنمای افقی */}
              {yTicks.map((t) => (
                <line
                  x1={PAD.left}
                  x2={W - PAD.right}
                  y1={y(t)}
                  y2={y(t)}
                  stroke="currentColor"
                  class="text-steel-100"
                  stroke-width="1"
                />
              ))}

              {/* برچسب محور قیمت — واحد «هزار تومان» چون ریال روی محور
                  عددی چهاردهم‌رقمی می‌سازد که خوانده نمی‌شود. */}
              {yTicks.map((t) => (
                <text
                  x={PAD.left - 8}
                  y={y(t) + 4}
                  text-anchor="end"
                  class="fill-steel-600"
                  style="font-size:11px"
                >
                  {fmt.format(Math.round(t / 10000))}
                </text>
              ))}

              <path d={areaPath} class="fill-accent" opacity="0.08" />
              <path
                d={linePath}
                fill="none"
                stroke="currentColor"
                class="text-accent"
                stroke-width="2.5"
                stroke-linejoin="round"
                stroke-linecap="round"
              />

              {points.map((p, i) => (
                <circle cx={x(i)} cy={y(p.price)} r={i === points.length - 1 ? 5 : 3.5} class="fill-accent">
                  <title>{`${faDate(p.date)} — ${fmt.format(Math.round(p.price / 10))} تومان`}</title>
                </circle>
              ))}

              {/* تاریخ اول و آخر */}
              <text x={x(0)} y={H - 8} text-anchor="start" class="fill-steel-600" style="font-size:11px">
                {faDate(points[0]!.date)}
              </text>
              <text x={x(points.length - 1)} y={H - 8} text-anchor="end" class="fill-steel-600" style="font-size:11px">
                {faDate(points[points.length - 1]!.date)}
              </text>
            </svg>

            <p class="text-xs text-steel-600 leading-6 mt-2">
              محور عمودی بر حسب <strong>هزار تومان</strong>. نقاط از تاریخچه‌ی ثبت‌شده‌ی قیمت در
              پنل مدیریت می‌آیند و با هر به‌روزرسانی قیمت افزوده می‌شوند.
            </p>
          </>
        ) : (
          /* ⚠️ هیچ منحنی تخیلی ساخته نمی‌شود. */
          <div class="text-center py-4">
            <p class="text-steel-700 leading-7 mb-1">
              تاریخچه‌ی قیمت برای این قطعه هنوز جمع نشده است.
            </p>
            <p class="text-xs text-steel-600 leading-6">
              روند قیمت پس از ثبت دومین به‌روزرسانی نمایش داده می‌شود. نموداری بر پایه‌ی داده‌ی
              تخمینی ساخته نمی‌شود.
            </p>
          </div>
        )}
      </div>
    </section>
  )
}

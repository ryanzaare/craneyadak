---
// src/components/ProductGallery.astro
// ---------------------------------------------------------------------------
// گالری تصویر محصول با بزرگ‌نمایی.
//
// چرا بزرگ‌نمایی تزئینی نیست: کاربر معمولاً قطعه‌ی فرسوده را در دست دارد و
// می‌خواهد شکل شیار، تعداد پیچ یا فرم دقیق قطعه را با تصویر مقایسه کند.
// تصویر ۴۰۰ پیکسلی این سوال را حل نمی‌کند و کاربر یا تماس می‌گیرد یا می‌رود.
//
// ⚠️ تصمیم پیاده‌سازی (رفع باگی که خودم ساختم):
// نسخه‌ی اول یک تگ <img> واحد داشت و با جاوااسکریپت `src` آن را عوض می‌کرد.
// وقتی تصاویر به `astro:assets` منتقل شدند این روش شکست — چون خروجی بهینه
// یک `srcset` چندنسخه‌ای است و بازنویسی دستی `src` آن را دور می‌زند و
// عملاً تصویر بهینه‌نشده بارگذاری می‌شود.
//
// راه‌حل: همه‌ی تصاویر رندر می‌شوند و فقط نمایش‌شان جابه‌جا می‌شود. هزینه‌ی
// اضافی ندارد (تصاویر غیرفعال lazy هستند) و سوییچ بین آن‌ها بدون هیچ
// درخواست شبکه و بدون پرش، آنی است.
// ---------------------------------------------------------------------------
import type { CraneImage } from '../lib/wp';
import RemoteImage from './RemoteImage.astro';

export interface Props {
  images: CraneImage[];
  productName: string;
}

const { images, productName } = Astro.props;
const gallery = images.slice(0, 6);
const hasImages = gallery.length > 0;
---

<div class="product-gallery">
  <figure class="aspect-square bg-gray-50 rounded-3xl border border-gray-100 overflow-hidden relative m-0">
    {hasImages ? (
      gallery.map((image, index) => (
        <div class="gallery-slide absolute inset-0" data-index={index} hidden={index !== 0}>
          <RemoteImage
            src={image.url}
            alt={image.altText}
            width={900}
            height={900}
            eager={index === 0}
            sizes="(max-width: 1024px) 100vw, 40vw"
            class="w-full h-full object-cover"
          />
        </div>
      ))
    ) : (
      <RemoteImage src={null} alt={productName} width={900} height={900} class="w-full h-full" />
    )}

    {hasImages && (
      <button
        type="button"
        id="gallery-zoom"
        class="absolute bottom-4 left-4 z-10 bg-white/95 backdrop-blur text-crane-navy border border-gray-200 rounded-xl px-4 py-2.5 text-sm font-bold shadow-sm hover:bg-white transition-colors focus:outline-none focus:ring-4 focus:ring-crane-orange/40 hidden print:hidden"
      >
        <span class="flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7" /></svg>
          بزرگ‌نمایی
        </span>
      </button>
    )}
  </figure>

  {gallery.length > 1 && (
    <ul class="grid grid-cols-6 gap-2.5 mt-4 print:hidden" role="list">
      {gallery.map((image, index) => (
        <li>
          <button
            type="button"
            class="gallery-thumb aspect-square w-full bg-gray-50 rounded-xl border-2 overflow-hidden transition-colors focus:outline-none focus:ring-4 focus:ring-crane-orange/30 aria-[current=true]:border-crane-orange border-gray-100 hover:border-gray-300"
            data-index={index}
            aria-current={index === 0 ? 'true' : 'false'}
            aria-label={`نمایش تصویر ${index + 1} از ${gallery.length} — ${productName}`}
          >
            <RemoteImage src={image.url} alt="" width={200} height={200} sizes="90px" class="w-full h-full object-cover" />
          </button>
        </li>
      ))}
    </ul>
  )}
</div>

{hasImages && (
  <dialog id="gallery-dialog" class="backdrop:bg-black/85 bg-transparent p-0 max-w-[95vw] max-h-[95vh] w-full">
    <div class="relative bg-white rounded-2xl overflow-hidden">
      {gallery.map((image, index) => (
        <div class="gallery-zoom-slide" data-index={index} hidden={index !== 0}>
          {/* عرض بزرگ‌تر عمدی: هدف این نما دیدن جزئیات سطح قطعه است. */}
          <RemoteImage
            src={image.url}
            alt={image.altText}
            width={1600}
            height={1600}
            sizes="95vw"
            class="w-full h-auto max-h-[90vh] object-contain"
          />
        </div>
      ))}
      <button
        type="button"
        id="gallery-close"
        class="absolute top-3 left-3 bg-white/95 text-crane-navy rounded-full w-11 h-11 flex items-center justify-center shadow-md hover:bg-white focus:outline-none focus:ring-4 focus:ring-crane-orange/40"
        aria-label="بستن تصویر"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
    </div>
  </dialog>
)}

<script>
  const dialog = document.getElementById('gallery-dialog') as HTMLDialogElement | null;
  const zoomBtn = document.getElementById('gallery-zoom');
  const closeBtn = document.getElementById('gallery-close');

  /** نمایش تصویر با اندیس مشخص در همه‌ی مجموعه‌ها (اصلی، بزرگ‌نمایی، بندانگشتی). */
  const show = (index: number) => {
    document.querySelectorAll<HTMLElement>('.gallery-slide, .gallery-zoom-slide').forEach((slide) => {
      slide.hidden = slide.dataset.index !== String(index);
    });
    document.querySelectorAll<HTMLButtonElement>('.gallery-thumb').forEach((thumb) => {
      thumb.setAttribute('aria-current', String(thumb.dataset.index === String(index)));
    });
  };

  document.querySelectorAll<HTMLButtonElement>('.gallery-thumb').forEach((thumb) => {
    thumb.addEventListener('click', () => show(Number(thumb.dataset.index ?? 0)));
  });

  // دکمه فقط وقتی ظاهر می‌شود که <dialog> واقعاً پشتیبانی شود — هرگز دکمه‌ی
  // بی‌اثر نمایش داده نمی‌شود.
  if (zoomBtn && dialog && typeof dialog.showModal === 'function') {
    zoomBtn.classList.remove('hidden');
    zoomBtn.addEventListener('click', () => dialog.showModal());
  }

  closeBtn?.addEventListener('click', () => dialog?.close());

  // کلیک روی پس‌زمینه هم می‌بندد — رفتار مورد انتظار کاربر.
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });

  // پیمایش با کیبورد داخل نمای بزرگ.
  dialog?.addEventListener('keydown', (event) => {
    const slides = document.querySelectorAll<HTMLElement>('.gallery-zoom-slide');
    if (slides.length < 2) return;

    const current = [...slides].findIndex((s) => !s.hidden);
    if (event.key === 'ArrowLeft') show((current + 1) % slides.length);
    if (event.key === 'ArrowRight') show((current - 1 + slides.length) % slides.length);
  });
</script>

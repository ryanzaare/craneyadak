---
// src/components/Footer.astro
import { SITE } from '../data/site';
import { SILOS, siloPath } from '../data/taxonomy';
import TrustBadges from './TrustBadges.astro';

const year = new Date().getFullYear();
// فوتر گروه‌های سیلو را نشان می‌دهد، نه ۳۰ دسته را — لینک داخلی متمرکز
// روی والدها، که از آن‌جا اعتبار به فرزندان توزیع می‌شود.
const footerSilos = SILOS.slice(0, 6);
---

<footer class="bg-crane-navy text-gray-300 mt-auto" role="contentinfo">
  {/* نشان‌های اعتماد پیش از لینک‌ها — خریدار صنعتی پیش از آن‌که دنبال
      لینک بگردد، دنبال دلیلی برای اعتماد می‌گردد. */}
  <TrustBadges variant="footer" />

  <div class="max-w-7xl mx-auto px-4 md:px-8 py-10">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      
      <!-- Brand & NAP Info -->
      <div class="md:col-span-2">
        <div class="flex items-center gap-2 mb-4">
          <span class="text-2xl font-black text-white">{SITE.name}</span>
          <svg class="w-7 h-7 text-crane-orange" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z M12 10v-6"></path>
          </svg>
        </div>
        <p class="text-sm leading-7 text-gray-400 max-w-md">
          {SITE.description}
        </p>
        
        <address class="not-italic text-sm mt-6 space-y-3 text-gray-400">
          <p class="flex items-start gap-2">
            <svg class="w-5 h-5 shrink-0 text-gray-500" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
            <span>{SITE.address.street} - {SITE.address.city}</span>
          </p>
          <p class="flex items-center gap-2">
            <svg class="w-5 h-5 shrink-0 text-gray-500" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
            <a href={`tel:${SITE.phone}`} class="text-white hover:text-crane-orange transition-colors focus:outline-none focus:text-crane-orange rounded px-1 -mx-1">
              {SITE.phoneDisplay}
            </a>
          </p>
          <p class="flex items-center gap-2">
            <svg class="w-5 h-5 shrink-0 text-gray-500" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            <a href={`mailto:${SITE.email}`} class="text-white hover:text-crane-orange transition-colors focus:outline-none focus:text-crane-orange rounded px-1 -mx-1">{SITE.email}</a>
          </p>
        </address>
      </div>

      <!-- Categories Links -->
      <nav aria-labelledby="footer-cats">
        <h2 id="footer-cats" class="text-white font-bold mb-5 text-base">دسته‌بندی‌های اصلی</h2>
        <ul class="space-y-3 text-sm">
          {footerSilos.map((silo) => (
            <li>
              <a href={siloPath(silo)} class="hover:text-crane-orange transition-colors inline-block py-1 focus:outline-none focus:text-crane-orange">
                {silo.name}
              </a>
            </li>
          ))}
          <li class="pt-2">
            <a href="/categories" class="text-crane-orange font-bold hover:underline py-1 inline-block">مشاهده همه دسته‌بندی‌ها ←</a>
          </li>
        </ul>
      </nav>

      <!-- Quick Links -->
      <nav aria-labelledby="footer-links">
        <h2 id="footer-links" class="text-white font-bold mb-5 text-base">دسترسی سریع</h2>
        <ul class="space-y-3 text-sm">
          <li><a href="/brands" class="hover:text-crane-orange transition-colors inline-block py-1 focus:outline-none focus:text-crane-orange">برندهای جهانی</a></li>
          <li><a href="/about" class="hover:text-crane-orange transition-colors inline-block py-1 focus:outline-none focus:text-crane-orange">درباره کرین یدک</a></li>
          <li><a href="/contact" class="hover:text-crane-orange transition-colors inline-block py-1 focus:outline-none focus:text-crane-orange">تماس با ما</a></li>
          <li><a href="/blog" class="hover:text-crane-orange transition-colors inline-block py-1 focus:outline-none focus:text-crane-orange">مقالات و آموزش‌ها</a></li>
          <li class="pt-3">
            {/* کانال‌های پیام‌رسان کنار اینستاگرام. در فروش B2B صنعتی
                ایران، واتساپ و تلگرام مسیر واقعی ارسال عکس پلاک دستگاه و
                کد فنی هستند — یعنی کانال فروش‌اند، نه شبکه‌ی اجتماعی. */}
            <ul class="flex items-center gap-2" role="list">
              <li>
                <a href={SITE.social.instagram} rel="noopener noreferrer" target="_blank" aria-label="اینستاگرام کرین یدک"
                   class="w-10 h-10 rounded-md bg-white/[0.07] border border-white/10 text-gray-300 hover:text-white hover:bg-white/15 transition-colors flex items-center justify-center focus:outline-none focus:ring-2 focus:ring-white/60">
                  <svg class="w-5 h-5" aria-hidden="true" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
                </a>
              </li>
              <li>
                <a href={`https://wa.me/${SITE.whatsapp.replace(/[^0-9]/g, '')}`} rel="noopener noreferrer" target="_blank" aria-label="واتساپ کرین یدک"
                   class="w-10 h-10 rounded-md bg-white/[0.07] border border-white/10 text-gray-300 hover:text-white hover:bg-[#25D366] transition-colors flex items-center justify-center focus:outline-none focus:ring-2 focus:ring-white/60">
                  <svg class="w-5 h-5" aria-hidden="true" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.885 3.4"/></svg>
                </a>
              </li>
              <li>
                <a href={`https://t.me/${SITE.telegram}`} rel="noopener noreferrer" target="_blank" aria-label="تلگرام کرین یدک"
                   class="w-10 h-10 rounded-md bg-white/[0.07] border border-white/10 text-gray-300 hover:text-white hover:bg-[#229ED9] transition-colors flex items-center justify-center focus:outline-none focus:ring-2 focus:ring-white/60">
                  <svg class="w-5 h-5" aria-hidden="true" fill="currentColor" viewBox="0 0 24 24"><path d="M11.944 0A12 12 0 000 12a12 12 0 0012 12 12 12 0 0012-12A12 12 0 0012 0a12 12 0 00-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 01.171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
                </a>
              </li>
            </ul>
          </li>
        </ul>
      </nav>
    </div>

    {/* دسترس‌پذیری (WCAG AA): رنگ قبلی gray-500 روی پس‌زمینه‌ی crane-navy
        فقط ~۴.۱:۱ کنتراست می‌داد که برای متن کوچک (۱۲px) رد می‌شود؛
        gray-400 روی همان پس‌زمینه ~۷.۴:۱ می‌دهد. */}
    {/* نوار پایانی. عبارت «توسعه‌یافته با استانداردهای سئوی مهندسی B2B»
        حذف شد: تبلیغ روش ساخت سایت به خریدار قطعه، هم بی‌ربط است و هم
        آماتوری به نظر می‌رسد. هیچ تأمین‌کننده‌ی جدی‌ای این را نمی‌نویسد.

        نشان اینماد عمداً در گوشه‌ی چپ-پایین است: در صفحات RTL این گوشه
        همان جایی است که کاربر ایرانی برای نشان‌های اعتماد نگاه می‌کند. */}
    <div class="border-t border-white/10 mt-10 pt-6 flex flex-col-reverse md:flex-row justify-between items-center gap-5 text-xs text-gray-400">
      <div class="flex items-center gap-3">
        <div
          class="w-[68px] h-[82px] shrink-0 rounded border-2 border-dashed border-white/20 flex items-center justify-center text-center p-1"
          aria-hidden="true"
        >
          <span class="text-[9px] leading-3 text-gray-400 font-bold">محل درج<br />کد اینماد</span>
        </div>
        <p class="leading-6 max-w-[16rem]">
          نماد اعتماد الکترونیکی پس از تایید دامنه در همین محل درج می‌شود.
        </p>
      </div>

      <p class="text-center md:text-left">کپی‌رایت © {year} {SITE.name}. تمامی حقوق محفوظ است.</p>
    </div>
  </div>
</footer>
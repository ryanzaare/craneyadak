---
// src/components/Footer.astro
import { SITE } from '../data/site';
import { SILOS, siloPath } from '../data/taxonomy';

const year = new Date().getFullYear();
// فوتر گروه‌های سیلو را نشان می‌دهد، نه ۳۰ دسته را — لینک داخلی متمرکز
// روی والدها، که از آن‌جا اعتبار به فرزندان توزیع می‌شود.
const footerSilos = SILOS.slice(0, 6);
---

<footer class="bg-crane-navy text-gray-300 mt-auto" role="contentinfo">
  <div class="max-w-7xl mx-auto px-4 md:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12">
      
      <!-- Brand & NAP Info -->
      <div class="md:col-span-2">
        <div class="flex items-center gap-2 mb-4">
          <span class="text-2xl font-black text-white">{SITE.name}</span>
          <svg class="w-7 h-7 text-crane-orange" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z M12 10v-6"></path>
          </svg>
        </div>
        <p class="text-sm leading-7 text-gray-400 max-w-md">
          {SITE.description}
        </p>
        
        <address class="not-italic text-sm mt-6 space-y-3 text-gray-400">
          <p class="flex items-start gap-2">
            <svg class="w-5 h-5 shrink-0 text-gray-500" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
            <span>{SITE.address.street} - {SITE.address.city}</span>
          </p>
          <p class="flex items-center gap-2">
            <svg class="w-5 h-5 shrink-0 text-gray-500" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
            <a href={`tel:${SITE.phone}`} class="text-white hover:text-crane-orange transition-colors focus:outline-none focus:text-crane-orange rounded px-1 -mx-1">
              {SITE.phoneDisplay}
            </a>
          </p>
          <p class="flex items-center gap-2">
            <svg class="w-5 h-5 shrink-0 text-gray-500" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            <a href={`mailto:${SITE.email}`} class="text-white hover:text-crane-orange transition-colors focus:outline-none focus:text-crane-orange rounded px-1 -mx-1">{SITE.email}</a>
          </p>
        </address>
      </div>

      <!-- Categories Links -->
      <nav aria-labelledby="footer-cats">
        <h2 id="footer-cats" class="text-white font-bold mb-5 text-base">دسته‌بندی‌های اصلی</h2>
        <ul class="space-y-3 text-sm">
          {footerSilos.map((silo) => (
            <li>
              <a href={siloPath(silo)} class="hover:text-crane-orange transition-colors inline-block py-1 focus:outline-none focus:text-crane-orange">
                {silo.name}
              </a>
            </li>
          ))}
          <li class="pt-2">
            <a href="/categories" class="text-crane-orange font-bold hover:underline py-1 inline-block">مشاهده همه دسته‌بندی‌ها ←</a>
          </li>
        </ul>
      </nav>

      <!-- Quick Links -->
      <nav aria-labelledby="footer-links">
        <h2 id="footer-links" class="text-white font-bold mb-5 text-base">دسترسی سریع</h2>
        <ul class="space-y-3 text-sm">
          <li><a href="/brands" class="hover:text-crane-orange transition-colors inline-block py-1 focus:outline-none focus:text-crane-orange">برندهای جهانی</a></li>
          <li><a href="/about" class="hover:text-crane-orange transition-colors inline-block py-1 focus:outline-none focus:text-crane-orange">درباره کرین یدک</a></li>
          <li><a href="/contact" class="hover:text-crane-orange transition-colors inline-block py-1 focus:outline-none focus:text-crane-orange">تماس با ما</a></li>
          <li><a href="/blog" class="hover:text-crane-orange transition-colors inline-block py-1 focus:outline-none focus:text-crane-orange">مقالات و آموزش‌ها</a></li>
          <li class="pt-2">
            <a href={SITE.social.instagram} rel="noopener noreferrer" target="_blank" class="flex items-center gap-2 text-gray-400 hover:text-crane-orange transition-colors py-1">
              <svg class="w-5 h-5" aria-hidden="true" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
              اینستاگرام کرین یدک
            </a>
          </li>
        </ul>
      </nav>
    </div>

    {/* دسترس‌پذیری (WCAG AA): رنگ قبلی gray-500 روی پس‌زمینه‌ی crane-navy
        فقط ~۴.۱:۱ کنتراست می‌داد که برای متن کوچک (۱۲px) رد می‌شود؛
        gray-400 روی همان پس‌زمینه ~۷.۴:۱ می‌دهد. */}
    <div class="border-t border-white/10 mt-12 pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-gray-400">
      <p>کپی‌رایت © {year} {SITE.name}. تمامی حقوق محفوظ است.</p>
      <p>توسعه‌یافته با استانداردهای سئوی مهندسی B2B</p>
    </div>
  </div>
</footer>
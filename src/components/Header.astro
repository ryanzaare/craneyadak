---
// src/components/Header.astro
// ---------------------------------------------------------------------------
// ⚠️ دو رفع باگ مهم در این فایل:
//
// ۱) هدر چسبان گاهی هنگام اسکرول به بالا ناپدید/نصفه می‌شد.
//    دو علت هم‌زمان داشت:
//    الف) `overflow-x-hidden` روی <body> یک زمینه‌ی اسکرول می‌ساخت که
//         `position: sticky` را می‌شکند (در Layout.astro به `clip` تغییر کرد).
//    ب) `backdrop-blur-lg` روی یک عنصر sticky در برخی مرورگرها باعث
//       آرتیفکت ترسیم (repaint) می‌شود؛ بخشی از هدر پاک می‌شد و تا اسکرول
//       بعدی برنمی‌گشت. با کاهش شدت بلور و اجبار عنصر به لایه‌ی کامپوزیت
//       مستقل (`transform: translateZ(0)`) رفع شد.
//
// ۲) منوی دسته‌بندی فقط ۷ گروه و «تعداد» فرزندان را نشان می‌داد.
//    این از نظر تجاری اشتباه بود: کاربری که دنبال «جاروبک» است، در منویی که
//    فقط نوشته «سیستم برق رسانی — ۵ دسته» هیچ نشانه‌ای نمی‌بیند و می‌رود.
//    حالا یک مگا-منو کامل، هر ۷ گروه را همراه با تمام ۳۱ زیردسته نشان
//    می‌دهد — بدون نیاز به کلیک. سود سئویی جانبی: هر صفحه به تمام صفحات
//    دسته لینک داخلی می‌دهد و عمق خزش کل کاتالوگ ۱ کلیک می‌شود.
//    ⚠️ فاز ۳ این را به «فقط دسته‌های دارای کالا» بُرد (تصمیم D)؛ کارفرما ۳ آبان ۱۴۰۵ لغوش کرد: دسته‌ها به‌زودی پر
//    می‌شوند و منو باید از همین حالا کامل باشد. هزینه: ~۲۰KB HTML خام روی هر صفحه (بودجه‌ی §6 ← ۲۰۵KB).
//    شمار کالای هر دسته عمداً در منو نیست: ۳۱ «(۰)» هم بایت است هم پیام «خالی».
// ---------------------------------------------------------------------------
import { SITE } from '../data/site';
import { SILOS, siloPath, categoryPath } from '../data/taxonomy';
import Logo from './Logo.astro';
import { ACCOUNT_MENU } from '../data/account-menu';
import { getContact } from '../lib/site-options';
import { mobileLine } from './contact-mobile';

// «خط ویژه تامین» (فاز ۳): خط همراه از وردپرس (memoized).
const mobile = mobileLine(await getContact());

// متغیر محیطی build به مرورگر نمی‌رسد؛ از data-wp-base خوانده می‌شود
// (src/scripts/account.ts). بدون آن، «خروج» در منوی هدر کار نمی‌کند.
const wpBase = (import.meta.env.WP_GRAPHQL_URL as string | undefined)?.replace(/\/+$/, '') ?? '';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href.replace(/\/$/, '');
const inSection = (prefix: string) => path.startsWith(prefix);

// روی گرافیت: steel-200 (۱۳:۱) و فعال = سفید ضخیم با زیرخط نارنجی (accent پرکردن است، نه متن — §5).
const navOn = 'text-white font-bold underline decoration-accent decoration-2 underline-offset-8';
const navOff = 'text-steel-200 hover:text-white';

const navLinks = [
  // آرشیو محصولات باید در ناوبری اصلی باشد: جایگزین PartFinder است و
  // تنها مسیر «همه‌ی کالاها را نشانم بده» در کل سایت.
  { href: '/products', label: 'فروشگاه' },
  { href: '/brands', label: 'برندها' },
  { href: '/about', label: 'درباره ما' },
  { href: '/contact', label: 'تماس با ما' },
];
---

<header
  class="sticky top-0 z-50 w-full bg-steel-900 text-white border-b border-steel-950 py-2 md:py-3"
  style="transform: translateZ(0);"
  role="banner"
  data-wp-base={wpBase}
>
  <div class="w-full max-w-7xl mx-auto flex flex-wrap justify-between items-center gap-y-2 px-4 md:px-8">
    <a href="/" class="flex min-w-0 items-center gap-3 rounded-lg p-1 focus:outline-none focus:ring-2 focus:ring-accent" aria-label={`صفحه اصلی ${SITE.name}`}>
      {/* چینش راست‌به‌چپ: `items-start` به‌جای `items-end`.
          در ظرف flex عمودی، محور متقاطع همان محور افقی است و با dir="rtl"
          مقدار `start` یعنی سمت راست. نسخه‌ی قبل `items-end` بود که در
          RTL به لبه‌ی چپ نگاشت می‌شود — یعنی نام برند و شعار زیر آن روی
          لبه‌ی اشتباه تراز می‌شدند. `text-right` هم صریح اضافه شد تا اگر
          روزی شعار در نمایشگر باریک به دو خط شکست، خط دوم هم درست بماند. */}
      {/* ⚠️ min-w-0 + whitespace-nowrap + truncate: با آیکن‌های سبد در هدر
          موبایل (۳۶۰px)، نام برند «کرین / یدک» دو خط و شعار سه خط می‌شد.
          حالا نام هرگز نمی‌شکند و فقط شعار، اگر جا نبود، با «…» کوتاه
          می‌شود. زیر ۳۶۰px (iPhone SE نسل اول) نام و نشان کمی کوچک‌ترند؛
          و اگر هر دو سبد پر باشند، نشان پنهان می‌شود (global.css،
          .brand-mark) — وگرنه نام ۱۴px روی نشان می‌افتاد (preview دیده شد). */}
      {/* ⚠️ هدر گرافیت (فاز ۳): بی‌backdrop-blur — پس‌زمینه‌ی مات هم باگ repaint بند ۱-ب بالا را از ریشه برمی‌دارد و
          هم هزینه‌ی ترکیب GPU روی هر اسکرول را (قفل سرعت). translateZ ارزان است و به‌عنوان بیمه ماند. */}
      <span class="flex min-w-0 flex-col items-start text-right leading-tight">
        <span class="whitespace-nowrap text-xl min-[360px]:text-2xl md:text-3xl font-black text-white tracking-tight">{SITE.name}</span>
        <span class="max-w-full truncate text-xs md:text-xs font-bold text-steel-300">{SITE.tagline}</span>
      </span>
      <Logo inverse class="brand-mark w-10 h-10 min-[360px]:w-12 min-[360px]:h-12 md:w-14 md:h-14 shrink-0" />
    </a>

    {/* ------------------------- جستجوی هدر (Frontend v2، فاز ۱) -------------------------
        چرا: یافته‌ی §4b — بازدیدکننده‌ای که روی صفحه‌ی داخلی (اغلب صفحه‌ی محصول، از گوگل) فرود می‌آید راهی برای
        جستجوی دوباره نداشت. «جستجو در ورودی اصلی است و کد فنی می‌فهمد» (§2 اصل ۱).
        یک فرم، دو جا: زیر xl ردیف کامل زیر لوگو (order-last + basis-full در flex-wrap)، از xl کنار لوگو. یک فرم
        یعنی یک landmark جستجو و یک id — نه دو فرم که یکی همیشه پنهان است.
        ⚠️ عمداً فرم سادهٔ GET بدون جاوااسکریپت و بدون فهرست پیشنهاد: SearchBox آرایه‌ی ساختاری را در HTML هر صفحه
        inline می‌کند و اسکریپت می‌آورد — روی *هر* صفحه یعنی وزن اضافه برای همه. پیشنهاد آنی و تحمل خط‌تیره/فاصله
        کار فاز ۲ (جستجو) است. نتیجه در /search/ با Pagefind (پارامتر q همان است که search.astro می‌خواند). */}
    {/* ردیف جستجو + «خط ویژه تامین» (فاز ۳): زیر xl ردیف دوم تمام‌عرض؛ از xl کنار لوگو. قرص تلفن در همین ردیف است، نه
        در ردیف اول: در lg ردیف اول (لوگو + ناوبری + آیکن‌ها) جای ۲۳۰px دیگر ندارد و flex-wrap ناوبری را می‌شکست.
        ⚠️ xl:basis-0: با basis-auto عرض محتوای جستجو + قرص مبنای شکستن خط بود و ناوبری در ۱۲۸۰px به ردیف دوم می‌رفت
        (هدر ۸۹ → ۱۳۷px). همراهش w-0 روی ورودی: عرض ذاتی ~۱۷۰px ورودی min-content ردیف بود و همان شکست را می‌ساخت.
        برچسب «خط ویژه تامین:» در xl تا 2xl پنهان است — فقط نقطه + شماره جا می‌شود. */}
    <div class="order-last basis-full flex items-center gap-2 xl:order-none xl:basis-0 xl:flex-1 xl:max-w-xl xl:mx-6 print:hidden">
    <form action="/search/" method="get" role="search" class="min-w-0 flex-1">
      <label for="header-search" class="sr-only">جستجوی کد فنی، نام قطعه یا برند</label>
      <div class="flex items-stretch h-11 rounded-md border border-steel-700 bg-steel-800 focus-within:border-steel-400">
        <input
          id="header-search"
          name="q"
          type="search"
          enterkeyhint="search"
          autocomplete="off"
          spellcheck="false"
          placeholder="جستجو"
          class="w-0 min-w-0 flex-1 bg-transparent px-3 text-base text-white placeholder:text-steel-400 focus:outline-none"
        />
        {/* میان‌بر «/» (فاز ۳) — فقط نشانه؛ شنونده در اسکریپت پایین. aria-keyshortcuts روی ورودی نیست چون همین kbd
            زیر lg (لمسی) پنهان است و میان‌بر صفحه‌کلید آنجا معنا ندارد. */}
        <kbd class="hidden lg:grid place-items-center self-center w-6 h-6 rounded border border-steel-600 font-mono text-xs text-steel-300" aria-hidden="true">/</kbd>
        <button type="submit" class="shrink-0 w-11 grid place-items-center text-steel-300 hover:text-white" aria-label="جستجو">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" /></svg>
        </button>
      </div>
    </form>
    {/* تماس یک‌لمسی موبایل (فاز ۳) — کنار جستجو، نه در ردیف لوگو: آن‌جا در ۳۹۰px آیکن‌ها را به ردیف سوم می‌برد
        (هدر ۱۲۵ → ۱۸۱px، build زنده‌ی 451c2cd). همان خط همراه قرص، که زیر md پنهان است. */}
    {mobile && (
      <a href={mobile.href} class="md:hidden shrink-0 grid place-items-center w-11 h-11 rounded-full border border-steel-700 bg-steel-800 text-white hover:border-steel-400" aria-label={`تماس فوری: ${mobile.display}`}>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" /></svg>
      </a>
    )}
    {mobile && (
      /* «● خط ویژه تامین: ۰۹…» — ⚠️ نقطه همیشه سبز است، بی‌بررسی ساعت (کارفرما، ۳ آبان ۱۴۰۵): این خط همراه فوری
         جرثقیلِ از کار افتاده است، نه تلفن دفتر؛ نقطه‌ی خاکستری «تعطیلیم» خوانده می‌شد. ادعای ۲۴ساعته ادعای خود
         کارفرماست. فاز ۳ آن را به ساعت کاری وردپرس بسته بود (business-hours.ts — حذف شد). */
      <a href={mobile.href}
        class="hidden md:inline-flex shrink-0 items-center gap-2 h-11 px-3.5 rounded-full border border-steel-700 bg-steel-800 text-sm font-bold text-white hover:border-steel-400 whitespace-nowrap">
        <span class="w-2 h-2 rounded-full bg-emerald-400" aria-hidden="true"></span>
        <span class="xl:hidden 2xl:inline">خط ویژه تامین:</span>
        <span class="tabular-nums" dir="ltr">{mobile.display}</span>
      </a>
    )}
    </div>

    {/* ------------------------- ناوبری دسکتاپ ------------------------- */}
    {/* ⚠️ ناوبری کامل از lg، نه md (فاز ۱): در ۷۶۸px پنج پیوند + لوگو + آیکن‌ها جا نمی‌شد و برچسب‌ها دوخطی بودند
        («دسته‌بندی / قطعات»)؛ با ردیف جستجو و flex-wrap، ناوبری به ردیف سوم می‌رفت (هدر چسبان ۱۸۹px). زیر lg همان
        منوی همبرگری موبایل. */}
    <nav class="hidden lg:block" aria-label="منوی اصلی">
      <ul class="flex items-center gap-7 text-sm font-normal">
        {/* «صفحه اصلی» از ناوبری دسکتاپ رفت (فاز ۳): لوگو همان پیوند است و ۹۰px آن برای قرص «خط ویژه تامین» لازم بود. */}

        <li id="mega-wrap" class="static">
          <button
            type="button"
            id="mega-trigger"
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="mega-menu"
            class:list={[
              'flex items-center gap-1 transition-colors py-2 focus:outline-none focus:ring-2 focus:ring-accent rounded',
              inSection('/categories') ? navOn : navOff,
            ]}
          >
            دسته‌بندی قطعات
            <svg id="mega-chevron" class="w-4 h-4 text-steel-400 transition-transform" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
          </button>
        </li>

        {navLinks.map((link) => (
          <li>
            <a href={link.href} class:list={['transition-colors py-2 focus:outline-none focus:ring-2 focus:ring-accent rounded', inSection(link.href) ? navOn : navOff]} aria-current={isActive(link.href) ? 'page' : undefined}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex shrink-0 items-center gap-1 md:gap-2">
      {/* ⚠️ حساب کاربری در هدر است، نه فقط فوتر — کارفرما درست گرفت که
          فوتر عملاً دیده نمی‌شود. برخلاف «پیگیری درخواست» (که کاربرش
          می‌داند دنبال چه می‌گردد و پایین صفحه را نگاه می‌کند)، ورود
          کاری است که کاربر در هر صفحه‌ای ممکن است بخواهد.

          وارد نشده: یک لینک ساده به صفحه‌ی ورود. وارد شده: منوی کشویی
          (فهرستش در src/data/account-menu.ts). سایت استاتیک است، پس
          اسکریپت پایین بر اساس توکن مرورگر یکی از این دو را نشان می‌دهد؛
          بدون جاوااسکریپت، لینک ورود می‌ماند. */}
      {/* ورودی دو سبد (کشوها در Baskets.astro). تا سبد خالی است پنهان‌اند:
          تا وقتی قیمتی در پنل تأیید نشده، سبد خرید هیچ‌وقت پر نمی‌شود و
          آیکن همیشه‌خالی فقط شلوغی است.
          ⚠️ روی موبایل کوچک‌تر از آیکن حساب (p-1.5، ۲۴px): با هر دو سبد پر،
          در عرض ۳۶۰px نام «کرین یدک» دو خطی می‌شد (preview دیده شد). */}
      <button
        type="button"
        id="quote-open"
        hidden
        class="relative rounded-md p-1.5 md:p-2 text-white hover:text-steel-300 transition-colors focus:outline-none focus:ring-2 focus:ring-accent"
        aria-label="سبد استعلام"
        aria-controls="quote-drawer"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-6 0h.01M12 16h3m-6 0h.01" />
        </svg>
        <span id="quote-count" class="absolute -top-0.5 -left-0.5 bg-white text-steel-900 rounded-full min-w-[1.25rem] h-5 px-1 flex items-center justify-center tabular-nums text-xs font-black">0</span>
      </button>
      <button
        type="button"
        id="cart-open"
        hidden
        class="relative rounded-md p-1.5 md:p-2 text-white hover:text-steel-300 transition-colors focus:outline-none focus:ring-2 focus:ring-accent"
        aria-label="سبد خرید"
        aria-controls="cart-drawer"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z" />
        </svg>
        <span id="cart-count" class="absolute -top-0.5 -left-0.5 bg-action text-white rounded-full min-w-[1.25rem] h-5 px-1 flex items-center justify-center tabular-nums text-xs font-black">0</span>
      </button>
      <a
        id="account-link"
        href="/account/login"
        class:list={[
          'flex items-center gap-1.5 rounded-md p-2 text-sm font-normal transition-colors focus:outline-none focus:ring-2 focus:ring-accent',
          inSection('/account') ? 'text-white underline decoration-accent decoration-2 underline-offset-8' : 'text-white hover:text-steel-300',
        ]}
        aria-label="ورود یا ثبت‌نام"
      >
        <svg class="w-7 h-7 md:w-6 md:h-6" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.5 20.1a7.5 7.5 0 0115 0A17.9 17.9 0 0112 21.75c-2.68 0-5.22-.58-7.5-1.65z" />
        </svg>
        <span class="hidden md:inline">ورود</span>
      </a>

      <div id="account-menu-wrap" class="relative hidden">
        <button
          id="account-trigger"
          type="button"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="account-menu"
          aria-label="منوی حساب من"
          class:list={[
            'flex items-center gap-1.5 rounded-md p-2 text-sm font-normal transition-colors focus:outline-none focus:ring-2 focus:ring-accent',
            inSection('/account') ? 'text-white underline decoration-accent decoration-2 underline-offset-8' : 'text-white hover:text-steel-300',
          ]}
        >
          <svg class="w-7 h-7 md:w-6 md:h-6" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.5 20.1a7.5 7.5 0 0115 0A17.9 17.9 0 0112 21.75c-2.68 0-5.22-.58-7.5-1.65z" />
          </svg>
          <span id="account-name" class="hidden md:inline max-w-[9rem] truncate">حساب من</span>
          <svg id="account-chevron" class="hidden md:block w-4 h-4 text-steel-500 transition-transform" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
        </button>

        {/* left-0: در RTL، دکمه در لبه‌ی چپ هدر است؛ منو باید به سمت داخل
            صفحه باز شود، نه بیرون از آن. */}
        <div
          id="account-menu"
          class="hidden absolute left-0 top-full mt-2 w-56 bg-white border border-steel-200 rounded-lg shadow-xl py-2 z-50"
          role="menu"
          aria-label="حساب من"
        >
          {ACCOUNT_MENU.map((item) => (
            <a
              href={item.href}
              role="menuitem"
              class:list={[
                'flex items-center gap-3 px-4 py-2.5 text-sm transition-colors focus:outline-none focus:bg-steel-50',
                isActive(item.href) ? 'text-accent-ink font-bold' : 'text-steel-700 hover:bg-steel-50 hover:text-steel-900',
              ]}
            >
              <svg class="w-5 h-5 shrink-0 text-steel-400" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d={item.icon} /></svg>
              {item.label}
            </a>
          ))}
          <div class="border-t border-steel-100 my-1" role="separator"></div>
          <button
            id="account-logout"
            type="button"
            role="menuitem"
            class="w-full flex items-center gap-3 px-4 py-2.5 text-sm text-red-700 hover:bg-red-50 transition-colors focus:outline-none focus:bg-red-50"
          >
            <svg class="w-5 h-5 shrink-0" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 16l4-4-4-4M19 12H9M13 20H6a2 2 0 01-2-2V6a2 2 0 012-2h7" /></svg>
            خروج
          </button>
        </div>
      </div>

      <button id="mobile-menu-btn" type="button" class="lg:hidden text-white rounded-md p-2 z-50 focus:outline-none focus:ring-2 focus:ring-accent" aria-label="باز کردن منو" aria-expanded="false" aria-controls="mobile-menu">
        <svg class="w-8 h-8" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path id="hamburger-icon-path" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  {/* ---------------------------- مگا-منو ---------------------------- */}
  <div
    id="mega-menu"
    class="hidden absolute inset-x-0 top-full bg-white border-b border-steel-200 shadow-xl max-h-[75vh] overflow-y-auto"
    role="region"
    aria-label="همه دسته‌بندی‌های قطعات"
  >
    <div class="max-w-7xl mx-auto px-6 py-8">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-8">
        {SILOS.map((silo) => (
          <div class="min-w-0">
            <a
              href={siloPath(silo)}
              class="flex items-center gap-2 font-black text-steel-900 hover:text-accent-ink transition-colors mb-3 pb-2 border-b border-steel-100 focus:outline-none focus:ring-2 focus:ring-accent rounded"
            >
              <span class="w-7 h-7 shrink-0 text-accent-ink" aria-hidden="true">
                <svg class="w-full h-full" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d={silo.icon} /></svg>
              </span>
              <span class="text-sm leading-6">{silo.name}</span>
            </a>
            {/* ⚠️ کلاس پیوندها یک‌بار روی ul (واریانت [&_a]) نه روی هر ۳۱ پیوند: رشته‌ی ~۲۰۰ بایتی تکراری ~۶KB به HTML
                *هر* صفحه می‌افزود (ممیزی بودجه‌ی HTML، ۱ آبان ۱۴۰۵). فوکوس = همان :focus-visible سراسری (accent). */}
            <ul class="space-y-1.5 [&_a]:block [&_a]:text-sm [&_a]:leading-6 [&_a]:rounded [&_a]:px-1 [&_a]:-mx-1 [&_a]:py-0.5 [&_a]:text-steel-700 [&_a:hover]:text-accent-ink [&_a[aria-current]]:text-accent-ink [&_a[aria-current]]:font-bold" role="list">
              {silo.categories.map((category) => (
                <li>
                  <a href={categoryPath({ ...category, silo })} aria-current={path === categoryPath({ ...category, silo }) ? 'page' : undefined}>{category.name}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <div class="mt-8 pt-5 border-t border-steel-100 flex flex-wrap items-center gap-4">
        <a href="/categories/" class="text-sm font-bold text-accent-ink hover:underline focus:outline-none focus:ring-2 focus:ring-accent rounded">مشاهده نقشه کامل کاتالوگ ←</a>
        <a href="/contact" class="text-sm font-bold text-steel-900 hover:text-accent-ink transition-colors focus:outline-none focus:ring-2 focus:ring-steel-900 rounded">قطعه را پیدا نکردید؟ کد فنی را استعلام بگیرید</a>
      </div>
    </div>
  </div>

  {/* ------------------------- منوی موبایل ------------------------- */}
  <div id="mobile-menu" class="hidden lg:hidden absolute top-full inset-x-0 bg-white border-b border-steel-100 shadow-lg z-40 max-h-[80vh] overflow-y-auto">
    <nav aria-label="منوی موبایل">
      <ul class="flex flex-col py-4 px-5 gap-1 text-base font-normal">
        <li><a href="/" class:list={['block py-2.5', isActive('/') ? 'text-accent-ink font-bold' : 'text-steel-700']}>صفحه اصلی</a></li>

        {/* آکاردئون: هر گروه باز می‌شود و زیردسته‌ها را نشان می‌دهد —
            همان اطلاعاتی که در دسکتاپ با هاور دیده می‌شود. */}
        <li class="border-t border-steel-100 pt-2 mt-1">
          <span class="block text-xs font-black text-steel-500 uppercase tracking-wider py-2">دسته‌بندی قطعات</span>
          <ul class="flex flex-col gap-1">
            {SILOS.map((silo) => (
              <li>
                <details class="group">
                  <summary class="flex items-center justify-between gap-2 cursor-pointer list-none py-2.5 text-steel-900 font-bold focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-ink rounded">
                    <span class="flex items-center gap-2">
                      <span class="w-5 h-5 shrink-0 text-accent-ink" aria-hidden="true">
                        <svg class="w-full h-full" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d={silo.icon} /></svg>
                      </span>
                      <span class="text-sm">{silo.name}</span>
                    </span>
                    <svg class="w-4 h-4 shrink-0 text-steel-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
                  </summary>
                  <ul class="flex flex-col pr-7 gap-0.5 pb-2 border-r-2 border-accent-soft mr-2.5 [&_a]:block [&_a]:text-sm [&_a]:text-steel-700 [&_a]:py-1.5" role="list">
                    <li><a href={siloPath(silo)} class="!text-xs font-bold !text-accent-ink">مشاهده کل گروه ←</a></li>
                    {silo.categories.map((category) => (
                      <li><a href={categoryPath({ ...category, silo })}>{category.name}</a></li>
                    ))}
                  </ul>
                </details>
              </li>
            ))}
          </ul>
        </li>

        <li class="border-t border-steel-100 pt-2 mt-1">
          <ul class="flex flex-col">
            {navLinks.map((link) => (
              <li><a href={link.href} class:list={['block py-2.5', inSection(link.href) ? 'text-accent-ink font-bold' : 'text-steel-700']}>{link.label}</a></li>
            ))}
          </ul>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  import { api, cacheName, cachedName, getToken, logout } from '../scripts/account';

  /* میان‌بر «/» → جستجو (جستجوی بزرگ صفحه‌ی اصلی اگر هست، وگرنه هدر). نه وقتی کاربر در فیلدی تایپ می‌کند. */
  document.addEventListener('keydown', (e) => {
    if (e.key !== '/' || e.ctrlKey || e.metaKey || e.altKey) return;
    if ((e.target as HTMLElement).closest('input, textarea, select, [contenteditable="true"]')) return;
    const box = document.querySelector<HTMLInputElement>('[data-slash-target]') ?? document.querySelector<HTMLInputElement>('#header-search');
    if (box) { e.preventDefault(); box.focus(); }
  });

  /* ----------------------- منوی حساب کاربری -----------------------
     فقط وجود توکن بررسی می‌شود، نه اعتبارش — اعتبارسنجی یک درخواست شبکه
     در هر صفحه‌ی سایت می‌شد. توکن منقضی را اولین درخواست حساب (۴۰۱)
     پاک می‌کند و از آن به بعد لینک ورود برمی‌گردد. */
  const accountLink = document.getElementById('account-link');
  const accountWrap = document.getElementById('account-menu-wrap');
  const accountTrigger = document.getElementById('account-trigger');
  const accountMenu = document.getElementById('account-menu');
  const accountChevron = document.getElementById('account-chevron');

  if (getToken() && accountLink && accountWrap && accountTrigger && accountMenu) {
    accountLink.classList.add('hidden');
    accountWrap.classList.remove('hidden');

    /* نام کاربر به‌جای «حساب من». تا رسیدن نام، متن پیش‌فرض می‌ماند (بدون
       پرش خالی). یک بار از سرور گرفته و نگه داشته می‌شود (cachedName)؛
       شکست شبکه هیچ‌چیز را نمی‌شکند. textContent، نه innerHTML: نام را
       خود کاربر نوشته است. */
    const nameEl = document.getElementById('account-name');
    const showName = (name: string) => {
      if (!nameEl || !name) return;
      nameEl.textContent = name;
      nameEl.title = name;
      accountTrigger.setAttribute('aria-label', `منوی حساب ${name}`);
    };
    const known = cachedName();
    if (known) showName(known);
    else
      api<{ profile?: { name?: string } }>('/account/me', { auth: true }).then((res) => {
        const name = res.ok ? res.data.profile?.name : '';
        if (name) {
          cacheName(name);
          showName(name);
        }
      });

    let closeTimer: ReturnType<typeof setTimeout> | undefined;
    const setOpen = (open: boolean) => {
      clearTimeout(closeTimer);
      accountMenu.classList.toggle('hidden', !open);
      accountTrigger.setAttribute('aria-expanded', String(open));
      accountChevron?.classList.toggle('rotate-180', open);
    };
    const isOpen = () => accountTrigger.getAttribute('aria-expanded') === 'true';
    // همان تأخیر بستن مگا-منو: حرکت مورب ماوس از دکمه به منو نباید آن را ببندد.
    const scheduleClose = () => {
      clearTimeout(closeTimer);
      closeTimer = setTimeout(() => setOpen(false), 180);
    };

    // هاور فقط روی دستگاهی که واقعاً هاور دارد؛ روی لمسی، mouseenter پیش
    // از click می‌آید و منو در یک لمس باز و فوراً بسته می‌شد.
    if (window.matchMedia('(hover: hover)').matches) {
      accountWrap.addEventListener('mouseenter', () => setOpen(true));
      accountWrap.addEventListener('mouseleave', scheduleClose);
    }
    accountTrigger.addEventListener('click', (e) => {
      e.stopPropagation();
      setOpen(!isOpen());
    });
    document.addEventListener('click', (e) => {
      if (isOpen() && !accountWrap.contains(e.target as Node)) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) {
        setOpen(false);
        accountTrigger.focus();
      }
    });
    accountWrap.addEventListener('focusout', (e) => {
      if (!accountWrap.contains(e.relatedTarget as Node)) setOpen(false);
    });

    document.getElementById('account-logout')?.addEventListener('click', () => {
      logout();
    });
  }

  /* ------------------------- منوی موبایل ------------------------- */
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconPath = document.getElementById('hamburger-icon-path');
  const HAMBURGER = 'M4 6h16M4 12h16M4 18h16';
  const CLOSE = 'M6 18L18 6M6 6l12 12';

  if (btn && menu && iconPath) {
    const setOpen = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'بستن منو' : 'باز کردن منو');
      menu.classList.toggle('hidden', !open);
      iconPath.setAttribute('d', open ? CLOSE : HAMBURGER);
    };
    const isOpen = () => btn.getAttribute('aria-expanded') === 'true';

    btn.addEventListener('click', (e) => { e.stopPropagation(); setOpen(!isOpen()); });
    document.addEventListener('click', (e) => {
      if (isOpen() && !menu.contains(e.target as Node) && !btn.contains(e.target as Node)) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) { setOpen(false); btn.focus(); }
    });
    window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
      if (e.matches && isOpen()) setOpen(false);
    });
  }

  /* --------------------------- مگا-منو ---------------------------
     با هاور باز می‌شود (سریع، بدون کلیک اضافه) و با کلیک/کیبورد هم
     کار می‌کند. تاخیر بستن عمدی است: بدون آن، حرکت مورب ماوس از دکمه
     به داخل منو باعث بسته‌شدن ناگهانی می‌شود — یکی از آزاردهنده‌ترین
     رفتارهای مگا-منوهای بد. */
  const trigger = document.getElementById('mega-trigger');
  const mega = document.getElementById('mega-menu');
  const chevron = document.getElementById('mega-chevron');
  const wrap = document.getElementById('mega-wrap');

  if (trigger && mega && wrap) {
    let closeTimer: ReturnType<typeof setTimeout> | undefined;

    const open = (state: boolean) => {
      clearTimeout(closeTimer);
      mega.classList.toggle('hidden', !state);
      trigger.setAttribute('aria-expanded', String(state));
      chevron?.classList.toggle('rotate-180', state);
    };
    const scheduleClose = () => {
      clearTimeout(closeTimer);
      closeTimer = setTimeout(() => open(false), 180);
    };

    trigger.addEventListener('mouseenter', () => open(true));
    trigger.addEventListener('focus', () => open(true));
    trigger.addEventListener('click', (e) => {
      e.preventDefault();
      open(trigger.getAttribute('aria-expanded') !== 'true');
    });

    trigger.addEventListener('mouseleave', scheduleClose);
    mega.addEventListener('mouseenter', () => clearTimeout(closeTimer));
    mega.addEventListener('mouseleave', scheduleClose);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && trigger.getAttribute('aria-expanded') === 'true') {
        open(false);
        trigger.focus();
      }
    });

    // کلیک بیرون، و خروج فوکوس کیبورد از کل ناحیه
    document.addEventListener('click', (e) => {
      const t = e.target as Node;
      if (!mega.contains(t) && !trigger.contains(t)) open(false);
    });
    document.addEventListener('focusin', (e) => {
      const t = e.target as Node;
      if (!mega.contains(t) && !trigger.contains(t)) open(false);
    });
  }
</script>

---
// src/components/Header.astro
// ---------------------------------------------------------------------------
// ⚠️ دو رفع باگ مهم در این فایل:
//
// ۱) هدر چسبان گاهی هنگام اسکرول به بالا ناپدید/نصفه می‌شد.
//    دو علت هم‌زمان داشت:
//    الف) `overflow-x-hidden` روی <body> یک زمینه‌ی اسکرول می‌ساخت که
//         `position: sticky` را می‌شکند (در Layout.astro به `clip` تغییر کرد).
//    ب) `backdrop-blur-lg` روی یک عنصر sticky در برخی مرورگرها باعث
//       آرتیفکت ترسیم (repaint) می‌شود؛ بخشی از هدر پاک می‌شد و تا اسکرول
//       بعدی برنمی‌گشت. با کاهش شدت بلور و اجبار عنصر به لایه‌ی کامپوزیت
//       مستقل (`transform: translateZ(0)`) رفع شد.
//
// ۲) منوی دسته‌بندی فقط ۷ گروه و «تعداد» فرزندان را نشان می‌داد.
//    این از نظر تجاری اشتباه بود: کاربری که دنبال «جاروبک» است، در منویی که
//    فقط نوشته «سیستم برق رسانی — ۵ دسته» هیچ نشانه‌ای نمی‌بیند و می‌رود.
//    حالا یک مگا-منو کامل، هر ۷ گروه را همراه با تمام ۳۱ زیردسته نشان
//    می‌دهد — بدون نیاز به کلیک. سود سئویی جانبی: هر صفحه به تمام صفحات
//    دسته لینک داخلی می‌دهد و عمق خزش کل کاتالوگ ۱ کلیک می‌شود.
// ---------------------------------------------------------------------------
import { SITE } from '../data/site';
import { SILOS, siloPath, categoryPath } from '../data/taxonomy';
import Logo from './Logo.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href.replace(/\/$/, '');
const inSection = (prefix: string) => path.startsWith(prefix);

const navLinks = [
  { href: '/brands', label: 'برندها' },
  { href: '/about', label: 'درباره ما' },
  { href: '/contact', label: 'تماس با ما' },
];
---

<header
  class="sticky top-0 z-50 w-full bg-white/95 backdrop-blur-sm border-b border-gray-100 py-3 shadow-sm"
  style="transform: translateZ(0);"
  role="banner"
>
  <div class="w-full max-w-7xl mx-auto flex justify-between items-center px-4 md:px-8">
    <a href="/" class="flex items-center gap-3 rounded-lg p-1 focus:outline-none focus:ring-2 focus:ring-crane-orange" aria-label={`صفحه اصلی ${SITE.name}`}>
      <span class="flex flex-col items-end leading-tight">
        <span class="text-2xl md:text-3xl font-black text-crane-navy tracking-tight">{SITE.name}</span>
        <span class="text-[10px] md:text-xs font-bold text-gray-600">{SITE.tagline}</span>
      </span>
      <Logo class="w-12 h-12 md:w-14 md:h-14 text-crane-navy shrink-0" />
    </a>

    {/* ------------------------- ناوبری دسکتاپ ------------------------- */}
    <nav class="hidden md:block" aria-label="منوی اصلی">
      <ul class="flex items-center gap-7 text-sm font-medium">
        <li>
          <a href="/" class:list={['transition-colors py-2 focus:outline-none focus:ring-2 focus:ring-crane-orange rounded', isActive('/') ? 'text-crane-orange font-bold' : 'text-gray-700 hover:text-crane-navy']} aria-current={isActive('/') ? 'page' : undefined}>صفحه اصلی</a>
        </li>

        <li id="mega-wrap" class="static">
          <button
            type="button"
            id="mega-trigger"
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="mega-menu"
            class:list={[
              'flex items-center gap-1 transition-colors py-2 focus:outline-none focus:ring-2 focus:ring-crane-orange rounded',
              inSection('/categories') ? 'text-crane-orange font-bold' : 'text-gray-700 hover:text-crane-navy',
            ]}
          >
            دسته‌بندی قطعات
            <svg id="mega-chevron" class="w-4 h-4 text-gray-500 transition-transform" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
          </button>
        </li>

        {navLinks.map((link) => (
          <li>
            <a href={link.href} class:list={['transition-colors py-2 focus:outline-none focus:ring-2 focus:ring-crane-orange rounded', inSection(link.href) ? 'text-crane-orange font-bold' : 'text-gray-700 hover:text-crane-navy']} aria-current={isActive(link.href) ? 'page' : undefined}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <button id="mobile-menu-btn" type="button" class="md:hidden text-crane-navy rounded-md p-2 z-50 focus:outline-none focus:ring-2 focus:ring-crane-orange" aria-label="باز کردن منو" aria-expanded="false" aria-controls="mobile-menu">
      <svg class="w-8 h-8" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path id="hamburger-icon-path" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  {/* ---------------------------- مگا-منو ---------------------------- */}
  <div
    id="mega-menu"
    class="hidden absolute inset-x-0 top-full bg-white border-b border-gray-200 shadow-xl max-h-[75vh] overflow-y-auto"
    role="region"
    aria-label="همه دسته‌بندی‌های قطعات"
  >
    <div class="max-w-7xl mx-auto px-6 py-8">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-8">
        {SILOS.map((silo) => (
          <div class="min-w-0">
            <a
              href={siloPath(silo)}
              class="flex items-center gap-2 font-black text-crane-navy hover:text-crane-orange transition-colors mb-3 pb-2 border-b border-gray-100 focus:outline-none focus:ring-2 focus:ring-crane-orange rounded"
            >
              <span class="w-7 h-7 shrink-0 text-crane-orange" aria-hidden="true">
                <svg class="w-full h-full" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d={silo.icon} /></svg>
              </span>
              <span class="text-sm leading-6">{silo.name}</span>
            </a>
            <ul class="space-y-1.5" role="list">
              {silo.categories.map((category) => (
                <li>
                  <a
                    href={categoryPath({ ...category, silo })}
                    class:list={[
                      'block text-sm leading-6 transition-colors rounded px-1 -mx-1 py-0.5 focus:outline-none focus:ring-2 focus:ring-crane-orange',
                      path === categoryPath({ ...category, silo })
                        ? 'text-crane-orange font-bold'
                        : 'text-gray-700 hover:text-crane-orange',
                    ]}
                  >
                    {category.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <div class="mt-8 pt-5 border-t border-gray-100 flex flex-wrap items-center gap-4">
        <a href="/categories" class="text-sm font-bold text-crane-orange hover:underline focus:outline-none focus:ring-2 focus:ring-crane-orange rounded">مشاهده نقشه کامل کاتالوگ ←</a>
        <a href="/contact" class="text-sm font-bold text-crane-navy hover:text-crane-orange transition-colors focus:outline-none focus:ring-2 focus:ring-crane-navy rounded">قطعه را پیدا نکردید؟ کد فنی را استعلام بگیرید</a>
      </div>
    </div>
  </div>

  {/* ------------------------- منوی موبایل ------------------------- */}
  <div id="mobile-menu" class="hidden md:hidden absolute top-full inset-x-0 bg-white border-b border-gray-100 shadow-lg z-40 max-h-[80vh] overflow-y-auto">
    <nav aria-label="منوی موبایل">
      <ul class="flex flex-col py-4 px-5 gap-1 text-base font-medium">
        <li><a href="/" class:list={['block py-2.5', isActive('/') ? 'text-crane-orange font-bold' : 'text-gray-700']}>صفحه اصلی</a></li>

        {/* آکاردئون: هر گروه باز می‌شود و زیردسته‌ها را نشان می‌دهد —
            همان اطلاعاتی که در دسکتاپ با هاور دیده می‌شود. */}
        <li class="border-t border-gray-100 pt-2 mt-1">
          <span class="block text-xs font-black text-gray-500 uppercase tracking-wider py-2">دسته‌بندی قطعات</span>
          <ul class="flex flex-col gap-1">
            {SILOS.map((silo) => (
              <li>
                <details class="group">
                  <summary class="flex items-center justify-between gap-2 cursor-pointer list-none py-2.5 text-crane-navy font-bold focus:outline-none focus-visible:ring-2 focus-visible:ring-crane-orange rounded">
                    <span class="flex items-center gap-2">
                      <span class="w-5 h-5 shrink-0 text-crane-orange" aria-hidden="true">
                        <svg class="w-full h-full" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d={silo.icon} /></svg>
                      </span>
                      <span class="text-sm">{silo.name}</span>
                    </span>
                    <svg class="w-4 h-4 shrink-0 text-gray-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
                  </summary>
                  <ul class="flex flex-col pr-7 gap-0.5 pb-2 border-r-2 border-orange-100 mr-2.5" role="list">
                    <li><a href={siloPath(silo)} class="block text-xs font-bold text-crane-orange py-1.5">مشاهده کل گروه ←</a></li>
                    {silo.categories.map((category) => (
                      <li><a href={categoryPath({ ...category, silo })} class="block text-sm text-gray-700 py-1.5">{category.name}</a></li>
                    ))}
                  </ul>
                </details>
              </li>
            ))}
          </ul>
        </li>

        <li class="border-t border-gray-100 pt-2 mt-1">
          <ul class="flex flex-col">
            {navLinks.map((link) => (
              <li><a href={link.href} class:list={['block py-2.5', inSection(link.href) ? 'text-crane-orange font-bold' : 'text-gray-700']}>{link.label}</a></li>
            ))}
          </ul>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  /* ------------------------- منوی موبایل ------------------------- */
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconPath = document.getElementById('hamburger-icon-path');
  const HAMBURGER = 'M4 6h16M4 12h16M4 18h16';
  const CLOSE = 'M6 18L18 6M6 6l12 12';

  if (btn && menu && iconPath) {
    const setOpen = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'بستن منو' : 'باز کردن منو');
      menu.classList.toggle('hidden', !open);
      iconPath.setAttribute('d', open ? CLOSE : HAMBURGER);
    };
    const isOpen = () => btn.getAttribute('aria-expanded') === 'true';

    btn.addEventListener('click', (e) => { e.stopPropagation(); setOpen(!isOpen()); });
    document.addEventListener('click', (e) => {
      if (isOpen() && !menu.contains(e.target as Node) && !btn.contains(e.target as Node)) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) { setOpen(false); btn.focus(); }
    });
    window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
      if (e.matches && isOpen()) setOpen(false);
    });
  }

  /* --------------------------- مگا-منو ---------------------------
     با هاور باز می‌شود (سریع، بدون کلیک اضافه) و با کلیک/کیبورد هم
     کار می‌کند. تاخیر بستن عمدی است: بدون آن، حرکت مورب ماوس از دکمه
     به داخل منو باعث بسته‌شدن ناگهانی می‌شود — یکی از آزاردهنده‌ترین
     رفتارهای مگا-منوهای بد. */
  const trigger = document.getElementById('mega-trigger');
  const mega = document.getElementById('mega-menu');
  const chevron = document.getElementById('mega-chevron');
  const wrap = document.getElementById('mega-wrap');

  if (trigger && mega && wrap) {
    let closeTimer: ReturnType<typeof setTimeout> | undefined;

    const open = (state: boolean) => {
      clearTimeout(closeTimer);
      mega.classList.toggle('hidden', !state);
      trigger.setAttribute('aria-expanded', String(state));
      chevron?.classList.toggle('rotate-180', state);
    };
    const scheduleClose = () => {
      clearTimeout(closeTimer);
      closeTimer = setTimeout(() => open(false), 180);
    };

    trigger.addEventListener('mouseenter', () => open(true));
    trigger.addEventListener('focus', () => open(true));
    trigger.addEventListener('click', (e) => {
      e.preventDefault();
      open(trigger.getAttribute('aria-expanded') !== 'true');
    });

    trigger.addEventListener('mouseleave', scheduleClose);
    mega.addEventListener('mouseenter', () => clearTimeout(closeTimer));
    mega.addEventListener('mouseleave', scheduleClose);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && trigger.getAttribute('aria-expanded') === 'true') {
        open(false);
        trigger.focus();
      }
    });

    // کلیک بیرون، و خروج فوکوس کیبورد از کل ناحیه
    document.addEventListener('click', (e) => {
      const t = e.target as Node;
      if (!mega.contains(t) && !trigger.contains(t)) open(false);
    });
    document.addEventListener('focusin', (e) => {
      const t = e.target as Node;
      if (!mega.contains(t) && !trigger.contains(t)) open(false);
    });
  }
</script>

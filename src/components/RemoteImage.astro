---
// src/components/RemoteImage.astro
// ---------------------------------------------------------------------------
// تصویر بهینه‌شده — تنها راه مجاز رندر تصویر در کل سایت.
//
// چرا این کامپوننت لازم است:
// تصاویر محصول از کتابخانه‌ی رسانه‌ی وردپرس می‌آیند (URL خارجی). یک تگ
// <img> ساده یعنی همان JPEG اصلی ۲ مگابایتی که مدیر محتوا آپلود کرده،
// مستقیم به موبایل کاربر ارسال شود. این دقیقاً همان ترسی بود که باعث شد
// پروژه تا امروز بدون تصویر بماند — و ترس درستی هم بود، برای <img> ساده.
//
// راه‌حل: `astro:assets` تصاویر ریموت را در زمان BUILD دانلود، تغییر اندازه
// و به AVIF/WebP تبدیل می‌کند. خروجی فایل ثابت است، پس بازدیدکننده هرگز به
// وردپرس وصل نمی‌شود و هزینه‌ی پردازش صفر است.
//
// نتیجه: عکس واقعی قطعه — که برای شناسایی حیاتی است و برای Google Images
// ترافیک می‌آورد — بدون هزینه‌ی سرعت.
//
// ⚠️ دامنه‌ی وردپرس باید در `image.domains` در astro.config.mjs مجاز شده
// باشد، وگرنه Astro از بهینه‌سازی امتناع می‌کند (سیاست امنیتی درست: جلوگیری
// از تبدیل‌شدن بیلد به سرویس پردازش تصویر برای هر URL دلخواه).
// ---------------------------------------------------------------------------
import { Image } from 'astro:assets';

export interface Props {
  src: string | null | undefined;
  alt: string;
  width: number;
  height: number;
  /** بارگذاری مشتاقانه فقط برای تصویر LCP (اولین تصویر بالای صفحه). */
  eager?: boolean;
  /** اندازه‌های واقعی نمایش در بریک‌پوینت‌ها — برای انتخاب درست srcset. */
  sizes?: string;
  class?: string;
  /** نسبت ابعاد جایگزین وقتی تصویری وجود ندارد. */
  fallbackClass?: string;
}

const {
  src,
  alt,
  width,
  height,
  eager = false,
  sizes = '(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 25vw',
  class: className = '',
  fallbackClass = '',
} = Astro.props;

// فقط URL مطلق http(s) قابل بهینه‌سازی است. مقدار نامعتبر نباید بیلد را
// بشکند — تصویر نداشتن یک واقعیت عملیاتی است، نه خطای کد.
const isRemote = typeof src === 'string' && /^https?:\/\//i.test(src);
---

{isRemote ? (
  <Image
    src={src!}
    alt={alt}
    width={width}
    height={height}
    widths={[width / 2, width, width * 1.5].map((w) => Math.round(w))}
    sizes={sizes}
    format="avif"
    fallbackFormat="webp"
    quality={72}
    loading={eager ? 'eager' : 'lazy'}
    decoding={eager ? 'sync' : 'async'}
    fetchpriority={eager ? 'high' : 'auto'}
    class={className}
  />
) : (
  /* جایگزین خنثی — عمداً یک آیکون است نه تصویر یک محصول دیگر.
     ابعاد ثابت نگه داشته می‌شود تا نبود تصویر باعث پرش چیدمان (CLS) نشود. */
  <div
    class:list={['flex items-center justify-center bg-gray-100 text-gray-300', className, fallbackClass]}
    style={`aspect-ratio: ${width} / ${height};`}
    role="img"
    aria-label={alt}
  >
    <svg class="w-1/4 h-1/4 min-w-8 min-h-8" fill="none" stroke="currentColor" stroke-width="1.2" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
    </svg>
  </div>
)}

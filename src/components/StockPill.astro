---
// src/components/StockPill.astro
// ---------------------------------------------------------------------------
// قرص وضعیت موجودی (Frontend v2، فاز ۰ — docs/frontend-v2.md §5).
//
// فقط دو وضعیتی که وردپرس واقعاً ثبت می‌کند برچسب دارند. «unknown» هیچ چیزی رندر نمی‌کند: برچسبی مثل
// «موجودی را بپرسید» یک ادعای ساختگی نیست، ولی جای خالی را با متن پر می‌کند و خریدار را وادار می‌کند
// قرصی را بخواند که هیچ اطلاعاتی ندارد (قاعده‌ی ۲: موجودی ساخته نشود).
//
// ⚠️ متن‌ها همان برچسب‌های فعلی صفحه‌ی محصول‌اند (`stockLabel` در products/[slug].astro) — زمان تحویل
// عمداً نیامده؛ عبارت زمانی فقط با تأیید کارفرما.
// رنگ: نقطه + متن، نه فقط رنگ (کوررنگی). emerald/amber رنگ وضعیت‌اند، نه برند — backlog: توکن معنایی.
// ---------------------------------------------------------------------------
import type { StockStatus } from '../lib/pricing';

export interface Props {
  status: StockStatus;
  class?: string;
}

const { status, class: className = '' } = Astro.props;

const STOCK_LABEL: Record<StockStatus, string | null> = {
  in_stock: 'موجود در انبار',
  on_order: 'تامین به‌سفارش',
  unknown: null,
};
const label = STOCK_LABEL[status];
---

{label && (
  <span
    class:list={[
      'inline-flex items-center gap-1.5 rounded border px-2 py-0.5 text-xs font-bold',
      status === 'in_stock' ? 'bg-emerald-50 text-emerald-800 border-emerald-200' : 'bg-amber-50 text-amber-900 border-amber-200',
      className,
    ]}
  >
    <span class:list={['w-1.5 h-1.5 rounded-full', status === 'in_stock' ? 'bg-emerald-600' : 'bg-amber-500']} aria-hidden="true" />
    {label}
  </span>
)}

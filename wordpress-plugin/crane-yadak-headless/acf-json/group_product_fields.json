        {
            "key": "field_cyh_product_sale_price",
            "label": "قیمت با تخفیف (ریال)",
            "name": "sale_price",
            "type": "number",
            "instructions": "⚠️ فقط زمانی پر کنید که واقعاً تخفیف داده‌اید. قیمت خط‌خورده‌ای که در سایت نمایش داده می‌شود همان «قیمت عادی» بالاست و باید قیمتی باشد که واقعاً قبلاً دریافت می‌شده. نمایش یک قیمت قبلیِ ساختگی، هم خلاف سیاست گوگل و هم از نظر قانون حمایت از مصرف‌کننده تخلف است. اگر این عدد از قیمت عادی بیشتر یا مساوی باشد، سایت آن را نادیده می‌گیرد.",
            "required": 0,
            "show_in_graphql": 1,
            "graphql_field_name": "salePrice",
            "min": 0,
            "step": "1"
        },
